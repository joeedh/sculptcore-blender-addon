/keys
# Vendored engine runtime staged by the build (ctypes package + native DLLs).
# This is a build product mirrored in from engine/; never committed.
/sculptcore_addon/lib/

# Python bytecode.
__pycache__/
*.pyc

# Blender install tree produced by the build helper.
/dist/

# Editor/OS noise.
.vscode/
.DS_Store

# Raw bench output (JSON per run); the rig is committed, the samples are not.
/claudeMemory/scripts/bench-results*/
/claudeMemory/scripts/bench-sc/

# GPU-trace A/B output: the JSON summaries are committed, the RenderDoc
# captures they were derived from (~4-8 MB per .rdc) are not.
/claudeMemory/scripts/gpu-trace-results*/captures/
