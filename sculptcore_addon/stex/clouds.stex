// Blender "Clouds" as a runtime texture program: 3D-mapped brush strokes
// evaluate this at the true sculpt-space point (CPU JIT, GPU-spliceable),
// so the pattern is infinite instead of a tiled [-1,1]^2 bake.
//
// Structure mirrors BLI_noise_generic_turbulence: depth+1 octaves of [0,1]
// lattice value noise, amplitude halved and frequency doubled per octave,
// hard noise = |2n - 1|, normalized by the amplitude sum; then Blender's
// bright/contrast fold and the optional color ramp (uploaded as a 256-entry
// luminance LUT). The noise basis is the engine's builtin `vnoise` host
// sampler (integer-hash lattice value noise, native CPU code + a WGSL twin
// for the splice) - visually equivalent to Blender's bases, not
// bit-identical, and noise_basis variants are not distinguished. The basis
// lives engine-side because the tcc CPU JIT does not optimize: a DSL-inlined
// hash cost ~9x the native sampler per octave.

sampler float vnoise(float3 p);

texture BlenderClouds {
  param float scale = 4.0;                    // 1 / noise_scale
  param float depth = 2.0 @range(0.0, 8.0);   // extra octaves (Blender noise_depth)
  param float hard = 0.0 @range(0.0, 1.0);    // noise_type == HARD_NOISE
  param float bright = 1.0;                   // Texture.intensity
  param float contrast = 1.0;
  param float no_clamp = 1.0 @range(0.0, 1.0); // not Texture.use_clamp
  param float use_ramp = 0.0 @range(0.0, 1.0);
  param float sx = 1.0;                       // texture_slot.scale
  param float sy = 1.0;
  param float sz = 1.0;
  param float ox = 0.0;                       // texture_slot.offset
  param float oy = 0.0;
  param float oz = 0.0;
  param ramp shape;

  float eval(float3 p, float3 n) {
    // Placement, verbatim from RE_texture_evaluate (texture_procedural.cc
    // :1061-1080): texvec[i] = size[i] * (vec[i] + ofs[i]) — offset *before*
    // scale. (The projx/y/z swizzle in that same block is identity here:
    // MTex defaults to PROJ_X/Y/Z (DNA_texture_types.h:315) and TextureSlot
    // RNA exposes no way to change it, so a brush slot never permutes axes.)
    // The +1 is BLI_noise_generic_turbulence's own, applied to the default
    // basis *before* the 1/noisesize divide (noise_c.cc:1244-1258); the
    // Musgrave path has no such offset, so it belongs here and not in the
    // sampler.
    float qx = ((p.x + ox) * sx + 1.0) * scale;
    float qy = ((p.y + oy) * sy + 1.0) * scale;
    float qz = ((p.z + oz) * sz + 1.0) * scale;
    float sum = 0.0;
    float amp = 1.0;
    float tot = 0.0;
    float fs = 1.0;
    float dmax = depth + 0.5;
    for (float o = 0.0; o < dmax; o = o + 1.0) {
      float t = vnoise(float3(qx * fs, qy * fs, qz * fs));
      if (hard > 0.5) {
        t = abs(2.0 * t - 1.0);
      }
      sum = sum + t * amp;
      tot = tot + amp;
      amp = amp * 0.5;
      fs = fs * 2.0;
    }
    // BRICONT (texture_common.h:15-25): the bright/contrast fold always
    // runs, but the [0,1] clamp only when TEX_NO_CLAMP is *clear* — and new
    // textures ship with it set (DNA_texture_types.h:396), so the default is
    // unclamped. Blender's tin legitimately leaves [0,1] there.
    float v = (sum / tot - 0.5) * contrast + bright - 0.5;
    if (no_clamp < 0.5) {
      v = clamp(v, 0.0, 1.0);
    }
    if (use_ramp > 0.5) {
      v = shape.sample(v);
    }
    return v;
  }
}
