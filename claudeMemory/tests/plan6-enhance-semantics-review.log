147: def _ensure_brush(session):
148:     """The session's reusable engine Brush (built once)."""
149:     if session.brush_obj is None:
150:         mgr = engine.manager()
151:         session.brush_obj = mgr.construct("sculptcore::brush::Brush")
152:     return session.brush_obj
153: 
154: 
155: def _ensure_executor(session):
156:     """The session's CommandExecutor, bound to its tree + brush, with a
157:     per-session MeshLog wired in so each stroke records an undo step."""
158:     if session.executor is None:
159:         mgr = engine.manager()
160:         ctor = mgr.get_struct("sculptcore::brush::CommandExecutor").find_constructor("main")
161:         session.executor = mgr.construct_with(ctor, session.tree(), _ensure_brush(session))
162:         session.meshlog = mgr.construct("sculptcore::meshlog::MeshLog")
163:         session.executor.meshLog = session.meshlog
164:         # Csr (ring-1 CSR adjacency) for the smooth family's for_neighbor source,
165:         # matching the engine's other sculpt consumer. Bit-identical to the
166:         # LiveDisk default on our freshly built meshes and marginally faster (Q1a
167:         # A/B); a dyntopo step overrides it back to LiveDisk internally.
168:         session.executor.setNeighborMode(1)
169:     return session.executor
