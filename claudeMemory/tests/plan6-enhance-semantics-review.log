230: def _grid_session(session):
231:     """The engine grids stroke session for the active multires level, created
232:     lazily and recreated on level change (a session binds one level). None
233:     when creation fails."""
234:     lib = engine.capi().lib
235:     level = session.multires_active_level
236:     if session.grid_ptr and session.grid_level != level:
237:         lib.GridStroke_free(session.grid_ptr)
238:         session.grid_ptr = None
239:         session.grid_generation += 1
240:         session.grid_cursor = 0
241:     if not session.grid_ptr:
242:         brush = _ensure_brush(session)
243:         ptr = lib.GridStroke_new(session.multires_ptr, level, brush.ptr)
244:         if not ptr:
245:             return None
246:         session.grid_ptr = ptr
247:         session.grid_level = level
248:         session.grid_generation += 1
249:         session.grid_cursor = 0
250:         session.grid_undo_bytes_base = 0
251:         # The addon relies on the engine-side ride-along mirror to keep the
252:         # slot mesh (extdraw, flush, mesh-path queries) current, and defers
253:         # normal refreshes to the frame cadence (closely-spaced dabs overlap
254:         # ~90%, so per-dab refresh recomputes the same fans many times).
255:         lib.GridStroke_setMirror(ptr, 1)
256:         lib.GridStroke_setDeferNormals(ptr, 1)
257:     return session.grid_ptr
