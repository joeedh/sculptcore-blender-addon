58: namespace sculptcore::brush {
59: 
60: enum class GridAttrPlanKind : int {
61:   Unbindable = 0,
62:   DefaultColumn,
63:   SessionChannel,
64:   LayerScratch,
65: };
66: 
67: /** Floats one element of `type` occupies in a store channel, or 0 if the
68:  * grids store cannot carry it. Copy-compatible types only: the float family
69:  * plus INT, which rides along as raw bytes. */
70: inline int gridAttrTypeFloats(mesh::AttrType type)
71: {
72:   switch (type) {
73:   case mesh::AttrType::FLOAT:
74:   case mesh::AttrType::INT:
75:     return 1;
76:   case mesh::AttrType::FLOAT2:
77:     return 2;
78:   case mesh::AttrType::FLOAT3:
79:     return 3;
80:   case mesh::AttrType::FLOAT4:
81:     return 4;
82:   default:
83:     return 0;
84:   }
85: }
86: 
87: /** Whether an all-zero column is a correct source for this read-only handle.
88:  * A registry of layers, not of brushes: `.boundary.vert.class` 0 is "interior"
89:  * and selects the plain-Laplacian branch, which is what the grids lattice is. */
90: inline bool gridAttrZeroDefault(const BrushAttrManifestEntry &entry)
91: {
92:   return entry.boundName == string(".boundary.vert.class");
93: }
94: 
95: /** The store-channel / cage-layer name a handle binds under, matching the mesh
96:  * path's rule (brush_executor.h): an explicit boundName wins, else the handle. */
97: inline const string &gridAttrLayerName(const BrushAttrManifestEntry &entry)
98: {
99:   return entry.boundName.size() ? entry.boundName : entry.handle;
100: }
101: 
102: /** Route one declared attr layer onto the grids domain.
103:  *
104:  * `attrs` is the live stack's storage policy (grid_attrs.h), or null where
105:  * there is none to ask — the pre-session dispatch probe. Null keeps the
106:  * type/domain answers and skips only the storage-class term, so a caller that
107:  * can supply it always gets the narrower answer. */
108: inline GridAttrPlanKind gridAttrPlan(const BrushAttrManifestEntry &entry,
109:                                      const subdiv::MultiresAttrs *attrs = nullptr)
110: {
111:   if (!entry.kernelWrites) {
112:     // A read-only handle needs a source, not storage. Anything else here
113:     // (enhance's held displacement, the cross field) is filled by a mesh-path
114:     // pre-pass; binding zeros would make those brushes silent no-ops instead
115:     // of falling back.
116:     return gridAttrZeroDefault(entry) ? GridAttrPlanKind::DefaultColumn
117:                                       : GridAttrPlanKind::Unbindable;
118:   }
119:   if (entry.domain != AttrElemDomain::Vertex && entry.domain != AttrElemDomain::Face) {
120:     // Edge/corner element domains have no grid element to land on: the store's
121:     // two domains are the (S+1)^2 vert lattice and the S^2 quad cells.
122:     return GridAttrPlanKind::Unbindable;
123:   }
124:   if (int(entry.use) & int(mesh::AttrUse::SCULPT_LAYER)) {
125:     // Per-dab scratch the executor folds into co; writeback then attributes
126:     // the residual into the live edit target's channel. Without a target
127:     // there is nowhere to attribute it -- decline, like the mesh path's
128:     // LayerEditScope, which is inert without a settings row.
129:     return (attrs && attrs->hasLayerEditTarget() &&
130:             entry.domain == AttrElemDomain::Vertex &&
131:             entry.type == mesh::AttrType::FLOAT3)
132:                ? GridAttrPlanKind::LayerScratch
133:                : GridAttrPlanKind::Unbindable;
134:   }
135:   if (attrs &&
136:       attrs->storageFor(gridAttrLayerName(entry), entry.type, mesh::AttrFlag::NONE) ==
137:           subdiv::GridAttrStorage::Derived)
138:   {
139:     // The storage class, enforced where the routing decision is made rather
140:     // than left to the channel's persist flag. A Derived attribute's grid
141:     // elements are a cache of the cage; a kernel that writes them is authoring
142:     // data the host cannot store and the next rebuild would discard. The cage
143:     // route (mesh path + Multires::scatterVertFloat4ToCage per dab) is the one
144:     // a host without multires attributes has.
145:     return GridAttrPlanKind::Unbindable;
146:   }
147:   return gridAttrTypeFloats(entry.type) > 0 ? GridAttrPlanKind::SessionChannel
148:                                             : GridAttrPlanKind::Unbindable;
149: }
150: 
151: /** A kernel-written layer's dense column plus its store channel. */
152: struct GridAttrMirror {
153:   string handle;
154:   string layer;
155:   mesh::AttrType type = mesh::AttrType::FLOAT;
156:   subdiv::GridElemDomain domain = subdiv::GridElemDomain::Vertex;
157:   int floats = 0;
158:   int channel = -1;
159:   /** Stroke sequence the column was last gathered for; a re-gather per step
160:    * is what re-reads store bytes an undo/redo swapped behind our back. */
161:   uint32_t gatheredFor = 0;
162:   bool dirty = false;
163:   mesh::AttrDataBase *column = nullptr;
164: };
165: 
166: /** resize(), not the (name, size) constructor: that one sizes the page table
167:  * but leaves the pages unmaterialized, and getElemData then returns null for
168:  * every element the mirror gathers into. */
169: template <class T>
170: inline mesh::AttrDataBase *gridAttrNewTypedColumn(const string &name, int n)
171: {
172:   auto *column = alloc::New<mesh::AttrData<T>>("grid attr column", name);
173:   column->resize(n);
174:   return column;
175: }
176: 
177: /** Allocate the dense column for `type`, sized to `n` verts, or null if the
178:  * type is not one gridAttrTypeFloats accepts. */
179: inline mesh::AttrDataBase *
180: gridAttrNewColumn(mesh::AttrType type, const string &name, int n)
181: {
182:   switch (type) {
183:   case mesh::AttrType::FLOAT:
184:     return gridAttrNewTypedColumn<float>(name, n);
185:   case mesh::AttrType::FLOAT2:
186:     return gridAttrNewTypedColumn<float2>(name, n);
187:   case mesh::AttrType::FLOAT3:
188:     return gridAttrNewTypedColumn<float3>(name, n);
189:   case mesh::AttrType::FLOAT4:
190:     return gridAttrNewTypedColumn<float4>(name, n);
191:   case mesh::AttrType::INT:
192:     return gridAttrNewTypedColumn<int>(name, n);
193:   default:
194:     return nullptr;
195:   }
196: }
197: 
198: /** Owner of the executor's mirrors: a domain rebuild (attach) drops them all,
199:  * since dense ids remap and the columns are sized to the old domain. */
200: struct GridAttrMirrorSet {
201:   Vector<GridAttrMirror *> items;
202: 
203:   GridAttrMirrorSet() = default;
204:   GridAttrMirrorSet(const GridAttrMirrorSet &) = delete;
205:   GridAttrMirrorSet &operator=(const GridAttrMirrorSet &) = delete;
206: 
207:   ~GridAttrMirrorSet()
208:   {
209:     clear();
210:   }
211: 
212:   void clear()
213:   {
214:     for (GridAttrMirror *m : items) {
215:       if (m->column) {
216:         alloc::Delete(m->column);
217:       }
218:       alloc::Delete(m);
219:     }
220:     items.clear();
221:   }
222: 
223:   GridAttrMirror *find(const string &handle)
224:   {
225:     for (GridAttrMirror *m : items) {
226:       if (m->handle == handle) {
227:         return m;
228:       }
229:     }
230:     return nullptr;
231:   }
232: };
233: 
234: /** Find or create the session channel backing `mirror` (persist=false: engine
235:  * owned, lazily allocated per level, seeded by addLevel, and in the serializer
236:  * so undo sees it).
237:  *
238:  * A level with no data yet is seeded from what the surface already shows — the
239:  * cage's derived samples for a vertex layer, the cage's own per-face value for
240:  * a face one — so a layer the host also carries (colour, face sets) is painted
241:  * *over* rather than from black. The seed is per level and one-shot:
242:  * MultiresAttrs::seedSessionChannel declines a level that already holds
243:  * authored values. */
244: inline int
245: gridAttrEnsureChannel(subdiv::Multires *mr, const GridAttrMirror &mirror, int level)
246: {
247:   int ch = mr->store.findChannel(mirror.layer);
248:   if (ch < 0) {
249:     // The host answers the persistence half. A layer it declared through
250:     // declareHostAttr has a container to be saved into; a layer it did not
251:     // declare is session-only. Either way the channel is marked Authored, and
252:     // the engine's own behaviour keys off that flag.
253:     const bool persist =
254:         mr->gridAttrs().storageFor(mirror.layer, mirror.type, mesh::AttrFlag::NONE) ==
255:         subdiv::GridAttrStorage::Host;
256:     ch = mr->store.addChannel(mirror.layer,
257:                               mirror.floats,
258:                               mirror.domain,
259:                               mirror.type,
260:                               persist,
261:                               subdiv::GridLevelRule::Authored);
262:   }
263:   Assert(mr->store.channelElemSize(ch) == mirror.floats &&
264:              mr->store.channelDomain(ch) == mirror.domain,
265:          "grid attr channel re-declared at another width or domain");
266:   if (!mr->store.channelLevelAllocated(level, ch)) {
267:     mr->gridAttrs().seedSessionChannel(level, mirror.layer);
268:   }
269:   return ch;
270: }
271: 
272: /** Push `verts`' mirror values into the derived draw samples of the same
273:  * layer, at every grid occurrence so a seam vert stays identical in each.
274:  *
275:  * The draw path reads MultiresAttrs' samples, not the store, and the store
276:  * only learns of a stroke at the fold — so without this a colour stroke is
277:  * invisible until mouse-up. No-op when the layer has no derived samples (the
278:  * cage carries no such attribute, so nothing renders it either). */
279: inline void gridAttrMirrorToSamples(GridAttrMirror &mirror,
280:                                     subdiv::GridLevelDomain *domain,
281:                                     std::span<const int> verts)
282: {
283:   subdiv::Multires *mr = domain->multires();
284:   const int level = domain->level();
285:   int comps = 0;
286:   float *dst = mr->gridAttrs().mutableSamples(level, mirror.layer, &comps);
287:   if (!dst || comps != mirror.floats) {
288:     return;
289:   }
290:   const int w = subdiv::GridsStore::elemWidth(level, subdiv::GridElemDomain::Vertex);
291:   const size_t bytes = size_t(comps) * sizeof(float);
292:   for (int v : verts) {
293:     const void *src = mirror.column->getElemData(v);
294:     auto occs = domain->occurrences(v);
295:     for (size_t i = 0; i < occs.size(); i += 3) {
296:       const size_t sample =
297:           (size_t(occs[i]) * size_t(w) + size_t(occs[i + 2])) * size_t(w) +
298:           size_t(occs[i + 1]);
299:       std::memcpy(&dst[sample * size_t(comps)], src, bytes);
300:     }
301:   }
302: }
303: 
304: /** Store -> dense column, one canonical sample per vertex. */
305: inline void gridAttrGather(GridAttrMirror &mirror, subdiv::GridLevelDomain *domain)
306: {
307:   subdiv::Multires *mr = domain->multires();
308:   const int level = domain->level();
309:   mr->store.ensureLevelResident(level);
310:   const size_t bytes = size_t(mirror.floats) * sizeof(float);
311:   const int n = domain->vertCount();
312:   for (int v = 0; v < n; v++) {
313:     const int *g = &domain->vertGrid[v * 3];
314:     std::memcpy(mirror.column->getElemData(v),
315:                 mr->store.elem(level, mirror.channel, g[0], g[1], g[2]),
316:                 bytes);
317:   }
318: }
319: 
320: /** Dense column -> store, through every occurrence so a boundary sample stays
321:  * identical in all the grids that carry it. */
322: inline void gridAttrScatter(GridAttrMirror &mirror,
323:                             subdiv::GridLevelDomain *domain,
324:                             std::span<const int> verts)
325: {
326:   subdiv::Multires *mr = domain->multires();
327:   const int level = domain->level();
328:   mr->store.ensureLevelResident(level);
329:   const size_t bytes = size_t(mirror.floats) * sizeof(float);
330:   for (int v : verts) {
331:     const void *src = mirror.column->getElemData(v);
332:     auto occs = domain->occurrences(v);
333:     for (size_t i = 0; i < occs.size(); i += 3) {
334:       std::memcpy(
335:           mr->store.elem(level, mirror.channel, occs[i], occs[i + 1], occs[i + 2]),
336:           src,
337:           bytes);
338:     }
339:   }
340:   mr->noteAttrEdit(level, mirror.channel);
341: }
342: 
343: /** The dense id of grid `g`'s cell `(u, v)` — grid-major, row-major, which is
344:  * also the store's own element order, so a whole grid is contiguous on both
345:  * sides. GridFaceIter numbers its faces by exactly this. */
346: inline int gridAttrFaceIndex(int grid, int u, int v, int S)
347: {
348:   return (grid * S + v) * S + u;
349: }
350: 
351: /** Store -> dense column over the S^2 cells of every grid. No canonical-sample
352:  * rule: a cell belongs to exactly one grid. */
353: inline void gridAttrGatherFace(GridAttrMirror &mirror, subdiv::GridLevelDomain *domain)
354: {
355:   subdiv::Multires *mr = domain->multires();
356:   const int level = domain->level();
357:   mr->store.ensureLevelResident(level);
358:   const size_t bytes = size_t(mirror.floats) * sizeof(float);
359:   const int S = domain->gridSide();
360:   const int gridCount = domain->gridCount();
361:   for (int g = 0; g < gridCount; g++) {
362:     for (int v = 0; v < S; v++) {
363:       for (int u = 0; u < S; u++) {
364:         std::memcpy(mirror.column->getElemData(gridAttrFaceIndex(g, u, v, S)),
365:                     mr->store.elem(level, mirror.channel, g, u, v),
366:                     bytes);
367:       }
368:     }
369:   }
370: }
371: 
372: /** Dense column -> store, for the cells of `grids` only. */
373: inline void gridAttrScatterFace(GridAttrMirror &mirror,
374:                                 subdiv::GridLevelDomain *domain,
375:                                 std::span<const int> grids)
376: {
377:   subdiv::Multires *mr = domain->multires();
378:   const int level = domain->level();
379:   mr->store.ensureLevelResident(level);
380:   const size_t bytes = size_t(mirror.floats) * sizeof(float);
381:   const int S = domain->gridSide();
382:   for (int g : grids) {
383:     for (int v = 0; v < S; v++) {
384:       for (int u = 0; u < S; u++) {
385:         std::memcpy(mr->store.elem(level, mirror.channel, g, u, v),
386:                     mirror.column->getElemData(gridAttrFaceIndex(g, u, v, S)),
387:                     bytes);
388:       }
389:     }
390:   }
391:   mr->noteAttrEdit(level, mirror.channel);
392: }
393: 
394: /** Push `grids`' face-set cells from the mirror into the draw path's per-sample
395:  * face-set colors, so a face dab is visible before the stroke-end fold.
396:  *
397:  * Face-set-specific by construction: "group" is the one face layer the draw
398:  * path has a consumer for, and MultiresAttrs turns cells into colors. Another
399:  * face layer binds and paints exactly the same way; it just has nothing to
400:  * render itself with, so this is a no-op for it. */
401: inline void gridAttrMirrorFaceToSamples(GridAttrMirror &mirror,
402:                                         subdiv::GridLevelDomain *domain,
403:                                         std::span<const int> grids,
404:                                         Vector<int> &scratch)
405: {
406:   if (mirror.layer != string("group") || mirror.type != mesh::AttrType::INT) {
407:     return;
408:   }
409:   subdiv::Multires *mr = domain->multires();
410:   const int level = domain->level();
411:   const int S = domain->gridSide();
412:   // Build the cache first if this is the stroke's first dab: a per-grid
413:   // refresh is a no-op before it exists, and the lazy build that follows
414:   // would source the store, which the mirror has not reached yet.
415:   mr->gridAttrs().faceSetSampleColors(level);
416:   scratch.resize(size_t(S) * size_t(S));
417:   for (int g : grids) {
418:     for (int v = 0; v < S; v++) {
419:       for (int u = 0; u < S; u++) {
420:         scratch[v * S + u] = *static_cast<const int *>(
421:             mirror.column->getElemData(gridAttrFaceIndex(g, u, v, S)));
422:       }
423:     }
424:     mr->gridAttrs().refreshFaceSetSampleColorsForGrid(level, g, scratch.data());
425:   }
426: }
427: 
