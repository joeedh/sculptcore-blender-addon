2359:   void beginStep(bool hasDyntopo)
2360:   {
2361:     preparedCavity.reset();
2362:     preparedStepOpen_ = true;
2363:     preparedStepTree_ = tree;
2364:     preparedStepMesh_ = tree ? tree->m : nullptr;
2365:     preparedStepBrush_ = brush;
2366:     preparedStepLog_ = meshLog;
2367:     isFirstOfStep = true;
2368:     strokeValidationFailed = false;
2369:     stepHasDyntopo = hasDyntopo;
2370:     /* Positions may have changed since the last stroke (undo, ops, other
2371:      * tools) â€” force the stroke's first needsCoPrev exec to take a full
2372:      * snapshot. The gen bump keeps stale node stamps from suppressing
2373:      * dirty-list appends. */
2374:     coPrevFull_ = false;
2375:     coPrevDirty_.clear();
2376:     coPrevGen_++;
2377:     uvReprojPending_.clear();
2378:     grabRegions_.clear();
2379:     grabWidenRadius_ = 0.0f;
2380:     if (brush) {
2381:       brush->resetStrokePath();
2382:     }
2383:     if (meshLog) {
2384:       meshLog->beginStep(hasDyntopo);
2385:     }
2386:     preparedStepId_ = meshLog ? meshLog->lastStepId() : -1;
2387:   }
2388: 
2389:   void endStep()
2390:   {
2391:     preparedStepOpen_ = false;
2392:     isFirstOfStep = false;
2393:     /* Flush the stroke's deferred UV reprojection while the step is still
2394:      * open, so the corner captures land inside it. */
2395:     if (uvReprojPending_.size() > 0 && tree && tree->m) {
2396:       Vector<int> rverts;
2397:       Vector<float3> rold;
2398:       for (const auto &pair : uvReprojPending_) {
2399:         rverts.append(pair.key);
2400:         rold.append(pair.value);
2401:       }
2402:       reprojectUvsWithCapture(tree->m,
2403:                               std::span<const int>(rverts.data(), rverts.size()),
2404:                               std::span<const float3>(rold.data(), rold.size()));
2405:     }
2406:     uvReprojPending_.clear();
2407:     if (meshLog) {
2408:       meshLog->endStep();
2409:     }
2410:   }
2411: };
2412: 
2413: /** Declared in accum_mode.h; AccumKind::Grab write-back uses it. First image to
2414:  * write vert `v` this dab â†’ stamp curDabGen and return true (re-base from orig);
2415:  * an already-stamped vert returns false (later image adds). The page was
2416:  * pre-materialized in exec(), so this only reads/writes an existing slot. With no
2417:  * stamp attr (single-image stroke, dab counter idle) every write re-bases. */
2418: inline bool grabClaimFirstTouch(const CommandExecutor &exec, int v)
2419: {
2420:   mesh::AttrData<int> *dabGen = exec.ctx.dabGen;
2421:   if (!dabGen) {
2422:     return true;
2423:   }
2424:   if ((*dabGen)[v] == int(exec.ctx.curDabGen)) {
2425:     return false;
2426:   }
2427:   (*dabGen)[v] = int(exec.ctx.curDabGen);
2428:   return true;
2429: }
2430: 
2431: /** Build a kernel's BrushCommandDef without a live stroke. csrNeighbors=false:
2432:  * the manifest and the flags are identical for both neighbor policies. The
2433:  * scratch Brush is what lets an extra (out-of-repo) kernel report its manifest â€”
2434:  * createExtraBrush seeds uniform defaults into the Brush it is handed, so a null
2435:  * one made every extra kernel report unhandled (and therefore empty), which is
2436:  * precisely the case the grid-attr capability rule has to answer for. False when
2437:  * `brushType` matched nothing. */
2438: inline bool buildBrushDef(SculptBrushes brushType, CommandExecutor::brush_command &def)
2439: {
2440:   Brush scratch;
2441:   return CommandExecutor::createCommandSwitch<AccumLive>(brushType, false, &scratch, def);
2442: }
2443: 
2444: /** A kernel's declared attribute layers, into caller-owned storage. Prefer this
2445:  * over BrushMetadata's bound instance methods in engine code: those park the
2446:  * result on the query object (the binding runtime hands bound structs back by
2447:  * pointer and cannot marshal a Vector), so two interleaved queries clobber each
2448:  * other. False when `brushType` matched nothing; `out` is cleared either way. */
2449: inline bool brushAttrManifestFor(SculptBrushes brushType,
2450:                                  Vector<BrushAttrManifestEntry> &out)
2451: {
2452:   out.clear();
2453:   CommandExecutor::brush_command def;
2454:   if (!buildBrushDef(brushType, def)) {
2455:     return false;
2456:   }
2457:   for (const auto &a : def.attrs) {
2458:     out.append(a);
2459:   }
2460:   return true;
2461: }
2462: 
2463: /** The manifest entry for one handle, or null. */
2464: inline const BrushAttrManifestEntry *
2465: findBrushAttrEntry(const Vector<BrushAttrManifestEntry> &manifest, const char *handle)
2466: {
2467:   util::string want(handle);
2468:   for (const auto &a : manifest) {
2469:     if (a.handle.operator==(want)) {
2470:       return &a;
2471:     }
2472:   }
2473:   return nullptr;
2474: }
2475: 
2476: /** A kernel's codegen-set policy bits, queried by tool id without a live stroke.
2477:  * All-false for an unknown or out-of-repo (extra) kernel. */
2478: inline BrushDefFlags brushDefFlagsFor(SculptBrushes brushType)
2479: {
2480:   BrushDefFlags flags;
2481:   CommandExecutor::brush_command def;
2482:   if (!buildBrushDef(brushType, def)) {
2483:     return flags;
2484:   }
2485:   flags.needsCoPrev = def.needsCoPrev;
2486:   flags.accumulable = def.accumulable;
2487:   flags.relaxesBase = def.relaxesBase;
2488:   flags.grabModeCapable = def.grabModeCapable;
2489:   flags.unbounded = def.unbounded;
2490:   flags.incremental = def.incremental;
2491:   flags.writesMask = def.writesMask;
2492:   flags.faceMode = def.faceMode;
2493:   for (const auto &a : def.attrs) {
2494:     if (a.kernelWrites && (a.use & int(mesh::AttrUse::COLOR))) {
2495:       flags.writesColor = true;
2496:     }
2497:     if (a.boundName.operator==(util::string(".boundary.vert.class"))) {
2498:       flags.readsVclass = true;
2499:     }
2500:   }
2501:   return flags;
2502: }
2503: 
2504: /**
2505:  * Stateless query object for a kernel's codegen-set metadata. Default-constructible
2506:  * and stroke-independent (unlike CommandExecutor, which needs a spatial tree and a
2507:  * live Brush), so a host can ask about any tool before â€” or without â€” a stroke and
2508:  * drive its dab shaping / GPU kernel choice off the answer instead of a per-brush
2509:  * conditional. Everything is addressed by index: the binding runtime can't marshal
2510:  * a JS string into a `util::string` method arg.
2511:  */
2512: struct BrushMetadata {
2513:   Vector<BrushAttrManifestEntry> queriedAttrs;
2514:   // Result slots â€” the binding runtime hands bound structs back by pointer, so
2515:   // the values have to outlive the call.
2516:   BrushDefFlags queriedFlags;
2517: 
2518:   static litestl::binding::types::Struct<BrushMetadata> *defineBindings()
2519:   {
2520:     using namespace litestl::binding;
2521:     types::Struct<BrushMetadata> *st = new types::Struct<BrushMetadata>(
2522:         "sculptcore::brush::BrushMetadata", sizeof(BrushMetadata));
2523:     BIND_STRUCT_DEFAULT_CONSTRUCTOR(st);
2524:     BIND_STRUCT_METHOD(st, queryAttrManifest, MARGS("brushType"));
2525:     BIND_STRUCT_METHOD(st, queriedAttrEntry, MARGS("idx"));
2526:     BIND_STRUCT_METHOD(st, queryBrushFlags, MARGS("brushType"));
2527:     return st;
2528:   }
2529: 
2530:   /** Enumerate a kernel's declared attribute layers so a host can retarget each
2531:    * retargetable handle (empty boundName, non-zero `use`) at the mesh layer active
2532:    * for that AttrUse category. Returns the entry count. */
2533:   int queryAttrManifest(int brushType)
2534:   {
2535:     brushAttrManifestFor(static_cast<SculptBrushes>(brushType), queriedAttrs);
2536:     return int(queriedAttrs.size());
2537:   }
2538: 
2539:   BrushAttrManifestEntry *queriedAttrEntry(int idx)
2540:   {
2541:     if (idx < 0 || idx >= int(queriedAttrs.size())) {
2542:       return nullptr;
2543:     }
2544:     return &queriedAttrs[idx];
2545:   }
2546: 
2547:   /** The kernel's policy bits. Valid until the next call; all-false for an
2548:    * unknown or out-of-repo (extra) kernel. */
2549:   BrushDefFlags *queryBrushFlags(int brushType)
2550:   {
2551:     queriedFlags = brushDefFlagsFor(static_cast<SculptBrushes>(brushType));
2552:     return &queriedFlags;
2553:   }
2554: };
2555: } // namespace sculptcore::brush
