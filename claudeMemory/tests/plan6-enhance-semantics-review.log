674:   // --- Property inheritance (Stage 4, bounded) ---------------------------
675:   // Link this brush's props to a parent default (e.g. a category-default
676:   // Brush's `props`) so any property this brush does not define locally
677:   // resolves from the parent. Takes the parent's `StructProp` (not a `Brush*`)
678:   // so `Brush::defineBindings` never references its own type â€” a self-reference
679:   // would re-enter defineBindings infinitely at init.
680:   void setPropsParent(props::StructProp *parentProps)
681:   {
682:     if (parentProps) {
683:       props::resolveStruct(*parentProps, props);
684:     }
685:   }
686:   void clearPropsParent()
687:   {
688:     if (props.struct_def) {
689:       props.struct_def->parent = nullptr;
690:     }
691:   }
692: 
693:   // --- Device (pen) dynamics configuration (Stage 3) ---------------------
694:   // The bridge configures a property's dynamics once per stroke, then pushes
695:   // device samples each dab; loadProps() applies them via the prop's Dynamics.
696: 
697:   // Raw native inspection, including unsupported legacy FLOAT64 stacks.
698:   // Configuration uses checked local ownership and eligibility separately.
699:   props::Dynamics *propDynamics(util::string name)
700:   {
701:     if (!props.struct_def) {
702:       return nullptr;
703:     }
704:     props::Property *p = props.struct_def->lookup(name);
705:     if (!p) {
706:       return nullptr;
707:     }
708:     props::detail::PropBaseType *base = static_cast<props::detail::PropBaseType *>(p);
709:     if (p->type == props::Prop::FLOAT32) {
710:       return &static_cast<props::Float32Prop *>(base)->dynamics;
711:     }
712:     if (p->type == props::Prop::INT32) {
713:       return &static_cast<props::Int32Prop *>(base)->dynamics;
714:     }
715:     if (p->type == props::Prop::BOOL) {
716:       return &static_cast<props::BoolProp *>(base)->dynamics;
717:     }
718:     if (p->type == props::Prop::FLOAT64) {
719:       return &static_cast<props::Float64Prop *>(base)->dynamics;
720:     }
721:     return nullptr;
722:   }
