396: static void cavityEffectsMatrix()
397: {
398:   for (bool grid : {false, true})
399:     for (bool nonAccum : {false, true})
400:       for (bool deferred : {false, true}) {
401:         if (!grid && deferred)
402:           continue;
403:         for (auto secondary : {SculptBrushes::MASK, SculptBrushes::SMOOTH}) {
404:           auto expected = cavityEffects(grid, false, nonAccum, deferred, secondary);
405:           auto actual = cavityEffects(grid, true, nonAccum, deferred, secondary);
406:           test_assert(expected.size() == actual.size());
407:           for (size_t i = 0; i < actual.size(); i++)
408:             test_assert((actual[i] - expected[i]).length() < 2e-6f);
409:         }
410:       }
411:   fprintf(stderr, "prepared cavity independent strength oracle and exact undo passed\n");
412: }
