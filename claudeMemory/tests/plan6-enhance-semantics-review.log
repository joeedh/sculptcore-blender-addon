199: static void cavityExecutors()
200: {
201:   for (auto mode :
202:        {CommandExecutor::NeighborMode::LiveDisk, CommandExecutor::NeighborMode::Csr})
203:   {
204:     auto *mesh = mesh::createCube(12, 2.0f);
205:     {
206:       spatial::SpatialTree tree(mesh);
207:       tree.leaf_limit = 32;
208:       tree.buildAll();
209:       Brush brush;
210:       brush.cavity_factor = 1;
211:       CommandExecutor ex(&tree, &brush);
212:       ex.neighborMode = mode;
213:       ex.beginStep(false);
214:       cavityExecutionCases(
215:           ex,
216:           brush,
217:           MeshCavitySrc{mesh},
218:           [&](int v) -> float3 & { return mesh->v.co[v]; },
219:           mesh->v.count);
220:       test_assert(mesh->topo_cache.valid(*mesh));
221:       ex.endStep();
222:       test_assert(
223:           ex.applyResolvedDab(SculptBrushes::DRAW, float3(0.0f), float3(0, 0, 1)).error ==
224:           PropError::ERROR_INVALID_OWNER);
225:       ex.beginStep(false);
226:       test_assert(ex.preparedCavity.evaluations() == 0);
227:       brush.automask_cavity = true;
228:       brush.radius = 1;
229:       brush.writeProps();
230:       mesh->topo_stamp++;
231:       test_assert(mesh->topo_frozen && !mesh->topo_cache.valid(*mesh));
232:       test_assert(
233:           ex.applyResolvedDab(SculptBrushes::DRAW, float3(0, 0, 1), float3(0, 0, 1))
234:               .error == PropError::ERROR_NONE);
235:       test_assert(brush.automask_cavity && ex.preparedCavity.evaluations() > 0);
236:       CavityScratch wrapped, fresh;
237:       wrapped.ensure(mesh->v.count);
238:       wrapped.token = UINT32_MAX;
239:       const auto reference = cavityRawT(MeshCavitySrc{mesh}, 0, 2, fresh);
240:       test_assert(cavityRawT(MeshCavitySrc{mesh}, 0, 2, wrapped) == reference &&
241:                   wrapped.token == 1);
242:       ex.endStep();
243:     }
244:     alloc::Delete(mesh);
245:   }
246:   for (bool deferred : {false, true}) {
247:     auto *cage = mesh::createCube(4, 2.0f);
248:     {
249:       subdiv::Multires mr;
250:       mr.init(*cage, 2);
251:       auto *domain = mr.gridDomain(2);
252:       domain->ensureTree(50);
253:       Brush brush;
254:       brush.cavity_factor = 1;
255:       GridBrushExecutor ex(domain, &brush);
256:       ex.deferNormals = deferred;
257:       ex.beginStep();
258:       cavityExecutionCases(
259:           ex,
260:           brush,
261:           GridBrushExecutor::GridCavitySrc{domain},
262:           [&](int v) -> float3 & { return domain->pos()[v]; },
263:           domain->vertCount());
264:       ex.endStep();
265:       ex.beginStep();
266:       test_assert(ex.preparedCavity.evaluations() == 0);
267:       ex.endStep();
268:       ex.attach(domain);
269:       test_assert(ex.preparedCavity.configurations() == 0);
270:     }
271:     alloc::Delete(cage);
272:   }
273:   fprintf(stderr, "prepared cavity mesh/grid first-contact cache and lifecycle passed\n");
274: }
