76: class StrokeSpacer:
77:     """Screen-space dab spacer: buffers the 2D mouse path and emits evenly
78:     spaced points along a centripetal Catmull-Rom spline (``stroke_math``),
79:     carrying the walk position across segments so cadence never clusters at a
80:     joint. Compared to the old linear-polyline walk this smooths jittery input
81:     (the parity route to Blender's stabilized stroke) without changing dab
82:     density: the same interval (the operator's vanilla-matched spacing) is
83:     walked, and each emitted point is still projected onto the surface by the
84:     operator.
85: 
86:     The first control point emits one raw dab immediately; a 1-segment lookahead
87:     holds each interior segment until its right neighbor arrives (the
88:     centripetal tangent needs the next point), so spline dabs lag input by one
89:     move; the trailing segment is flushed with a right-clamp on release
90:     (``flush``). A non-positive interval bypasses the spline and emits every
91:     input point. Supplying samples returns ``(point, sample)`` pairs; otherwise
92:     emitted points are ``(x, y)`` tuples."""
93: 
94:     def __init__(self):
95:         self.points = []
96:         self.inputs = []
97:         self.walk_carry = 0.0
98:         self._flushed = False
99: 
100:     def add(self, p, spacing, sample=None):
101:         """Dab points for the newly arrived control point ``p`` (an ``(x, y)``
102:         pair). The first call emits ``p`` itself (raw); later calls emit the
103:         spaced points of the segment whose right neighbor ``p`` just
104:         completed."""
105:         p = (float(p[0]), float(p[1]))
106:         if self.inputs and (sample is None) != (self.inputs[0] is None):
107:             raise ValueError("A spacer cannot mix sampled and position-only inputs")
108:         self.points.append(p)
109:         self.inputs.append(sample)
110:         self._flushed = False
111:         n = len(self.points)
112:         if n == 1 or spacing <= 0.0:
113:             return [(p, sample)] if sample is not None else [p]
114:         if n < 3:
115:             # The first segment still lacks the right neighbor its tangent needs.
116:             return []
117:         # points[n-3] -> points[n-2], with right neighbor points[n-1] = p.
118:         return self._walk_segment(n - 3, right_clamp=False, spacing=spacing)
119: 
120:     def flush(self, spacing):
121:         """Emit the trailing segment (the last two points) with a right-clamp,
122:         on stroke release. No-op for a single-point stroke or non-positive
123:         spacing."""
124:         n = len(self.points)
125:         if self._flushed or n < 2 or spacing <= 0.0:
126:             return []
127:         self._flushed = True
128:         return self._walk_segment(n - 2, right_clamp=True, spacing=spacing)
129: 
130:     def _walk_segment(self, i, right_clamp, spacing):
131:         """Arc-length-walk the Catmull-Rom segment ``points[i] -> points[i+1]``,
132:         clamping the outer control points at the path ends."""
133:         pts = self.points
134:         p1, p2 = pts[i], pts[i + 1]
135:         p0 = pts[i - 1] if i >= 1 else p1
136:         p3 = p2 if right_clamp else pts[i + 2]
137:         bez = stroke_math.cr_to_bezier(p0, p1, p2, p3)
138:         sampled = self.inputs[i] is not None
139:         emitted, self.walk_carry = stroke_math.arc_length_walk(
140:             bez, spacing, self.walk_carry, with_fractions=sampled)
141:         if sampled:
142:             emitted = [(point, stroke_input.InputSample.interpolate(self.inputs[i], self.inputs[i + 1], fraction))
143:                        for point, fraction in emitted]
144:         return emitted
145: 
