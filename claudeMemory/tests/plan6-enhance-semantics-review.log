300: props::ScalarRegistrationResult PreparedBrushScalars::publish(Brush &brush) const
301: {
302:   if (brush_ != &brush || definition_ != brush.props.struct_def || !definition_) {
303:     return {PropError::ERROR_INVALID_OWNER, "brush"};
304:   }
305:   auto result = brush.props.struct_def->registerScalars(declarations());
306:   if (result.error != PropError::ERROR_NONE) {
307:     return result;
308:   }
309:   // All recoverable checks precede this barrier. These setters only write
310:   // working caches, including readonly authored sources, never their values.
311:   ensureExtraUniformDefaults(brush);
312:   applyWorking(brush);
313:   return {};
314: }
315: 
316: void PreparedBrushScalars::applyWorking(Brush &brush) const
317: {
318:   brush.cavity_curve = cavityCurve_;
319:   brush.unboundedExtent = unboundedExtent_;
320:   for (const auto &value : values_) {
321:     props::numtype_dispatch(value.type, [&]<typename P>() {
322:       using T = typename P::value_type;
323:       if (value.nativeMember >= 0) {
324:         *static_cast<T *>(Brush::builtinPropDescriptorSpan()[value.nativeMember].address(
325:             brush)) = T(value.value);
326:       } else if constexpr (std::is_same_v<T, float>) {
327:         brush.setEvaluatedNamedFloat(value.storeSlot, T(value.value));
328:       } else if constexpr (std::is_same_v<T, int32_t>) {
329:         brush.setEvaluatedNamedInt(value.storeSlot, T(value.value));
330:       } else if constexpr (std::is_same_v<T, bool>) {
331:         brush.setEvaluatedNamedBool(value.storeSlot, T(value.value));
332:       }
333:     });
334:   }
335: }
336: 
337: props::ScalarRegistrationResult
338: prepareBrushScalars(Brush &brush,
339:                     std::span<const BrushUniformManifestEntry> uniforms,
340:                     const props::DeviceInputCtx &inputs,
341:                     PreparedBrushScalars &output,
342:                     std::span<const BrushScalarOverride> overrides,
343:                     std::span<const BrushUniformManifestEntry> programUniforms,
344:                     ScalarSource source,
345:                     std::span<const BrushDynamicsOverride> dynamicsOverrides,
346:                     std::span<const float> cavityCurveOverride)
347: {
348:   if (!brush.props.struct_def)
349:     return {PropError::ERROR_INVALID_OWNER, "brush"};
350:   PreparedBrushScalars candidate;
351:   candidate.brush_ = &brush;
352:   candidate.definition_ = brush.props.struct_def;
353:   candidate.unboundedExtent_ = brush.unboundedExtent;
354:   static_assert(Brush::kCavityCurveLutSize == 256);
355:   if (!cavityCurveOverride.empty() && cavityCurveOverride.size() != 256)
356:     return {PropError::ERROR_INVALID_VALUE, "cavity curve"};
357:   for (size_t i = 0; i < 256; i++) {
358:     const float value =
359:         cavityCurveOverride.empty() ? brush.cavity_curve[i] : cavityCurveOverride[i];
360:     if (!std::isfinite(value))
361:       return {PropError::ERROR_INVALID_VALUE, "cavity curve"};
362:     candidate.cavityCurve_[i] = value;
363:   }
364:   for (size_t index = 0; index < uniforms.size(); index++) {
365:     const auto &entry = uniforms[index];
366:     for (size_t prior = 0; prior < index; prior++) {
367:       if (entry.name == uniforms[prior].name)
368:         return {PropError::ERROR_SCHEMA_CONFLICT, entry.name};
369:     }
370:     auto error = validateTarget(entry);
371:     if (error != PropError::ERROR_NONE)
372:       return {error, entry.name};
373:     if (executorSetting(entry.name)) {
374:       for (const auto &setting : executorSettingDeclarations()) {
375:         if (setting.name != entry.name)
376:           continue;
377:         if (entry.scalarType != setting.type || entry.dynamic || entry.hasDefault ||
378:             (entry.hasRange &&
379:              (entry.rangeMin != setting.rangeMin || entry.rangeMax != setting.rangeMax)))
380:           return {PropError::ERROR_SCHEMA_CONFLICT, entry.name};
381:       }
382:     } else if (scalar(entry.scalarType)) {
383:       candidate.declarations_.append(declarationOf(entry));
384:     }
385:   }
386:   auto validation =
387:       brush.props.struct_def->validateScalarDeclarations(candidate.declarations());
388:   if (validation.error != PropError::ERROR_NONE)
389:     return validation;
390: 
391:   auto append =
392:       [&](PreparedBrushScalar value, const ScalarDeclaration *declaration, bool common) {
393:         const BrushScalarOverride *override = nullptr;
394:         for (const auto &item : overrides) {
395:           if (item.name == value.name) {
396:             if (override)
397:               return PropError::ERROR_SCHEMA_CONFLICT;
398:             override = &item;
399:           }
400:         }
401:         const BrushDynamicsOverride *stackOverride = nullptr;
402:         for (const auto &item : dynamicsOverrides) {
403:           if (item.name == value.name) {
404:             if (stackOverride)
405:               return PropError::ERROR_SCHEMA_CONFLICT;
406:             if (item.type != value.type)
407:               return PropError::ERROR_INVALID_TYPE;
408:             if (!value.dynamic || source != ScalarSource::Authored ||
409:                 !props::Dynamics::validStack(item.dynamics.devices))
410:               return PropError::ERROR_INVALID_DYNAMICS;
411:             stackOverride = &item;
412:           }
413:         }
414:         auto error = prepareValue(
415:             brush, value, declaration, common, inputs, override, source, stackOverride);
416:         if (error == PropError::ERROR_NONE)
417:           candidate.values_.append(std::move(value));
418:         return error;
419:       };
420:   for (int id = 0; id <= int(BrushProp::Invert); id++) {
421:     util::string name(brushPropName(id));
422:     ScalarDeclaration declaration;
423:     bool declared = false;
424:     if (auto *entry = findUniform(uniforms, name)) {
425:       declaration = declarationOf(*entry);
426:       declared = true;
427:     } else if (auto *entry = findUniform(programUniforms, name)) {
428:       declaration = declarationOf(*entry);
429:       declared = true;
430:     } else {
431:       declared = brush.props.struct_def->scalarDeclaration(name, declaration);
432:     }
433:     const Prop type = id == int(BrushProp::Invert) ? Prop::BOOL : Prop::FLOAT32;
434:     if (declared && declaration.type != type)
435:       return {PropError::ERROR_INVALID_TYPE, name};
436:     auto error =
437:         append({name, type, 0, !declared || declaration.dynamic, nativeMember(name), -1},
438:                declared ? &declaration : nullptr,
439:                true);
440:     if (error != PropError::ERROR_NONE)
441:       return {error, name};
442:   }
443:   for (const auto &setting : executorSettingDeclarations()) {
444:     auto error =
445:         append({setting.name, setting.type, 0, false, nativeMember(setting.name), -1},
446:                &setting,
447:                false);
448:     if (error != PropError::ERROR_NONE)
449:       return {error, setting.name};
450:   }
451:   for (const auto &entry : uniforms) {
452:     if (!scalar(entry.scalarType) || commonMember(entry.name) >= 0 ||
453:         executorSetting(entry.name))
454:       continue;
455:     auto declaration = declarationOf(entry);
456:     auto error = append({entry.name,
457:                          entry.scalarType,
458:                          0,
459:                          entry.dynamic,
460:                          nativeMember(entry.name),
461:                          entry.storeSlot},
462:                         &declaration,
463:                         false);
464:     if (error != PropError::ERROR_NONE)
465:       return {error, entry.name};
466:   }
467:   for (const auto &override : overrides) {
468:     bool found = false;
469:     for (const auto &value : candidate.values_) {
470:       found |= value.name == override.name;
471:     }
472:     if (!found)
473:       return {PropError::ERROR_NOT_EXISTS, override.name};
474:   }
475:   for (const auto &item : dynamicsOverrides) {
476:     bool found = false;
477:     for (const auto &value : candidate.values_)
478:       found |= value.name == item.name;
479:     if (!found)
480:       return {PropError::ERROR_NOT_EXISTS, item.name};
481:   }
482:   for (auto *property : brush.props.struct_def->properties()) {
483:     auto *dynamics = dynamicsOf(property);
484:     if (!dynamics || dynamics->devices.size() == 0)
485:       continue;
486:     bool eligible = false;
487:     bool active = false;
488:     for (const auto &value : candidate.values_) {
489:       if (value.name == property->name && value.type == property->type &&
490:           brush.props.struct_def->lookupLocal(value.name) == property)
491:       {
492:         eligible = value.dynamic;
493:         active = true;
494:         break;
495:       }
496:     }
497:     if (!active) {
498:       bool belongsToProgram = false;
499:       for (const auto &entry : programUniforms) {
500:         if (entry.name == property->name && entry.scalarType == property->type &&
501:             brush.props.struct_def->lookupLocal(entry.name) == property)
502:         {
503:           belongsToProgram = true;
504:           break;
505:         }
506:       }
507:       // Every owning stage is prepared before execution; report its own errors there.
508:       if (belongsToProgram)
509:         continue;
510:     }
511:     if (!eligible || !props::Dynamics::validStack(dynamics->devices)) {
512:       return {PropError::ERROR_INVALID_DYNAMICS, property->name};
513:     }
514:   }
515:   for (const auto &value : candidate.values_)
516:     if (value.name == util::string("unboundedExtent"))
517:       candidate.unboundedExtent_ = float(value.value);
518:   output = std::move(candidate);
519:   return {};
520: }
521: 
522: props::ScalarRegistrationResult
523: validateUnboundedSupport(const PreparedBrushScalars &stage, float radius)
524: {
525:   using props::PropError;
526:   if (!named_uniform_detail::supportedFloat(radius) || !std::isfinite(radius) ||
527:       radius < 0 || (radius > 0 && !std::isfinite(1.0f / radius)))
528:     return {PropError::ERROR_INVALID_VALUE, "radius"};
529:   if (radius == 0)
530:     return {};
531:   const Brush *brush = stage.sourceBrush();
532:   if (!brush)
533:     return {PropError::ERROR_INVALID_OWNER, "brush"};
534:   for (int axis = 0; axis < 3; axis++)
535:     if (!named_uniform_detail::supportedFloat(brush->grabFrom[axis]) ||
536:         !named_uniform_detail::supportedFloat(brush->grabTo[axis]) ||
537:         !std::isfinite(brush->grabFrom[axis]) || !std::isfinite(brush->grabTo[axis]))
538:       return {PropError::ERROR_INVALID_VALUE, "unbounded frame"};
539:   const float extent = stage.unboundedExtent();
540:   if (!named_uniform_detail::supportedFloat(extent) || !std::isfinite(extent))
541:     return {PropError::ERROR_INVALID_VALUE, "unboundedExtent"};
542:   if (extent <= 0)
543:     return {};
544:   const float cutoff = radius * extent;
545:   const float width = 0.2f * cutoff;
546:   if (!std::isfinite(cutoff) || cutoff <= 0 || !std::isfinite(width) || width <= 0)
547:     return {PropError::ERROR_INVALID_VALUE, "unbounded cutoff"};
548:   return {};
549: }
550: } // namespace sculptcore::brush
