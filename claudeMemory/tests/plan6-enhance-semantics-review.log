1: // The per-tool host-pass table. Every "this brush needs host work around its
2: // kernel" fact is one row here, invoked blindly by the executors (see
3: // brush_hooks.h). The one per-tool residue left outside this table is
4: // gpu_marshal.cc's ctx tail (KELVINLET/GRAB/POSE), kept deliberately.
5: #include "brush_hooks.h"
6: 
7: #include "brush/brush.h"
8: #include "brush/brush_executor.h"
9: #include "brush/enhance.h"
10: #include "brush/feature_field.h"
11: 
12: #include <span>
13: 
14: namespace sculptcore::brush {
15: 
16: using litestl::util::Vector;
17: 
18: static void collectRegionVerts(BrushHookCtx &c, Vector<int> &out)
19: {
20:   for (spatial::SpatialNode *node : *c.nodes) {
21:     for (int v : node->data->unique_verts) {
22:       out.append(v);
23:     }
24:   }
25: }
26: 
27: /** BSMOOTH / FEATURE_ALIGN both read the lazily-derived `.boundary.vert.class`,
28:  * so it is refreshed once at stroke start, while topology links are live. */
29: static void hookBoundaryClassRefresh(BrushHookCtx &c)
30: {
31:   c.exec.refreshBoundaryClassForBSmooth(c.m);
32: }
33: 
34: /** ENHANCE: fill the cached per-vertex difference-of-smooths displacement over
35:  * the dab region before the kernel reads `.brush.enhance.disp`. Cached per
36:  * stroke (keyed by strokeGen); topology is live (brushNeedsLiveLinks). */
37: static void hookEnhanceRegion(BrushHookCtx &c)
38: {
39:   Vector<int> regionVerts;
40:   collectRegionVerts(c, regionVerts);
41:   EnhanceParams ep;
42:   ep.rings = c.brush->enhance_rings;
43:   ep.inner = c.brush->enhance_inner;
44:   updateEnhanceRegion(*c.m, regionVerts, ep, c.exec.strokeGen);
45: }
46: 
47: /** FEATURE_ALIGN: (re)seed + diffuse the per-vertex cross field over the dab's
48:  * region so the kernel reads an up-to-date field. Incremental — only the
49:  * region's verts are written, so the saved field grows as the stroke covers
50:  * the mesh. Topology is live (brushNeedsLiveLinks). */
51: static void hookCrossFieldRegion(BrushHookCtx &c)
52: {
53:   Vector<int> regionVerts;
54:   collectRegionVerts(c, regionVerts);
55:   FeatureFieldParams ffParams;
56:   updateCrossFieldRegion(*c.m, regionVerts, ffParams);
57: }
58: 
59: /** POLYGROUP: mark the touched nodes' faces boundary-dirty so the next
60:  * recomputeDirty reclassifies their inter-group edges. */
61: static void hookPolygroupDirty(BrushHookCtx &c)
62: {
63:   std::span<spatial::SpatialNode *> nodeSpan(c.nodes->data(), c.nodes->size());
64:   c.exec.markPolygroupDirty(nodeSpan);
65: }
66: 
67: const BrushHooks *brushHooksFor(SculptBrushes tool)
68: {
69:   static const BrushHooks bsmooth = {
70:       hookBoundaryClassRefresh, nullptr, nullptr, true, true};
71:   static const BrushHooks featureAlign = {
72:       hookBoundaryClassRefresh, hookCrossFieldRegion, nullptr};
73:   static const BrushHooks enhance = {nullptr, hookEnhanceRegion, nullptr};
74:   static const BrushHooks polygroup = {nullptr, nullptr, hookPolygroupDirty};
75: 
76:   switch (tool) {
77:   case SculptBrushes::BSMOOTH:
78:     return &bsmooth;
79:   case SculptBrushes::FEATURE_ALIGN:
80:     return &featureAlign;
81:   case SculptBrushes::ENHANCE:
82:     return &enhance;
83:   case SculptBrushes::POLYGROUP:
84:     return &polygroup;
85:   default:
86:     return nullptr;
87:   }
88: }
89: 
90: } // namespace sculptcore::brush
