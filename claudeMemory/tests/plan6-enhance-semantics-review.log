19:     return prepareBrushScalars(brush, {}, brush.deviceInputCtx, prepared).error;
20:   };
21:   test_assert(prepare() == PropError::ERROR_NONE);
22:   auto value = [&](const char *name) {
23:     for (const auto &item : prepared.values())
24:       if (item.name == string(name))
25:         return item.value;
26:     return -999.0;
27:   };
28:   test_assert(value("cavity_factor") == 1.25 && value("cavity_blur_steps") == 3 &&
29:               value("cavity_inverted") == 1);
30:   test_assert(prepared.declarations().empty());
31:   props::ScalarDeclaration declaration;
