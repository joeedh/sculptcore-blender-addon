1732: def _ray_origin_dir(context, coord):
1733:     """Object-space ``(origin, direction)`` of the view ray through a 2D region
1734:     coordinate (both 3-tuples). Split out so symmetry can reflect the ray and
1735:     re-cast it."""
1736:     from bpy_extras import view3d_utils
1737: 
1738:     region = context.region
1739:     rv3d = context.region_data
1740:     ob = context.active_object
1741: 
1742:     origin_world = view3d_utils.region_2d_to_origin_3d(region, rv3d, coord)
1743:     direction_world = view3d_utils.region_2d_to_vector_3d(region, rv3d, coord)
1744: 
1745:     matrix_inv = ob.matrix_world.inverted()
1746:     origin = matrix_inv @ origin_world
1747:     direction = (matrix_inv.to_3x3() @ direction_world).normalized()
1748:     return tuple(origin), tuple(direction)
1749: 
1750: 
1751: def _ray_from_coord(context, coord, session):
1752:     """Unproject a 2D region coordinate to an object-space ray and cast it
1753:     against the engine tree."""
1754:     origin, direction = _ray_origin_dir(context, coord)
1755:     return raycast(session, origin, direction)
1756: 
1757: 
1758: def _ray_from_event(context, event, session):
1759:     """Unproject the mouse event to an object-space ray and cast it against
1760:     the engine tree."""
1761:     return _ray_from_coord(
1762:         context, (event.mouse_region_x, event.mouse_region_y), session)
1763: 
1764: 
1765: def _cursor_on_anchor_plane(context, event, anchor_obj):
1766:     """Object-space point where the mouse ray meets the view-facing plane
1767:     through the anchor — grab's drag target."""
1768:     return _coord_on_plane(context, (event.mouse_region_x, event.mouse_region_y),
1769:                            anchor_obj)
1770: 
1771: 
1772: def _coord_on_plane(context, coord, anchor_obj):
1773:     """Object-space point where the ray through a 2D region coordinate meets the
1774:     view-facing plane through ``anchor_obj``. Measuring drag on a plane at a
1775:     fixed depth (rather than against the surface) is what lets a stroke keep
1776:     dragging after the geometry has moved out from under the cursor."""
1777:     import mathutils
1778:     from bpy_extras import view3d_utils
1779: 
1780:     region = context.region
1781:     rv3d = context.region_data
1782:     ob = context.active_object
1783: 
1784:     anchor_world = ob.matrix_world @ mathutils.Vector(anchor_obj)
1785:     loc_world = view3d_utils.region_2d_to_location_3d(region, rv3d, coord, anchor_world)
1786:     return tuple(ob.matrix_world.inverted() @ loc_world)
1787: 
1788: 
1789: def _pixel_to_world_length(context, position, pixel_len):
1790:     """Object-space length spanning ``pixel_len`` screen pixels at
1791:     ``position``'s depth (vanilla paint_calc_object_space_radius semantics).
1792:     Returns None when the point projects off-screen."""
1793:     import mathutils
1794:     from bpy_extras import view3d_utils
1795: 
1796:     region = context.region
1797:     rv3d = context.region_data
1798:     ob = context.active_object
1799: 
1800:     center_world = ob.matrix_world @ mathutils.Vector(position)
1801:     offset_2d = view3d_utils.location_3d_to_region_2d(region, rv3d, center_world)
1802:     if offset_2d is None:
1803:         return None
1804:     offset_2d = offset_2d.copy()
1805:     offset_2d.x += pixel_len
1806:     ray_origin = view3d_utils.region_2d_to_origin_3d(region, rv3d, offset_2d)
1807:     ray_dir = view3d_utils.region_2d_to_vector_3d(region, rv3d, offset_2d)
1808:     # Object-space distance from the point to the unprojected offset at its depth.
1809:     edge_world = ray_origin + ray_dir * (center_world - ray_origin).length
1810:     matrix_inv = ob.matrix_world.inverted()
1811:     return (matrix_inv @ edge_world - matrix_inv @ center_world).length
1812: 
1813: 
1814: def _world_radius(context, brush, position):
1815:     """Object-space dab radius from the brush's pixel radius at the dab
1816:     location."""
1817:     sculpt = context.tool_settings.sculpt
1818:     length = _pixel_to_world_length(context, position, mapping.pixel_radius(sculpt, brush))
1819:     return length or (mapping.unprojected_radius(brush) or 1.0)
1820: 
1821: 
1822: def register():
1823:     bpy.utils.register_class(SCULPTCORE_OT_brush_stroke)
1824: 
1825: 
1826: def unregister():
1827:     bpy.utils.unregister_class(SCULPTCORE_OT_brush_stroke)
