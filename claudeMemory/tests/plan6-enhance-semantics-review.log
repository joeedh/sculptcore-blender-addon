211: def toggle_kernel_name(mode, brush, session):
212:     """Kernel for a Shift/Alt stroke toggle (vanilla brush_toggle semantics).
213: 
214:     Shift over a paint brush blurs colour, as vanilla sculpt does. On multires
215:     the stroke runs through the engine's cage-dab entry (CageSmooth_*): dabs
216:     execute on the cage colour column at cage resolution — the 1-ring average a
217:     neighbour-reading smooth needs — and the touched grids re-derive per dab
218:     (grids-native-completion CS2/CS3).
219: 
220:     A plain function rather than inline invoke code: the verify harness drives
221:     ``stroke_begin``/``apply_dab`` directly and never runs the modal operator.
222:     """
223:     if mode != 'SMOOTH':
224:         return "MASK"
225:     if brush is not None and brush.sculpt_brush_type in mapping.COLOR_TYPES:
226:         return "COLORSMOOTH"
227:     return "BSMOOTH"
