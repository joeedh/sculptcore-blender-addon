276: static std::vector<float3> cavityEffects(
277:     bool grid, bool prepared, bool nonAccum, bool deferred, SculptBrushes secondary)
278: {
279:   std::vector<float3> output;
280:   auto *mesh = mesh::createCube(grid ? 4 : 12, 2.0f);
281:   {
282:     subdiv::Multires mr;
283:     mr.init(*mesh, 2);
284:     auto *domain = mr.gridDomain(2);
285:     domain->ensureTree(50);
286:     spatial::SpatialTree tree(mesh);
287:     tree.leaf_limit = 32;
288:     tree.buildAll();
289:     meshlog::MeshLog meshLog;
290:     if (!prepared)
291:       meshLog.setActiveMesh(mesh);
292:     subdiv::GridStrokeLog gridLog;
293:     Brush brush;
294:     brush.radius = 2;
295:     brush.strength = .2f;
296:     brush.automask_cavity = prepared;
297:     brush.cavity_use_curve = true;
298:     brush.cavity_curve.fill(.75f);
299:     brush.automask_view_normal = prepared;
300:     brush.view_normal_limit = .4f;
301:     brush.view_normal_falloff = .2f;
302:     brush.writeProps();
303:     const auto originalCurve = brush.cavity_curve;
304:     BrushProgram program;
305:     const SculptBrushes tools[] = {SculptBrushes::DRAW, secondary, SculptBrushes::DRAW};
306:     const float masks[] = {.25f, .75f, .5f};
307:     for (int i = 0; i < 3; i++) {
308:       program.addCommand(int(tools[i]));
309:       program.setCommandFloat(i, int(BrushProp::Radius), i == 0 ? .7f : 1.5f);
310:       program.setCommandFloat(
311:           i, int(BrushProp::Strength), .2f * (prepared ? 1 : masks[i]));
312:       if (prepared) {
313:         for (const auto &setting : std::initializer_list<BrushScalarOverride>{
314:                  {"automask_cavity", props::Prop::BOOL, 1},
315:                  {"cavity_factor", props::Prop::FLOAT32, 2},
316:                  {"cavity_blur_steps", props::Prop::INT32, 3},
317:                  {"cavity_inverted", props::Prop::BOOL, 0},
318:                  {"cavity_use_curve", props::Prop::BOOL, 1},
319:                  {"automask_view_normal", props::Prop::BOOL, 0},
320:                  {"cull_backfaces", props::Prop::BOOL, 1},
321:                  {"view_normal_limit", props::Prop::FLOAT32, 1},
322:                  {"view_normal_falloff", props::Prop::FLOAT32, .1}})
323:           program.setCommandScalarChecked(i, setting.name, setting.type, setting.value);
324:       }
325:       if (prepared && i != 1) {
326:         Vector<float> lut;
327:         lut.resize(256);
328:         for (auto &sample : lut)
329:           sample = masks[i];
330:         test_assert(program.replaceCommandCavityCurveChecked(i, lut) == 0);
331:       }
332:     }
333:     CommandExecutor meshEx(&tree, &brush);
334:     meshEx.meshLog = &meshLog;
335:     meshEx.nonAccum = nonAccum;
336:     meshEx.setStrokeGen(1);
337:     GridBrushExecutor gridEx(domain, &brush, &gridLog);
338:     gridEx.nonAccum = nonAccum;
339:     gridEx.deferNormals = deferred;
340:     auto positions = [&]() {
341:       std::vector<float3> values;
342:       int count = grid ? domain->vertCount() : mesh->v.count;
343:       for (int v = 0; v < count; v++)
344:         values.push_back(grid ? domain->pos()[v] : mesh->v.co[v]);
345:       return values;
346:     };
347:     auto before = positions();
348:     if (grid)
349:       gridEx.beginStep();
350:     else
351:       meshEx.beginStep(false);
352:     for (int dab = 0; dab < 3; dab++) {
353:       float3 center(.1f * dab, 0, 1), normal(0, 0, 1);
354:       if (grid) {
355:         if (prepared)
356:           test_assert(gridEx.applyResolvedProgram(&program, center, normal).error ==
357:                       PropError::ERROR_NONE);
358:         else
359:           gridEx.applyProgram(&program, center, normal);
360:       } else {
361:         if (prepared)
362:           test_assert(meshEx.applyResolvedProgram(&program, center, normal).error ==
363:                       PropError::ERROR_NONE);
364:         else {
365:           meshEx.applyDab(&program, center, normal, 1.5f, nullptr, 0);
366:           tree.updateQueries();
367:         }
368:       }
369:       test_assert(brush.cavity_curve == originalCurve &&
370:                   brush.automask_cavity == prepared && brush.cavity_use_curve &&
371:                   brush.cavity_factor == 1 && !brush.cavity_inverted);
372:       test_assert(brush.cavity_blur_steps == 2 &&
373:                   brush.automask_view_normal == prepared && !brush.cull_backfaces &&
374:                   brush.view_normal_limit == .4f && brush.view_normal_falloff == .2f);
375:     }
376:     output = positions();
377:     int moved = 0;
378:     for (size_t i = 0; i < output.size(); i++)
379:       moved += (output[i] - before[i]).length() > 1e-6f;
380:     test_assert(moved > 0);
381:     if (grid) {
382:       gridEx.endStep();
383:       gridLog.undo();
384:     } else {
385:       meshEx.endStep();
386:       meshLog.undo(mesh, &tree);
387:     }
388:     auto undone = positions();
389:     for (size_t i = 0; i < before.size(); i++)
390:       test_assert((undone[i] - before[i]).lengthSqr() == 0);
391:   }
392:   alloc::Delete(mesh);
393:   return output;
394: }
