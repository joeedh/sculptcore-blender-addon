114: int BrushProgram::replaceCommandCavityCurveChecked(int idx, Vector<float> &samples)
115: {
116:   if (idx < 0 || size_t(idx) >= commands.size())
117:     return int(PropError::ERROR_NOT_EXISTS);
118:   if (samples.size() != Brush::kCavityCurveLutSize)
119:     return int(PropError::ERROR_INVALID_VALUE);
120:   for (float sample : samples) {
121:     if (!std::isfinite(sample))
122:       return int(PropError::ERROR_INVALID_VALUE);
123:   }
124:   Vector<float> candidate(samples);
125:   commands[idx].cavityCurveOverride = std::move(candidate);
126:   return 0;
127: }
