164: bool GridBrushExecutor::supportsResolved(SculptBrushes type)
165: {
166:   if (resolvedState(float3(0.0f), float3(0.0f)).error != props::PropError::ERROR_NONE)
167:     return false;
168:   brush_command command;
169:   return createPreparedCommand(type, command) && resolvedCapability(command, type);
