57: 
58: bool scalar(Prop type)
59: {
60:   return type == Prop::FLOAT32 || type == Prop::INT32 || type == Prop::BOOL;
61: }
62: 
63: int nativeMember(const util::string &name)
64: {
65:   auto members = Brush::builtinPropDescriptorSpan();
66:   for (size_t i = 0; i < members.size(); i++) {
67:     if (std::strcmp(name.c_str(), members[i].name) == 0) {
68:       return int(i);
69:     }
70:   }
71:   return -1;
72: }
73: 
74: int commonMember(const util::string &name)
75: {
76:   for (int id = 0; id <= int(BrushProp::Invert); id++) {
77:     if (std::strcmp(name.c_str(), brushPropName(id)) == 0) {
78:       return id;
79:     }
80:   }
81:   return -1;
82: }
