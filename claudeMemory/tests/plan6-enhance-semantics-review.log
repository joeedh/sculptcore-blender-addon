944: 
945:   // Normalized 0..1+ distance from the brush center for a vertex offset
946:   // `delta = co - surfacePos`, per the active `falloff_shape`. `surfaceNo` is
947:   // the brush-center surface normal, used only by Box to orient its frame.
948:   // Feeds the curve via `t = 1 - min(dist, 1)`. WGSL mirrors this in
949:   // `brush_falloff_dist`; changing one without the other breaks the
950:   // CPU/GPU bit-equality contract.
951:   float falloffDist(float3 delta, float3 surfaceNo) const
952:   {
953:     float inv_r = 1.0f / radius;
954:     switch (falloff_shape) {
955:     case FalloffShape::Spherical:
956:       return delta.length() * inv_r;
957:     case FalloffShape::Cube: {
958:       float ax = std::fabs(delta[0]);
959:       float ay = std::fabs(delta[1]);
960:       float az = std::fabs(delta[2]);
961:       float m = ax > ay ? ax : ay;
962:       m = m > az ? m : az;
963:       return m * inv_r;
964:     }
965:     case FalloffShape::Linear:
966:       return std::fabs(delta.dot(falloff_dir)) * inv_r;
967:     case FalloffShape::Box: {
968:       // Stroke-aligned oriented cuboid: axis 0 = stroke tangent (`falloff_dir`)
969:       // projected into the surface tangent plane, axis 1 = in-plane
970:       // perpendicular, axis 2 = surface normal; extents from `falloff_extent`.
971:       float3 n = surfaceNo.normalized();
972:       float3 tang = falloff_dir - n * falloff_dir.dot(n);
973:       float tl = tang.length();
974:       if (tl < 1e-6f) {
975:         // Stroke ~parallel to the normal: pick any in-plane axis.
976:         float3 ref =
977:             std::abs(n[2]) < 0.999f ? float3{0.0f, 0.0f, 1.0f} : float3{1.0f, 0.0f, 0.0f};
978:         tang = ref.cross(n);
979:         tl = tang.length();
980:       }
981:       tang = tang / tl;
982:       float3 lat = n.cross(tang);
983:       float dn = std::fabs(delta.dot(tang)) / falloff_extent[0];
984:       float d1 = std::fabs(delta.dot(lat)) / falloff_extent[1];
985:       float d2 = std::fabs(delta.dot(n)) / falloff_extent[2];
986:       float m = dn > d1 ? dn : d1;
987:       m = m > d2 ? m : d2;
988:       return m * inv_r;
989:     }
990:     }
991:     return delta.length() * inv_r;
992:   }
993: 
994:   // Evaluate the active falloff curve at normalized centerwise `t`
995:   // (1 at center, 0 at radius). Source of truth for the C++ side; the
996:   // WGSL emitter mirrors the same branches in `brush_falloff`.
997:   // The Gaussian width (9 in the exponent) hits exp(-9) ~= 1.2e-4 at
998:   // the edge, so no hard cutoff is needed. The Curve branch does
999:   // clamped linear interpolation over `falloff_curve` â€” N-1 segments,
1000:   // index N-1 read directly when t lands exactly at 1.
1001:   float falloffEval(float t) const
1002:   {
1003:     switch (falloff_kind) {
1004:     case FalloffKind::Smoothstep:
1005:       return t * t * (3.0f - 2.0f * t);
1006:     case FalloffKind::Linear:
1007:       return t;
1008:     case FalloffKind::Gaussian: {
1009:       float u = 1.0f - t;
1010:       return std::exp(-9.0f * u * u);
1011:     }
1012:     case FalloffKind::Curve: {
1013:       float clamped = t < 0.0f ? 0.0f : (t > 1.0f ? 1.0f : t);
1014:       float scaled = clamped * (float)(kFalloffCurveSize - 1);
1015:       int i0 = (int)scaled;
1016:       if (i0 >= kFalloffCurveSize - 1)
1017:         return falloff_curve[kFalloffCurveSize - 1];
1018:       float frac = scaled - (float)i0;
1019:       return falloff_curve[i0] * (1.0f - frac) + falloff_curve[i0 + 1] * frac;
1020:     }
1021:     }
1022:     return t;
1023:   }
1024: 
1025:   // Bilinear sample of the brush texture at UV `uv` (clamped to edge).
1026:   // Returns 1.0 when no texture is bound so callers can multiply
1027:   // unconditionally. WGSL mirrors this with a clamped textureSampleLevel;
1028:   // the float math here is the CPU source of truth.
1029:   float sampleTexBilinear(litestl::math::float2 uv) const
1030:   {
1031:     if (tex_width <= 0 || tex_height <= 0 || tex_pixels.size() == 0) {
1032:       return 1.0f;
1033:     }
1034: 
1035:     // Texel-space coords with half-texel offset; clamp to edge.
1036:     float fx = uv[0] * (float)tex_width - 0.5f;
1037:     float fy = uv[1] * (float)tex_height - 0.5f;
1038: 
1039:     int x0 = (int)std::floor(fx);
1040:     int y0 = (int)std::floor(fy);
1041:     float tx = fx - (float)x0;
1042:     float ty = fy - (float)y0;
1043: 
1044:     auto clampi = [](int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); };
1045:     int x0c = clampi(x0, 0, tex_width - 1);
1046:     int y0c = clampi(y0, 0, tex_height - 1);
1047:     int x1c = clampi(x0 + 1, 0, tex_width - 1);
1048:     int y1c = clampi(y0 + 1, 0, tex_height - 1);
1049: 
1050:     float p00 = tex_pixels[y0c * tex_width + x0c];
1051:     float p10 = tex_pixels[y0c * tex_width + x1c];
1052:     float p01 = tex_pixels[y1c * tex_width + x0c];
1053:     float p11 = tex_pixels[y1c * tex_width + x1c];
1054: 
1055:     float a = p00 * (1.0f - tx) + p10 * tx;
1056:     float b = p01 * (1.0f - tx) + p11 * tx;
1057:     return a * (1.0f - ty) + b * ty;
1058:   }
1059: 
1060:   // Bind a grayscale brush texture (row-major `width * height` floats,
1061:   // copied). The marshal-safe bridge seam: bound Vector args cross the
1062:   // boundary, flat pixel pointers don't. Bad dims or a size mismatch clears.
1063:   void setTexture(int width, int height, litestl::util::Vector<float> &pixels)
1064:   {
1065:     if (width <= 0 || height <= 0 || pixels.size() != size_t(width) * size_t(height)) {
1066:       clearTexture();
1067:       return;
1068:     }
1069:     tex_width = width;
1070:     tex_height = height;
1071:     tex_pixels.clear();
1072:     for (float p : pixels) {
1073:       tex_pixels.append(p);
1074:     }
1075:   }
1076: 
1077:   void clearTexture()
1078:   {
1079:     tex_width = 0;
1080:     tex_height = 0;
1081:     tex_pixels.clear();
1082:   }
1083: 
1084:   /** Compile `source` as a texture script and bind the program (replacing any
1085:    * prior one). On failure the brush is left with no program and the message
1086:    * lands in `texture_script_error`. `@const` params are frozen into the
1087:    * compiled code â€” to change one, edit the source and rebind (milliseconds
1088:    * under tcc); the param setters below refuse them. */
1089:   bool setTextureScriptSource(litestl::util::stringref source,
1090:                               litestl::util::stringref filename)
1091:   {
1092:     clearTextureScript();
1093:     TextureProgram *p = compileTextureScript(source, filename, texture_script_error);
1094:     if (!p) {
1095:       return false;
1096:     }
1097:     texture_program = p;
1098:     for (float f : p->defaults) {
1099:       texture_params.append(f);
1100:     }
1101:     return true;
1102:   }
1103: 
1104:   // Marshal-safe wrapper: the binding runtime can't pass a host string into a
1105:   // util::string arg (see BrushProp), so script source crosses as a char
1106:   // Vector. NUL-terminated locally â€” stringref has no (ptr, size) ctor.
1107:   bool setTextureScript(litestl::util::Vector<char> &source)
1108:   {
1109:     litestl::util::Vector<char> buf;
1110:     for (char c : source) {
1111:       buf.append(c);
1112:     }
1113:     buf.append('\0');
1114:     return setTextureScriptSource(buf.data(), "<script>");
1115:   }
1116: 
1117:   void clearTextureScript()
1118:   {
1119:     if (texture_program) {
1120:       freeTextureProgram(texture_program);
1121:       texture_program = nullptr;
1122:     }
1123:     texture_params.clear();
1124:     texture_script_error = litestl::util::string("");
1125:   }
1126: 
1127:   int textureParamCount()
1128:   {
1129:     return texture_program ? (int)texture_program->params.size() : 0;
1130:   }
1131: 
1132:   TextureProgramParam *queriedTextureParamEntry(int i)
1133:   {
1134:     if (!texture_program || i < 0 || i >= (int)texture_program->params.size()) {
1135:       return nullptr;
1136:     }
1137:     return &texture_program->params[i];
1138:   }
1139: 
1140:   // Set a scalar param by manifest index, clamped to its @range. False for
1141:   // ramps, @const params, or an unbound/invalid index.
1142:   bool setTextureParamAt(int i, float value)
1143:   {
1144:     TextureProgramParam *p = queriedTextureParamEntry(i);
1145:     if (!p || p->isRamp || p->isConst || p->offset < 0) {
1146:       return false;
1147:     }
1148:     if (p->hasRange) {
1149:       value =
1150:           value < p->rangeMin ? p->rangeMin : (value > p->rangeMax ? p->rangeMax : value);
1151:     }
1152:     texture_params[p->offset] = value;
1153:     return true;
1154:   }
1155: 
1156:   // Overwrite a ramp param's LUT â€” exactly kTexRampSize samples.
1157:   bool setTextureRampAt(int i, litestl::util::Vector<float> &lut)
1158:   {
1159:     TextureProgramParam *p = queriedTextureParamEntry(i);
1160:     if (!p || !p->isRamp || p->offset < 0 || (int)lut.size() != kTexRampSize) {
1161:       return false;
1162:     }
1163:     for (int k = 0; k < kTexRampSize; k++) {
1164:       texture_params[p->offset + k] = lut[k];
1165:     }
1166:     return true;
1167:   }
1168: 
1169:   /** Evaluate the bound texture program at one point, outside any stroke.
1170:    *
1171:    * Returns 0 with no program bound. The map context is null, so a program
1172:    * whose `usesMap` is set sees `mapPoint()` as identity rather than a real
1173:    * render matrix â€” check `textureUsesMap()` and drive such a program through
1174:    * a stroke instead.
1175:    */
1176:   float evalTextureAt(float px, float py, float pz, float nx, float ny, float nz)
1177:   {
1178:     if (!texture_program || !texture_program->eval) {
1179:       return 0.0f;
1180:     }
1181:     const float P[3] = {px, py, pz};
1182:     const float N[3] = {nx, ny, nz};
1183:     const float *params = texture_params.size() > 0 ? texture_params.data() : nullptr;
1184:     return texture_program->eval(P, N, params, nullptr);
1185:   }
1186: 
1187:   bool textureUsesMap()
1188:   {
1189:     return texture_program ? texture_program->usesMap : false;
1190:   }
1191: 
1192:   // C++-side convenience (unbound â€” strings can't cross the boundary).
1193:   int textureParamIndex(const char *name)
1194:   {
1195:     for (int i = 0; i < textureParamCount(); i++) {
1196:       if (texture_program->params[i].name == litestl::util::string(name)) {
1197:         return i;
1198:       }
1199:     }
1200:     return -1;
1201:   }
1202: 
1203:   // Drop all recorded stroke samples â€” called at the start of each stroke so
1204:   // STROKE_CURVED arc lengths are measured from the stroke's first dab.
1205:   void resetStrokePath()
1206:   {
1207:     strokePathCount = 0;
1208:   }
1209: 
1210:   // Append a dab center to the StrokePath, accumulating arc length from the
1211:   // previous sample. Once full, the oldest sample is dropped (true ring) so
1212:   // arc length keeps growing along a long stroke without unbounded storage.
1213:   void pushStrokeSample(float3 pos, float3 normal)
1214:   {
1215:     float arclen = 0.0f;
1216:     if (strokePathCount > 0) {
1217:       const StrokeSample &prev = strokePath[strokePathCount - 1];
1218:       arclen = prev.arclen + (pos - prev.pos).length();
1219:     }
1220:     if (strokePathCount < kStrokePathMax) {
1221:       strokePath[strokePathCount++] = StrokeSample{pos, normal, arclen};
1222:     } else {
1223:       for (int i = 1; i < kStrokePathMax; i++) {
1224:         strokePath[i - 1] = strokePath[i];
1225:       }
1226:       strokePath[kStrokePathMax - 1] = StrokeSample{pos, normal, arclen};
1227:     }
1228:   }
1229: 
1230:   // Project `co` onto the StrokePath polyline and return UV for STROKE_CURVED:
1231:   // uv.x = arc length at the nearest point along the stroke, uv.y = the
1232:   // (unsigned) lateral distance from the centerline. With no path recorded the
1233:   // origin is returned. WGSL mirrors this in `brush_stroke_uv`.
1234:   litestl::math::float2 sampleStrokeUV(float3 co) const
1235:   {
1236:     if (strokePathCount == 0) {
1237:       return litestl::math::float2{0.0f, 0.0f};
1238:     }
1239:     if (strokePathCount == 1) {
1240:       return litestl::math::float2{strokePath[0].arclen,
1241:                                    (co - strokePath[0].pos).length()};
1242:     }
1243: 
1244:     float bestDist = std::numeric_limits<float>::max();
1245:     float bestArc = 0.0f;
1246:     float bestLat = 0.0f;
1247:     for (int i = 0; i + 1 < strokePathCount; i++) {
1248:       float3 a = strokePath[i].pos;
1249:       float3 ab = strokePath[i + 1].pos - a;
1250:       float len2 = ab.dot(ab);
1251:       float t = len2 > 0.0f ? (co - a).dot(ab) / len2 : 0.0f;
1252:       t = t < 0.0f ? 0.0f : (t > 1.0f ? 1.0f : t);
1253:       float3 d = co - (a + ab * t);
1254:       float dist = d.length();
1255:       if (dist < bestDist) {
1256:         bestDist = dist;
1257:         bestArc =
1258:             strokePath[i].arclen + (strokePath[i + 1].arclen - strokePath[i].arclen) * t;
1259:         bestLat = dist;
1260:       }
1261:     }
1262:     return litestl::math::float2{bestArc, bestLat};
1263:   }
1264: 
1265:   // Overwrite `falloff_curve` with a named preset. `inverse` flips the
1266:   // smoothstep shape (full strength at the edge, zero at the center) â€”
1267:   // useful for verifying the LUT actually drives the kernel rather
1268:   // than being shadowed by the analytic dispatch.
1269:   enum class CurvePreset { Smoothstep, Linear, Inverse, Gaussian };
1270: 
1271:   // Re-sample `falloffCurve` (the authoring curve) into `falloff_curve`
1272:   // (the baked LUT). Call after mutating `falloffCurve`.
1273:   void rebakeFalloff()
1274:   {
1275:     props::detail::curve::bake_curve_lut(
1276:         *falloffCurve.gen, falloff_curve.data(), kFalloffCurveSize);
1277:   }
1278: 
1279:   // Construct the authoring `CurveGen` for a named preset, then rebake.
1280:   // Inverse maps to a reverse-linear b-spline (1-t); Gaussian maps to a
1281:   // centered-bump `CurveGenGuassian` parameterized to match the brush's
1282:   // analytic edge gaussian exp(-9(1-t)^2) (offset=1, 1/(2ÏƒÂ²)=9).
1283:   void setFalloffCurvePreset(CurvePreset p)
1284:   {
1285:     using namespace props::detail::curve;
1286: 
1287:     switch (p) {
1288:     case CurvePreset::Smoothstep:
1289:       falloffCurve = CurveGen(props::PropCurves::SMOOTHSTEP);
1290:       break;
1291:     case CurvePreset::Linear:
1292:       falloffCurve = CurveGen(props::PropCurves::LINEAR);
1293:       break;
1294:     case CurvePreset::Inverse: {
1295:       falloffCurve = CurveGen(props::PropCurves::BSPLINE);
1296:       static_cast<CurveGenBSpline *>(falloffCurve.gen)
1297:           ->loadTemplate(SplineTemplate::REVERSE_LINEAR);
1298:       break;
1299:     }
1300:     case CurvePreset::Gaussian: {
1301:       falloffCurve = CurveGen(props::PropCurves::GUASSIAN);
1302:       CurveGenGuassian *g = static_cast<CurveGenGuassian *>(falloffCurve.gen);
1303:       g->height = 1.0;
1304:       g->offset = 1.0;
1305:       g->deviation = 1.0 / std::sqrt(18.0);
1306:       break;
1307:     }
1308:     }
1309: 
1310:     rebakeFalloff();
1311:   }
