433:   /** Enable non-accumulate mode for the upcoming stroke, and set its generation
434:    * stamp (a monotonic per-stroke counter; must be non-zero, since the
435:    * `.brush.disp.gen` attr defaults to 0 = "not stamped this stroke"). */
436:   void setNonAccum(bool v)
437:   {
438:     nonAccum = v;
439:   }
