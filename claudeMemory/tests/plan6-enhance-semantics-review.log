166: template <typename T> constexpr props::Prop brushMemberType()
167: {
168:   if constexpr (std::is_same_v<T, float>) {
169:     return props::Prop::FLOAT32;
170:   } else if constexpr (std::is_same_v<T, int>) {
171:     return props::Prop::INT32;
172:   } else if constexpr (std::is_same_v<T, bool>) {
173:     return props::Prop::BOOL;
174:   } else if constexpr (std::is_same_v<T, litestl::math::float2>) {
175:     return props::Prop::VEC2F;
176:   } else if constexpr (std::is_same_v<T, float3>) {
177:     return props::Prop::VEC3F;
178:   } else if constexpr (std::is_same_v<T, float4>) {
179:     return props::Prop::VEC4F;
180:   } else if constexpr (std::is_array_v<T>) {
181:     return props::Prop::ARRAYBUFFER;
182:   } else {
183:     return props::Prop::INVALID_TYPE;
184:   }
185: }
