47: def _on_viewport_draw():
48:     global _frames_presented
49:     _frames_presented += 1
50: 
51: 
52: def _draw_counter_push():
53:     global _draw_counter_handle, _draw_counter_strokes
54:     _draw_counter_strokes += 1
55:     if _draw_counter_handle is None:
56:         _draw_counter_handle = bpy.types.SpaceView3D.draw_handler_add(
57:             _on_viewport_draw, (), 'WINDOW', 'POST_PIXEL')
58: 
59: 
60: def _draw_counter_pop():
61:     global _draw_counter_handle, _draw_counter_strokes
62:     _draw_counter_strokes = max(0, _draw_counter_strokes - 1)
63:     if _draw_counter_strokes == 0 and _draw_counter_handle is not None:
64:         bpy.types.SpaceView3D.draw_handler_remove(_draw_counter_handle, 'WINDOW')
65:         _draw_counter_handle = None
