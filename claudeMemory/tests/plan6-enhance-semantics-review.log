250: props::ScalarRegistrationResult CommandExecutor::applyResolvedProgram(
251:     BrushProgram *program, float3 center, float3 normal, bool validateOnly)
252: {
253:   using props::PropError;
254:   auto fail = [&](PropError error, const char *name) {
255:     lastRegistration = {error, name};
256:     return lastRegistration;
257:   };
258:   if (!preparedStepValid() || !program || !brush || !tree || !tree->m || !tree->getRoot())
259:     return fail(PropError::ERROR_INVALID_OWNER, "program or mesh");
260:   for (int axis = 0; axis < 3; axis++)
261:     if (!std::isfinite(center[axis]) || !std::isfinite(normal[axis]))
262:       return fail(PropError::ERROR_INVALID_VALUE, "dab frame");
263:   if (!program->commands.size()) {
264:     PreparedBrushScalars empty;
265:     lastRegistration = prepareBrushScalars(*brush, {}, brush->deviceInputCtx, empty);
266:     if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
267:       return lastRegistration;
268:     lastRegistration = {};
269:     dabNodes_.clear();
270:     lastDabNodeCount = 0;
271:     clearIsFirstOfStep();
272:     return {};
273:   }
274:   Vector<brush_command> commands;
275:   commands.resize(program->commands.size());
276:   Vector<std::span<const BrushUniformManifestEntry>> manifests;
277:   bool needsLive = keepTopoThawed;
278:   for (size_t i = 0; i < program->commands.size(); i++) {
279:     const auto &entry = program->commands[i];
280:     auto &command = commands[i];
281:     if (!createPreparedCommand(entry.type, command)) {
282:       lastRegistration = programError(i, {PropError::ERROR_NOT_EXISTS, "kernel"});
283:       return lastRegistration;
284:     }
285:     if (entry.attrLayerOverrides.size() ||
286:         !resolvedCapability(*this, command, entry.type))
287:     {
288:       lastRegistration = programError(
289:           i, {PropError::ERROR_INVALID_VALUE, "unsupported resolved capability"});
290:       return lastRegistration;
291:     }
292:     needsLive |= brushNeedsLiveLinks(entry.type);
293:     manifests.append({command.uniforms.data(), command.uniforms.size()});
294:   }
295:   PreparedProgramScalars prepared;
296:   lastRegistration = prepareProgramScalars(*brush,
297:                                            *program,
298:                                            {manifests.data(), manifests.size()},
299:                                            brush->deviceInputCtx,
300:                                            prepared);
301:   if (lastRegistration.error != PropError::ERROR_NONE)
302:     return lastRegistration;
303:   bool allLeaves = false;
304:   for (size_t i = 0; i < commands.size(); i++) {
305:     if (!commands[i].unbounded)
306:       continue;
307:     lastRegistration =
308:         programError(i, validateUnboundedSupport(prepared.stages[i], prepared.radii[i]));
309:     if (lastRegistration.error != PropError::ERROR_NONE)
310:       return lastRegistration;
311:     allLeaves |= prepared.radii[i] > 0;
312:   }
313:   lastRegistration = {};
314:   if (validateOnly)
315:     return {};
316:   dabNodes_.clear();
317:   if (prepared.radius > 0) {
318:     if (allLeaves) {
319:       for (auto *node : tree->leaves())
320:         if (node->data && node->data->unique_verts.size())
321:           dabNodes_.append(node);
322:     } else {
323:       tree->filterNodes(center, prepared.radius, dabNodes_);
324:     }
325:   }
326:   lastDabNodeCount = int(dabNodes_.size());
327:   if (dabNodes_.size()) {
328:     ScopedBrushWorkingValues working(*brush,
329:                                      {prepared.stages.data(), prepared.stages.size()});
330:     auto *mesh = tree->m;
331:     Vector<BrushHookFn> completed;
332:     BrushHookCtx hc{*this, mesh, &dabNodes_, brush, isFirstOfStep};
333:     for (size_t i = 0; i < program->commands.size(); i++) {
334:       const auto *hooks = brushHooksFor(program->commands[i].type);
335:       if (!prepared.radii[i] || !hooks || !hooks->stepPreFreeze)
336:         continue;
337:       bool seen = false;
338:       for (auto fn : completed)
339:         seen |= fn == hooks->stepPreFreeze;
340:       if (!seen) {
341:         hooks->stepPreFreeze(hc);
342:         completed.append(hooks->stepPreFreeze);
343:       }
344:     }
345:     bool needsCavity = false;
346:     for (size_t i = 0; i < prepared.stages.size(); i++) {
347:       if (prepared.radii[i] > 0)
348:         for (const auto &value : prepared.stages[i].values())
349:           needsCavity |= value.name == string("automask_cavity") && value.value != 0;
350:     }
351:     if (needsCavity) {
352:       if (mesh->topo_frozen && !mesh->topo_cache.valid(*mesh))
353:         mesh->thawTopo();
354:       mesh->topo_cache.ensureRing1(*mesh);
355:     }
356:     if (needsLive) {
357:       if (mesh->topo_frozen)
358:         mesh->thawTopo();
359:     } else if (!mesh->topo_frozen) {
360:       mesh->freezeTopo();
361:     }
362:     ctx.m = mesh;
363:     ctx.surfaceNo = normal;
364:     ctx.surfacePos = center;
365:     ctx.meshLog = meshLog;
366:     ctx.isFirstOfStep = isFirstOfStep;
367:     updateStrokeFrame(center);
368:     brush->pushStrokeSample(center, normal);
369:     ScopedPreparedCavity cavityScope(preparedCavityActive);
370:     for (size_t i = 0; i < commands.size(); i++) {
371:       if (prepared.radii[i] == 0)
372:         continue;
373:       prepared.stages[i].applyWorking(*brush);
374:       curCaptureSlot = int(i);
375:       curCaptureTool = int(program->commands[i].type);
376:       exec(commands[i], {dabNodes_.data(), dabNodes_.size()});
377:     }
378:     curCaptureSlot = -1;
379:     tree->updateQueries();
380:   }
381:   clearIsFirstOfStep();
382:   return {};
383: }
384: 
385: int CommandExecutor::allocateUniformQueryToken()
386: {
387:   static std::atomic<int> next{0};
388:   int current = next.load(std::memory_order_relaxed);
389:   while (current < std::numeric_limits<int>::max()) {
390:     if (next.compare_exchange_weak(current, current + 1, std::memory_order_relaxed)) {
391:       return current + 1;
392:     }
393:   }
394:   return 0;
395: }
