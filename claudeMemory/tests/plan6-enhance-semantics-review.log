19: /** Context handed to every per-tool hook: the executor plus the dab's mesh and
20:  * in-region spatial nodes. `m` may be null when the node set is empty. */
21: struct BrushHookCtx {
22:   CommandExecutor &exec;
23:   mesh::Mesh *m = nullptr;
24:   litestl::util::Vector<spatial::SpatialNode *> *nodes = nullptr;
25:   Brush *brush = nullptr;
26:   bool isFirstOfStep = false;
27: };
28: 
29: using BrushHookFn = void (*)(BrushHookCtx &);
30: 
31: /** The host-side passes a tool needs around its kernel, as a uniform shape.
32:  * The executors invoke each phase without knowing which tool wants it, so a
33:  * tool with host work is one table row in brush_hooks.cc rather than a
34:  * conditional at every call site. */
35: struct BrushHooks {
36:   /** Stroke start (first dab), before the per-dab topology freeze; topology
37:    * links are live. E.g. BSMOOTH/FEATURE_ALIGN's boundary-class refresh. */
38:   BrushHookFn stepPreFreeze = nullptr;
39:   /** Every dab, after freeze/thaw and before the kernel runs. E.g. ENHANCE's
40:    * difference-of-smooths region fill and FEATURE_ALIGN's cross-field update
41:    * (both live-links tools, so topology is thawed here). */
42:   BrushHookFn dabPre = nullptr;
43:   /** Every dab, after the kernel ran. E.g. POLYGROUP's boundary-dirty mark. */
44:   BrushHookFn dabPost = nullptr;
45:   /** Safe before prepared execution, independent of stage scalars and dab order. */
46:   bool preparedInvariant = false;
47:   /** Grids use the read-only zero boundary column and need no mesh refresh. */
48:   bool preparedGridSkip = false;
49: };
50: 
51: /** Tool-keyed hook lookup; null when the tool needs no host-side passes. */
52: const BrushHooks *brushHooksFor(SculptBrushes tool);
53: 
54: inline bool preparedHooksSupported(SculptBrushes tool, bool grid)
55: {
56:   const auto *hooks = brushHooksFor(tool);
57:   return !hooks || (hooks->preparedInvariant && !hooks->dabPre && !hooks->dabPost &&
58:                     (!grid || hooks->preparedGridSkip));
59: }
60: 
61: } // namespace sculptcore::brush
