1705:   bool prepareProgramDeclarations(BrushProgram *program)
1706:   {
1707:     if (!program || !brush || !brush->props.struct_def) {
1708:       lastRegistration = {props::PropError::ERROR_INVALID_OWNER, "program"};
1709:       return registrationSucceeded();
1710:     }
1711:     Vector<props::ScalarDeclaration> declarations;
1712:     for (const auto &entry : program->commands) {
1713:       if (entry.dynamicsOverrides.size() || entry.scalarOverrides.size() ||
1714:           entry.cavityCurveOverride.size())
1715:       {
1716:         lastRegistration = {props::PropError::ERROR_INVALID_VALUE,
1717:                             "typed program requires resolved execution"};
1718:         return registrationSucceeded();
1719:       }
1720:       brush_command command;
1721:       if (!createDeclarationCommand(entry.type, command)) {
1722:         lastRegistration = {props::PropError::ERROR_NOT_EXISTS, "kernel"};
1723:         return registrationSucceeded();
1724:       }
1725:       command.appendScalarDeclarations(declarations);
1726:     }
1727:     lastRegistration = brush->props.struct_def->registerScalars(
1728:         {declarations.data(), declarations.size()});
1729:     return registrationSucceeded();
1730:   }
