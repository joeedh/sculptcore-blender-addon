423:   /** Select the SMOOTH for_neighbor source: 0 = LiveDisk (live topology links),
424:    * 1 = Csr (the cached ring1 adjacency). The LiteMesh sculpt path uses Csr â€”
425:    * a freshly built mesh doesn't maintain live disk links, so LiveDisk smooth
426:    * finds no neighbors and no-ops. Exposed as an int (NeighborMode is an
427:    * unbound enum). */
428:   void setNeighborMode(int mode)
429:   {
430:     neighborMode = static_cast<NeighborMode>(mode);
431:   }
