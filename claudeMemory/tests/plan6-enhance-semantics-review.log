101: // One recorded stroke-dab center for the StrokePath ring buffer. `arclen` is
102: // the cumulative world-space distance from the first sample to this one, so a
103: // projection onto the polyline yields a monotonic curvilinear coordinate.
104: struct StrokeSample {
105:   float3 pos{0, 0, 0};
106:   float3 normal{0, 0, 1};
107:   float arclen = 0.0f;
