11: namespace sculptcore::brush {
12: 
13: /** Each stage owns its contact region even when the program selects all leaves. */
14: inline bool preparedCavityContact(const Brush &brush,
15:                                   bool unbounded,
16:                                   const float3 &point,
17:                                   const float3 &center,
18:                                   const float3 &normal)
19: {
20:   if (!unbounded)
21:     return brush.falloffDist(point - center, normal) < 1.0f;
22:   if (brush.unboundedExtent <= 0)
23:     return true;
24:   const float cutoff = brush.radius * brush.unboundedExtent;
25:   return std::hypot(double(point[0]) - double(center[0]),
26:                     double(point[1]) - double(center[1]),
27:                     double(point[2]) - double(center[2])) < double(cutoff);
28: }
29: 
30: /** First-contact cavity factors owned by one prepared stroke transaction. */
31: class PreparedCavityCache {
32: public:
33:   struct Key {
34:     int blur;
35:     float factor;
36:     bool inverted, useCurve;
37:     std::array<float, Brush::kCavityCurveLutSize> curve;
38: 
39:     bool operator==(const Key &b) const
40:     {
41:       return blur == b.blur && factor == b.factor && inverted == b.inverted &&
42:              useCurve == b.useCurve && curve == b.curve;
43:     }
44:   };
45:   struct Entry {
46:     Key key;
47:     litestl::util::Map<int, float> factors;
48:   };
49: 
50:   void reset()
51:   {
52:     entries_.clear();
53:     active_.resize(0, false);
54:     scratch_ = CavityScratch();
55:     geometry_ = nullptr;
56:     topology_ = 0;
57:     evaluations_ = 0;
58:   }
59: 
60:   void beginGeometry(const void *geometry, uint64_t topology, int capacity)
61:   {
62:     if (geometry_ != geometry || topology_ != topology) {
63:       reset();
64:       geometry_ = geometry;
65:       topology_ = topology;
66:     }
67:     active_.resize(capacity, false);
68:   }
69: 
70:   Entry &entry(const Brush &brush)
71:   {
72:     const Key key{brush.cavity_blur_steps,
73:                   brush.cavity_factor,
74:                   brush.cavity_inverted,
75:                   brush.cavity_use_curve,
76:                   brush.cavity_curve};
77:     for (auto &item : entries_) {
78:       if (item->key == key)
79:         return *item;
80:     }
81:     auto created = std::make_unique<Entry>();
82:     created->key = key;
83:     entries_.append(std::move(created));
84:     return *entries_.last();
85:   }
86: 
87:   template <class Source> void fill(Entry &entry, const Source &source, int vertex)
88:   {
89:     float *cached = entry.factors.lookup_ptr(vertex);
90:     if (!cached) {
91:       CavityParams params;
92:       params.enabled = true;
93:       params.blur_steps = entry.key.blur;
94:       params.factor = entry.key.factor;
95:       params.inverted = entry.key.inverted;
96:       params.use_curve = entry.key.useCurve;
97:       params.curve_lut = entry.key.curve.data();
98:       const float value =
99:           cavityRemap(params, cavityRawT(source, vertex, params.blur_steps, scratch_));
100:       entry.factors.add(vertex, value);
101:       evaluations_++;
102:       write(vertex, value);
103:     } else {
104:       write(vertex, *cached);
105:     }
106:   }
107: 
108:   void write(int vertex, float value)
109:   {
110:     active_.materialize(vertex);
111:     active_[vertex] = value;
112:   }
113: 
114:   mesh::AttrData<float> *active()
115:   {
116:     return &active_;
117:   }
118:   size_t evaluations() const
119:   {
120:     return evaluations_;
121:   }
122:   size_t configurations() const
123:   {
124:     return entries_.size();
125:   }
126:   size_t storedFactors() const
127:   {
128:     size_t count = 0;
129:     for (const auto &item : entries_)
130:       count += item->factors.size();
131:     return count;
132:   }
133: 
134: private:
135:   litestl::util::Vector<std::unique_ptr<Entry>> entries_;
136:   mesh::AttrData<float> active_{util::string(".prepared.cavity"), 0};
137:   CavityScratch scratch_;
138:   const void *geometry_ = nullptr;
139:   uint64_t topology_ = 0;
140:   size_t evaluations_ = 0;
141: };
142: 
143: /** Select prepared cache behavior only while an accepted prepared stage executes. */
144: struct ScopedPreparedCavity {
145:   bool &flag;
146:   bool previous;
147:   explicit ScopedPreparedCavity(bool &flag) : flag(flag), previous(flag)
148:   {
149:     flag = true;
150:   }
151:   ~ScopedPreparedCavity()
152:   {
153:     flag = previous;
154:   }
155: };
156: 
157: } // namespace sculptcore::brush
