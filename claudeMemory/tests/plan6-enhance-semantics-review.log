426:   /** Generated defaults and evaluated writes never change authored properties. */
427:   void ensureNamedFloatDefault(int slot, float value)
428:   {
429:     if (slot >= 0 && slot < kNamedUniformSlotLimit) {
430:       namedFloats.ensure(slot, value);
431:     }
432:   }
433:   void ensureNamedIntDefault(int slot, int32_t value)
434:   {
435:     if (slot >= 0 && slot < kNamedUniformSlotLimit) {
436:       namedInts.ensure(slot, value);
437:     }
438:   }
439:   void ensureNamedBoolDefault(int slot, bool value)
440:   {
441:     if (slot >= 0 && slot < kNamedUniformSlotLimit) {
442:       namedBools.ensure(slot, value);
443:     }
444:   }
445:   void setEvaluatedNamedFloat(int slot, float value)
446:   {
447:     if (slot >= 0 && slot < kNamedUniformSlotLimit) {
448:       namedFloats.set(slot, value);
449:     }
450:   }
451:   void setEvaluatedNamedInt(int slot, int32_t value)
452:   {
453:     if (slot >= 0 && slot < kNamedUniformSlotLimit) {
454:       namedInts.set(slot, value);
455:     }
456:   }
457:   void setEvaluatedNamedBool(int slot, bool value)
458:   {
459:     if (slot >= 0 && slot < kNamedUniformSlotLimit) {
460:       namedBools.set(slot, value);
461:     }
462:   }
