12: bool resolvedCapability(CommandExecutor &executor,
13:                         const CommandExecutor::brush_command &command,
14:                         SculptBrushes type)
15: {
16:   const auto &brush = *executor.brush;
17:   return !(
18:       executor.stepHasDyntopo || (executor.anchoredGrab && command.grabModeCapable) ||
19:       !resolvedAttributesSupported(
20:           {command.attrs.size() ? &command.attrs[0] : nullptr, command.attrs.size()}) ||
21:       (command.attrs.size() && !brushHooksFor(type)) ||
22:       executor.defaultAttrOverrides.size() ||
23:       (command.execHost && !command.preparedHostNoop) || !command.preparedScalarSafe ||
24:       !preparedHooksSupported(type, false) || executor.previewActive() ||
25:       !resolvedFalloffSupported(brush));
26: }
