1765:   // Update the per-dab stroke frame: the stroke tangent (this dab origin minus
1766:   // the previous dab center) and, for the oriented Box falloff, its primary
1767:   // axis. Must run *before* pushStrokeSample appends this origin, and before the
1768:   // kernel executes. Shared by both the single-brush and program dab paths so
1769:   // Box/wing-scrape orientation is identical regardless of entry point.
1770:   void updateStrokeFrame(float3 origin)
1771:   {
1772:     // Under mirror symmetry the host owns strokeDir (it reflects the primary
1773:     // tangent per image); the shared ring buffer would otherwise interleave
1774:     // primary + mirror origins. Derive from the buffer only when host didn't.
1775:     if (!brush->strokeDirHostSet) {
1776:       if (brush->strokePathCount == 0) {
1777:         // First dab of the stroke: no tangent exists yet, and the previous
1778:         // stroke's is not one (wing scrape would lean its wings along it).
1779:         brush->strokeDir = float3(0.0f, 0.0f, 0.0f);
1780:       } else {
1781:         float3 d = origin - brush->strokePath[brush->strokePathCount - 1].pos;
1782:         float len = d.length();
1783:         if (len > 1e-7f) {
1784:           brush->strokeDir = d / len;
1785:         }
1786:       }
1787:     }
1788:     // The bridge only flips the shape to Box; the direction is owned here so it
1789:     // stays consistent with wing-scrape's strokeDir.
1790:     if (brush->falloff_shape == FalloffShape::Box) {
1791:       brush->falloff_dir = brush->strokeDir;
1792:     }
1793:   }
1794: 
1795:   void execBrush(Mesh *m,
1796:                  SculptBrushes brushType,
1797:                  Vector<spatial::SpatialNode *> *nodes,
1798:                  float3 origin,
1799:                  float3 normal)
1800:   {
1801:     if (!preflightRaw(brushType))
1802:       return;
1803:     auto cmd = createCommand(brushType);
1804: 
1805:     // Enter/leave frozen-topology mode per dab (both calls early-out when
1806:     // already in the target state, so this is cheap to re-check every dab).
1807:     // Note: this is the C++ executor path only; the GPU dispatch in gpu_stroke
1808:     // has its own neighbor handling and is unaffected.
1809:     const BrushHooks *hooks = brushHooksFor(brushType);
1810:     BrushHookCtx hookCtx{*this, m, nodes, brush, isFirstOfStep};
1811:     if (nodes->size() > 0) {
1812:       if (hooks && hooks->stepPreFreeze && isFirstOfStep) {
1813:         hooks->stepPreFreeze(hookCtx);
1814:       }
1815:       if (brushNeedsLiveLinks(brushType) || keepTopoThawed) {
1816:         if (m->topo_frozen) {
1817:           m->thawTopo();
1818:         }
1819:       } else if (!m->topo_frozen) {
1820:         m->freezeTopo();
1821:       }
1822:     }
1823: 
1824:     // Per-dab host pre-passes (brush_hooks.cc): ENHANCE's region fill and
1825:     // FEATURE_ALIGN's cross-field update â€” the latter previously ran only on
1826:     // the execProgram path. Topology is live for both (brushNeedsLiveLinks).
1827:     if (hooks && hooks->dabPre && nodes->size() > 0) {
1828:       hooks->dabPre(hookCtx);
1829:     }
1830: 
1831:     // Resolve common props with device dynamics applied (a bit-identical no-op
1832:     // without configured devices; mirrors the execProgram load). No
1833:     // loadUniformProps: this path's callers set kernel uniforms as raw fields.
1834:     brush->loadCommonProps(&brush->deviceInputCtx);
1835: 
1836:     ctx.m = m;
1837:     ctx.surfaceNo = normal;
1838:     ctx.surfacePos = origin;
1839:     ctx.meshLog = meshLog;
1840:     ctx.isFirstOfStep = isFirstOfStep;
1841: 
1842:     // Stroke tangent + oriented-Box axis for this dab (before pushStrokeSample).
1843:     updateStrokeFrame(origin);
1844: 
1845:     // Record this dab center so STROKE_CURVED can map vertices onto the
1846:     // accumulated stroke polyline. Incremental on purpose: a dab's vertices
1847:     // see the path up to and including this dab.
1848:     brush->pushStrokeSample(origin, normal);
1849: 
1850:     std::span<spatial::SpatialNode *> nodeSpan(nodes->data(), nodes->size());
1851:     curCaptureSlot = 0;
1852:     curCaptureTool = int(brushType);
1853:     exec(cmd, nodeSpan);
1854:     curCaptureSlot = -1;
1855: 
1856:     if (hooks && hooks->dabPost) {
1857:       hooks->dabPost(hookCtx);
1858:     }
1859:   }
1860: 
1861:   /** Validate raw source semantics without publishing or mutating geometry. */
1862:   bool preflightRaw(SculptBrushes type);
1863:   bool preflightRawProgram(BrushProgram *program);
1864:   bool supportsResolved(SculptBrushes type);
1865:   bool supportsResolvedProgram(BrushProgram *program);
1866:   bool createPreparedCommand(SculptBrushes type, brush_command &command);
1867: 
1868:   /** Checked CPU mesh entry with evaluated spherical node selection. */
1869:   props::ScalarRegistrationResult applyResolvedDab(SculptBrushes brushType,
1870:                                                    float3 center,
1871:                                                    float3 normal,
1872:                                                    bool validateOnly = false);
1873: 
1874:   /** Preflight the whole program and restore scalar working state after execution. */
1875:   props::ScalarRegistrationResult applyResolvedProgram(BrushProgram *program,
1876:                                                        float3 center,
1877:                                                        float3 normal,
1878:                                                        bool validateOnly = false);
1879: 
1880:   /** Run one hook phase over a program's commands, once per distinct hook fn
1881:    * (BSMOOTH and FEATURE_ALIGN share the boundary-class refresh, which must
1882:    * not run twice for a program listing both). */
1883:   void
1884:   runProgramHooks(BrushProgram *prog, BrushHookFn BrushHooks::*phase, BrushHookCtx &hc)
1885:   {
1886:     BrushHookFn seen[8] = {};
1887:     int nseen = 0;
1888:     for (auto &entry : prog->commands) {
1889:       const BrushHooks *hooks = brushHooksFor(entry.type);
1890:       BrushHookFn fn = hooks ? hooks->*phase : nullptr;
1891:       if (!fn) {
1892:         continue;
1893:       }
1894:       bool dup = false;
1895:       for (int i = 0; i < nseen; i++) {
1896:         dup = dup || seen[i] == fn;
1897:       }
1898:       if (dup) {
1899:         continue;
1900:       }
1901:       if (nseen < 8) {
1902:         seen[nseen++] = fn;
1903:       }
1904:       fn(hc);
1905:     }
1906:   }
1907: 
1908:   /** Run a composite brush program over one node set per dab. Each sub-command
1909:    * resolves the brush's props (with its sparse overrides applied) into the
1910:    * cached scalars, then runs like a standalone brush. Used for autosmooth
1911:    * (`[main, SMOOTH]`): SMOOTH is a second `exec()` whose `co_prev` snapshot is
1912:    * re-taken *after* the main pass mutated positions, so it smooths the result. */
1913:   void execProgram(BrushProgram *prog,
1914:                    Vector<spatial::SpatialNode *> *nodes,
1915:                    float3 origin,
1916:                    float3 normal)
1917:   {
1918:     if (!preflightRawProgram(prog))
1919:       return;
1920:     if (!prog->commands.size())
1921:       return;
1922:     if (!prepareProgramDeclarations(prog))
1923:       return;
1924: 
1925:     // Topology freeze/thaw is decided once for the whole dab: thaw if *any*
1926:     // sub-command needs live disk links (a live-disk smooth), otherwise freeze
1927:     // for the program's duration. Mixed programs (e.g. DRAW + SMOOTH) thaw,
1928:     // which is harmless for the link-agnostic commands.
1929:     if (nodes->size() > 0) {
1930:       bool needsLive = false;
1931:       for (auto &entry : prog->commands) {
1932:         if (brushNeedsLiveLinks(entry.type))
1933:           needsLive = true;
1934:       }
1935:       mesh::Mesh *m = (*nodes)[0]->data->m;
1936:       // Stroke-start hooks (e.g. the boundary-class refresh) must precede the
1937:       // freeze below â€” they need live links.
1938:       if (isFirstOfStep) {
1939:         BrushHookCtx hookCtx{*this, m, nodes, brush, isFirstOfStep};
1940:         runProgramHooks(prog, &BrushHooks::stepPreFreeze, hookCtx);
1941:       }
1942:       // Cavity automasking's BFS blur reads the ring1 CSR. Build it here, while
1943:       // topology links are live, before the per-dab freeze drops them: thaw a
1944:       // stale frozen mesh (topology changed since the CSR was built), then
1945:       // (re)build the stamp-keyed CSR (a no-op when already current). exec()'s
1946:       // fill then reads the cached CSR even after the mesh re-freezes below.
1947:       if (brush->automask_cavity) {
1948:         if (m->topo_frozen && !m->topo_cache.valid(*m)) {
1949:           m->thawTopo();
1950:         }
1951:         m->topo_cache.ensureRing1(*m);
1952:       }
1953:       if (needsLive || keepTopoThawed) {
1954:         if (m->topo_frozen)
1955:           m->thawTopo();
1956:       } else if (!m->topo_frozen) {
1957:         m->freezeTopo();
1958:       }
1959:     }
1960: 
1961:     // Per-dab host pre-passes (brush_hooks.cc), once per dab rather than per
1962:     // sub-command: ENHANCE's region fill, FEATURE_ALIGN's cross-field update.
1963:     // Topology is live for these tools (brushNeedsLiveLinks).
1964:     if (nodes->size() > 0) {
1965:       BrushHookCtx hookCtx{*this, (*nodes)[0]->data->m, nodes, brush, isFirstOfStep};
1966:       runProgramHooks(prog, &BrushHooks::dabPre, hookCtx);
1967:     }
1968: 
1969:     // Stroke tangent + oriented-Box axis for this dab (Route A). Must run before
1970:     // pushStrokeSample appends this origin. Drives wing-scrape and Box falloff.
1971:     updateStrokeFrame(origin);
1972: 
1973:     // One stroke sample per dab (not per sub-command): the stroke advances once.
1974:     brush->pushStrokeSample(origin, normal);
1975: 
1976:     for (auto &entry : prog->commands) {
1977:       // Apply this command's sparse overrides onto the authored props,
1978:       // snapshotting the prior values so the brush's base props survive the
1979:       // dab unmodified (the next dab re-syncs them from the bridge regardless).
1980:       Vector<BrushFloatOverride> savedFloats;
1981:       for (auto &ov : entry.floatOverrides) {
1982:         // Name-keyed overrides target a generated kernel uniform; id-keyed ones
1983:         // target a common prop. Resolve to the prop name either way and snapshot
1984:         // the prior value under that same name for an exact rollback.
1985:         util::string nm =
1986:             ov.name.size() ? ov.name : util::string(brushPropName(ov.propId));
1987:         BrushFloatOverride saved;
1988:         saved.name = nm;
1989:         saved.value = brush->props.lookupFloat(nm.c_str(), 0.0f);
1990:         savedFloats.append(std::move(saved));
1991:         brush->props.setFloat(nm.c_str(), ov.value);
1992:       }
1993:       bool savedInvert = brush->invert;
1994:       if (entry.overrideInvert) {
1995:         brush->props.setValue<bool>("invert", entry.invertValue);
1996:       }
1997: 
1998:       auto cmd = createCommand(entry.type);
1999: 
2000:       // Register this kernel's scalar-float uniforms as props (idempotent,
2001:       // defaults seeded), then resolve common props + the kernel's uniforms
2002:       // into cached scalars (applies device dynamics). The uniform half is
2003:       // generated per brush from its `uniform` declarations.
2004:       brush->loadCommonProps(&brush->deviceInputCtx);
2005:       if (cmd.loadUniformProps) {
2006:         cmd.loadUniformProps(*brush, &brush->deviceInputCtx);
2007:       }
2008: 
2009:       ctx.surfaceNo = normal;
2010:       ctx.surfacePos = origin;
2011:       ctx.meshLog = meshLog;
2012:       ctx.isFirstOfStep = isFirstOfStep;
2013: 
2014:       std::span<spatial::SpatialNode *> nodeSpan(nodes->data(), nodes->size());
2015:       curCaptureSlot = int(&entry - prog->commands.data());
2016:       curCaptureTool = int(entry.type);
2017:       exec(cmd,
2018:            nodeSpan,
2019:            std::span<const BrushAttrLayerOverride>(entry.attrLayerOverrides.data(),
2020:                                                    entry.attrLayerOverrides.size()));
2021:       curCaptureSlot = -1;
2022: 
2023:       if (const BrushHooks *hooks = brushHooksFor(entry.type); hooks && hooks->dabPost) {
2024:         BrushHookCtx hookCtx{*this,
2025:                              nodes->size() ? (*nodes)[0]->data->m : nullptr,
2026:                              nodes,
2027:                              brush,
2028:                              isFirstOfStep};
2029:         hooks->dabPost(hookCtx);
2030:       }
2031: 
2032:       // Roll the base props back (saved under the resolved prop name).
2033:       for (auto &s : savedFloats) {
2034:         brush->props.setFloat(s.name.c_str(), s.value);
2035:       }
2036:       if (entry.overrideInvert) {
2037:         brush->props.setValue<bool>("invert", savedInvert);
2038:       }
2039:     }
2040:   }
2041: 
2042:   /** Run one dynamic-topology dab under the cursor. Reproduces the native
2043:    * debug harness's Scene::applyDynTopoDab wiring (thaw + combined meshlog/
2044:    * spatial callbacks + in-region seed) MINUS tree->update() and the meshlog
2045:    * step: the TS sculpt path already drives spatial.update() each frame
2046:    * (LiteMesh.drawQ) and wraps the whole stroke in one meshlog step. Returns
2047:    * splits+collapses applied (DynTopoStats.splits + .collapses). */
2048:   int applyDynTopoDab(float3 center,
2049:                       float radius,
2050:                       dyntopo::DynTopoParams *params,
2051:                       uint32_t seed)
2052:   {
2053:     if (!tree || !params || !tree->m) {
2054:       return 0;
2055:     }
2056:     mesh::Mesh *m = tree->m;
2057: 
2058:     // Locked bases (multires level meshes) never retopologize: a level mesh is
2059:     // derived from the grid store, so changing its topology strands every
2060:     // level's displacement and the host's grid map (mesh.h topoLocked).
2061:     if (m->topoLocked) {
2062:       return 0;
2063:     }
2064: 
2065:     // Displacement-base coherence: tell the remesh ops the active stroke's gen so
2066:     // the tangential smooth resamples the field it slides verts through. Keyed on
2067:     // the attr actually existing (the brush's stroke-start pre-pass creates it),
2068:     // so it can never claim a gen no command stamped.
2069:     params->dispGen =
2070:         m->v.attrs.has(mesh::AttrType::FLOAT3, ".brush.disp.vec") ? strokeGen : 0;
2071: 
2072:     // A dyntopo dab mutates topology and walks live disk/radial links; keep the
2073:     // mesh thawed for the whole stroke (endDynTopoStroke releases it).
2074:     keepTopoThawed = true;
2075:     if (m->topo_frozen) {
2076:       m->thawTopo();
2077:     }
2078: 
2079:     // Fold any pending boundary edits (seam marking / poly-group paint, and the
2080:     // flags propagated by in-stroke splits) into the derived flags + per-vert
2081:     // class while links are live (recomputeDirty walks the disk/radial cycles).
2082:     // Self-limiting: recomputeDirty processes only dirty elements and clears
2083:     // m->boundaryDirty, so this is a no-op on dabs that changed nothing.
2084:     if (params->preserve_features && m->boundaryDirty) {
2085:       mesh::boundary::recomputeDirty(m);
2086:     }
2087: 
2088:     // Combined callbacks: meshlog (undo) fanned with the spatial tree's
2089:     // incremental-ownership handlers. getSpatialCallbacks() returns a shared
2090:     // persistent member, so copy its three std::functions by value before
2091:     // composing â€” never alias it across dabs.
2092:     mesh::MeshCallbacks combined;
2093:     mesh::MeshCallbacks *cb = nullptr;
2094:     mesh::MeshCallbacks *sp = tree->getSpatialCallbacks();
2095:     mesh::MeshCallbacks *ml = meshLog ? meshLog->callbacks() : nullptr;
2096:     if (meshLog) {
2097:       /* The topo-chunk callbacks no-op without an active mesh (Scene::
2098:        * applyDynTopoDab does the same wiring on the debug-harness path). */
2099:       meshLog->setActiveMesh(m);
2100:     }
2101:     if (sp && ml) {
2102:       combined = *ml;
2103:       auto mlFC = combined.onFaceCreate, spFC = sp->onFaceCreate;
2104:       combined.onFaceCreate = [mlFC, spFC](int f) {
2105:         if (mlFC)
2106:           mlFC(f);
2107:         if (spFC)
2108:           spFC(f);
2109:       };
2110:       auto mlFK = combined.onFaceKill, spFK = sp->onFaceKill;
2111:       combined.onFaceKill = [mlFK, spFK](int f) {
2112:         if (mlFK)
2113:           mlFK(f); /* meshlog snapshots before the tree drops it */
2114:         if (spFK)
2115:           spFK(f);
2116:       };
2117:       auto mlVK = combined.onVertKill, spVK = sp->onVertKill;
2118:       combined.onVertKill = [mlVK, spVK](int v) {
2119:         if (mlVK)
2120:           mlVK(v);
2121:         if (spVK)
2122:           spVK(v);
2123:       };
2124:       auto mlFCh = combined.onFaceChange, spFCh = sp->onFaceChange;
2125:       combined.onFaceChange = [mlFCh, spFCh](int f) {
2126:         if (mlFCh)
2127:           mlFCh(f); /* meshlog records the rewired (Existed && Live) face */
2128:         if (spFCh)
2129:           spFCh(f); /* tree re-flags the owning leaf (in-place flip/split) */
2130:       };
2131:       cb = &combined;
2132:     } else {
2133:       cb = ml ? ml : sp;
2134:     }
2135: 
2136:     // Round-0 seed: verts of the in-region leaves, so the dab is O(brush region)
2137:     // rather than O(mesh). The caller owns the spatial query; dyntopo stays
2138:     // spatial-free and just receives the set.
2139:     Vector<spatial::SpatialNode *> &hit = dynTopoNodes_;
2140:     hit.clear();
2141:     tree->filterNodes(center, radius, hit);
2142: 
2143:     Vector<int> &seedVerts = dynTopoSeed_;
2144:     seedVerts.clear();
2145:     size_t nseed = 0;
2146:     for (spatial::SpatialNode *n : hit) {
2147:       nseed += n->unique_verts().size();
2148:     }
2149:     seedVerts.ensure_capacity(nseed);
2150:     for (spatial::SpatialNode *n : hit) {
2151:       for (int v : n->unique_verts()) {
2152:         seedVerts.append(v);
2153:       }
2154:     }
2155: 
2156:     dyntopo::DynTopoStats st =
2157:         dyntopo::runDyntopoRemesh(*m,
2158:                                   center,
2159:                                   radius,
2160:                                   *params,
2161:                                   seed,
2162:                                   cb,
2163:                                   span<const int>(seedVerts.data(), seedVerts.size()));
2164: 
2165:     lastDynTopoStats = st;
2166:     return st.splits + st.collapses;
2167:   }
2168: 
2169:   /** One unified brush dab â€” the single dab sequence shared by every client
2170:    * (TS app, debug interactive/script). Runs, in order: optional dyntopo pre-pass
2171:    * (when params != nullptr), spatial node filter, deform program, then the
2172:    * per-dab meshlog topo-chunk seal. Dyntopo runs BEFORE the deform so the brush
2173:    * moves the freshly-refined geometry; the chunk is sealed AFTER the deform so a
2174:    * Created vert's end_body captures its deformed co directly (endStep still
2175:    * refreshes verts a LATER dab re-deforms without a topo touch). Caller owns
2176:    * building `prog` and configuring `*params`; pass params=nullptr to disable
2177:    * dyntopo. Call between beginStep(hasDyntopo) and endStep() (and
2178:    * endDynTopoStroke() before endStep() on a dyntopo stroke). Returns
2179:    * splits+collapses applied. */
2180:   int applyDab(BrushProgram *prog,
2181:                float3 center,
2182:                float3 normal,
2183:                float radius,
2184:                dyntopo::DynTopoParams *params,
2185:                uint32_t seed)
2186:   {
2187:     if (!tree || !tree->m) {
2188:       return 0;
2189:     }
2190:     if (!preflightRawProgram(prog) || !prepareProgramDeclarations(prog)) {
2191:       return -1;
2192:     }
2193:     int topoApplied = 0;
2194:     if (params) {
2195:       topoApplied = applyDynTopoDab(center, radius, params, seed);
2196:     }
2197:     // `radius` here is the node-filter radius only (the falloff uses
2198:     // brush->radius). A from-orig grab-class program ignores the host's
2199:     // drag-widened radius and takes the pinned region instead â€” the executor
2200:     // owns that policy (see grabFilterNodes).
2201:     float pinRadius = 0.0f;
2202:     for (const BrushCommandEntry &e : prog->commands) {
2203:       radius = std::fmax(radius, filterRadiusFloor(e.type));
2204:       if (grabAnchoredTool(e.type)) {
2205:         pinRadius = std::fmax(pinRadius, grabPinRadius(e.type));
2206:       }
2207:     }
2208:     Vector<spatial::SpatialNode *> &nodes = dabNodes_;
2209:     nodes.clear();
2210:     if (pinRadius > 0.0f) {
2211:       grabFilterNodes(center, pinRadius, radius, nodes);
2212:     } else {
2213:       tree->filterNodes(center, radius, nodes);
2214:     }
2215:     lastDabNodeCount = int(nodes.size());
2216:     if (nodes.size() > 0) {
2217:       execProgram(prog, &nodes, center, normal);
2218:       if (!lastUniformValidationOk())
2219:         return -1;
2220:     }
2221:     if (params && meshLog) {
2222:       /* Per-dab seal: deactivate this dab's topo chunk NOW (finalizing its
2223:          Created end-states) so the next dab's topo captures land in a fresh
2224:          chunk. Without it one step-wide chunk captures an Existed vert's
2225:          begin-body at its FIRST TOPO touch â€” mid-step for verts the brush
2226:          deformed in earlier dabs â€” and that stale body, sitting at position
2227:          0, wins the reverse-order undo over the element store's true
2228:          pre-step row (the multistep undo corruption). */
2229:       meshLog->pushTopoChunk();
2230:     }
2231:     clearIsFirstOfStep();
2232:     return topoApplied;
2233:   }
2234: 
2235:   /** execBrush-based overload for callers driving a single brush type rather than
2236:    * a BrushProgram (the native debug harness). Same dyntopo+filter+seal sequence. */
2237:   int applyDab(SculptBrushes brushType,
2238:                float3 center,
2239:                float3 normal,
2240:                float radius,
2241:                dyntopo::DynTopoParams *params,
2242:                uint32_t seed)
2243:   {
2244:     if (!tree || !tree->m) {
2245:       return 0;
2246:     }
2247:     if (!preflightRaw(brushType))
2248:       return -1;
2249:     mesh::Mesh *m = tree->m;
2250:     int topoApplied = 0;
2251:     if (params) {
2252:       topoApplied = applyDynTopoDab(center, radius, params, seed);
2253:     }
2254:     // `radius` is the node-filter radius only; grab-class strokes take the
2255:     // pinned region (see the BrushProgram overload).
2256:     radius = std::fmax(radius, filterRadiusFloor(brushType));
2257:     Vector<spatial::SpatialNode *> &nodes = dabNodes_;
2258:     nodes.clear();
2259:     if (grabAnchoredTool(brushType)) {
2260:       grabFilterNodes(center, grabPinRadius(brushType), radius, nodes);
2261:     } else {
2262:       tree->filterNodes(center, radius, nodes);
2263:     }
2264:     lastDabNodeCount = int(nodes.size());
2265:     if (nodes.size() > 0) {
2266:       execBrush(m, brushType, &nodes, center, normal);
2267:       if (!lastUniformValidationOk())
2268:         return -1;
2269:     }
2270:     if (params && meshLog) {
2271:       /* Per-dab seal: deactivate this dab's topo chunk NOW (finalizing its
2272:          Created end-states) so the next dab's topo captures land in a fresh
2273:          chunk. Without it one step-wide chunk captures an Existed vert's
2274:          begin-body at its FIRST TOPO touch â€” mid-step for verts the brush
2275:          deformed in earlier dabs â€” and that stale body, sitting at position
2276:          0, wins the reverse-order undo over the element store's true
2277:          pre-step row (the multistep undo corruption). */
2278:       meshLog->pushTopoChunk();
2279:     }
2280:     clearIsFirstOfStep();
2281:     return topoApplied;
2282:   }
2283: 
2284:   /** Release the stroke-long topology thaw set by applyDynTopoDab. Call once at
2285:    * stroke end; the next non-dyntopo dab re-freezes on its own. Also folds in the
2286:    * final dab's pending boundary marks (the per-dab recompute runs at the *next*
2287:    * dab's start, so the last dab's new geometry would otherwise stay unclassified
2288:    * until the next stroke) while topology links are still live. */
2289:   void endDynTopoStroke()
2290:   {
2291:     if (tree && tree->m && tree->m->boundaryDirty) {
2292:       if (tree->m->topo_frozen) {
2293:         tree->m->thawTopo();
2294:       }
2295:       mesh::boundary::recomputeDirty(tree->m);
2296:     }
2297:     keepTopoThawed = false;
2298:   }
2299: 
2300:   void clearIsFirstOfStep()
2301:   {
2302:     isFirstOfStep = false;
2303:   }
