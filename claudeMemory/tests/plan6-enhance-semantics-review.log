441:   /** Declare whether the upcoming stroke is anchored (see `anchoredGrab`). Must
442:    * be set before createCommand, i.e. before the first dab of the stroke. */
443:   void setAnchoredGrab(bool v)
444:   {
445:     anchoredGrab = v;
446:   }
447: 
448:   /** Mark the upcoming grab-class dab/image (#35): false = primary image, which
449:    * begins a new logical dab and bumps the per-dab generation so every vert it
450:    * touches re-bases from orig; true = mirror image of the same dab (shared verts
451:    * add). The AccumOrigGrab write-back keys off the per-vert dab stamp, so this
452:    * only needs to advance `dabGen` once per dab (on the primary image). */
453:   void setGrabAccumAdd(bool v)
454:   {
455:     grabAccumAdd = v;
456:     if (!v) {
457:       dabGen++;
458:     }
459:   }
460:   void setStrokeGen(int gen)
461:   {
462:     strokeGen = uint32_t(gen);
463:   }
464: 
465:   /** Per-call iterator factories used by CommandCtx::vertexIter/faceIter. The
466:    * vertex iterator is parameterized by the AccumMode policy and threaded the
467:    * displacement field (null/0 unless a from-base mode is active for this dab). */
468:   template <class AccMode>
469:   BasicVertexIter<AccMode> makeVertexIter(spatial::SpatialNode &node)
470:   {
471:     return BasicVertexIter<AccMode>(node, *this, ctx.dispVec, ctx.dispGen, ctx.strokeGen);
472:   }
473:   BasicFaceIter makeFaceIter(spatial::SpatialNode &node)
474:   {
475:     return BasicFaceIter(node, *this);
476:   }
477: 
478:   /** Type-dispatch half of createCommandImpl, stateless so `queryBrushFlags` can
479:    * reach a kernel's manifest without a live stroke. `brushOrNull` is only used
480:    * by the extra-kernel registry (uniform defaults); a null one just means extra
481:    * kernels report unhandled. Returns false when `brushType` matched nothing.
482:    *
483:    * Both halves are generated: the built-ins from the kernels' @tool annotations
484:    * (brushes/generated/builtin_brushes.gen.h, graded by tests/test_brush_registry.cc)
485:    * and the extras from the configured extra-kernel dirs. Adding a brush touches
486:    * neither this function nor any other host conditional. */
487:   template <class AccMode>
488:   static bool createCommandSwitch(SculptBrushes brushType,
489:                                   bool csrNeighbors,
490:                                   Brush *brushOrNull,
491:                                   brush_command &def)
492:   {
493:     if (command::createBuiltinBrush<CommandExecutor, CsrNbr, LiveDiskNbr, AccMode>(
494:             int(brushType), csrNeighbors, def))
495:     {
496:       return true;
497:     }
498:     // Extra (out-of-repo) kernels dispatch through the generated registry;
499:     // a no-op fallback compiles in when no extra kernel dirs are configured.
500:     return brushOrNull &&
501:            command::createExtraBrush<CommandExecutor, CsrNbr, LiveDiskNbr, AccMode>(
502:                int(brushType), csrNeighbors, *brushOrNull, def);
503:   }
504: 
505:   /** Fill `def` for `brushType` under a fixed AccumMode policy. createCommand
506:    * calls this once for AccumLive, then again for AccumOrig when non-accumulate
507:    * is active and the brush is accumulable â€” the second call overwrites def.exec
508:    * with the AccumOrig kernel while keeping the rest of the (identical) manifest. */
509:   template <class AccMode>
510:   void createCommandImpl(SculptBrushes brushType, brush_command &def)
511:   {
512:     if (createCommandSwitch<AccMode>(
513:             brushType, effectiveNeighborMode() == NeighborMode::Csr, brush, def))
514:     {
515:       return;
516:     }
517:     printf("Unknown brush type %d\n", static_cast<int>(brushType));
518:     abort();
519:   }
520: 
521:   brush_command createCommand(SculptBrushes brushType)
522:   {
523:     brush_command def;
524:     createCommandImpl<AccumLive>(brushType, def);
525:     if (def.grabModeCapable && anchoredGrab) {
526:       // Always deform from each vert's stroke-start position, so the region is
527:       // fixed at stroke start and the grab follows the cursor (#35). One write-
528:       // back (AccumOrigGrab) serves every symmetry image: the first image to
529:       // touch a vert this dab re-bases it from orig, later images of the same
530:       // dab add their displacement onto it (arbitrated by the per-vert dab
531:       // stamp). Forced on regardless of the ACCUMULATE flag. The op marks each
532:       // image via setGrabAccumAdd, which advances the per-dab generation on the
533:       // primary.
534:       def.grabMode = true;
535:       /* The second impl call re-appends the same uniform + attr manifests â€”
536:          clear them first or grab-class brushes report every entry twice (the
537:          wave-5 queryUniformManifest / queryAttrManifest bridge). */
538:       def.uniforms = decltype(def.uniforms)();
539:       def.attrs = decltype(def.attrs)();
540:       createCommandImpl<AccumOrigGrab>(brushType, def);
541:     } else if (nonAccum && def.accumulable && !def.relaxesBase) {
542:       def.uniforms = decltype(def.uniforms)();
543:       def.attrs = decltype(def.attrs)();
544:       createCommandImpl<AccumOrig>(brushType, def);
545:     }
546:     return def;
547:   }
548: 
549:   /** Lower bound on the node-filter radius for `brushType`. An `@unbounded`
550:    * kernel carries no distance falloff of its own â€” only `unboundedWindow`'s
551:    * cutoff at R = radius * unboundedExtent â€” so a filter sized from the brush
552:    * radius stops while the field is still live and the leaf boundary tears.
553:    * Hosts still own the radius (grab widens it by the drag); this only raises
554:    * it, and returns 0 for every ordinary kernel. */
555:   float filterRadiusFloor(SculptBrushes brushType)
556:   {
557:     ensureToolMemo(brushType);
558:     return floorMemoUnbounded_ ? brush->radius * brush->unboundedExtent : 0.0f;
559:   }
560: 
561:   void ensureToolMemo(SculptBrushes brushType)
562:   {
563:     if (int(brushType) != floorMemoTool_) {
564:       brush_command def;
565:       createCommandImpl<AccumLive>(brushType, def);
566:       floorMemoTool_ = int(brushType);
567:       floorMemoUnbounded_ = def.unbounded;
568:       floorMemoGrabCapable_ = def.grabModeCapable;
569:     }
570:   }
571: 
572:   /** Whether `brushType` takes the from-orig fixed-region grab policy on this
573:    * stroke â€” the same condition createCommand uses to pick AccumOrigGrab. */
574:   bool grabAnchoredTool(SculptBrushes brushType)
575:   {
576:     ensureToolMemo(brushType);
577:     return floorMemoGrabCapable_ && anchoredGrab;
578:   }
579: 
580:   /** Drag-independent radius the pinned grab region is sized from: the falloff
581:    * radius, raised for an `@unbounded` kernel exactly as filterRadiusFloor does.
582:    * Hosts widen the radius they pass applyDab by the cumulative drag (the GPU
583:    * dab and the anchored preview snapshot need that); the pinned CPU region
584:    * must not follow it. */
585:   float grabPinRadius(SculptBrushes brushType)
586:   {
587:     return std::fmax(brush->radius, filterRadiusFloor(brushType));
588:   }
589: 
590:   /** Node set for one dab of a from-orig grab-class stroke.
591:    *
592:    * Such a stroke only ever moves verts within the falloff radius of its FIXED
593:    * anchor (it re-bases from each vert's stroke-start position), so the leaves
594:    * it needs are exactly the ones its first dab saw â€” including the border
595:    * leaves that draw replicas, whose AABBs already touch that sphere. Pin that
596:    * set for the stroke instead of re-filtering: the leaves deform away from the
597:    * anchor as the drag grows, and the old fix for that (widen the filter by the
598:    * drag) made every dab stamp, run, re-normal and re-upload the whole swept
599:    * region â€” per-dab cost growing with the drag for no extra coverage.
600:    *
601:    * `hostRadius` is what the host asked for; it is only used by the dyntopo
602:    * fallback, which cannot pin anything. */
603:   void grabFilterNodes(float3 center,
604:                        float pinRadius,
605:                        float hostRadius,
606:                        Vector<spatial::SpatialNode *> &nodes)
607:   {
608:     if (stepHasDyntopo) {
609:       // Topology and the leaf set move under the stroke, so nothing survives
610:       // being pinned; fall back to the drag-widened filter.
611:       grabWidenRadius_ = std::fmax(
612:           grabWidenRadius_, std::fmax(hostRadius, pinRadius + brush->grabTo.length()));
613:       tree->filterNodes(center, grabWidenRadius_, nodes);
614:       return;
615:     }
616: 
617:     GrabRegion *reg = nullptr;
618:     const float tol = std::fmax(pinRadius, 1.0f) * 1e-4f;
619:     for (GrabRegion &r : grabRegions_) {
620:       if ((r.center - center).lengthSqr() <= tol * tol) {
621:         reg = &r;
622:         break;
623:       }
624:     }
625:     if (reg && reg->radius >= pinRadius) {
626:       nodes.clear();
627:       for (int id : reg->nodeIds) {
628:         if (spatial::SpatialNode *n = tree->node_from_id(id)) {
629:           nodes.append(n);
630:         }
631:       }
632:       return;
633:     }
634: 
635:     // First dab of this symmetry image, or its radius grew (pressure dynamics).
636:     tree->filterNodes(center, pinRadius, nodes);
637:     if (!reg) {
638:       // One entry per symmetry image; more than that means the "anchor" is
639:       // drifting, so stop caching rather than grow without bound.
640:       if (grabRegions_.size() >= 16) {
641:         return;
642:       }
643:       grabRegions_.append(GrabRegion());
644:       reg = &grabRegions_[grabRegions_.size() - 1];
645:     }
646:     reg->center = center;
647:     reg->radius = pinRadius;
648:     reg->nodeIds.clear();
649:     for (spatial::SpatialNode *n : nodes) {
650:       reg->nodeIds.append(n->id);
651:     }
652:   }
653: 
654:   /** Map a declared attribute domain to the mesh's element AttrGroup. */
655:   static mesh::AttrGroup *attrGroupForDomain(mesh::Mesh *m, AttrElemDomain d)
656:   {
657:     switch (d) {
658:     case AttrElemDomain::Vertex:
659:       return &m->v.attrs;
660:     case AttrElemDomain::Face:
661:       return &m->f.attrs;
662:     case AttrElemDomain::Edge:
663:       return &m->e.attrs;
664:     case AttrElemDomain::Corner:
665:       return &m->c.attrs;
666:     }
667:     return nullptr;
668:   }
669: 
670:   static int elemCountForDomain(mesh::Mesh *m, AttrElemDomain d)
671:   {
672:     switch (d) {
673:     case AttrElemDomain::Vertex:
674:       return m->v.count;
675:     case AttrElemDomain::Face:
676:       return m->f.count;
677:     case AttrElemDomain::Edge:
678:       return m->e.count;
679:     case AttrElemDomain::Corner:
680:       return m->c.count;
681:     }
682:     return 0;
683:   }
684: 
685:   /** Per-domain element *capacity*. Use this (not the count) when iterating by raw
686:    * element id â€” dyntopo leaves freelist gaps, so a live element's id can exceed
687:    * the live count. */
688:   static int elemCapacityForDomain(mesh::Mesh *m, AttrElemDomain d)
689:   {
690:     switch (d) {
691:     case AttrElemDomain::Vertex:
692:       return int(m->v.capacity());
693:     case AttrElemDomain::Face:
694:       return int(m->f.capacity());
695:     case AttrElemDomain::Edge:
696:       return int(m->e.capacity());
697:     case AttrElemDomain::Corner:
698:       return int(m->c.capacity());
699:     }
700:     return 0;
701:   }
702: 
703:   void exec(brush_command &cmd,
704:             std::span<spatial::SpatialNode *> nodes,
705:             std::span<const BrushAttrLayerOverride> attrOverrides = {})
706:   {
707:     // Resolve declared attribute layers once per dab (shared across all nodes;
708:     // the AttrData pointers are mesh-wide and stable for the dab's duration).
709:     if (attrOverrides.size() == 0 && defaultAttrOverrides.size() > 0) {
710:       attrOverrides = std::span<const BrushAttrLayerOverride>(
711:           defaultAttrOverrides.data(), defaultAttrOverrides.size());
712:     }
713:     attrBindingStorage.clear();
714:     ctx.attrBindings = nullptr;
715:     if (cmd.attrs.size() > 0 && nodes.size() > 0) {
716:       mesh::Mesh *m = nodes[0]->data->m;
717:       for (int ai = 0; ai < int(cmd.attrs.size()); ai++) {
718:         auto &entry = cmd.attrs[ai];
719:         mesh::AttrGroup *grp = attrGroupForDomain(m, entry.domain);
720:         if (!grp)
721:           continue;
722: 
723:         // An override redirects this handle to the user-selected "active"
724:         // layer (by index). Honour it only when the layer exists and its type
725:         // matches the handle's declared type (the TS attribute manager already
726:         // constrains categories by type, so a mismatch means a stale index â€”
727:         // fall through to the default by-name binding rather than corrupt the
728:         // wrong-typed layer).
729:         int ovLayer = -1;
730:         for (const auto &ov : attrOverrides) {
731:           if (ov.attrIdx == ai) {
732:             ovLayer = ov.layerIndex;
733:             break;
734:           }
735:         }
736:         if (ovLayer >= 0 && ovLayer < int(grp->attrs.size()) &&
737:             grp->attrs[ovLayer].type == entry.type)
738:         {
739:           // Materialize the chosen layer by its (type,name) and bind it. Copy
740:           // the name first â€” ensure() of an existing layer won't realloc, but a
741:           // local keeps the AttrRef& from dangling regardless.
742:           string nm = grp->attrs[ovLayer].name;
743:           mesh::AttrRef ref = grp->ensure(entry.type, nm, /*materialize=*/true);
744:           attrBindingStorage.items.append(BrushAttrBinding{entry.handle, ref});
745:           continue;
746:         }
747: 
748:         string layer = entry.boundName.size() ? entry.boundName : entry.handle;
749:         bool existed = grp->has(entry.type, layer);
750:         mesh::AttrRef ref = grp->ensure(entry.type, layer, /*materialize=*/true);
751:         if (!existed) {
752:           // Value-init a freshly created layer so unpainted elements are
753:           // deterministic: paint reads+writes the layer, and an uninitialized
754:           // page would make output depend on heap garbage (breaking GPU A/B +
755:           // goldens). set_default zeroes simple/vector types. Span capacity (not
756:           // count): value-init by raw id so dyntopo's freelist-gap slots aren't
757:           // left as heap garbage for a paint that reads them.
758:           int n = elemCapacityForDomain(m, entry.domain);
759:           mesh::detail::type_dispatch(entry.type, [&]<typename T>() {
760:             if constexpr (std::is_same_v<T, bool>) {
761:               // BoolAttrView has no set_default; clear it explicitly so a fresh
762:               // bool layer isn't read as heap garbage (was previously skipped).
763:               auto *bv = static_cast<mesh::BoolAttrView *>(ref.data);
764:               for (int i = 0; i < n; i++)
765:                 bv->set(i, false);
766:             } else {
767:               auto *dd = static_cast<mesh::AttrData<T> *>(ref.data);
768:               for (int i = 0; i < n; i++)
769:                 dd->set_default(i);
770:             }
771:           });
772:           // A first-ever poly-group layer means "every face in the host's
773:           // default set", not group 0 -- Mesh::ensureFaceGroups' rule, applied
774:           // here because the bind, not the host, created the layer.
775:           if ((entry.use & int(mesh::AttrUse::POLYGROUP)) &&
776:               entry.type == mesh::AttrType::INT && entry.domain == AttrElemDomain::Face &&
777:               m->default_group_id != 0)
778:           {
779:             auto *dd = static_cast<mesh::AttrData<int> *>(ref.data);
780:             for (int fi : m->f) {
781:               dd->materialize(fi);
782:               (*dd)[fi] = m->default_group_id;
783:             }
784:           }
785:         }
786:         attrBindingStorage.items.append(BrushAttrBinding{entry.handle, ref});
787:       }
788:       ctx.attrBindings = &attrBindingStorage;
789:     }
790: 
791:     // Sculpt-layer bracket: snapshot every written SCULPT_LAYER binding over
792:     // the dab region so the post-dab end() folds the kernel's delta edits into
793:     // evaluated v.co (displace compositor; frozen layers get reverted).
794:     layerScopes.clear();
795:     if (ctx.attrBindings && nodes.size() > 0) {
796:       mesh::Mesh *m = nodes[0]->data->m;
797:       layerRegionVerts.clear();
798:       for (auto &binding : attrBindingStorage.items) {
799:         if (!(binding.ref.use & mesh::AttrUse::SCULPT_LAYER)) {
800:           continue;
801:         }
802:         bool writes = false;
803:         for (auto &entry : cmd.attrs) {
804:           if (entry.handle == binding.handle && entry.kernelWrites) {
805:             writes = true;
806:             break;
807:           }
808:         }
809:         if (!writes) {
810:           continue;
811:         }
812:         if (layerRegionVerts.size() == 0) {
813:           // Leaf unique_verts sets are disjoint, so no dedup is needed.
814:           for (auto *node : nodes) {
815:             for (int v : node->data->unique_verts) {
816:               layerRegionVerts.append(v);
817:             }
818:           }
819:         }
820:         displace::LayerEditScope scope;
821:         if (scope.begin(
822:                 *m,
823:                 binding.ref.name,
824:                 std::span<const int>(layerRegionVerts.data(), layerRegionVerts.size())))
825:         {
826:           layerScopes.append(std::move(scope));
827:         }
828:       }
829:     }
830: 
831:     if (cmd.execHost) {
832:       cmd.execHost(ctx, *brush);
833:     }
834: 
835:     /* Capture walk-elision: execPre captures EVERY element of every node it is
836:      * handed (falloff-independent), so on a topology-stable stroke a leaf that
837:      * was already walked for this (stroke, sub-command slot) has nothing left
838:      * to capture â€” skip it wholesale instead of re-checking its per-element
839:      * stamps. Leaf element sets only change under dyntopo (splits/merges are
840:      * driven by dyntopo adds/collapses), which disables the stamps. */
841:     const bool stampCapture = ctx.meshLog && !stepHasDyntopo && curCaptureSlot >= 0 &&
842:                               curCaptureSlot < spatial::SpatialNode::MAX_CAPTURE_SLOTS;
843:     std::span<spatial::SpatialNode *> captureSpan(nodes.data(), nodes.size());
844:     int stampSid = 0;
845:     if (stampCapture) {
846:       stampSid = ctx.meshLog->curStrokeId() + 1;
847:       captureNodes_.clear();
848:       for (auto *node : nodes) {
849:         auto &st = node->captureStamps[curCaptureSlot];
850:         if (st.sid != stampSid || st.tool != curCaptureTool) {
851:           captureNodes_.append(node);
852:         }
853:       }
854:       captureSpan =
855:           std::span<spatial::SpatialNode *>(captureNodes_.data(), captureNodes_.size());
856:     }
857:     cmd.execPre(ctx, captureSpan);
858:     if (stampCapture) {
859:       for (auto *node : captureNodes_) {
860:         auto &st = node->captureStamps[curCaptureSlot];
861:         st.sid = stampSid;
862:         st.tool = curCaptureTool;
863:       }
864:     }
865: 
866:     // Jacobi snapshot: capture pre-dab vertex positions so for_neighbor reads
867:     // a consistent state regardless of the parallel node loop's interleaving.
868:     // Indexed by RAW vertex id (so are co[] and the CSR neighbor ids), so it must
869:     // span the full capacity, not v.count: dyntopo leaves freelist gaps, so a live
870:     // vertex's id can exceed v.count â€” a count-sized snapshot would be read
871:     // out-of-bounds for those verts/neighbors (garbage â†’ smooth spikes).
872:     if (cmd.needsCoPrev && nodes.size() > 0) {
873:       mesh::Mesh *m = nodes[0]->data->m;
874:       int cap = int(m->v.capacity());
875: 
876:       /* Incremental refresh: on a topology-stable stroke, kernels only move
877:        * verts of the node sets they were handed â€” so after the stroke's first
878:        * full snapshot, entries can only be stale for nodes some exec touched
879:        * since the last refresh (coPrevDirty_). Neighbor reads outside every
880:        * touched set are still current from the full copy. */
881:       const bool canTrack = !stepHasDyntopo;
882:       if (canTrack && coPrevFull_ && int(coPrevStorage.size()) == cap) {
883:         litestl::task::parallel_for(
884:             util::IndexRange(coPrevDirty_.size()),
885:             [&](IndexRange range) {
886:               for (int i : range) {
887:                 for (int v : coPrevDirty_[i]->data->unique_verts) {
888:                   coPrevStorage[v] = m->v.co[v];
889:                 }
890:               }
891:             },
892:             1);
893:       } else {
894:         coPrevStorage.resize(cap);
895:         /* Full snapshot, copied page-wise: memcpy per materialized page
896:          * instead of the paged per-element operator[]. */
897:         mesh::AttrData<float3> *cod = m->v.co.get_data();
898:         float3 *dst = coPrevStorage.data();
899:         int copied = 0;
900:         for (auto &page : cod->pages) {
901:           int n = std::min(int(ATTR_PAGESIZE), cap - copied);
902:           if (n <= 0) {
903:             break;
904:           }
905:           if (page.data) {
906:             std::memcpy(static_cast<void *>(dst + copied),
907:                         static_cast<const void *>(page.data),
908:                         size_t(n) * sizeof(float3));
909:           } else {
910:             for (int i = 0; i < n; i++) {
911:               dst[copied + i] = page.value;
912:             }
913:           }
914:           copied += n;
915:         }
916:         coPrevFull_ = canTrack;
917:       }
918:       coPrevGen_++;
919:       coPrevDirty_.clear();
920:       ctx.co_prev = &coPrevStorage;
921: 
922:       // CSR neighbor source is static across the stroke â€” (re)build once,
923:       // single-threaded, before the parallel node loop reads it.
924:       if (effectiveNeighborMode() == NeighborMode::Csr) {
925:         m->topo_cache.ensureRing1(*m);
926:       }
927:     }
928: 
929:     // Stroke-start setup: ensure the `.brush.disp.*` TEMP attrs and stamp each
930:     // in-region vert under the current generation, single-threaded before the
931:     // parallel loop. A vert is stamped once per stroke (first contact) with a
932:     // zero displacement, so every from-base consumer derives the stroke-start
933:     // surface as `co - disp`.
934:     ctx.origNo = nullptr;
935:     ctx.dispVec = nullptr;
936:     ctx.dispGen = nullptr;
937:     ctx.strokeGen = 0;
938:     ctx.dabGen = nullptr;
939:     ctx.curDabGen = 0;
940:     // Grab-class brushes always need a stroke-start base (cmd.grabMode), even
941:     // when not `accumulable` (kelvinlet is @global) and regardless of the
942:     // ACCUMULATE flag â€” they deform from it via AccumOrigGrab (#35). A
943:     // @relaxation kernel never has one (it stays on AccumLive). Kernels may also
944:     // opt into the normal snapshot via cmd.needsOrigNormals.
945:     if ((cmd.grabMode || (nonAccum && cmd.accumulable && !cmd.relaxesBase) ||
946:          cmd.needsOrigNormals) &&
947:         nodes.size() > 0)
948:     {
949:       mesh::Mesh *m = nodes[0]->data->m;
950:       // TEMP + NOCOPY: stroke-transient, not undoable. NOCOPY keeps the meshlog
951:       // from snapshotting these during a logged dyntopo step â€” their pages are
952:       // materialized lazily (only brushed verts), so a mid-stroke edge collapse
953:       // would otherwise capture an unmaterialized page (null on WASM â†’ warn+skip;
954:       // a garbage pointer on native â†’ crash, ImmediateTODOs #37). Interpolation
955:       // stays enabled (no NOINTERP): a displacement field is correct to
956:       // interpolate onto split verts, unlike an absolute snapshot.
957:       mesh::AttrRef &dispRef =
958:           m->v.attrs.ensure(mesh::AttrType::FLOAT3, ".brush.disp.vec", false);
959:       dispRef.flag |= mesh::AttrFlag::TEMP | mesh::AttrFlag::NOCOPY;
960:       mesh::AttrRef &dispGenRef =
961:           m->v.attrs.ensure(mesh::AttrType::INT, ".brush.disp.gen", false);
962:       dispGenRef.flag |= mesh::AttrFlag::TEMP | mesh::AttrFlag::NOCOPY;
963:       ctx.dispVec = static_cast<mesh::AttrData<float3> *>(dispRef.data);
964:       ctx.dispGen = static_cast<mesh::AttrData<int> *>(dispGenRef.data);
965:       if (cmd.needsOrigNormals) {
966:         mesh::AttrRef &noRef =
967:             m->v.attrs.ensure(mesh::AttrType::FLOAT3, ".brush.orig.no", false);
968:         noRef.flag |= mesh::AttrFlag::TEMP | mesh::AttrFlag::NOCOPY;
969:         ctx.origNo = static_cast<mesh::AttrData<float3> *>(noRef.data);
970:       }
971:       ctx.strokeGen = strokeGen;
972: 
973:       // Grab-class first-touch stamp (#35): ensure `.brush.dab.gen` + pass the
974:       // per-dab counter to the kernel. Pages are pre-materialized below (with the
975:       // disp stamp) so the parallel kernel only reads/writes existing slots.
976:       if (cmd.grabMode) {
977:         mesh::AttrRef &dabRef =
978:             m->v.attrs.ensure(mesh::AttrType::INT, ".brush.dab.gen", false);
979:         dabRef.flag |= mesh::AttrFlag::TEMP | mesh::AttrFlag::NOCOPY;
980:         ctx.dabGen = static_cast<mesh::AttrData<int> *>(dabRef.data);
981:         ctx.curDabGen = dabGen;
982:       }
983: 
984:       // Lazy first-touch stamping, O(region): the stamp is zero, since an
985:       // untouched vert's base *is* its current position. Verts dyntopo creates
986:       // mid-stroke inherit an interpolated disp (and gen), so they arrive
987:       // already stamped and are skipped.
988:       //
989:       // Normals are looser than positions â€” the spatial halo refresh can rewrite
990:       // a vert's normal one fan-ring ahead of the brush â€” so when a kernel opted
991:       // into orig normals, each region leaf's SKIRT verts (its neighbor-owned
992:       // fan, exactly the set the halo can reach ahead of the region) are stamped
993:       // along with its own. The halo only refreshes fans of already-moved
994:       // (= already-stamped-leaf) verts, so this stays ahead of it without ever
995:       // sweeping the whole mesh.
996:       auto stampBase = [&](int v) {
997:         ctx.dispGen->materialize(v);
998:         if ((*ctx.dispGen)[v] != int(strokeGen)) {
999:           ctx.dispVec->materialize(v);
1000:           (*ctx.dispVec)[v] = float3(0.0f, 0.0f, 0.0f);
1001:           if (ctx.origNo) {
1002:             ctx.origNo->materialize(v);
1003:             (*ctx.origNo)[v] = m->v.no[v];
1004:           }
1005:           (*ctx.dispGen)[v] = int(strokeGen);
1006:         }
1007:       };
1008:       // Same elision as the capture walk above: this visits every element of
1009:       // each leaf and writes a stroke-fixed value, so re-walking a leaf a later
1010:       // dab still covers is pure overhead once it is fully stamped.
1011:       const int stampOpts = (ctx.origNo ? 1 : 0) | (ctx.dabGen ? 2 : 0);
1012:       const bool elideStamp = !stepHasDyntopo && strokeGen != 0;
1013:       for (auto *node : nodes) {
1014:         if (elideStamp && node->baseStampGen == strokeGen &&
1015:             node->baseStampOpts == stampOpts)
1016:         {
1017:           continue;
1018:         }
1019:         for (int v : node->data->unique_verts) {
1020:           if (ctx.dabGen) {
1021:             ctx.dabGen->materialize(v);
1022:           }
1023:           stampBase(v);
1024:         }
1025:         if (ctx.origNo) {
1026:           for (const auto &tri : node->data->skirt_tris) {
1027:             for (int k = 0; k < 3; k++) {
1028:               stampBase(m->c.v[tri.c[k]]);
1029:             }
1030:           }
1031:         }
1032:         node->baseStampGen = elideStamp ? strokeGen : 0;
1033:         node->baseStampOpts = elideStamp ? stampOpts : -1;
1034:       }
1035:     }
1036: 
1037:     // View-normal automasking is DYNAMIC: resolve the stroke's params (shared
1038:     // camera ray, limit, falloff) onto the ctx; strength() evaluates the factor
1039:     // against each vertex's live normal on every call. No cache, no stamp
1040:     // ordering, no per-vertex ray history.
1041:     ctx.viewNormal = viewNormalParamsFor(*brush);
1042: 
1043:     // Cavity automask pre-fill (see automask.h for the caching contract): the
1044:     // BFS ring-blur is too expensive per dab, so each in-region vert's 0..1
1045:     // cavity factor is stamped once per stroke into `.brush.automask.cavity`,
1046:     // single-threaded, before the parallel kernel loop reads it via strength().
1047:     ctx.automaskFactor = nullptr;
1048:     ctx.automaskEnabled = false;
1049:     if (preparedCavityActive && brush->automask_cavity && nodes.size()) {
1050:       auto *m = nodes[0]->data->m;
1051:       preparedCavity.beginGeometry(nodes[0]->data->m, m->topo_stamp, m->v.count);
1052:       PreparedCavityCache::Entry *entry = nullptr;
1053:       for (auto *node : nodes) {
1054:         for (int v : node->data->unique_verts) {
1055:           float3 contact = m->v.co[v];
1056:           if (nonAccum && cmd.accumulable && !cmd.relaxesBase && ctx.dispVec &&
1057:               ctx.dispGen && ctx.dispGen->safe_get(v) == int(ctx.strokeGen))
1058:             contact -= ctx.dispVec->safe_get(v);
1059:           if (preparedCavityContact(
1060:                   *brush, cmd.unbounded, contact, ctx.surfacePos, ctx.surfaceNo))
1061:           {
1062:             if (!entry)
1063:               entry = &preparedCavity.entry(*brush);
1064:             preparedCavity.fill(*entry, MeshCavitySrc{m}, v);
1065:           } else {
1066:             preparedCavity.write(v, 1.0f);
1067:           }
1068:         }
1069:       }
1070:       ctx.automaskFactor = preparedCavity.active();
1071:       ctx.automaskEnabled = entry != nullptr;
1072:     } else if (brush->automask_cavity && nodes.size() > 0) {
1073:       mesh::Mesh *m = nodes[0]->data->m;
1074:       if (!m->topo_frozen || m->topo_cache.valid(*m)) {
1075:         m->topo_cache.ensureRing1(*m);
1076:       }
1077:       if (m->topo_cache.valid(*m)) {
1078:         mesh::AttrRef &facRef =
1079:             m->v.attrs.ensure(mesh::AttrType::FLOAT, ".brush.automask.cavity", false);
1080:         facRef.flag |= mesh::AttrFlag::TEMP | mesh::AttrFlag::NOCOPY;
1081:         mesh::AttrRef &genRef =
1082:             m->v.attrs.ensure(mesh::AttrType::INT, ".brush.automask.gen", false);
1083:         genRef.flag |= mesh::AttrFlag::TEMP | mesh::AttrFlag::NOCOPY;
1084:         auto *fac = static_cast<mesh::AttrData<float> *>(facRef.data);
1085:         auto *gen = static_cast<mesh::AttrData<int> *>(genRef.data);
1086: 
1087:         static_assert(int(Brush::kCavityCurveLutSize) == kCavityCurveSize,
1088:                       "brush cavity_curve LUT size must match automask kCavityCurveSize");
1089:         CavityParams cp;
1090:         cp.enabled = true;
1091:         cp.blur_steps = brush->cavity_blur_steps;
1092:         cp.factor = brush->cavity_factor;
1093:         cp.inverted = brush->cavity_inverted;
1094:         cp.use_curve = brush->cavity_use_curve;
1095:         cp.curve_lut = brush->cavity_curve.data();
1096: 
1097:         CavityScratch scr;
1098:         for (auto *node : nodes) {
1099:           for (int v : node->data->unique_verts) {
1100:             gen->materialize(v);
1101:             fac->materialize(v);
1102:             if (strokeGen == 0 || (*gen)[v] != int(strokeGen)) {
1103:               (*fac)[v] = cavityFactor(m, v, cp, scr);
1104:               (*gen)[v] = int(strokeGen);
1105:             }
1106:           }
1107:         }
1108:         ctx.automaskFactor = fac;
1109:         ctx.automaskEnabled = true;
1110:       }
1111:     }
1112: 
1113:     // Skip leaves emptied of verts: heavy in-stroke collapse can leave a zero-vert
1114:     // leaf whose loose AABB still overlaps the brush sphere, so a vertex iterator on
1115:     // it wild-reads unique_verts.begin() (brush_iterators.h: "never on empty node").
1116:     // affected_verts is a sticky hint list: nothing clears it until the normals
1117:     // pass consumes it, so by late stroke it holds every vert of every prior
1118:     // dab. Remember where each node's list ends, so border propagation walks
1119:     // only what this dab adds.
1120:     affectedBase_.resize(nodes.size());
1121:     for (int i : IndexRange(nodes.size())) {
1122:       affectedBase_[i] = int(nodes[i]->affected_verts.size());
1123:     }
1124: 
1125: #ifdef NO_PARALLEL_FOR
1126:     for (auto *node : nodes) {
1127:       if (node->data->unique_verts.size() == 0) {
1128:         continue;
1129:       }
1130:       CommandCtx<CommandExecutor> finalCtx(ctx, *node, *this, *brush);
1131:       cmd.exec(finalCtx);
1132:     }
1133: #else
1134:     litestl::task::parallel_for(
1135:         util::IndexRange(nodes.size()),
1136:         [&](IndexRange range) {
1137:           for (int i : range) {
1138:             SpatialNode *node = nodes[i];
1139:             if (node->data->unique_verts.size() == 0) {
1140:               continue;
1141:             }
1142:             CommandCtx<CommandExecutor> finalCtx(ctx, *node, *this, *brush);
1143:             cmd.exec(finalCtx);
1144:           }
1145:         },
1146:         4);
1147: #endif
1148: 
1149:     cmd.execPost(ctx, nodes);
1150: 
1151:     // Fold sculpt-layer edits into evaluated positions (the kernel already
1152:     // flagged the touched nodes Spatial_UpdateNormals|UpdateGPU|RegenBounds).
1153:     for (auto &scope : layerScopes) {
1154:       scope.end();
1155:     }
1156:     layerScopes.clear();
1157: 
1158:     // Border propagation: kernels flag only the node whose own verts moved, but
1159:     // neighbouring leaves' tris draw replicas of (and integrate normals over) a
1160:     // moved border vert â€” flag those too, appending the vert as a normals hint.
1161:     if (nodes.size() > 1) {
1162:       mesh::Mesh *mm = nodes[0]->data->m;
1163:       // Stamp the dab's moved verts instead of hashing them into a Set: the
1164:       // border pass only ever asks a membership question, and at a large brush
1165:       // radius that set costs ~50k inserts plus ~33k probes per dab.
1166:       if (movedStamp_.size() < mm->v.capacity()) {
1167:         movedStamp_.resize(mm->v.capacity());
1168:         std::fill(movedStamp_.begin(), movedStamp_.end(), 0u);
1169:         movedStampGen_ = 0;
1170:       }
1171:       if (++movedStampGen_ == 0) {
1172:         std::fill(movedStamp_.begin(), movedStamp_.end(), 0u);
1173:         movedStampGen_ = 1;
1174:       }
1175:       size_t movedCount = 0;
1176:       for (int i : IndexRange(nodes.size())) {
1177:         auto &av = nodes[i]->affected_verts;
1178:         for (int j = affectedBase_[i]; j < int(av.size()); j++) {
1179:           movedStamp_[av[j]] = movedStampGen_;
1180:           movedCount++;
1181:         }
1182:       }
1183:       if (movedCount > 0) {
1184:         for (auto *node : nodes) {
1185:           if (node->flag & spatial::Spatial_RegenTris) {
1186:             continue; // tris are stale; the pending full regen covers this leaf
1187:           }
1188:           // The candidates are exactly this leaf's foreign verts, so scan the
1189:           // tris only to (re)build that cache â€” not once per dab.
1190:           tree->ensure_border_cache(node);
1191:           bool touched = false;
1192:           for (int v : node->data->foreign_verts) {
1193:             if (movedStamp_[v] == movedStampGen_) {
1194:               node->affected_verts.append(v);
1195:               touched = true;
1196:             }
1197:           }
1198:           if (touched) {
1199:             node->update(spatial::Spatial_UpdateNormals | spatial::Spatial_UpdateGPUGeom |
1200:                          spatial::Spatial_RegenBounds);
1201:           }
1202:         }
1203:       }
1204:     }
1205: 
1206:     /* coPrev bookkeeping: every vert this exec (kernel, execPost, layer fold)
1207:      * may have moved lives in `nodes` â€” queue them for the next needsCoPrev
1208:      * refresh. Skipped under dyntopo (node pointers/element sets unstable;
1209:      * the refresh falls back to a full snapshot there anyway). */
1210:     if (!stepHasDyntopo) {
1211:       for (auto *node : nodes) {
1212:         if (node->coPrevStamp != coPrevGen_) {
1213:           node->coPrevStamp = coPrevGen_;
1214:           coPrevDirty_.append(node);
1215:         }
1216:       }
1217:     }
1218: 
1219:     /* UV slide-reprojection: re-anchor the dab's moved verts' UVs on their
1220:      * pre-move ring. Rides the coPrev snapshot, so only needsCoPrev kernels
1221:      * (the smooth family) qualify. Dyntopo strokes keep topology live â€”
1222:      * reproject per dab (its ring changes under the stroke); frozen strokes
1223:      * accumulate {vert -> first-seen pre-move position} and endStep flushes
1224:      * once (a per-dab thaw would perturb the frozen-CSR stroke state). */
1225:     if (brush && brush->reproject_uvs && cmd.needsCoPrev && nodes.size() > 0 &&
1226:         ctx.co_prev == &coPrevStorage)
1227:     {
1228:       if (stepHasDyntopo) {
1229:         mesh::Mesh *m = nodes[0]->data->m;
1230:         Vector<int> rverts;
1231:         Vector<float3> rold;
1232:         Set<int, 64> seen;
1233:         for (auto *node : nodes) {
1234:           for (int v : node->affected_verts) {
1235:             if (v >= 0 && v < int(coPrevStorage.size()) && seen.add(v)) {
1236:               rverts.append(v);
1237:               rold.append(coPrevStorage[v]);
1238:             }
1239:           }
1240:         }
1241:         if (rverts.size() > 0) {
1242:           reprojectUvsWithCapture(m,
1243:                                   std::span<const int>(rverts.data(), rverts.size()),
1244:                                   std::span<const float3>(rold.data(), rold.size()));
1245:         }
1246:       } else {
1247:         for (auto *node : nodes) {
1248:           for (int v : node->affected_verts) {
1249:             if (v >= 0 && v < int(coPrevStorage.size())) {
1250:               uvReprojPending_.add(v, coPrevStorage[v]); /* first-seen wins */
1251:             }
1252:           }
1253:         }
1254:       }
1255:     }
1256:   }
1257: 
1258:   /** Run reprojectVertUVs with per-corner undo capture into the meshlog's
1259:    * CORNER element store (the same AttrSaver-gated append-as-touched pattern
1260:    * the generated kernels use for vertex positions), so a stroke's UV edits
1261:    * revert with it. Requires live topology; thaws if needed. */
1262:   void reprojectUvsWithCapture(mesh::Mesh *m,
1263:                                std::span<const int> verts,
1264:                                std::span<const float3> oldCo)
1265:   {
1266:     if (m->topo_frozen) {
1267:       m->thawTopo();
1268:     }
1269:     mesh::MeshCallbacks cb;
1270:     meshlog::AttrSaver<mesh::ElemType::CORNER> saver;
1271:     meshlog::LogChunkElems *store = nullptr;
1272:     Vector<mesh::AttrRef, 4> refs;
1273:     int sid = 0, mask = 0;
1274:     if (meshLog) {
1275:       for (mesh::AttrRef &attr : m->c.attrs.attrs) {
1276:         if (attr.type == mesh::AttrType::FLOAT2 && attr.data &&
1277:             (int(attr.use) & int(mesh::AttrUse::UV)) != 0)
1278:         {
1279:           refs.append(attr);
1280:         }
1281:       }
1282:       if (refs.size() > 0) {
1283:         saver.ensure(*m);
1284:         store = meshLog->elemStore(mesh::ElemType::CORNER);
1285:         int bit = meshlog::CUSTOM_START;
1286:         for (mesh::AttrRef &ref : refs) {
1287:           store->data.ensureAttr(m->c.attrs, ref);
1288:           mask |= saver.add(ref, 1 << bit);
1289:           bit++;
1290:         }
1291:         sid = meshLog->curStrokeId();
1292:       }
1293:     }
1294:     cb.onCornerChange = [&](int c) {
1295:       if (store && saver.needsData(c, sid, mask)) {
1296:         const int row = store->data.appendRows(1);
1297:         store->data.cpyFrom(m->c.attrs, c, row);
1298:         saver.updateSaved(c, sid, mask);
1299:       }
1300:       // Refill the face owner's GPU attribute streams: the deform kernels only
1301:       // flag Spatial_UpdateGPUGeom, which skips them â€” without this the
1302:       // viewport keeps drawing the pre-reprojection UVs.
1303:       if (tree) {
1304:         const int ni = tree->treeMesh.f.node[m->l.f[m->c.l[c]]];
1305:         if (ni) {
1306:           tree->node_from_id(ni)->update(spatial::NodeFlags::Spatial_UpdateGPU);
1307:         }
1308:       }
1309:     };
1310:     mesh::uvproj::reprojectVertUVs(m, verts, oldCo, &cb);
1311:   }
1312: 
1313:   /** Whether a stroke with this brush must keep the mesh's disk/radial link
1314:    * pages live. A brush that touches no live TOPO link during a dab lets the
1315:    * mesh sit topology-frozen â€” the pages dropped â€” for the whole stroke.
1316:    *
1317:    * Three kernel facts answer it, all reflected out of the DSL by the registry
1318:    * generators rather than enumerated here (a hand-kept enum list is how a new
1319:    * kernel silently gets a frozen stroke, and reading a dropped page is a
1320:    * heap-layout-dependent UAF, not a wrong pixel â€” graded by
1321:    * tests/test_brush_live_links.cc):
1322:    *
1323:    *  - a `for_neighbor` loop, which reads the 1-ring â€” but only its live-disk
1324:    *    instantiation walks links; the CSR one reads MeshTopoCache::ring1;
1325:    *  - `@fulltopo`, i.e. a host pre-pass that walks live topology every dab
1326:    *    (the cross-field and enhance-details passes) â€” unconditional, since the
1327:    *    thaw is what makes a stroke-start CSR snapshot go stale;
1328:    *  - a `face` stage, dispatched per face, which reaches its verts through the
1329:    *    live face loop.
1330:    *
1331:    * Called per dab, so every query is a switch on an int and allocates nothing.
1332:    */
1333:   bool brushNeedsLiveLinks(SculptBrushes brushType) const
1334:   {
1335:     const int id = int(brushType);
1336:     if (builtinBrushFullTopo(id) || extraBrushFullTopo(id) || builtinBrushFaceMode(id) ||
1337:         extraBrushFaceMode(id))
1338:     {
1339:       return true;
1340:     }
1341:     return (builtinBrushUsesForNeighbor(id) || extraBrushUsesForNeighbor(id)) &&
1342:            neighborMode != NeighborMode::Csr;
1343:   }
1344: 
1345:   /** The boundary-aware smooth brush reads the lazily-derived
1346:    * `.boundary.vert.class`. Fold any pending boundary edits (seam marking,
1347:    * poly-group paint) into it once at stroke start, while topology links are
1348:    * live â€” recomputeDirty walks the disk/radial cycles and would touch freed
1349:    * pages under frozen topology.
1350:    *
1351:    * Gated on m->boundaryDirty: when nothing changed since the last recompute
1352:    * (the common case â€” e.g. plain smoothing with no boundaries marked) this is a
1353:    * no-op and, crucially, does NOT thaw. An unconditional thaw here perturbs the
1354:    * frozen-topology CSR neighbor set the stroke relies on, making bsmooth
1355:    * diverge from plain smooth even with zero boundaries. */
1356:   void refreshBoundaryClassForBSmooth(mesh::Mesh *m)
1357:   {
1358:     if (!m->boundaryDirty)
1359:       return;
1360:     if (m->topo_frozen)
1361:       m->thawTopo();
1362:     mesh::boundary::recomputeDirty(m);
1363:   }
1364: 
1365:   /** After a poly-group dab, mark every face the touched nodes own boundary-dirty
1366:    * so the next recomputeDirty reclassifies their inter-group edges. A superset
1367:    * of the actually-repainted faces (bounded by the dab's node coverage), which
1368:    * only costs extra recompute, never wrong results. Runs while topology is live
1369:    * (POLYGROUP is a live-links brush). */
1370:   void markPolygroupDirty(std::span<spatial::SpatialNode *> nodes)
1371:   {
1372:     for (spatial::SpatialNode *node : nodes) {
1373:       mesh::Mesh *m = node->data->m;
1374:       for (int f : node->data->unique_faces) {
1375:         mesh::boundary::markFaceDirty(m, f);
1376:       }
1377:     }
1378:   }
1379: 
1380:   /** The fixed common float props are valid dynamics targets for any brush (the
1381:    * bridge drives strength/radius/... by pressure regardless of the active
1382:    * kernel), so they're exempt from the active-manifest membership check. */
1383:   static bool isCommonFloatProp(const string &name)
1384:   {
1385:     return name == string("strength") || name == string("radius") ||
1386:            name == string("spacing") || name == string("planeoff") ||
1387:            name == string("autosmooth");
1388:   }
1389: 
1390:   static const BrushUniformManifestEntry *findUniformEntry(brush_command &cmd,
1391:                                                            const string &name)
1392:   {
1393:     for (const auto &u : cmd.uniforms) {
1394:       if (u.name == name)
1395:         return &u;
1396:     }
1397:     return nullptr;
1398:   }
1399: 
1400:   /** Validate the active brush's uniform dynamics once at stroke start, scoped to
1401:    * its manifest. Catches the shared-`Brush`-struct traps (a stray dynamic left
1402:    * over from another kernel, a dynamic on a `@static`/non-float uniform), an
1403:    * unbaked 1-entry response curve, an out-of-range authored default, and an
1404:    * inverted/NaN `@range`. Returns a structured result; the caller skips the
1405:    * stroke on `!ok` so a misconfigured binding never mutates the mesh. */
1406:   UniformValidationResult validateUniformDynamics(brush_command &cmd)
1407:   {
1408:     UniformValidationResult res;
1409:     char buf[256];
1410: 
1411:     // (A) Static manifest checks â€” independent of any configured dynamic.
1412:     for (const auto &u : cmd.uniforms) {
1413:       if (!u.hasRange)
1414:         continue;
1415:       if (std::isnan(u.rangeMin) || std::isnan(u.rangeMax) || u.rangeMin > u.rangeMax) {
1416:         res.ok = false;
1417:         snprintf(buf,
1418:                  sizeof(buf),
1419:                  "uniform '%s': invalid @range [%g, %g]",
1420:                  u.name.c_str(),
1421:                  u.rangeMin,
1422:                  u.rangeMax);
1423:         res.messages.append(string(buf));
1424:         continue; // a broken range makes the default check meaningless
1425:       }
1426:       if (u.isFloat && u.hasDefault && (u.def < u.rangeMin || u.def > u.rangeMax)) {
1427:         res.ok = false;
1428:         snprintf(buf,
1429:                  sizeof(buf),
1430:                  "uniform '%s': default %g outside @range [%g, %g]",
1431:                  u.name.c_str(),
1432:                  u.def,
1433:                  u.rangeMin,
1434:                  u.rangeMax);
1435:         res.messages.append(string(buf));
1436:       }
1437:     }
1438: 
1439:     // (B) Dynamics checks â€” every prop carrying a configured device stack must
1440:     // be a valid, dynamic-capable target of the active brush.
1441:     if (brush && brush->props.struct_def) {
1442:       for (props::Property *p : brush->props.struct_def->properties()) {
1443:         props::Dynamics *dyn = brush->propDynamics(p->name);
1444:         if (!dyn || dyn->devices.size() == 0)
1445:           continue;
1446: 
1447:         const BrushUniformManifestEntry *entry = findUniformEntry(cmd, p->name);
1448:         if (!entry && !isCommonFloatProp(p->name) && p->name != string("invert")) {
1449:           res.ok = false;
1450:           snprintf(buf,
1451:                    sizeof(buf),
1452:                    "stray dynamic on '%s': not a uniform of the active brush",
1453:                    p->name.c_str());
1454:           res.messages.append(string(buf));
1455:           continue;
1456:         }
1457:         if (entry && !(entry->dynamic &&
1458:                        (entry->isFloat || entry->scalarType == props::Prop::INT32 ||
1459:                         entry->scalarType == props::Prop::BOOL)))
1460:         {
1461:           res.ok = false;
1462:           snprintf(buf,
1463:                    sizeof(buf),
1464:                    "dynamic on '%s': uniform is @static / unsupported (not "
1465:                    "dynamic-capable)",
1466:                    p->name.c_str());
1467:           res.messages.append(string(buf));
1468:           continue;
1469:         }
1470:         if (!props::Dynamics::validStack(dyn->devices)) {
1471:           res.ok = false;
1472:           res.messages.append(string("uniform '") + p->name +
1473:                               "': invalid or pending device stack");
1474:         }
1475:         for (const auto &dev : dyn->devices) {
1476:           if (dev.curveTable.size() == 1) {
1477:             res.ok = false;
1478:             snprintf(buf,
1479:                      sizeof(buf),
1480:                      "uniform '%s': device response curve has 1 entry "
1481:                      "(unbaked; need 0 or >=2)",
1482:                      p->name.c_str());
1483:             res.messages.append(string(buf));
1484:           }
1485:           int dt = (int)dev.type;
1486:           if (dt < 0 || dt > (int)props::DeviceType::TWIST) {
1487:             res.ok = false;
1488:             snprintf(buf,
1489:                      sizeof(buf),
1490:                      "uniform '%s': invalid device type %d",
1491:                      p->name.c_str(),
1492:                      dt);
1493:             res.messages.append(string(buf));
1494:           }
1495:         }
1496:       }
1497:     }
1498: 
1499:     return res;
1500:   }
1501: 
1502:   /** --- Wave 5: per-kernel uniform manifest query for the TS bridge -----------
1503:    * The binding runtime can't marshal a JS string into a `util::string` method
1504:    * arg, so the bridge enumerates the active brush's manifest by index instead
1505:    * of by name. queryUniformManifest caches the kernel's manifest (and registers
1506:    * its props so propDynamics(name) resolves) and returns the entry count;
1507:    * queriedUniformEntry exposes each entry as a bound read-only struct; the
1508:    * *UniformDynamics methods resolve the index -> name and delegate to the Brush
1509:    * by-name dynamics API (Wave 3). */
1510: 
1511:   int queryUniformManifest(int brushType)
1512:   {
1513:     queriedUniforms.clear();
1514:     canonicalUniforms_.clear();
1515:     querySource_ = this;
1516:     queryBrush_ = nullptr;
1517:     queryStruct_ = nullptr;
1518:     uniformQueryToken_ = allocateUniformQueryToken();
1519:     if (!uniformQueryToken_ || !brush || !brush->props.struct_def) {
1520:       lastRegistration = {props::PropError::ERROR_INVALID_OWNER, "query"};
1521:       return -1;
1522:     }
1523:     brush_command cmd;
1524:     if (!createDeclarationCommand(SculptBrushes(brushType), cmd)) {
1525:       lastRegistration = {props::PropError::ERROR_NOT_EXISTS, "kernel"};
1526:       return -1;
1527:     }
1528:     if (brush && brush->props.struct_def) {
1529:       lastRegistration = cmd.registerProps(*brush->props.struct_def);
1530:       if (!registrationSucceeded()) {
1531:         return -1;
1532:       }
1533:       // Initialize legacy working slots only after successful registration.
1534:       createCommand(SculptBrushes(brushType));
1535:     }
1536:     for (const auto &u : cmd.uniforms) {
1537:       queriedUniforms.append(u);
1538:       canonicalUniforms_.append(u);
1539:     }
1540:     queryBrush_ = brush;
1541:     queryStruct_ = brush->props.struct_def;
1542:     return int(queriedUniforms.size());
1543:   }
