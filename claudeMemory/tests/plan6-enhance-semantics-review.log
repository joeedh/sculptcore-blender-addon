145: 
146: props::ScalarRegistrationResult prepareProgramScalars(
147:     Brush &brush,
148:     const BrushProgram &program,
149:     std::span<const std::span<const BrushUniformManifestEntry>> manifests,
150:     const props::DeviceInputCtx &inputs,
151:     PreparedProgramScalars &output)
152: {
153:   if (!brush.props.struct_def || manifests.size() != program.commands.size())
154:     return {PropError::ERROR_INVALID_OWNER, "program"};
155:   util::Vector<props::ScalarDeclaration> declarations;
156:   util::Vector<BrushUniformManifestEntry> scope;
157:   for (size_t i = 0; i < manifests.size(); i++) {
158:     for (const auto &entry : manifests[i]) {
159:       if (!executorSetting(entry.name) &&
160:           (entry.scalarType == Prop::FLOAT32 || entry.scalarType == Prop::INT32 ||
161:            entry.scalarType == Prop::BOOL))
162:       {
163:         declarations.append({entry.name,
164:                              entry.scalarType,
165:                              entry.hasDefault,
166:                              entry.def,
167:                              entry.hasRange,
168:                              entry.rangeMin,
169:                              entry.rangeMax,
170:                              entry.dynamic});
171:       }
172:       bool found = false;
173:       for (const auto &known : scope)
174:         found |= known.name == entry.name;
175:       if (!found)
176:         scope.append(entry);
177:     }
178:     auto result = brush.props.struct_def->validateScalarDeclarations(
179:         {declarations.data(), declarations.size()});
180:     if (result.error != PropError::ERROR_NONE)
181:       return programError(i, result);
182:   }
183:   PreparedProgramScalars candidate;
184:   for (size_t i = 0; i < manifests.size(); i++) {
185:     const auto &command = program.commands[i];
186:     util::Vector<BrushScalarOverride> overrides;
187:     for (const auto &item : command.floatOverrides) {
188:       if (!item.name.size() && (item.propId < 0 || item.propId > int(BrushProp::Invert)))
189:         return programError(i, {PropError::ERROR_NOT_EXISTS, "common property ID"});
190:       overrides.append(
191:           {item.name.size() ? item.name : util::string(brushPropName(item.propId)),
192:            Prop::FLOAT32,
193:            double(item.value)});
194:     }
195:     for (const auto &item : command.scalarOverrides)
196:       overrides.append(item);
197:     if (command.overrideInvert)
198:       overrides.append({"invert", Prop::BOOL, command.invertValue ? 1.0 : 0.0});
199:     for (const auto &item : overrides) {
200:       if (!item.name.size() || std::strlen(item.name.c_str()) != item.name.size())
201:         return programError(i, {PropError::ERROR_NOT_EXISTS, "property name"});
202:     }
203:     PreparedBrushScalars stage;
204:     auto result = prepareBrushScalars(
205:         brush,
206:         manifests[i],
207:         inputs,
208:         stage,
209:         {overrides.data(), overrides.size()},
210:         {scope.data(), scope.size()},
211:         ScalarSource::Authored,
212:         {command.dynamicsOverrides.size() ? &command.dynamicsOverrides[0] : nullptr,
213:          command.dynamicsOverrides.size()},
214:         {command.cavityCurveOverride.size() ? &command.cavityCurveOverride[0] : nullptr,
215:          command.cavityCurveOverride.size()});
216:     if (result.error != PropError::ERROR_NONE)
217:       return programError(i, result);
218:     float radius = -1;
219:     for (const auto &value : stage.values())
220:       if (value.name == util::string("radius"))
221:         radius = float(value.value);
222:     if (!std::isfinite(radius) || radius < 0 ||
223:         (radius > 0 && !std::isfinite(1.0f / radius)))
224:       return programError(i, {PropError::ERROR_INVALID_VALUE, "radius"});
225:     candidate.radius = std::max(candidate.radius, radius);
226:     candidate.radii.append(radius);
227:     candidate.stages.append(std::move(stage));
228:   }
229:   output = std::move(candidate);
230:   return {};
231: }
232: 
233: ScopedBrushWorkingValues::ScopedBrushWorkingValues(
234:     Brush &brush, std::span<const PreparedBrushScalars> stages, bool executorOnly)
235:     : brush_(brush), executorOnly_(executorOnly), floatSize_(brush.namedFloats.size()),
236:       intSize_(brush.namedInts.size()), boolSize_(brush.namedBools.size()),
237:       cavityCurve_(brush.cavity_curve), unboundedExtent_(brush.unboundedExtent)
238: {
239:   for (const auto &stage : stages) {
240:     for (const auto &value : stage.values()) {
241:       if (executorOnly && !executorSetting(value.name))
242:         continue;
243:       bool found = false;
244:       for (const auto &known : saved_)
245:         found |= known.type == value.type && known.member == value.nativeMember &&
246:                  known.slot == value.storeSlot;
247:       if (found)
248:         continue;
249:       Saved saved{value.type, value.nativeMember, value.storeSlot};
250:       props::numtype_dispatch(value.type, [&]<typename P>() {
251:         using T = typename P::value_type;
252:         static_assert(sizeof(T) <= 4);
253:         if (value.nativeMember >= 0) {
254:           std::memcpy(
255:               saved.bytes.data(),
256:               Brush::builtinPropDescriptorSpan()[value.nativeMember].address(brush),
257:               sizeof(T));
258:         } else {
259:           const auto &store = [&]() -> const NamedUniformStore<T> & {
260:             if constexpr (std::is_same_v<T, float>)
261:               return brush.namedFloats;
262:             else if constexpr (std::is_same_v<T, int32_t>)
263:               return brush.namedInts;
264:             else
265:               return brush.namedBools;
266:           }();
267:           if (size_t(value.storeSlot) < store.size())
268:             std::memcpy(saved.bytes.data(), &store.values_[value.storeSlot], sizeof(T));
269:           saved.initialized = store.initialized(value.storeSlot);
270:         }
271:       });
272:       saved_.append(saved);
273:     }
274:   }
275: }
276: 
277: ScopedBrushWorkingValues::~ScopedBrushWorkingValues()
278: {
279:   brush_.cavity_curve = cavityCurve_;
280:   brush_.unboundedExtent = unboundedExtent_;
281:   for (const auto &saved : saved_) {
282:     props::numtype_dispatch(saved.type, [&]<typename P>() {
283:       using T = typename P::value_type;
284:       if (saved.member >= 0) {
285:         std::memcpy(Brush::builtinPropDescriptorSpan()[saved.member].address(brush_),
286:                     saved.bytes.data(),
287:                     sizeof(T));
288:       } else {
289:         auto &store = [&]() -> NamedUniformStore<T> & {
290:           if constexpr (std::is_same_v<T, float>)
291:             return brush_.namedFloats;
292:           else if constexpr (std::is_same_v<T, int32_t>)
293:             return brush_.namedInts;
294:           else
295:             return brush_.namedBools;
296:         }();
297:         if (size_t(saved.slot) < store.size()) {
298:           std::memcpy(&store.values_[saved.slot], saved.bytes.data(), sizeof(T));
299:           store.initialized_[saved.slot] = saved.initialized;
300:         }
301:       }
302:     });
303:   }
304:   if (executorOnly_)
305:     return;
306:   brush_.namedFloats.values_.resize(floatSize_);
307:   brush_.namedFloats.initialized_.resize(floatSize_);
308:   brush_.namedInts.values_.resize(intSize_);
309:   brush_.namedInts.initialized_.resize(intSize_);
310:   brush_.namedBools.values_.resize(boolSize_);
311:   brush_.namedBools.initialized_.resize(boolSize_);
312: }
