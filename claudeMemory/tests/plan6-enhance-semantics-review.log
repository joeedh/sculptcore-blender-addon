137: props::ScalarRegistrationResult programError(size_t index,
138:                                              props::ScalarRegistrationResult error)
139: {
140:   char prefix[64];
141:   std::snprintf(prefix, sizeof(prefix), "command[%zu].", index);
142:   error.name = util::string(prefix) + error.name;
