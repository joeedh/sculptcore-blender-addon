5: """
6: Dependency-free stroke geometry: centripetal Catmull-Rom to cubic Bezier,
7: Bezier evaluation and sub-curve extraction, and an arc-length walk that emits
8: points at even intervals with a carry threaded across segments.
9: 
10: Ported from the reference app's ``stroke_math.ts``. It is the pure-math layer
11: under ``StrokeSpacer``: given the raw 2D control points of a mouse path it
12: produces evenly spaced points along a smooth spline (centripetal alpha = 0.5
13: avoids the cusps and self-intersections a uniform Catmull-Rom makes on jittery
14: input). Points are plain tuples of floats; every routine is dimension-agnostic
15: (2D screen space is the only current caller, but the world-space slice helpers
16: work in 3D too), so this module imports nothing and is unit-testable on its own.
17: """
18: 
19: import math
20: 
21: # Below this, two control points are treated as coincident and their knot
22: # interval is nudged up so the centripetal tangents stay finite.
23: _EPS = 1e-9
24: 
25: 
26: def _sub(a, b):
27:     return tuple(x - y for x, y in zip(a, b))
28: 
29: 
30: def _add(a, b):
31:     return tuple(x + y for x, y in zip(a, b))
32: 
33: 
34: def _scale(a, s):
35:     return tuple(x * s for x in a)
36: 
37: 
38: def _lerp(a, b, t):
39:     return tuple(x + (y - x) * t for x, y in zip(a, b))
40: 
41: 
42: def _dist(a, b):
43:     return math.sqrt(sum((x - y) ** 2 for x, y in zip(a, b)))
44: 
45: 
46: def cr_to_bezier(p0, p1, p2, p3, alpha=0.5):
47:     """The centripetal Catmull-Rom segment from ``p1`` to ``p2`` as a cubic
48:     Bezier ``(b0, b1, b2, b3)``. ``p0``/``p3`` are the outer control points that
49:     define the endpoint tangents; clamp them to ``p1``/``p2`` at the ends of a
50:     path. ``alpha`` is the parameterization exponent (0 uniform, 0.5 centripetal,
51:     1 chordal); 0.5 is the cusp-free default."""
52:     # Knot spacing t_i = t_{i-1} + |p_i - p_{i-1}|**alpha, floored so coincident
53:     # points don't divide by zero.
54:     t0 = 0.0
55:     t1 = t0 + max(_dist(p0, p1) ** alpha, _EPS)
56:     t2 = t1 + max(_dist(p1, p2) ** alpha, _EPS)
57:     t3 = t2 + max(_dist(p2, p3) ** alpha, _EPS)
58: 
59:     # Non-uniform Catmull-Rom endpoint tangents (reduces to (p2-p0)/2 and
60:     # (p3-p1)/2 for uniform knots).
61:     m1 = _add(_add(_scale(_sub(p1, p0), 1.0 / (t1 - t0)),
62:                    _scale(_sub(p2, p0), -1.0 / (t2 - t0))),
63:               _scale(_sub(p2, p1), 1.0 / (t2 - t1)))
64:     m2 = _add(_add(_scale(_sub(p2, p1), 1.0 / (t2 - t1)),
65:                    _scale(_sub(p3, p1), -1.0 / (t3 - t1))),
66:               _scale(_sub(p3, p2), 1.0 / (t3 - t2)))
67: 
68:     # Hermite -> Bezier over the local interval [t1, t2] (length h): the Bezier
69:     # start tangent 3*(b1-b0) equals h*m1, so b1 = p1 + h/3 * m1.
70:     h = t2 - t1
71:     b1 = _add(p1, _scale(m1, h / 3.0))
72:     b2 = _sub(p2, _scale(m2, h / 3.0))
73:     return (tuple(p1), b1, b2, tuple(p2))
74: 
75: 
76: def eval_cubic(bez, t):
77:     """Evaluate the cubic Bezier ``bez`` at parameter ``t`` in [0, 1]."""
78:     b0, b1, b2, b3 = bez
79:     u = 1.0 - t
80:     c0 = u * u * u
81:     c1 = 3.0 * u * u * t
82:     c2 = 3.0 * u * t * t
83:     c3 = t * t * t
84:     return tuple(b0[i] * c0 + b1[i] * c1 + b2[i] * c2 + b3[i] * c3
85:                  for i in range(len(b0)))
86: 
87: 
88: def _split_cubic(bez, t):
89:     """De Casteljau split of ``bez`` at ``t`` into (left, right) cubics."""
90:     b0, b1, b2, b3 = bez
91:     ab = _lerp(b0, b1, t)
92:     bc = _lerp(b1, b2, t)
93:     cd = _lerp(b2, b3, t)
94:     abc = _lerp(ab, bc, t)
95:     bcd = _lerp(bc, cd, t)
96:     abcd = _lerp(abc, bcd, t)
97:     return (b0, ab, abc, abcd), (abcd, bcd, cd, b3)
98: 
99: 
100: def sub_cubic(bez, a, b):
101:     """The restriction of the cubic Bezier ``bez`` to the parameter interval
102:     ``[a, b]`` (0 <= a <= b <= 1), as a new cubic Bezier."""
103:     _, right = _split_cubic(bez, a)  # right spans [a, 1] reparameterized to [0, 1]
104:     span = 1.0 - a
105:     t = 0.0 if span <= _EPS else (b - a) / span
106:     left, _ = _split_cubic(right, t)  # left spans [a, b]
107:     return left
108: 
109: 
110: def arc_length_walk(bez, spacing, carry, chords=32, *, with_fractions=False):
111:     """Walk ``bez`` at even arc-length ``spacing``, returning
112:     ``(points, carry_out)``.
113: 
114:     ``carry`` is the arc length already accumulated toward the next point when
115:     this segment begins (0 at the very first segment); ``carry_out`` is the
116:     leftover past the last emitted point, to be threaded into the next segment's
117:     walk so cadence never clusters at a joint. Arc length is approximated with
118:     ``chords`` straight chords; the parameter is interpolated linearly inside the
119:     chord that contains each target distance. With ``with_fractions``, each point
120:     carries its traveled arc fraction within this segment."""
121:     if spacing <= 0.0:
122:         return [], carry
123: 
124:     # Sample the curve and build the cumulative chord-length table.
125:     pts = [eval_cubic(bez, i / chords) for i in range(chords + 1)]
126:     cum = [0.0] * (chords + 1)
127:     for i in range(chords):
128:         cum[i + 1] = cum[i] + _dist(pts[i], pts[i + 1])
129:     total = cum[chords]
130: 
131:     emitted = []
132:     # First target sits `spacing - carry` into this segment; then every spacing.
133:     target = spacing - carry
134:     seg = 0
135:     while target <= total + 1e-12:
136:         while seg < chords and cum[seg + 1] < target:
137:             seg += 1
138:         if seg >= chords:
139:             chord_len = cum[chords] - cum[chords - 1]
140:             frac = 1.0 if chord_len <= _EPS else (target - cum[chords - 1]) / chord_len
141:             t = (chords - 1 + frac) / chords
142:         else:
143:             chord_len = cum[seg + 1] - cum[seg]
144:             frac = 0.0 if chord_len <= _EPS else (target - cum[seg]) / chord_len
145:             t = (seg + frac) / chords
146:         point = eval_cubic(bez, min(max(t, 0.0), 1.0))
147:         fraction = min(1.0, max(0.0, target / total)) if total > 0 else 0.0
148:         emitted.append((point, fraction) if with_fractions else point)
149:         target += spacing
150: 
151:     # `target - spacing` is the arc position of the last emitted point (or
152:     # `-carry` if none emitted); the remainder becomes the next segment's carry.
153:     carry_out = total - (target - spacing)
154:     return emitted, carry_out
