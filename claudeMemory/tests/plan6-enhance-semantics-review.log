52: bool GridBrushExecutor::resolvedCapability(const brush_command &command,
53:                                            SculptBrushes type) const
54: {
55:   return !(
56:       (anchoredGrab && command.grabModeCapable) ||
57:       !resolvedAttributesSupported(
58:           {command.attrs.size() ? &command.attrs[0] : nullptr, command.attrs.size()}) ||
59:       command.faceMode || !maskStorageSupported(*this, command.writesMask) ||
60:       command.needsOrigNormals || (command.execHost && !command.preparedHostNoop) ||
61:       !command.preparedScalarSafe || !preparedHooksSupported(type, true) ||
62:       attrMirrors_.items.size() || attachedMultires_->editTarget() != -1 ||
63:       attachedMultires_->writebackChannel() != 0 || !resolvedFalloffSupported(*brush));
64: }
