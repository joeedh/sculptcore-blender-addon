96: int BrushProgram::removeCommandDynamicsChecked(int idx, util::string name, int scalarType)
97: {
98:   auto error = commandStackTarget(*this, idx, name, scalarType);
99:   if (error != PropError::ERROR_NONE)
100:     return int(error);
101:   Vector<BrushDynamicsOverride> candidate;
102:   for (const auto &item : commands[idx].dynamicsOverrides) {
103:     if (item.name == name) {
104:       if (item.type != Prop(scalarType))
105:         return int(PropError::ERROR_INVALID_TYPE);
106:     } else {
107:       candidate.append(item);
108:     }
109:   }
110:   commands[idx].dynamicsOverrides = std::move(candidate);
111:   return 0;
112: }
