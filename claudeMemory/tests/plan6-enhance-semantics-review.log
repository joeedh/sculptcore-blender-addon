187: struct Brush {
188:   props::StructProp props;
189:   props::DeviceInputCtx deviceInputCtx;
190: 
191:   float strength = 1;
192:   float radius = 1;
193:   /* Fraction of the brush *diameter* between successive dabs along a stroke,
194:    * i.e. BrushStrokeDriver walks `spacing * 2 * radius` per dab. */
195:   float spacing = 0.25f;
196:   /* Plane-brush offset along surfaceNo as a fraction of radius â€” places the
197:    * projection plane above/below the stroke surface point for the clay-family
198:    * (plane) kernels. Unused by the non-plane brushes. */
199:   float planeoff = 0.0f;
200:   /* Autosmooth amount. Synced from the TS brush for prop parity / inheritance,
201:    * but not read C++-side yet: the chained SMOOTH command is built bridge-side
202:    * (buildBrushProgram reads the TS value and emits a SMOOTH BrushProgram entry
203:    * â€” see brush_executor.h). 0 disables the chained smooth. */
204:   float autosmooth = 0.0f;
205:   /* Plane-brush active side: +1 pulls verts below the projection plane up onto
206:    * it (clay / fill), -1 pulls verts above it down onto it (scrape). Set per
207:    * tool by the bridge; read by the plane kernel as `ctx.brush.planeSide`. */
208:   float planeSide = 1.0f;
209:   bool invert = false;
210:   FalloffKind falloff_kind = FalloffKind::Smoothstep;
211:   FalloffShape falloff_shape = FalloffShape::Spherical;
212:   // Direction for `FalloffShape::Linear` and the primary axis of
213:   // `FalloffShape::Box` (expected normalized). Unused by the other shapes.
214:   // Default +Z keeps the value well-defined.
215:   float3 falloff_dir{0, 0, 1};
216:   // Per-axis half-extents (Ã—radius) for `FalloffShape::Box`, in the oriented
217:   // frame built from `falloff_dir` (extent[0] is along the stroke direction).
218:   // {1,1,1} makes Box an oriented cube. Unused by the other shapes.
219:   float3 falloff_extent{1, 1, 1};
220: 
221:   // Stroke tangent (current dab origin âˆ’ previous dab center), set host-side by
222:   // the executor each dab. Drives wing-scrape wing orientation and can feed the
223:   // oriented Box falloff via `falloff_dir`. Default +Z keeps it well-defined.
224:   float3 strokeDir{0, 0, 1};
225: 
226:   // When true, the host set `strokeDir` for this dab, so the executor must not
227:   // re-derive it from the shared stroke-path ring buffer â€” mirror-image dabs
228:   // supply their own reflected tangent. Reset per dab by the caller.
229:   bool strokeDirHostSet = false;
230: 
231:   // Wing-scrape: half-angle (radians) of each wing plane off the surface, plus
232:   // the two wing-plane normals (surfaceNo rotated Â±wingAngle about strokeDir),
233:   // recomputed per dab by the wingscrape kernel's host stage.
234:   float wingAngle = 0.3f;
235:   float3 wingNormalA{0, 0, 1};
236:   float3 wingNormalB{0, 0, 1};
237: 
238:   // Poly-group paint: the group id the polygroup kernel writes to faces under
239:   // the brush this stroke (read as the `activeGroup` uniform). Set host-side
240:   // per stroke; a plain member loadProps leaves untouched.
241:   int activeGroup = 1;
242: 
243:   // Color paint: the target color the color kernel lerps toward (read as the
244:   // `brushColor` uniform). Synced from the TS brush per stroke.
245:   float4 brushColor{1, 1, 1, 1};
246: 
247:   // Color paint blend mode (read as the `mixMode` uniform; see ColorMixModes /
248:   // color.sbrush). Synced from the TS brush per stroke. 0 = MIX (straight lerp).
249:   int mixMode = 0;
250: 
251:   // Brush texture (grayscale, row-major, `tex_width * tex_height` floats).
252:   // Empty means "no texture": `sampleTexBilinear` returns 1.0 so a kernel
253:   // multiplying by the sample is a no-op. `coord_space` maps a sample point
254:   // to UV; Global and ViewRepeat fract-wrap it (Global's tile spans world
255:   // [-1,1]^2); `tex_repeat` is tiles per viewport height under ViewRepeat.
256:   int tex_width = 0;
257:   int tex_height = 0;
258:   litestl::util::Vector<float> tex_pixels;
259:   TexCoordSpace coord_space = TexCoordSpace::Global;
260:   float tex_repeat = 1.0f;
261: 
262:   /** Runtime-compiled texture script (texture-scripts T3.4). When bound it
263:    * takes precedence over the bitmap texture in sampleBrushTex; the script
264:    * does its own point mapping, so `coord_space` does not apply to it. Owned
265:    * (freed by clearTextureScript / ~Brush); Brush is never copied. */
266:   TextureProgram *texture_program = nullptr;
267:   // Live param slab (`texture_program->paramSlabSize` floats), seeded from
268:   // the program's defaults at bind and edited via setTextureParamAt /
269:   // setTextureRampAt. Read by sampleBrushTex every eval.
270:   litestl::util::Vector<float> texture_params;
271:   // Last setTextureScript compile error; empty after a successful bind.
272:   litestl::util::string texture_script_error;
273: 
274:   // Ring buffer of recent stroke-dab centers, driving STROKE_CURVED texture
275:   // mapping. Pushed host-side as dabs advance (CommandExecutor::execBrush),
276:   // reset at the start of each stroke (CommandExecutor::beginStep). Uniform-
277:   // resident on CPU; the WGSL emitter mirrors it as a storage buffer.
278:   StrokeSample strokePath[kStrokePathMax];
279:   int strokePathCount = 0;
280: 
281:   // Kelvinlet brush uniforms â€” LamÃ©-style material constants. Live on Brush
282:   // (rather than only on CommandCtx) because they're authored alongside
283:   // strength/radius. Defaults match the kelvinlet paper's "soft rubber".
284:   float mu = 1.0f;
285:   float nu = 0.4f;
286: 
287:   // Cutoff radius of an `@unbounded` brush field, as a multiple of `radius`.
288:   // The kernel's `unbounded_window()` smoothsteps the field to exactly zero
289:   // over [0.8R, R] with R = radius * unboundedExtent, and the host sizes the
290:   // spatial-node filter radius from the same R â€” that pairing is what keeps a
291:   // field with unbounded support from tearing on a leaf boundary. Read by TS
292:   // (sculptcore_ops) so the constant lives in exactly one place.
293:   float unboundedExtent = 8.0f;
294: 
295:   // Pinch amount (0..1), synced from the TS brush (brush.pinch). Read by the
296:   // pinch / sharp kernels as the `@static` uniform `pinch` to scale the
297:   // toward-axis pull. A plain member loadProps leaves untouched.
298:   float pinch = 0.0f;
299:   // Smooth projection factor (0..1), synced from the TS brush (brush.smoothProj).
300:   // Read by bsmooth as `@static` uniform `projection`: the fraction of each
301:   // smoothing step's normal component removed, so the surface slides tangentially
302:   // instead of shrinking (volume preservation).
303:   float projection = 0.0f;
304:   // Rake amount (0..1), synced from the TS brush (brush.rake). Read by the
305:   // feature-align smooth kernel as the `@static` uniform `rake`: how strongly
306:   // edges aligned with the per-vertex cross field are up-weighted, biasing the
307:   // smooth so edge flow follows feature/curvature directions (topology rake).
308:   float rake = 0.0f;
309:   // Re-anchor corner UVs after tangential vertex motion (uv_reproject.h): the
310:   // executor reprojects each moved vertex's UVs on its pre-move 1-ring so
311:   // textures don't swim under smooth-family strokes. Host-set; not a uniform.
312:   bool reproject_uvs = false;
313: 
314:   // Cavity automasking (documentation/plans/2026-07-14-2007-cavity-automasking.md):
315:   // a per-vertex, per-stroke local-convexity factor multiplied into the effective
316:   // strength â€” distinct from the painted `mask`. Computed host-side (see
317:   // automask.h); `cavity_factor` scales it, `cavity_blur_steps` sets the BFS blur
318:   // radius, `cavity_inverted` masks concavities instead of convexities.
319:   bool automask_cavity = false;
320:   float cavity_factor = 1.0f;
321:   int cavity_blur_steps = 2;
322:   bool cavity_inverted = false;
323: 
324:   // View-normal automasking (documentation/plans/2026-07-25-1138-view-normal-
325:   // automasking.md): fade verts whose normal turns edge-on to the camera, where
326:   // a dab otherwise tears the silhouette. `view_normal_limit` / `_falloff` are
327:   // radians (see automask.h ViewNormalParams); `cull_backfaces` also zeroes
328:   // away-facing geometry. Defaults off in the engine so existing headless
329:   // scenes â€” which never set `viewDir` â€” are unchanged; the app turns it on.
330:   bool automask_view_normal = false;
331:   bool cull_backfaces = false;
332:   float view_normal_limit = kViewNormalLimitDefault;
333:   float view_normal_falloff = kViewNormalFalloffDefault;
334: 
335:   // Unit eye->surface ray in object space, host-set per dab (mirrored under
336:   // symmetry). Only read by the view-normal automask.
337:   float3 viewDir{0, 0, -1};
338: 
339:   // Enhance-details brush (source/brush/enhance.h): `enhance_rings` is the outer
340:   // smoothing depth (low-pass cutoff / feature scale); `enhance_inner` is the
341:   // inner depth â€” 0 = classic unsharp (high-pass), >=1 = difference-of-smooths
342:   // band-pass (default, rejects mesh noise).
343:   int enhance_rings = 4;
344:   int enhance_inner = 1;
345: 
346:   // Grab-style ctx state (kelvinlet, future pose). `grabFrom` is the stroke
347:   // origin captured at the start of the dab; `grabTo` is the current cursor.
348:   float3 grabFrom{0, 0, 0};
349:   float3 grabTo{0, 0, 0};
350: 
351:   // Pose-brush cage. `poseCageRest` is sampled when the dab starts; the DSL
352:   // displaces each vertex by a weighted sum of `poseCageNow[i] - poseCageRest[i]`
353:   // with weights = 1 / (1 + |v.co - poseCageRest[i]|Â²). Four anchors is the
354:   // tightest fit that still gives a smooth pose without needing a loop in
355:   // the DSL (Wave 4b has no `for`).
356:   float3 poseCageRest[4] = {};
357:   float3 poseCageNow[4] = {};
358: 
359:   // Authoring source of truth for the `Curve` falloff. Defaults to a
360:   // smoothstep so a brush switched to `Curve` without ever calling
361:   // `setFalloffCurvePreset` still produces the historical falloff shape.
362:   props::detail::curve::CurveGen falloffCurve{props::PropCurves::SMOOTHSTEP};
363: 
364:   // Baked output of `falloffCurve`, consulted when
365:   // `falloff_kind == FalloffKind::Curve`. Regenerated by `rebakeFalloff()`.
366:   std::array<float, kFalloffCurveSize> falloff_curve = [] {
367:     props::detail::curve::CurveGenSimple<props::PropCurves::SMOOTHSTEP> ss;
368:     return props::detail::curve::bake_curve_lut<kFalloffCurveSize>(ss);
369:   }();
370: 
371:   // expose falloffCurveSize to TS bridge
372:   float falloffCurveSize = kFalloffCurveSize;
373:   void setFalloffCurveEntry(int i, float f)
374:   {
375:     falloff_curve[i] = f;
376:   }
377: 
378:   bool replaceFalloffCurveChecked(util::Vector<float> &samples);
379:   bool replaceCavityCurveChecked(util::Vector<float> &samples);
380: 
381:   // Cavity-automask curve LUT (size must equal automask.h kCavityCurveSize = 256;
382:   // a static_assert in the executor pins the two together). Reshapes the linear
383:   // cavity factor when `cavity_use_curve` is set; the TS bridge bakes it entry by
384:   // entry via setCavityCurveEntry, exactly like the falloff curve. Defaults to a
385:   // straight ramp (identity), so enabling the curve without authoring one is a
386:   // no-op. Only consulted when cavity_use_curve is set, so the array default is
387:   // fine for the common (curve-off) case.
388:   static constexpr int kCavityCurveLutSize = 256;
389:   bool cavity_use_curve = false;
390:   std::array<float, kCavityCurveLutSize> cavity_curve = [] {
391:     std::array<float, kCavityCurveLutSize> a{};
392:     for (int i = 0; i < kCavityCurveLutSize; i++) {
393:       a[i] = float(i) / float(kCavityCurveLutSize - 1);
394:     }
395:     return a;
396:   }();
397:   float cavityCurveSize = kCavityCurveLutSize;
398:   void setCavityCurveEntry(int i, float f)
399:   {
400:     if (i >= 0 && i < kCavityCurveLutSize) {
401:       cavity_curve[i] = f;
402:     }
403:   }
