66:               int(PropError::ERROR_NONE));
67:   test_assert(program.commands[0].cavityCurveOverride[7] == 7.0f / 255);
68:   test_assert(program.removeCommandCavityCurveChecked(-1) != int(PropError::ERROR_NONE));
69:   std::span<const BrushUniformManifestEntry> manifests[2] = {};
