89: template <class Executor, class Source, class Co>
90: static void
91: cavityExecutionCases(Executor &ex, Brush &brush, Source source, Co co, int count)
92: {
93:   const float3 center(0, 0, 1), normal(0, 0, 1);
94:   BrushProgram program;
95:   program.addCommand(int(SculptBrushes::DRAW));
96:   program.addCommand(int(SculptBrushes::DRAW));
97:   // A disabled large first command must not claim first contact for the small cavity
98:   // command.
99:   program.setCommandFloat(0, int(BrushProp::Radius), 3);
100:   program.setCommandFloat(0, int(BrushProp::Strength), 0);
101:   program.setCommandFloat(1, int(BrushProp::Radius), .9f);
102:   program.setCommandFloat(1, int(BrushProp::Strength), 0);
103:   program.setCommandScalarChecked(1, "automask_cavity", props::Prop::BOOL, 1);
104:   program.setCommandScalarChecked(1, "cavity_factor", props::Prop::FLOAT32, .7);
105:   auto run = [&](float3 position = float3(0, 0, 1)) {
106:     test_assert(ex.applyResolvedProgram(&program, position, normal).error ==
107:                 PropError::ERROR_NONE);
108:     test_assert(!brush.automask_cavity && brush.cavity_factor == 1.0f &&
109:                 !ex.preparedCavityActive);
110:   };
111:   run(float3(100));
112:   test_assert(ex.preparedCavity.configurations() == 0);
113:   run();
114:   test_assert(ex.preparedCavity.configurations() == 1);
115:   size_t contacts = 0;
116:   CavityParams params;
117:   params.enabled = true;
118:   params.factor = .7f;
119:   params.blur_steps = brush.cavity_blur_steps;
120:   params.inverted = brush.cavity_inverted;
121:   params.use_curve = brush.cavity_use_curve;
122:   params.curve_lut = brush.cavity_curve.data();
123:   CavityScratch scratch;
124:   std::vector<float> first(count, -1);
125:   for (int v = 0; v < count; v++) {
126:     if ((co(v) - center).length() / .9f < 1) {
127:       contacts++;
128:       first[v] = cavityRemap(params, cavityRawT(source, v, params.blur_steps, scratch));
129:       test_assert((*ex.preparedCavity.active())[v] == first[v]);
130:     }
131:   }
132:   test_assert(contacts > 0 && ex.preparedCavity.evaluations() == contacts &&
133:               ex.preparedCavity.storedFactors() == contacts);
134:   run();
135:   test_assert(ex.preparedCavity.evaluations() == contacts);
136:   // Alter only neighboring geometry, then revisit A through B: A remains first-contact
137:   // frozen.
138:   for (int v = 0; v < count; v++)
139:     co(v)[2] += .015f * float((v % 5) - 2);
140:   std::vector<float> expectedB(count, -1);
141:   size_t newA = 0, contactsB = 0;
142:   for (int v = 0; v < count; v++) {
143:     if ((co(v) - center).length() / .9f >= 1)
144:       continue;
145:     const float raw = cavityRawT(source, v, params.blur_steps, scratch);
146:     if (first[v] < 0) {
147:       first[v] = cavityRemap(params, raw);
148:       newA++;
149:     }
150:     params.factor = .8f;
151:     expectedB[v] = cavityRemap(params, raw);
152:     params.factor = .7f;
153:     contactsB++;
154:   }
155:   program.setCommandScalarChecked(1, "cavity_factor", props::Prop::FLOAT32, .8);
156:   run();
157:   test_assert(ex.preparedCavity.configurations() == 2);
158:   const auto afterB = ex.preparedCavity.evaluations();
159:   test_assert(afterB == contacts + contactsB);
160:   for (int v = 0; v < count; v++)
161:     if (expectedB[v] >= 0)
162:       test_assert((*ex.preparedCavity.active())[v] == expectedB[v]);
163:   program.setCommandScalarChecked(1, "cavity_factor", props::Prop::FLOAT32, .7);
164:   run();
165:   for (int v = 0; v < count; v++)
166:     if (first[v] >= 0 && (co(v) - center).length() / .9f < 1)
167:       test_assert((*ex.preparedCavity.active())[v] == first[v]);
168:   const auto afterA = ex.preparedCavity.evaluations();
169:   test_assert(afterA == afterB + newA);
170:   run();
171:   test_assert(ex.preparedCavity.evaluations() == afterA);
172:   // Every configuration field participates in identity, including a disabled curve's
173:   // samples.
174:   for (const auto &override :
175:        std::initializer_list<BrushScalarOverride>{
176:            {"cavity_blur_steps", props::Prop::INT32, 3},
177:            {"cavity_inverted", props::Prop::BOOL, 1},
178:            {"cavity_use_curve", props::Prop::BOOL, 1}})
179:   {
180:     const auto configs = ex.preparedCavity.configurations();
181:     program.setCommandScalarChecked(1, override.name, override.type, override.value);
182:     run();
183:     test_assert(ex.preparedCavity.configurations() == configs + 1);
184:   }
185:   const auto oldCurve = brush.cavity_curve;
186:   brush.cavity_curve[4] += .01f;
187:   const auto configs = ex.preparedCavity.configurations();
188:   run();
189:   test_assert(ex.preparedCavity.configurations() == configs + 1 &&
190:               brush.cavity_curve[4] == oldCurve[4] + .01f);
191:   // A malformed later command fails before any cache or topology work.
192:   const auto evaluations = ex.preparedCavity.evaluations();
193:   program.commands[1].cavityCurveOverride.append(0);
194:   test_assert(ex.applyResolvedProgram(&program, center, normal).error ==
195:               PropError::ERROR_INVALID_VALUE);
196:   test_assert(ex.preparedCavity.evaluations() == evaluations && !ex.preparedCavityActive);
197: }
