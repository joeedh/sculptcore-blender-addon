252:   int checkedUniformName(int token, int index, int scalarType, string &name) const
253:   {
254:     if (token <= 0 || token != uniformQueryToken_ || querySource_ != this || !brush ||
255:         brush != queryBrush_ || brush->props.struct_def != queryStruct_)
256:     {
257:       return int(props::PropError::ERROR_STALE_QUERY);
258:     }
259:     if (index < 0 || index >= int(canonicalUniforms_.size())) {
260:       return int(props::PropError::ERROR_NOT_EXISTS);
261:     }
262:     const auto &entry = canonicalUniforms_[index];
263:     if (scalarType != int(entry.scalarType)) {
264:       return int(props::PropError::ERROR_INVALID_TYPE);
265:     }
266:     name = entry.name;
267:     return 0;
268:   }
