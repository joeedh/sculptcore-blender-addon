464:   /** Describe native member storage and semantic dynamics eligibility. */
465:   static std::span<const BrushMemberDescriptor> builtinPropDescriptorSpan()
466:   {
467: #define BRUSH_MEMBER(member, eligible)                                                   \
468:   [] {                                                                                   \
469:     static_assert(brushMemberType<decltype(member)>() != props::Prop::INVALID_TYPE);     \
470:     return BrushMemberDescriptor{                                                        \
471:         #member,                                                                         \
472:         brushMemberType<decltype(member)>(),                                             \
473:         eligible,                                                                        \
474:         std::is_array_v<decltype(member)>                                                \
475:             ? brushMemberType<std::remove_extent_t<decltype(member)>>()                  \
476:             : props::Prop::INVALID_TYPE,                                                 \
477:         int(std::extent_v<decltype(member)>),                                            \
478:         [](Brush &brush) -> void * { return &brush.member; }};                           \
479:   }()
480:     static const BrushMemberDescriptor members[] = {
481:         BRUSH_MEMBER(strength, true),
482:         BRUSH_MEMBER(radius, true),
483:         BRUSH_MEMBER(spacing, true),
484:         BRUSH_MEMBER(planeoff, true),
485:         BRUSH_MEMBER(planeSide, false),
486:         BRUSH_MEMBER(autosmooth, true),
487:         BRUSH_MEMBER(invert, true),
488:         BRUSH_MEMBER(strokeDir, false),
489:         BRUSH_MEMBER(wingAngle, true),
490:         BRUSH_MEMBER(wingNormalA, false),
491:         BRUSH_MEMBER(wingNormalB, false),
492:         BRUSH_MEMBER(activeGroup, false),
493:         BRUSH_MEMBER(brushColor, false),
494:         BRUSH_MEMBER(mixMode, false),
495:         BRUSH_MEMBER(mu, true),
496:         BRUSH_MEMBER(nu, true),
497:         BRUSH_MEMBER(unboundedExtent, true),
498:         BRUSH_MEMBER(pinch, true),
499:         BRUSH_MEMBER(projection, true),
500:         BRUSH_MEMBER(rake, true),
501:         BRUSH_MEMBER(grabFrom, false),
502:         BRUSH_MEMBER(grabTo, false),
503:         BRUSH_MEMBER(poseCageRest, false),
504:         BRUSH_MEMBER(poseCageNow, false),
505:         BRUSH_MEMBER(automask_cavity, false),
506:         BRUSH_MEMBER(cavity_factor, false),
507:         BRUSH_MEMBER(cavity_blur_steps, false),
508:         BRUSH_MEMBER(cavity_inverted, false),
509:         BRUSH_MEMBER(cavity_use_curve, false),
510:         BRUSH_MEMBER(automask_view_normal, false),
511:         BRUSH_MEMBER(cull_backfaces, false),
512:         BRUSH_MEMBER(view_normal_limit, false),
513:         BRUSH_MEMBER(view_normal_falloff, false),
514:     };
515: #undef BRUSH_MEMBER
516:     return {members, sizeof(members) / sizeof(members[0])};
517:   }
518: 
519:   static void builtinPropDescriptors(litestl::util::Vector<BrushMemberDescriptor> &out)
520:   {
521:     for (const auto &member : builtinPropDescriptorSpan()) {
522:       out.append(member);
523:     }
524:   }
525: 
526:   static void builtinPropNames(litestl::util::Vector<litestl::util::string> &out)
527:   {
528:     litestl::util::Vector<BrushMemberDescriptor> descriptors;
529:     builtinPropDescriptors(descriptors);
530:     for (const auto &descriptor : descriptors) {
531:       out.append(litestl::util::string(descriptor.name));
532:     }
533:   }
