12: /**
13:  * Enhance-details brush (difference-of-smooths, band-pass).
14:  *
15:  * Amplifies surface relief by adding a high-/band-pass of the position field
16:  * along a smoothed normal. Two ring-walk low-passes are built per vertex:
17:  *   S_inner = mean position within `inner` rings   (the sharp reference)
18:  *   S_outer = mean position within `rings`  rings   (the base surface)
19:  * and the per-vertex enhance vector is
20:  *   E = dot(S_inner - S_outer, n̂) * n̂          (n̂ = smoothed normal)
21:  * `inner == 0` makes S_inner the raw vertex → classic unsharp (high-pass, keeps
22:  * mesh noise); `inner >= 1` is a difference-of-smooths band-pass that rejects
23:  * both per-vertex noise and coarse form (the default). The kernel then applies
24:  * `v.co += E * strength`.
25:  *
26:  * E is computed host-side (the N-ring BFS can't live in a 1-ring kernel) and
27:  * cached per stroke in the `.brush.enhance.disp` TEMP attr, keyed by strokeGen
28:  * via `.brush.enhance.gen` — the cavity/feature-align pattern. CPU-only, like
29:  * feature-align.
30:  */
31: namespace sculptcore::brush {
32: using litestl::math::float3;
33: 
34: inline constexpr const char *ENHANCE_DISP_ATTR = ".brush.enhance.disp";
35: inline constexpr const char *ENHANCE_GEN_ATTR = ".brush.enhance.gen";
36: 
37: struct EnhanceParams {
38:   // Outer smoothing depth (N) — the low-pass cutoff / feature scale.
39:   int rings = 4;
40:   // Inner smoothing depth (m): 0 = classic unsharp (high-pass), >=1 = difference-
41:   // of-smooths band-pass (default; rejects per-vertex noise). Clamped to < rings.
42:   int inner = 1;
43: };
44: 
45: /** Reusable BFS scratch: a monotonic-token visited set sized to the vertex
46:  * capacity plus two frontier buffers, so the region fill allocates once. */
47: struct EnhanceScratch {
48:   litestl::util::Vector<uint32_t> visitStamp;
49:   uint32_t token = 0;
50:   litestl::util::Vector<int> frontier;
51:   litestl::util::Vector<int> nextFrontier;
52: 
53:   void ensure(int vertCap)
54:   {
55:     if (int(visitStamp.size()) < vertCap) {
56:       visitStamp.resize(vertCap);
57:       for (int i = 0; i < vertCap; i++) {
58:         visitStamp[i] = 0;
59:       }
60:     }
61:   }
62: };
63: 
64: /**
65:  * Per-vertex enhance displacement (difference-of-smooths, projected on the
66:  * smoothed normal). BFS-walks the ring1 CSR out to `rings`, averaging position
67:  * over the inner and outer neighborhoods (both include the center) and the
68:  * normal over the outer one. Requires `m->topo_cache.ring1` current. Returns 0
69:  * for degenerate neighborhoods.
70:  */
71: inline float3
72: computeEnhanceDisp(mesh::Mesh *m, int v0, const EnhanceParams &p, EnhanceScratch &scr)
73: {
74:   const mesh::VertNbrCSR &csr = m->topo_cache.ring1;
75:   if (int(csr.offsets.size()) <= v0 + 1) {
76:     return float3{0, 0, 0};
77:   }
78: 
79:   int inner = p.inner < 0 ? 0 : p.inner;
80:   int outer = p.rings < 1 ? 1 : p.rings;
81:   if (inner > outer) {
82:     inner = outer;
83:   }
84: 
85:   scr.ensure(m->v.count);
86:   scr.token++;
87:   const uint32_t tok = scr.token;
88: 
89:   float3 innerSum{0, 0, 0}, outerSum{0, 0, 0}, normalSum{0, 0, 0};
90:   int innerCount = 0, outerCount = 0;
91: 
92:   auto visit = [&](int idx, int depth) {
93:     const float3 co = m->v.co[idx];
94:     outerSum += co;
95:     normalSum += m->v.no[idx];
96:     outerCount++;
97:     if (depth <= inner) {
98:       innerSum += co;
99:       innerCount++;
100:     }
101:   };
102: 
103:   scr.frontier.clear();
104:   scr.visitStamp[v0] = tok;
105:   scr.frontier.append(v0);
106:   visit(v0, 0);
107: 
108:   for (int depth = 1; depth <= outer; depth++) {
109:     scr.nextFrontier.clear();
110:     for (int u : scr.frontier) {
111:       uint32_t off = csr.offsets[u];
112:       uint32_t end = csr.offsets[u + 1];
113:       for (uint32_t k = off; k < end; k++) {
114:         int nb = csr.nbr_verts[k];
115:         if (scr.visitStamp[nb] == tok) {
116:           continue;
117:         }
118:         scr.visitStamp[nb] = tok;
119:         scr.nextFrontier.append(nb);
120:         visit(nb, depth);
121:       }
122:     }
123:     std::swap(scr.frontier, scr.nextFrontier);
124:     if (scr.frontier.size() == 0) {
125:       break;
126:     }
127:   }
128: 
129:   if (innerCount == 0 || outerCount == 0) {
130:     return float3{0, 0, 0};
131:   }
132: 
133:   float3 sInner = innerSum / float(innerCount);
134:   float3 sOuter = outerSum / float(outerCount);
135: 
136:   float3 nrm = normalSum;
137:   float nlen = nrm.length();
138:   nrm = nlen > 1e-6f ? nrm / nlen : m->v.no[v0];
139: 
140:   float3 detail = sInner - sOuter;
141:   return nrm * detail.dot(nrm);
142: }
143: 
144: /**
145:  * Fill `.brush.enhance.disp` for `verts` (the dab region) with the per-vertex
146:  * enhance vector, once per stroke (gated by `.brush.enhance.gen == strokeGen`).
147:  * Ensures the two TEMP attrs and the ring1 CSR. Call from the executor before
148:  * the ENHANCE kernel, while topology is live.
149:  */
150: inline void updateEnhanceRegion(mesh::Mesh &m,
151:                                 const litestl::util::Vector<int> &verts,
152:                                 const EnhanceParams &params,
153:                                 uint32_t strokeGen)
154: {
155:   m.topo_cache.ensureRing1(m);
156: 
157:   mesh::AttrRef &dispRef =
158:       m.v.attrs.ensure(mesh::AttrType::FLOAT3, ENHANCE_DISP_ATTR, false);
159:   dispRef.flag |= mesh::AttrFlag::TEMP | mesh::AttrFlag::NOCOPY;
160:   mesh::AttrRef &genRef = m.v.attrs.ensure(mesh::AttrType::INT, ENHANCE_GEN_ATTR, false);
161:   genRef.flag |= mesh::AttrFlag::TEMP | mesh::AttrFlag::NOCOPY;
162:   auto *disp = static_cast<mesh::AttrData<float3> *>(dispRef.data);
163:   auto *gen = static_cast<mesh::AttrData<int> *>(genRef.data);
164: 
165:   EnhanceScratch scr;
166:   for (int v : verts) {
167:     gen->materialize(v);
168:     disp->materialize(v);
169:     if (strokeGen == 0 || (*gen)[v] != int(strokeGen)) {
170:       (*disp)[v] = computeEnhanceDisp(&m, v, params, scr);
171:       (*gen)[v] = int(strokeGen);
172:     }
173:   }
174: }
175: 
176: } // namespace sculptcore::brush
