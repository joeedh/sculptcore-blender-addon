33:   property.dynamics.configure(props::DeviceType::PRESSURE, math::BasicMix::MULTIPLY, 1);
34:   test_assert(prepare() == PropError::ERROR_INVALID_DYNAMICS);
35:   property.dynamics.devices.clear();
36:   brush.cavity_blur_steps = -1;
37:   test_assert(prepare() == PropError::ERROR_INVALID_VALUE);
38:   brush.cavity_blur_steps = INT32_MAX;
39:   test_assert(prepare() == PropError::ERROR_INVALID_VALUE);
40:   brush.cavity_blur_steps = 3;
41:   brush.cavity_curve[7] = std::numeric_limits<float>::quiet_NaN();
42:   test_assert(!brush.automask_cavity && prepare() == PropError::ERROR_INVALID_VALUE);
43:   brush.cavity_curve[7] = .125f;
44: 
45:   BrushProgram program;
46:   program.addCommand(int(SculptBrushes::DRAW));
47:   program.addCommand(int(SculptBrushes::DRAW));
48:   test_assert(program.setCommandScalarChecked(
49:                   0, "automask_cavity", props::Prop::BOOL, 1) == PropError::ERROR_NONE);
50:   test_assert(
51:       program.setCommandScalarChecked(0, "cavity_factor", props::Prop::FLOAT32, 2.5) ==
