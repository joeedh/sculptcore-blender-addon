2305:   /** Anchored/Drag Dot live preview: snapshot the region the next preview-only
2306:    * applyDab() is about to touch (see MeshLog::beginPreviewDab). Call
2307:    * immediately before that dab (the primary/first dab of a driver tick; use
2308:    * extendPreviewDab() for any symmetry mirror images of the same tick).
2309:    * Roll the whole group back with rollbackPreviewDab() before the next
2310:    * tick's dabs, or keep it with commitPreviewDab() at stroke end. */
2311:   void beginPreviewDab(float3 center, float radius)
2312:   {
2313:     if (!meshLog || !tree) {
2314:       return;
2315:     }
2316:     meshLog->beginPreviewDab(tree->m, tree, center, radius);
2317:   }
2318: 
2319:   /** Add another region to the currently-open preview session (a mirror
2320:    * image of the same driver tick) without resetting it â€” the whole group
2321:    * rolls back together via one rollbackPreviewDab(). See
2322:    * MeshLog::extendPreviewDab. */
2323:   void extendPreviewDab(float3 center, float radius)
2324:   {
2325:     if (!meshLog || !tree) {
2326:       return;
2327:     }
2328:     meshLog->extendPreviewDab(tree->m, tree, center, radius);
2329:   }
2330: 
2331:   /** Undo the most recent preview dab (topology pop-and-undo + position/attr
2332:    * restore) without closing the step. See MeshLog::rollbackPreviewDab. */
2333:   void rollbackPreviewDab()
2334:   {
2335:     if (!meshLog || !tree) {
2336:       return;
2337:     }
2338:     meshLog->rollbackPreviewDab(tree->m, tree);
2339:   }
2340: 
2341:   /** True if a preview snapshot is pending rollback (diagnostic / debug-app use). */
2342:   bool previewActive() const
2343:   {
2344:     return meshLog && meshLog->previewActive();
2345:   }
2346: 
2347:   /** Keep the pending preview dab's effect and drop its snapshot bookkeeping.
2348:    * Call once at the true end of an Anchored/Drag Dot stroke (after the last
2349:    * dab, instead of a paired rollback) so previewActive() doesn't leak into
2350:    * the next stroke's step. See MeshLog::commitPreviewDab. */
2351:   void commitPreviewDab()
2352:   {
2353:     if (!meshLog) {
2354:       return;
2355:     }
2356:     meshLog->commitPreviewDab();
2357:   }
