182: props::ScalarRegistrationResult GridBrushExecutor::applyResolvedDab(
183:     SculptBrushes brushType, float3 origin, float3 normal, bool validateOnly)
184: {
185:   using props::PropError;
186:   auto fail = [&](PropError error, const char *name) {
187:     lastRegistration = {error, name};
188:     return lastRegistration;
189:   };
190:   lastRegistration = resolvedState(origin, normal);
191:   if (lastRegistration.error != PropError::ERROR_NONE)
192:     return lastRegistration;
193:   brush_command command;
194:   if (!createPreparedCommand(brushType, command)) {
195:     return fail(PropError::ERROR_NOT_EXISTS, "kernel");
196:   }
197:   if (!resolvedCapability(command, brushType)) {
198:     return fail(PropError::ERROR_INVALID_VALUE, "unsupported resolved capability");
199:   }
200:   PreparedBrushScalars prepared;
201:   lastRegistration =
202:       prepareBrushScalars(*brush,
203:                           {command.uniforms.data(), command.uniforms.size()},
204:                           brush->deviceInputCtx,
205:                           prepared);
206:   if (lastRegistration.error != PropError::ERROR_NONE) {
207:     return lastRegistration;
208:   }
209:   float radius = -1;
210:   for (const auto &value : prepared.values()) {
211:     if (value.name == string("radius")) {
212:       radius = float(value.value);
213:     }
214:   }
215:   if (!std::isfinite(radius) || radius < 0 ||
216:       (radius > 0 && !std::isfinite(1.0f / radius)))
217:   {
218:     return fail(PropError::ERROR_INVALID_VALUE, "radius");
219:   }
220:   if (command.unbounded) {
221:     lastRegistration = validateUnboundedSupport(prepared, radius);
222:     if (lastRegistration.error != PropError::ERROR_NONE)
223:       return lastRegistration;
224:   }
225:   if (validateOnly)
226:     return {};
227:   ScopedBrushWorkingValues executorSettings(*brush, {&prepared, 1}, true);
228:   lastRegistration = prepared.publish(*brush);
229:   if (lastRegistration.error != PropError::ERROR_NONE) {
230:     return lastRegistration;
231:   }
232:   stats.dabs++;
233:   dabMoved_.clear();
234:   dabGrids_.clear();
235:   dabLeaves_.clear();
236:   nodePtrs_.clear();
237:   if (radius > 0 && queryDabLeaves(false, radius, origin, command.unbounded)) {
238:     updateStrokeFrame(origin);
239:     brush->pushStrokeSample(origin, normal);
240:     dabSeq_++;
241:     ScopedPreparedCavity cavityScope(preparedCavityActive);
242:     execStage(command, origin, normal);
243:     finishDab();
244:   }
245:   isFirstOfStep = false;
246:   return {};
247: }
248: 
249: props::ScalarRegistrationResult GridBrushExecutor::applyResolvedProgram(
250:     BrushProgram *program, float3 origin, float3 normal, bool validateOnly)
251: {
252:   using props::PropError;
253:   lastRegistration = resolvedState(origin, normal);
254:   if (lastRegistration.error != PropError::ERROR_NONE)
255:     return lastRegistration;
256:   if (!program) {
257:     lastRegistration = {PropError::ERROR_INVALID_OWNER, "program"};
258:     return lastRegistration;
259:   }
260:   if (!program->commands.size()) {
261:     PreparedBrushScalars empty;
262:     lastRegistration = prepareBrushScalars(*brush, {}, brush->deviceInputCtx, empty);
263:     if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
264:       return lastRegistration;
265:     stats.dabs++;
266:     dabMoved_.clear();
267:     dabGrids_.clear();
268:     dabLeaves_.clear();
269:     nodePtrs_.clear();
270:     isFirstOfStep = false;
271:     return {};
272:   }
273:   Vector<brush_command> commands;
274:   commands.resize(program->commands.size());
275:   Vector<std::span<const BrushUniformManifestEntry>> manifests;
276:   for (size_t i = 0; i < program->commands.size(); i++) {
277:     const auto &entry = program->commands[i];
278:     auto &command = commands[i];
279:     if (!createPreparedCommand(entry.type, command)) {
280:       lastRegistration = programError(i, {PropError::ERROR_NOT_EXISTS, "kernel"});
281:       return lastRegistration;
282:     }
283:     if (entry.attrLayerOverrides.size() || !resolvedCapability(command, entry.type)) {
284:       lastRegistration = programError(
285:           i, {PropError::ERROR_INVALID_VALUE, "unsupported resolved capability"});
286:       return lastRegistration;
287:     }
288:     manifests.append({command.uniforms.data(), command.uniforms.size()});
289:   }
290:   PreparedProgramScalars prepared;
291:   lastRegistration = prepareProgramScalars(*brush,
292:                                            *program,
293:                                            {manifests.data(), manifests.size()},
294:                                            brush->deviceInputCtx,
295:                                            prepared);
296:   if (lastRegistration.error != PropError::ERROR_NONE)
297:     return lastRegistration;
298:   bool allLeaves = false;
299:   for (size_t i = 0; i < commands.size(); i++) {
300:     if (!commands[i].unbounded)
301:       continue;
302:     lastRegistration =
303:         programError(i, validateUnboundedSupport(prepared.stages[i], prepared.radii[i]));
304:     if (lastRegistration.error != PropError::ERROR_NONE)
305:       return lastRegistration;
306:     allLeaves |= prepared.radii[i] > 0;
307:   }
308:   lastRegistration = {};
309:   if (validateOnly)
310:     return {};
311:   stats.dabs++;
312:   dabMoved_.clear();
313:   dabGrids_.clear();
314:   dabLeaves_.clear();
315:   nodePtrs_.clear();
316:   if (prepared.radius > 0 && queryDabLeaves(false, prepared.radius, origin, allLeaves)) {
317:     ScopedBrushWorkingValues working(*brush,
318:                                      {prepared.stages.data(), prepared.stages.size()});
319:     updateStrokeFrame(origin);
320:     brush->pushStrokeSample(origin, normal);
321:     dabSeq_++;
322:     ScopedPreparedCavity cavityScope(preparedCavityActive);
323:     for (size_t i = 0; i < commands.size(); i++) {
324:       if (prepared.radii[i] == 0)
325:         continue;
326:       prepared.stages[i].applyWorking(*brush);
327:       execStage(commands[i], origin, normal);
328:     }
329:     finishDab();
330:   }
331:   isFirstOfStep = false;
332:   return {};
333: }
