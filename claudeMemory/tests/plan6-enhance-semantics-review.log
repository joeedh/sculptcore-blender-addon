285: bool resolvedFalloffSupported(const Brush &brush)
286: {
287:   if (brush.falloff_shape != FalloffShape::Spherical)
288:     return false;
289:   if (brush.falloff_kind == FalloffKind::Smoothstep ||
290:       brush.falloff_kind == FalloffKind::Linear)
291:     return true;
292:   if (brush.falloff_kind != FalloffKind::Curve || brush.falloff_curve[0] != 0.0f)
293:     return false;
294:   for (float value : brush.falloff_curve)
295:     if (!std::isfinite(value) || value < 0.0f || value > 1.0f)
296:       return false;
297:   return true;
298: }
