143: props::ScalarRegistrationResult CommandExecutor::applyResolvedDab(SculptBrushes brushType,
144:                                                                   float3 center,
145:                                                                   float3 normal,
146:                                                                   bool validateOnly)
147: {
148:   using props::PropError;
149:   auto fail = [&](PropError error, const char *name) {
150:     lastRegistration = {error, name};
151:     return lastRegistration;
152:   };
153:   if (!preparedStepValid() || !brush || !tree || !tree->m || !tree->getRoot()) {
154:     return fail(PropError::ERROR_INVALID_OWNER, "mesh");
155:   }
156:   for (int axis = 0; axis < 3; axis++) {
157:     if (!std::isfinite(center[axis]) || !std::isfinite(normal[axis])) {
158:       return fail(PropError::ERROR_INVALID_VALUE, "dab frame");
159:     }
160:   }
161:   brush_command command;
162:   if (!createPreparedCommand(brushType, command)) {
163:     return fail(PropError::ERROR_NOT_EXISTS, "kernel");
164:   }
165:   // These modes need additional region, host-state or attribute preflight.
166:   // Generated host stages may themselves change radius/center after selection.
167:   if (!resolvedCapability(*this, command, brushType)) {
168:     return fail(PropError::ERROR_INVALID_VALUE, "unsupported resolved capability");
169:   }
170:   PreparedBrushScalars prepared;
171:   lastRegistration =
172:       prepareBrushScalars(*brush,
173:                           {command.uniforms.data(), command.uniforms.size()},
174:                           brush->deviceInputCtx,
175:                           prepared);
176:   if (lastRegistration.error != PropError::ERROR_NONE) {
177:     return lastRegistration;
178:   }
179:   float radius = -1;
180:   for (const auto &value : prepared.values()) {
181:     if (value.name == string("radius")) {
182:       radius = float(value.value);
183:     }
184:   }
185:   if (!std::isfinite(radius) || radius < 0 ||
186:       (radius > 0 && !std::isfinite(1.0f / radius)))
187:   {
188:     return fail(PropError::ERROR_INVALID_VALUE, "radius");
189:   }
190:   // No callbacks or yields between preparation and publication. The exact
191:   // scratch command above executes below; no live factory or legacy loader.
192:   if (command.unbounded) {
193:     lastRegistration = validateUnboundedSupport(prepared, radius);
194:     if (lastRegistration.error != PropError::ERROR_NONE)
195:       return lastRegistration;
196:   }
197:   if (validateOnly)
198:     return {};
199:   ScopedBrushWorkingValues executorSettings(*brush, {&prepared, 1}, true);
200:   lastRegistration = prepared.publish(*brush);
201:   if (lastRegistration.error != PropError::ERROR_NONE) {
202:     return lastRegistration;
203:   }
204:   dabNodes_.clear();
205:   if (radius > 0) {
206:     if (command.unbounded) {
207:       for (auto *node : tree->leaves())
208:         if (node->data && node->data->unique_verts.size())
209:           dabNodes_.append(node);
210:     } else {
211:       tree->filterNodes(center, radius, dabNodes_);
212:     }
213:   }
214:   lastDabNodeCount = int(dabNodes_.size());
215:   if (dabNodes_.size()) {
216:     auto *mesh = tree->m;
217:     if (const auto *hooks = brushHooksFor(brushType); hooks && hooks->stepPreFreeze) {
218:       BrushHookCtx hc{*this, mesh, &dabNodes_, brush, isFirstOfStep};
219:       hooks->stepPreFreeze(hc);
220:     }
221:     if (brush->automask_cavity) {
222:       if (mesh->topo_frozen && !mesh->topo_cache.valid(*mesh))
223:         mesh->thawTopo();
224:       mesh->topo_cache.ensureRing1(*mesh);
225:     }
226:     if (brushNeedsLiveLinks(brushType) || keepTopoThawed) {
227:       if (mesh->topo_frozen)
228:         mesh->thawTopo();
229:     } else if (!mesh->topo_frozen) {
230:       mesh->freezeTopo();
231:     }
232:     ctx.m = mesh;
233:     ctx.surfaceNo = normal;
234:     ctx.surfacePos = center;
235:     ctx.meshLog = meshLog;
236:     ctx.isFirstOfStep = isFirstOfStep;
237:     updateStrokeFrame(center);
238:     brush->pushStrokeSample(center, normal);
239:     curCaptureSlot = 0;
240:     curCaptureTool = int(brushType);
241:     ScopedPreparedCavity cavityScope(preparedCavityActive);
242:     exec(command, {dabNodes_.data(), dabNodes_.size()});
243:     curCaptureSlot = -1;
244:     tree->updateQueries();
245:   }
246:   clearIsFirstOfStep();
247:   return {};
248: }
