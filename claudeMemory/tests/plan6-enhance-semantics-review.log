275:   BrushUniformManifestEntry uniformSnapshotChecked(int token, int uniformIndex) const
276:   {
277:     BrushUniformManifestEntry result;
278:     string name;
279:     int type = uniformIndex >= 0 && uniformIndex < int(canonicalUniforms_.size())
280:                    ? int(canonicalUniforms_[uniformIndex].scalarType)
281:                    : int(props::Prop::INVALID_TYPE);
282:     result.status = checkedUniformName(token, uniformIndex, type, name);
283:     if (!result.status) {
284:       result = canonicalUniforms_[uniformIndex];
285:     }
286:     return result;
287:   }
