SOURCE FILE: engine/source/brush/kernels/enhance.sbrush
1: // Enhance details (difference-of-smooths band-pass). Amplifies surface relief by
2: // adding a high-/band-pass of the position field along a smoothed normal. The
3: // per-vertex enhance vector `edisp` is computed host-side and cached per stroke
4: // (source/brush/enhance.h, updateEnhanceRegion) — the N-ring smooth can't live in
5: // a 1-ring kernel, so this kernel just applies the cached displacement scaled by
6: // the brush strength/falloff and paint mask. CPU-only (like feature-align).
7: @brush("enhance")
8: @tool ENHANCE
9: // updateEnhanceRegion's N-ring BFS walks live links every dab.
10: @fulltopo
11: brush Enhance {
12:   attr vertex float3 edisp = ".brush.enhance.disp";
13: 
14:   vertex void apply(inout Vertex v) {
15:     float s = strength(v.co) * masks();
16:     if (s == 0.0) { continue; }
17:     v.co += v.edisp * s;
18:   }
19: }
