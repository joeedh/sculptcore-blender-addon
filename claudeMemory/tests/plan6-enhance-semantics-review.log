260: def stroke_begin(session, *, has_dyntopo=False, accumulate=True, anchored_grab=True,
261:                  grids_kernel=None, cage_kernel=None):
262:     session.last_stroke_grids = False
263:     session.last_stroke_cage = False
264:     if grids_kernel is not None and grids_capable(session, grids_kernel):
265:         grid = _grid_session(session)
266:         if grid is not None:
267:             lib = engine.capi().lib
268:             lib.GridStroke_setNonAccum(grid, 0 if accumulate else 1)
269:             lib.GridStroke_setAnchoredGrab(grid, 1 if anchored_grab else 0)
270:             # A fold point (mesh-path stroke, level op) may have rebuilt the
271:             # domain, which cleared the grid undo history.
272:             if lib.GridStroke_sync(grid) == 2:
273:                 session.grid_generation += 1
274:                 session.grid_cursor = 0
275:                 session.grid_undo_bytes_base = 0
276:             if lib.GridStroke_begin(grid):
277:                 session.last_stroke_grids = True
278:                 session.stroke_gen += 1
279:                 session.filter_high_water = 0.0
280:                 # Grids strokes draw from the grids source; flip back if a
281:                 # mesh-path tool moved the provider to the slot tree.
282:                 if session.draw_provider_kind != 'GRIDS':
283:                     convert.use_grids_provider(session)
284:                 return
285:     if cage_kernel is not None and session.multires_ptr:
286:         # Cage-dab colour smoothing (CS3): the stroke's dabs run engine-side
287:         # on the cage colour column and re-derive the touched grids. The rest
288:         # of the mesh-path stroke shape below still runs — the executor step
289:         # is empty, but it is a real meshlog step, so undo.push pairs this
290:         # stroke's cage columns with its own step id.
291:         lib = engine.capi().lib
292:         ptr = lib.CageSmooth_new(session.multires_ptr, session.multires_active_level,
293:                                  _ensure_brush(session).ptr)
294:         if ptr and not lib.CageSmooth_begin(ptr, convert._SC_COLOR):
295:             lib.CageSmooth_free(ptr)
296:             ptr = None
297:         if ptr:
298:             session.cage_smooth_ptr = ptr
299:             session.last_stroke_cage = True
300:     if (session.multires_ptr and session.draw_provider_kind != 'SLOT'
301:             and not session.last_stroke_cage):
302:         # Mesh-path stroke on a multires session: its edits land in the slot
303:         # mesh, which the grids source cannot see — draw the slot tree for
304:         # the duration (first flip pays the slot GPU-buffer build; the
305:         # ride-along mirror keeps the slot current, so no heal is needed).
306:         # A cage stroke's epilogue re-derives into both draw sources, so it
307:         # keeps whichever provider is active.
308:         convert.use_slot_provider(session)
309:     executor = _ensure_executor(session)
310:     executor.beginStep(has_dyntopo)
311:     session.dyntopo_active = has_dyntopo
312:     # A nonzero, per-stroke generation is required for grab-class kernels
313:     # (they orig-stamp against it); harmless for the rest.
314:     session.stroke_gen += 1
315:     executor.setStrokeGen(session.stroke_gen)
316:     # Anchoring is a property of the *stroke*, not the kernel: it decides
317:     # whether a @grabmode kernel deforms from each vert's stroke-start position
318:     # (fixed region, absolute drag) or accumulates dab to dab like any other
319:     # brush. The engine defaults it on; set it explicitly so a path-mode
320:     # kelvinlet would build up instead of re-basing every dab.
321:     executor.setAnchoredGrab(anchored_grab)
322:     session.filter_high_water = 0.0
323:     # Vanilla's per-brush "Accumulate": with it off, the engine measures each
324:     # accumulable command from a stroke-start snapshot (nonAccum mode) so
325:     # repeated passes within one stroke don't build up.
326:     executor.setNonAccum(not accumulate)
