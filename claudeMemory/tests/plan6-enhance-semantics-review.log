343: # Vanilla dyntopo detail constants (sculpt_dyntopo.hh).
344: DYNTOPO_EDGE_MIN_FACTOR = 0.4       # EDGE_LENGTH_MIN_FACTOR
345: _DYNTOPO_RELATIVE_SCALE = 0.4       # RELATIVE_SCALE_FACTOR
346: 
347: # Blender detail_refine_method -> engine DynTopoMode value.
348: _DYNTOPO_REFINE_MODES = {'SUBDIVIDE': 0, 'COLLAPSE': 1, 'SUBDIVIDE_COLLAPSE': 2}
349: 
350: 
351: def dyntopo_max_edge(sculpt, ob, world_radius, pixel_radius, pixel_size):
352:     """Object-space max edge length from Blender's dyntopo detail settings
353:     (ports #constant_to_detail_size / #brush_to_detail_size /
354:     #relative_to_detail_size). RELATIVE and BRUSH scale with the dab's world
355:     radius; CONSTANT/MANUAL are view-independent."""
356:     method = sculpt.detail_type_method
357:     if method in {'CONSTANT', 'MANUAL'}:
358:         # mat4_to_scale equivalent: the mean axis scale of the object matrix.
359:         scale_vector = ob.matrix_world.to_scale()
360:         scale = (abs(scale_vector[0]) + abs(scale_vector[1]) + abs(scale_vector[2])) / 3.0
361:         return 1.0 / (max(sculpt.constant_detail_resolution, 0.0001) * max(scale, 1e-8))
362:     if method == 'BRUSH':
363:         return world_radius * sculpt.detail_percent / 100.0
364:     return ((world_radius / max(pixel_radius, 1.0))
365:             * (sculpt.detail_size * pixel_size) / _DYNTOPO_RELATIVE_SCALE)
366: 
367: 
368: def configure_dyntopo_params(params, scene, refine_method):
369:     """Apply the per-scene remesher tuning (props.py) plus the refine method
370:     onto a DynTopoParams. An unset refine method (older files carry DNA
371:     flags 0, which RNA reads as '') falls back to the default Both."""
372:     params.mode = _DYNTOPO_REFINE_MODES.get(refine_method, 2)
373:     params.do_flips = scene.sculptcore_dyntopo_flips
374:     params.do_smooth = scene.sculptcore_dyntopo_smooth
375:     params.smooth_lambda = scene.sculptcore_dyntopo_smooth_lambda
376:     params.reproject_uvs = scene.sculptcore_reproject_uvs
377:     params.max_rounds = scene.sculptcore_dyntopo_max_rounds
378:     params.max_splits = scene.sculptcore_dyntopo_split_budget
379:     params.max_collapses = scene.sculptcore_dyntopo_collapse_budget
380: 
381: 
382: def build_dyntopo_params(session, l_max, l_min):
383:     """Reusable DynTopoParams (edge-length bounds in object space)."""
384:     mgr = engine.manager()
385:     if session.dtparams is None:
386:         session.dtparams = mgr.construct("sculptcore::dyntopo::DynTopoParams")
387:     p = session.dtparams
388:     p.l_max = l_max
389:     p.l_min = min(l_min, l_max * 0.5)
390:     return p
391: 
392: 
393: def dyntopo_due(stroke_s, last_dyntopo_s, spacing):
394:     """Whether a remesh is due at stroke arc-length ``stroke_s``: true once the
395:     stroke has travelled ``spacing`` since the last remesh at ``last_dyntopo_s``.
396:     A ``spacing`` of 0 is due on every dab (the every-dab baseline)."""
397:     return stroke_s - last_dyntopo_s >= spacing
398: 
399: 
400: def _refresh_queries(session):
401:     """The query-correctness half of the spatial update, run after every dab.
402: 
403:     The dab moved verts, which leaves every node bound it touched stale, and the
404:     node filter (and raycast, and picking) reads those bounds. A brush that
405:     carries geometry *out* of its own node bounds — snake hook and grab most
406:     of all — otherwise stalls the moment the tip leaves the region the tree
407:     still thinks it occupies: the next dab's filterNodes finds nothing and the
408:     stroke silently dies mid-drag.
409: 
410:     Deliberately not the full ``tree.update(gpu)``: the GPU-buffer half belongs
411:     once per frame in the draw path (convert.draw_refresh), not per dab."""
412:     session.tree().updateQueries()
413: 
414: 
415: def apply_dyntopo_dab(session, program, center, normal, radius, params, seed):
416:     """One program dab through ``applyDab``. With ``params`` set it also runs the
417:     dyntopo remesh pass; with ``params`` None it is a plain deforming dab (no
418:     remesh) — the reference's ``params ?? 0`` path for the off-cadence dabs
419:     between remeshes."""
420:     mgr = engine.manager()
421:     executor = _ensure_executor(session)
422:     center_v = _float3(mgr, *center)
423:     normal_v = _float3(mgr, *normal)
424:     try:
425:         executor.setGrabAccumAdd(False)
426:         moved = executor.applyDab(program, center_v, normal_v, radius, params, seed)
427:     finally:
428:         center_v.dispose()
429:         normal_v.dispose()
430:     if moved >= 0:
431:         _refresh_queries(session)
432:     return moved
433: 
434: 
435: def apply_dab(session, brush_type, center, normal, radius):
436:     """Run one dab at an object-space center/normal. `center`/`normal` are
437:     3-tuples; `brush_type` is the SculptBrushes enum value. Returns the
438:     number of spatial nodes the dab touched (0 = brush missed the surface);
439:     grids-native strokes return the moved-vert count instead."""
440:     import sculptcore
441: 
442:     if session.last_stroke_cage:
443:         # Cage-dab route: one primary image per call (symmetry mirrors arrive
444:         # as their own calls, already reflected). Strength was written by
445:         # apply_dab_state's per-pass override; the pressure LUT is folded in
446:         # there too, so the engine's own stays off.
447:         import numpy as np
448:         dab = np.array([center[0], center[1], center[2],
449:                         normal[0], normal[1], normal[2], radius],
450:                        dtype=np.float32)
451:         return engine.capi().lib.CageSmooth_dabCurrentInputs(
452:             session.cage_smooth_ptr, int(brush_type), dab, session.brush_obj.strength)
453:     if session.last_stroke_grids:
454:         # Grids-native: the engine queries its own GridTree, mirrors the slot
455:         # mesh, and refreshes normals/bounds — no filterNodes/_refresh_queries.
456:         lib = engine.capi().lib
457:         if lib.GridStroke_supportsResolved(session.grid_ptr, int(brush_type), None):
458:             return lib.GridStroke_dabResolved(session.grid_ptr, int(brush_type), *center, *normal)
459:         return lib.GridStroke_dab(
460:             session.grid_ptr, int(brush_type),
461:             center[0], center[1], center[2],
462:             normal[0], normal[1], normal[2], 0)
463: 
464:     mgr = engine.manager()
465:     executor = _ensure_executor(session)
466:     tree = session.tree()
467: 
468:     if executor.supportsResolved(brush_type):
469:         return engine.capi().lib.MeshStroke_dabResolved(executor.ptr, int(brush_type), *center, *normal)
470:     if not executor.preflightRaw(brush_type):
471:         return -1
472: 
473:     center_v = _float3(mgr, *center)
474:     normal_v = _float3(mgr, *normal)
475:     nodes = mgr.construct("litestl::util::Vector<sculptcore::spatial::SpatialNode*,4>")
476:     filter_r = brush_policy.filter_radius(brush_type, radius, session.brush_obj, session)
477:     try:
478:         if not tree.filterNodes(center_v, filter_r, nodes):
479:             return 0
480:         # New logical dab primary image: grab-class kernels re-base from the
481:         # stroke-start position each dab instead of accumulating (mirrors the
482:         # native harness). No-op for non-grab kernels.
483:         executor.setGrabAccumAdd(False)
484:         executor.execBrush(session.mesh(), brush_type, nodes, center_v, normal_v)
485:         if not executor.lastUniformValidationOk():
486:             return -1
487:         # applyDab clears this after every dab; these exec paths bypass it, so
488:         # without the clear the stroke re-runs its once-per-stroke work (uniform
489:         # validation, the BSMOOTH boundary-class refresh) on every dab.
490:         executor.clearIsFirstOfStep()
491:         count = len(sculptcore.BoundVector(mgr, nodes.ptr, nodes.bind_type))
492:     finally:
493:         for obj in (nodes, center_v, normal_v):
494:             obj.dispose()
495:     # After the node handles are released: updateQueries may split or merge
496:     # leaves, which invalidates them.
497:     _refresh_queries(session)
498:     return count
499: 
500: 
501: def apply_grab_dab(session, brush_type, anchor, cursor, normal, radius, accum_add=False):
502:     """Grab-class dab: deform the fixed region under `anchor` by the
503:     cumulative cursor delta (`brush.grabTo`/`grabFrom`). The dab centers on the
504:     anchor and the node filter widens by the drag distance so the anchored
505:     region stays covered as the cursor moves away — and, for an `@unbounded`
506:     kernel, by the field's own extent (see brush_policy.filter_radius).
507: 
508:     `accum_add` marks a later symmetry image of the same logical dab: False
509:     (the primary) begins a new logical dab and re-bases every touched vert from
510:     its stroke-start position; True adds this image's delta on top, so a vertex
511:     on a symmetry plane touched by two images sums both reflections."""
512:     mgr = engine.manager()
513:     executor = _ensure_executor(session)
514:     brush = session.brush_obj
515:     tree = session.tree()
516:     if not session.last_stroke_grids and not executor.preflightRaw(brush_type):
517:         return -1
518: 
519:     gf = brush.grabFrom.vec
520:     gt = brush.grabTo.vec
521:     drag = 0.0
522:     # The kernels consume grabTo as the cumulative drag *delta* (the grab
523:     # write-back re-bases each vert as orig + grabTo * falloff), not as the
524:     # absolute cursor point.
525:     for i in range(3):
526:         gf[i] = anchor[i]
527:         gt[i] = cursor[i] - anchor[i]
528:         drag += (cursor[i] - anchor[i]) ** 2
529:     drag = drag ** 0.5
530: 
531:     if session.last_stroke_grids:
532:         # Grids-native anchored grab: the engine pins the first dab's leaf
533:         # region (radius + the @unbounded floor) — no drag widening needed.
534:         return engine.capi().lib.GridStroke_dab(
535:             session.grid_ptr, int(brush_type),
536:             anchor[0], anchor[1], anchor[2],
537:             normal[0], normal[1], normal[2], 1 if accum_add else 0)
538: 
539:     anchor_v = _float3(mgr, *anchor)
540:     normal_v = _float3(mgr, *normal)
541:     nodes = mgr.construct("litestl::util::Vector<sculptcore::spatial::SpatialNode*,4>")
542:     filter_r = brush_policy.filter_radius(brush_type, radius, brush, session, drag=drag)
543:     try:
544:         if not tree.filterNodes(anchor_v, filter_r, nodes):
545:             return 0
546:         executor.setGrabAccumAdd(accum_add)
547:         executor.execBrush(session.mesh(), brush_type, nodes, anchor_v, normal_v)
548:         if not executor.lastUniformValidationOk():
549:             return -1
550:         executor.clearIsFirstOfStep()
551:         import sculptcore
552:         count = len(sculptcore.BoundVector(mgr, nodes.ptr, nodes.bind_type))
553:     finally:
554:         for obj in (nodes, anchor_v, normal_v):
555:             obj.dispose()
556:     _refresh_queries(session)
557:     return count
558: 
559: 
560: def set_snake_hook_state(session, center, delta):
561:     """Write the snakehook kernel's ctx vectors for one dab image: `grabFrom` is
562:     the dab center, `grabTo` the drag step it should apply. The kernel drags
563:     by `grabTo` and gathers toward `grabFrom + grabTo`, so leaving these at their
564:     (0,0,0) defaults gathers every vert toward the object origin instead of
565:     hooking. Set before the dab, like apply_grab_dab's write."""
566:     brush = session.brush_obj
567:     gf = brush.grabFrom.vec
568:     gt = brush.grabTo.vec
569:     for i in range(3):
570:         gf[i] = center[i]
571:         gt[i] = delta[i]
572: 
573: 
574: def build_program(session, main_kernel, smooth_factor=0.0):
575:     """Build a program `[main]`, or `[main, BSMOOTH]` when `smooth_factor > 0`
576:     (autosmooth). Owned by the session and reused across dabs; also the dab
577:     unit for the dyntopo path (applyDab takes a program)."""
578:     mgr = engine.manager()
579:     if session.program is None:
580:         session.program = mgr.construct("sculptcore::brush::BrushProgram")
581:     prog = session.program
582:     prog.clear()
583:     prog.addCommand(main_kernel)
584:     if smooth_factor > 0.0:
585:         smooth = int(mgr.get("sculptcore::brush::SculptBrushes").items["BSMOOTH"])
586:         idx = prog.addCommand(smooth)
587:         # Pin the chained smooth to non-inverted: it shares the Brush with the
588:         # main command, so a Ctrl-inverted dab would otherwise negate the
589:         # smooth strength too — an anti-Laplacian that explodes the mesh.
590:         prog.setCommandInvert(idx, False)
591:         # BrushProp::Strength == 0. The runtime can't marshal a string arg into
592:         # a util::string method param, so the smooth strength is overridden by
593:         # propId, not by name (setCommandFloatByName).
594:         prog.setCommandFloat(idx, 0, smooth_factor)
595:     return prog
596: 
597: 
598: def apply_dab_program(session, program, center, normal, radius, kernel=None):
599:     """Run a BrushProgram (e.g. [main, BSMOOTH]) for one dab. ``kernel`` is the
600:     program's main kernel, used only to size the node filter (the chained
601:     BSMOOTH is never unbounded)."""
602:     import sculptcore
603: 
604:     if session.last_stroke_grids:
605:         # Grids-native program dab: one engine call runs every entry over one
606:         # shared node query (the engine widens it to the entries' field radii).
607:         lib = engine.capi().lib
608:         if lib.GridStroke_supportsResolved(session.grid_ptr, 0, program.ptr):
609:             return lib.GridStroke_dabProgramResolved(session.grid_ptr, program.ptr, *center, *normal)
610:         return lib.GridStroke_dabProgram(
611:             session.grid_ptr, program.ptr,
612:             center[0], center[1], center[2],
613:             normal[0], normal[1], normal[2])
614: 
615:     mgr = engine.manager()
616:     executor = _ensure_executor(session)
617:     tree = session.tree()
618:     if executor.supportsResolvedProgram(program):
619:         return engine.capi().lib.MeshStroke_dabProgramResolved(executor.ptr, program.ptr, *center, *normal)
620:     if not executor.preflightRawProgram(program):
621:         return -1
622:     center_v = _float3(mgr, *center)
623:     normal_v = _float3(mgr, *normal)
624:     nodes = mgr.construct("litestl::util::Vector<sculptcore::spatial::SpatialNode*,4>")
625:     filter_r = brush_policy.filter_radius(kernel, radius, session.brush_obj, session)
626:     try:
627:         if not tree.filterNodes(center_v, filter_r, nodes):
628:             return 0
629:         executor.setGrabAccumAdd(False)
630:         executor.execProgram(program, nodes, center_v, normal_v)
631:         if not executor.lastUniformValidationOk():
632:             return -1
633:         executor.clearIsFirstOfStep()
634:         count = len(sculptcore.BoundVector(mgr, nodes.ptr, nodes.bind_type))
635:     finally:
636:         for obj in (nodes, center_v, normal_v):
637:             obj.dispose()
638:     _refresh_queries(session)
639:     return count
640: 
641: 
642: def stroke_end(session):
643:     if session.last_stroke_grids:
644:         # Grids-native: endStep folded the stroke into the store already
645:         # (restricted writeback) and closed the grid undo step; the engine
646:         # mirror kept the slot mesh + normals current per dab.
647:         engine.capi().lib.GridStroke_end(session.grid_ptr)
648:         session.grid_cursor += 1
649:         return
650:     if session.last_stroke_cage and session.cage_smooth_ptr:
651:         # Close the cage session first; the (empty) executor step below still
652:         # ends normally so the stroke owns a meshlog step for undo.push.
653:         lib = engine.capi().lib
654:         lib.CageSmooth_end(session.cage_smooth_ptr)
655:         lib.CageSmooth_free(session.cage_smooth_ptr)
656:         session.cage_smooth_ptr = None
657:     executor = _ensure_executor(session)
658:     if session.dyntopo_active:
659:         executor.endDynTopoStroke()
660:     executor.endStep()
661:     # endStep() advanced the meshlog's applied-step count; mirror it (a stroke
662:     # begun after an undo truncates the redo branch, so +1 is always correct).
663:     session.meshlog_cursor += 1
664:     # A mesh-path MASK stroke on multires wrote only the slot column; fold it
665:     # into the store (no-op when the stroke touched no mask, or no multires).
666:     convert.fold_slot_mask(session)
667:     # Normals only over the leaves the stroke dirtied. Mesh.recalc_normals() is
668:     # O(whole mesh) and thaws the topology, so on a multires cage it cost half a
669:     # second per stroke plus a frozen-topology rebuild on the next dab.
670:     session.tree().updateNormals()
671: 
672: 
673: def raycast(session, origin, direction):
674:     """Cast a ray (object space) against the engine tree; returns a
675:     (position, normal, face_index) tuple on hit, else None. Grids sessions
676:     with a live domain use the GridTree — its bounds refresh per dab
677:     engine-side, where the mesh tree's would be stale between grids dabs."""
678:     lib = engine.capi().lib
679:     if (session.multires_ptr
680:             # While the grids provider is displaying, the domain is the
681:             # authoritative surface (a mesh-path stroke flips the provider to
682:             # 'SLOT' first, and a level rebind re-registers at the new
683:             # level), and with the lazy slot there may be NO mesh tree yet.
684:             and session.draw_provider_kind == 'GRIDS'
685:             and lib.Multires_hasGridDomain(
686:                 session.multires_ptr, session.multires_active_level)):
687:         import ctypes
688: 
689:         import numpy as np
690: 
691:         out = np.zeros(10, dtype=np.float32)
692:         nearest = ctypes.c_int(-1)
693:         hit = lib.GridTree_castRay(
694:             session.multires_ptr, session.multires_active_level,
695:             origin[0], origin[1], origin[2],
696:             direction[0], direction[1], direction[2],
697:             out, ctypes.byref(nearest))
698:         if not hit:
699:             return None
700:         # Level-mesh face id from the hit cell (buildLevelTopo's grid-major
701:         # cell order) so callers keep their face-index semantics.
702:         side = 1 << (session.multires_active_level - 1)
703:         face = int(out[7]) * side * side + int(out[9]) * side + int(out[8])
704:         return ((float(out[0]), float(out[1]), float(out[2])),
705:                 (float(out[3]), float(out[4]), float(out[5])), face)
706: 
707:     mgr = engine.manager()
708:     tree = session.tree()
709:     orig_v = _float3(mgr, *origin)
710:     dir_v = _float3(mgr, *direction)
711:     hit = mgr.construct("sculptcore::spatial::CastRayIsect")
712:     try:
713:         if not tree.castRay(orig_v, dir_v, hit):
714:             return None
715:         p = tuple(hit.p.vec)
716:         n = tuple(hit.normal.vec)
717:         return (p, n, hit.faceIndex)
718:     finally:
719:         for obj in (orig_v, dir_v, hit):
720:             obj.dispose()
721: 
722: 
723: class SCULPTCORE_OT_brush_stroke(bpy.types.Operator):
724:     bl_idname = "sculptcore.brush_stroke"
725:     bl_label = "SculptCore Stroke"
726:     # No 'UNDO': the stroke pushes its own CUSTOM_MODE step (delta undo) at end
727:     # via undo.push, instead of a full memfile snapshot. The Mesh ID stays
728:     # authoritative through the mode's flush for save/render.
729:     bl_options = set()
730: 
731:     # SKIP_SAVE (like vanilla paint_stroke_operator_properties): without it a
732:     # plain-LMB stroke reuses the last-used value, so one Ctrl/Shift stroke
733:     # would latch INVERT/SMOOTH permanently.
734:     mode: bpy.props.EnumProperty(
735:         name="Stroke Mode",
736:         items=(
737:             ('NORMAL', "Regular", "Apply brush normally"),
738:             ('INVERT', "Invert", "Invert action of brush for duration of stroke"),
739:             ('SMOOTH', "Smooth", "Switch brush to smooth mode for duration of stroke"),
740:             ('MASK', "Mask", "Switch brush to the mask brush for duration of stroke"),
741:         ),
742:         default='NORMAL',
743:         options={'SKIP_SAVE'},
744:     )
745: 
746:     @classmethod
747:     def poll(cls, context):
748:         ob = context.active_object
749:         return (
750:             ob is not None
751:             and ob.mode == 'CUSTOM'
752:             and ob.custom_mode == "sculptcore.sculpt"
753:             and ob.name in engine.sessions
754:         )
755: 
756:     def invoke(self, context, event):
757:         ob = context.active_object
758:         # A foreign memfile undo may have changed the mesh under us (custom-undo
759:         # modes skip the generic refresh); rebuild the session before sculpting
760:         # if the engine no longer matches the Mesh.
761:         convert.resync_if_diverged(ob)
762:         self.session = engine.sessions[ob.name]
763:         self.brush = context.tool_settings.sculpt.brush
764:         mgr = engine.manager()
765:         if self.mode in {'SMOOTH', 'MASK'}:
766:             # Shift-stroke smooths (colour blur over a paint brush), Alt-stroke
767:             # masks — both with the active brush's radius/strength (vanilla
768:             # brush_toggle semantics). The pick lives in toggle_kernel_name.
769:             kernel_name = toggle_kernel_name(self.mode, self.brush, self.session)
770:             self.kernel = (int(mgr.get("sculptcore::brush::SculptBrushes").items[kernel_name])
771:                            if self.brush else None)
772:         else:
773:             self.kernel = mapping.kernel_enum(mgr, self.brush) if self.brush else None
774:         if self.kernel is None:
775:             self.report({'WARNING'}, "SculptCore: brush type has no kernel")
776:             return {'CANCELLED'}
777: 
778:         self._last_flush = 0.0
779:         # Gate closed at stroke start: the first refresh waits for the frame
780:         # the invoke's own tag_redraw requests (≤ one frame period), keeping
781:         # the invariant one refresh per presented frame from dab one.
782:         self._flush_frame = _frames_presented
783:         _draw_counter_push()
784:         self._dab_count = 0
785:         # Object-space running sum of this stroke's dab centers; written to
786:         # Paint.stroke_pivot (world space) at stroke end so the viewport orbits
787:         # around the last stroke, as vanilla sculpt does. Symmetry mirrors are
788:         # excluded — vanilla accumulates only the primary center too.
789:         self._pivot_sum = [0.0, 0.0, 0.0]
790:         self._pivot_n = 0
791:         # A kernel toggle (smooth/mask) replaces the brush's own kernel, so
792:         # brush-type-derived behavior (grab anchoring, face-set group
793:         # assignment, autosmooth chaining) is bypassed for the stroke.
794:         kernel_toggle = self.mode in {'SMOOTH', 'MASK'}
795:         # Layer brush: make sure the layerdraw kernel has a write target
796:         # before any capability query -- on multires the grids roster itself
797:         # flips on the live edit target (LD3).
798:         if not kernel_toggle and self.brush.sculpt_brush_type == 'LAYER':
799:             from . import layers
800:             layers.ensure_stroke_target(context, ob, self.session)
801:         self._grab_class = not kernel_toggle and mapping.is_grab_class(self.brush)
802:         # Snake hook's kernel reads the grab ctx vectors (see
803:         # mapping.is_snake_hook) and its influence region walks out with the
804:         # extruded tip rather than tracking the surface under the cursor — see
805:         # _snake_hook_advance for the state these four fields carry.
806:         self._snake_hook = not kernel_toggle and mapping.is_snake_hook(self.brush)
807:         self._sh_origin = None
808:         self._sh_normal = None
809:         self._sh_center = None
810:         self._sh_plane = None
811:         self._sh_delta = (0.0, 0.0, 0.0)
812:         self._preview_origin = None
813:         # Smoothing strokes (Shift-toggle or the Smooth brush itself) iterate
814:         # per dab by strength, vanilla-style (see smooth_iteration_strengths).
815:         self._smooth_stroke = (
816:             self.mode == 'SMOOTH'
817:             or (not kernel_toggle and self.brush.sculpt_brush_type == 'SMOOTH'))
818:         # Anchored / Drag-Dot stroke methods drive the engine preview-dab API
819:         # (one live, non-compounding dab per input) instead of the spacer. DOTS/
820:         # SPACE (and, for now, AIRBRUSH/LINE/CURVE) use the spacer path; grab
821:         # anchors via its own kernel, so it keeps the grab path.
822:         self._stroke_method = self.brush.stroke_method
823:         self._preview_method = (not self._grab_class
824:                                 and self._stroke_method in {'ANCHORED', 'DRAG_DOT'})
825:         # Tablet pressure (M4): Blender maps pressure to strength/size through
826:         # the Brush.curve_strength / curve_size response curves, baked once here
827:         # (never per dab) into Python-side LUTs. The smooth brush folds pressure
828:         # in through them (it re-runs the kernel per relaxation pass, whose
829:         # per-node loadProps would re-consume an engine device sample); the
830:         # normal path additionally drives the engine device dynamics (each dab
831:         # refills the sample; mouse reports 1.0, a no-op). The cursor overlay
832:         # scales its radius by the size LUT. Grab-class strokes get no pressure.
833:         sc_brush = _ensure_brush(self.session)
834:         # Which toggle each row owns is per-brush: vanilla's own where it drives
835:         # anything, ours where vanilla's is inert (mapping.pressure_prop_names).
836:         strength_prop, size_prop = mapping.pressure_prop_names(self.brush)
837:         use_strength = not self._grab_class and getattr(self.brush, strength_prop)
838:         use_size = not self._grab_class and getattr(self.brush, size_prop)
839:         self._use_pressure = use_strength or use_size
840:         self._pressure_strength_lut = (
841:             mapping.sample_pressure_curve(self.brush, 'curve_strength') if use_strength else None)
842:         self._pressure_size_lut = (
843:             mapping.sample_pressure_curve(self.brush, 'curve_size') if use_size else None)
844:         curve_cache = self.session.curve_cache
845:         # Brush texture (Phase 2): bind or clear per stroke; view-pinned
846:         # mappings also need the current perspective matrix.
847:         texture.apply_texture(self.brush, sc_brush, context, session=self.session)
848:         if texture.needs_render_matrix(self.brush):
849:             texture.apply_render_matrix(context, _ensure_executor(self.session))
850:         # Stroke-constant brush settings, including the falloff/cavity curve
851:         # tables (bulk uploads skipped when the session already holds them).
852:         # The dab paths write only the
853:         # radius/invert state on top (mapping.apply_dab_state).
854:         paint = context.tool_settings.sculpt
855:         mapping.apply_brush_settings(
856:             self.brush, paint.unified_paint_settings, sc_brush, paint=paint, cache=curve_cache)
857:         from . import engine_props
858:         engine_props.sync_authored(self.session, _ensure_executor(self.session), self.kernel)
859:         # Record the installed stack generation after all checked scalar writes.
860:         mapping.apply_pressure_dynamics(
861:             self.brush, sc_brush, cache=curve_cache,
862:             use_strength=use_strength and not self._smooth_stroke,
863:             use_size=use_size and not self._smooth_stroke)
864:         # UV slide-reprojection (scene toggle): the executor re-anchors moved
865:         # verts' UVs for the smooth-family kernels. Any stroke that may run
866:         # one (smooth brush, Shift-smooth, autosmooth chain) diverges the
867:         # engine UVs from the Mesh, so the flush must write them back.
868:         sc_brush.reproject_uvs = context.scene.sculptcore_reproject_uvs
869:         if sc_brush.reproject_uvs:
870:             self.session.uv_dirty = True
871:         # "Adjust Strength for Spacing": constant for the stroke, folded into
872:         # every dab's strength write — together with any per-type strength
873:         # compensation (kernel-scale parity, see mapping.STRENGTH_SCALE).
874:         self._overlap = mapping.overlap_attenuation(self.brush, cache=self.session.curve_cache)
875:         if not kernel_toggle:
876:             self._overlap *= mapping.STRENGTH_SCALE.get(
877:                 self.brush.sculpt_brush_type, 1.0)
878:         self._anchor = None
879:         self._anchor_normal = None
880:         self._drag_origin = None
881:         # Dab spacing along the stroke path (engine StrokeSpacer semantics:
882:         # interval = world radius x spacing fraction). Grab-class ignores it.
883:         self._spacer = StrokeSpacer()
884:         self._input_sampler = stroke_input.InputSampler(context.scene.sculptcore_speed_reference)
885:         # Trailing-flush state, refreshed on every move (see _dab_at); defaults
886:         # cover a commit with no intervening move.
887:         self._last_invert = False
888:         self._last_pressure = 1.0
889:         self._last_spacing = 0.0
890:         # Dyntopo cadence bookkeeping: accumulated stroke arc length and the
891:         # arc length of the last remesh. -inf so the first dab always remeshes.
892:         self._stroke_s = 0.0
893:         self._last_dyntopo_s = float("-inf")
894:         self._dyntopo_spacing = 0.0
895:         # Plane-mirror symmetry: one sign vector per reflection (empty = off).
896:         self._mirror_signs = symmetry.mirror_signs(symmetry.axes_from_mesh(ob.data))
897:         # Face-set brushes paint a fresh group id per stroke. ensureFaceGroups
898:         # flood-fills a first-ever group attr with the mesh's default id (so
899:         # unpainted faces read as Blender's default set, not scattered zeros);
900:         # newFaceGroupId skips that default, so a painted set is never the
901:         # invisible one (extending the default set stays an explicit sample of
902:         # an existing face's id, never an allocation).
903:         self.session.last_stroke_face_sets = False
904:         if not kernel_toggle and self.brush.sculpt_brush_type in mapping.FACE_SET_TYPES:
905:             brush = _ensure_brush(self.session)
906:             if self.session.multires_ptr:
907:                 # Face sets are a Derived grid attribute, so the engine roster
908:                 # refuses the grids path and the stroke runs mesh-path on the
909:                 # slot's derived `group` column. The slot is lazy: without this
910:                 # the wrapper below binds a null Mesh* and the group calls fault.
911:                 convert.ensure_multires_slot(self.session)
912:             mesh_obj = self.session.mesh()
913:             mesh_obj.ensureFaceGroups()
914:             brush.activeGroup = int(mesh_obj.newFaceGroupId())
915:             # On multires this paints the SLOT's derived column, which does
916:             # not persist, so undo.push scatters it home to the cage (§6 of
917:             # plans/grid-domain-attributes.md).
918:             self.session.last_stroke_face_sets = True
919:         # Colour is the other layer with no multires domain to live in: the
920:         # store channel and the slot column both die with the session, so the
921:         # cage is where a paint stroke's dabs land (§6.3 of
922:         # plans/grid-domain-attributes.md). A Shift-smooth over a paint brush
923:         # edits the same cage column through the engine's cage-dab entry, so
924:         # it snapshots (and undoes) as a colour stroke too.
925:         self._cage_smooth = (kernel_toggle and self.mode == 'SMOOTH'
926:                              and self.session.multires_ptr is not None
927:                              and self.brush.sculpt_brush_type in mapping.COLOR_TYPES)
928:         self.session.last_stroke_color = (
929:             (not kernel_toggle and self.brush.sculpt_brush_type in mapping.COLOR_TYPES)
930:             or self._cage_smooth)
931:         # Both flags are known now, and the cage is untouched: this is the only
932:         # place the pre-stroke columns can still be read, since every dab from
933:         # here on writes them.
934:         if self.session.multires_ptr:
935:             undo.snapshot_cage_columns(self.session)
936:         # Dyntopo (scene toggle) and autosmooth both run through a program;
937:         # neither applies to grab-class nor to a Shift-smooth stroke.
938:         # Autosmooth also skips the smooth brush itself.
939:         scene = context.scene
940:         smooth_factor = 0.0
941:         if (not self._grab_class and not kernel_toggle
942:                 and self.brush.sculpt_brush_type != 'SMOOTH'
943:                 and self.brush.auto_smooth_factor > 0.0):
944:             smooth_factor = self.brush.auto_smooth_factor
945: 
946:         self._dyntopo = None
947:         self._program = None
948:         self._detail_factor = None
949:         # A multires level mesh is derived from the grid store, so remeshing it
950:         # strands every level's displacement and the grid map; the engine
951:         # refuses the dab (Mesh::topoLocked) and this keeps the stroke from
952:         # opening a topology-logging undo step for changes that never come.
953:         if (not self._grab_class and not kernel_toggle
954:                 and self.session.multires_ptr is None
955:                 and getattr(scene, "sculptcore_dyntopo", False)):
956:             self._program = build_program(self.session, self.kernel, smooth_factor)
957:             # Detail size from Blender's dyntopo settings (see
958:             # dyntopo_max_edge). CONSTANT/MANUAL fix the edge length for the
959:             # stroke; RELATIVE/BRUSH reduce to `factor * world_radius`,
960:             # re-applied per remesh dab (the radius is depth-dependent).
961:             sculpt_settings = context.tool_settings.sculpt
962:             pixel_radius = mapping.pixel_radius(sculpt_settings, self.brush)
963:             if sculpt_settings.detail_type_method in {'CONSTANT', 'MANUAL'}:
964:                 l_max = dyntopo_max_edge(sculpt_settings, ob, 0.0, pixel_radius,
965:                                          context.preferences.system.pixel_size)
966:             else:
967:                 # Factor per unit world radius (formulas are linear in it).
968:                 self._detail_factor = dyntopo_max_edge(
969:                     sculpt_settings, ob, 1.0, pixel_radius,
970:                     context.preferences.system.pixel_size)
971:                 l_max = self._detail_factor  # placeholder; set per remesh dab
972:             self._dyntopo = build_dyntopo_params(
973:                 self.session, l_max, l_max * DYNTOPO_EDGE_MIN_FACTOR)
974:             configure_dyntopo_params(self._dyntopo, scene,
975:                                      sculpt_settings.detail_refine_method)
976:             # Remesh cadence in the same (pixel) units stroke_s accumulates: a
977:             # fraction of the brush diameter of stroke travel per remesh pass.
978:             frac = max(getattr(scene, "sculptcore_dyntopo_spacing", 0.5), 0.0)
979:             self._dyntopo_spacing = frac * 2.0 * pixel_radius
980:         elif smooth_factor > 0.0:
981:             self._program = build_program(self.session, self.kernel, smooth_factor)
982: 
983:         # A/B (design/cpp-dab-loop.md, variant B): run the per-dab loop of a
984:         # plain spaced stroke engine-side, batched per pointer event. Python
985:         # keeps the spacer walk and ray synthesis; everything the flat batch
986:         # cannot express — grab anchoring, preview dabs, snake hook's walking
987:         # tip, multi-pass smooth, dyntopo — stays on the per-dab path above.
988:         # Programs (autosmooth) batch on both domains via the *_dabBatchProgram
989:         # variants (S4 grids, S5 mesh).
990:         self._batch = (not self._grab_class and not self._preview_method
991:                        and not self._snake_hook and not self._smooth_stroke
992:                        and self._dyntopo is None
993:                        and getattr(scene, "sculptcore_cpp_dab_loop", False))
994:         # Set when a batch call returns the engine's stroke-dead sentinel
995:         # (stale grids domain); invoke/modal tear the stroke down through
996:         # _finish rather than falling back mid-stroke.
997:         self._engine_dead = False
998:         if self._batch:
999:             import numpy as np
1000:             self._mirror_flat = np.ascontiguousarray(
1001:                 np.array(self._mirror_signs, dtype=np.float32).reshape(-1))
1002:             # The engine-side node filter widens to the kernel's field radius,
1003:             # same as brush_policy.filter_radius with no drag; latching never
1004:             # applies here (grab-class is excluded from the batch path). For a
1005:             # program this is the main kernel's multiplier — the chained
1006:             # BSMOOTH is never unbounded.
1007:             self._filter_mul = (
1008:                 float(_ensure_brush(self.session).unboundedExtent)
1009:                 if brush_policy.for_kernel(self.kernel).unbounded else 1.0)
1010: 
1011:         # Anchored refuses a stroke that starts off the surface — checked before
1012:         # opening the undo step, so a refusal leaves no empty step behind.
1013:         if self._preview_method and self._stroke_method == 'ANCHORED':
1014:             a_origin, a_dir = _ray_origin_dir(
1015:                 context, (event.mouse_region_x, event.mouse_region_y))
1016:             a_hit = raycast(self.session, a_origin, a_dir)
1017:             if a_hit is None:
1018:                 self.report({'WARNING'},
1019:                             "SculptCore: anchored stroke must start on the surface")
1020:                 _draw_counter_pop()
1021:                 return {'CANCELLED'}
1022:             self._anchor = a_hit[0]
1023:             self._anchor_normal = a_hit[1]
1024:             self._anchor_screen = (event.mouse_region_x, event.mouse_region_y)
1025:             self._anchor_radius = _world_radius(context, self.brush, a_hit[0])
1026:             # Anchored pins the dab center, so a snake-hook drag can only come
1027:             # from the cursor: same plane projection the grab path uses, taken
1028:             # at pen-down so the first dab's delta is exactly zero.
1029:             if self._snake_hook:
1030:                 self._drag_origin = _cursor_on_anchor_plane(context, event, self._anchor)
1031: 
1032:         # Kernel toggles (smooth/mask) accumulate inherently, like vanilla,
1033:         # and non-accumulate only exists where vanilla shows the option
1034:         # (has_accumulate): for kernels without the concept — smooth is a
1035:         # relaxation, not a displacement — the engine's snapshot re-basing
1036:         # (nonAccum) is nonsense and blows the geometry up.
1037:         accumulate = (self.mode in {'SMOOTH', 'MASK'}
1038:                       or self._grab_class
1039:                       or not self.brush.sculpt_capabilities.has_accumulate
1040:                       or self.brush.use_accumulate
1041:                       or (not kernel_toggle and
1042:                           self.brush.sculpt_brush_type in mapping.FORCE_ACCUMULATE))
1043:         # Grids-native dispatch (multires W1): plain dab/grab strokes of
1044:         # kernels the engine reports as grids-capable skip the materialized-mesh
1045:         # hot path entirely, and so do autosmooth programs when every entry is
1046:         # capable (E2; dyntopo never coexists with multires, so a program here is
1047:         # autosmooth's). Snake hook rides this too — its per-dab state is written
1048:         # on the shared Brush, which both paths read. Preview flows stay
1049:         # mesh-path (the grid executor has no preview machinery).
1050:         grids_kernel = None
1051:         if (self.session.multires_ptr is not None
1052:                 and not self._preview_method
1053:                 and (self._program is None
1054:                      or program_grids_capable(self.session, self.kernel))):
1055:             grids_kernel = self.kernel
1056:         # The grab-class path is the anchored one (fixed region at the stroke
1057:         # start, absolute cursor drag); every other path dabs along the stroke.
1058:         stroke_begin(self.session, has_dyntopo=self._dyntopo is not None,
1059:                      accumulate=accumulate, anchored_grab=self._grab_class,
1060:                      grids_kernel=grids_kernel,
1061:                      cage_kernel=self.kernel if self._cage_smooth else None)
1062:         # The grids session is created inside stroke_begin, so its own copy of
1063:         # the view matrix can only be pushed here — the mesh-path push above
1064:         # rides the long-lived executor.
1065:         if self.session.last_stroke_grids and texture.needs_render_matrix(self.brush):
1066:             texture.apply_render_matrix_grids(context, self.session.grid_ptr)
1067:         # First dab at the invoke location — before the modal handler is
1068:         # registered, so an engine-refused first batch can still bail out with
1069:         # a plain CANCELLED return.
1070:         self._publish_cursor_pressure(event.pressure)
1071:         if self._preview_method:
1072:             self._dab_preview(context, event)
1073:         else:
1074:             self._dab_at(context, event)
1075:         if self._engine_dead:
1076:             self.report({'WARNING'}, "SculptCore: engine refused the stroke; see the system console")
1077:             if self._preview_method:
1078:                 return self._finish_preview(context, commit=False)
1079:             return self._finish(context, 'CANCELLED')
1080:         context.window_manager.modal_handler_add(self)
1081:         return {'RUNNING_MODAL'}
1082: 
1083:     def _dab_at(self, context, event, redraw=True):
1084:         """Apply the stroke at one pointer sample. `redraw` off skips the
1085:         viewport tail — used for the backlog samples of one event batch, which
1086:         are sculpted but not individually presented (see ``modal``)."""
1087:         sample = self._read_input(event)
1088:         if sample is None:
1089:             return
1090:         paint = context.tool_settings.sculpt
1091:         unified = paint.unified_paint_settings
1092:         # The keymap sets INVERT for Ctrl-LMB; live Ctrl also inverts so the
1093:         # direction can be toggled mid-stroke.
1094:         invert = event.ctrl or self.mode == 'INVERT'
1095: 
1096:         if self._grab_class:
1097:             sample.upload(self.session.brush_obj)
1098:             if self._anchor is None:
1099:                 # Anchor the region at the stroke-start surface point. Only the
1100:                 # anchoring dab needs the surface; misses just retry next move.
1101:                 hit = _ray_from_event(context, event, self.session)
1102:                 if hit is None:
1103:                     return
1104:                 position, normal, _face = hit
1105:                 self._anchor = position
1106:                 self._anchor_normal = normal
1107:                 self._anchor_radius = _world_radius(context, self.brush, position)
1108:                 # Drag reference: the mouse ray's plane projection at pen-down,
1109:                 # so both drag endpoints come from the same projection and the
1110:                 # first dab's delta is exactly zero, not merely near it.
1111:                 self._drag_origin = _cursor_on_anchor_plane(context, event, self._anchor)
1112:             # No re-raycast after anchoring: the drag must keep working when
1113:             # the cursor leaves the surface (vanilla grab semantics), and the
1114:             # region/radius stay pinned to the stroke start regardless.
1115:             mapping.apply_dab_state(self.brush, unified, self.session.brush_obj,
1116:                                     world_radius=self._anchor_radius, invert=invert,
1117:                                     strength_scale=self._overlap)
1118:             # Drag target = anchor + mouse motion on the view-facing plane
1119:             # through the anchor (both endpoints are projections of the mouse
1120:             # ray, so the first dab's delta is exactly zero).
1121:             plane_point = _cursor_on_anchor_plane(context, event, self._anchor)
1122:             drag = mapping.drag_offset(
1123:                 self.brush,
1124:                 tuple(plane_point[i] - self._drag_origin[i] for i in range(3)),
1125:                 self._anchor_normal, self.session.brush_obj.strength)
1126:             cursor = tuple(self._anchor[i] + drag[i] for i in range(3))
1127:             self._track_pivot(cursor)
1128:             if apply_grab_dab(self.session, self.kernel, self._anchor, cursor,
1129:                               self._anchor_normal, self._anchor_radius) < 0:
1130:                 self._engine_dead = True
1131:                 return
1132:             # Symmetry: reflect the anchor, cursor and normal directly (no
1133:             # re-raycast for grab — the resolved plane point is used as-is).
1134:             for sign in self._mirror_signs:
1135:                 moved = apply_grab_dab(
1136:                     self.session, self.kernel,
1137:                     symmetry.reflect(self._anchor, sign),
1138:                     symmetry.reflect(cursor, sign),
1139:                     symmetry.reflect(self._anchor_normal, sign),
1140:                     self._anchor_radius, accum_add=True)
1141:                 if moved < 0:
1142:                     self._engine_dead = True
1143:                     return
1144:         else:
1145:             pixel_r = mapping.pixel_radius(context.tool_settings.sculpt, self.brush)
1146:             # Vanilla spacing is a percentage of the brush *diameter*:
1147:             # radius * spacing / 50 (#paint_space_stroke_spacing).
1148:             step = max(self.brush.spacing, 1) / 50.0 * pixel_r
1149:             coord = (event.mouse_region_x, event.mouse_region_y)
1150:             # Remember the last-move state so the trailing spline segment can be
1151:             # flushed on release (the release event carries no spline context).
1152:             self._last_invert = invert
1153:             self._last_pressure = event.pressure
1154:             self._last_spacing = step
1155:             points = self._spacer.add(coord, step, sample)
1156:             if self._batch:
1157:                 if points and not self._engine_dead:
1158:                     self._apply_batch(context, points)
1159:             else:
1160:                 for point, dab_sample in points:
1161:                     self._apply_spaced_dab(context, point, dab_sample)
1162: 
1163:         # Face sets and colour are cage attributes a subdivided level only
1164:         # mirrors, so this batch's paint is carried onto the cage and the grids
1165:         # it touched are re-derived from it -- now, not at stroke end, or the
1166:         # stroke would draw at grid resolution and then snap to the cage's on
1167:         # release (§6.3 of plans/grid-domain-attributes.md).
1168:         if self.session.multires_ptr and not self.session.last_stroke_cage:
1169:             undo.scatter_cage_columns(self.session)
1170:         if redraw:
1171:             self._mid_redraw(context)
1172: 
1173:     def _mid_redraw(self, context):
1174:         """Throttled mid-stroke refresh: the draw provider needs only its GPU
1175:         buffers refreshed; the Mesh write-back is deferred to the mode's flush
1176:         callback. The full flush remains only for the no-provider fallback,
1177:         where the viewport draws the Mesh itself."""
1178:         import time
1179:         now = time.monotonic()
1180:         # Cadence: wall-clock throttle AND a frame consumed the last refresh.
1181:         # Above 30 fps the frame gate never engages (a frame always presents
1182:         # between two 33 ms throttle passes); it sheds refreshes only when
1183:         # events outrun frames — event floods and frame-bound heavy scenes —
1184:         # where a refill no frame reads is provably wasted work.
1185:         if (now - self._last_flush > 1.0 / 30.0
1186:                 and _frames_presented != self._flush_frame):
1187:             # Deferred grids normals resolve at the same cadence the provider
1188:             # re-uploads, so shading and geometry stay in step.
1189:             if self.session.last_stroke_grids and self.session.grid_ptr:
1190:                 engine.capi().lib.GridStroke_flushNormals(self.session.grid_ptr)
1191:             if self.session.draw_key:
1192:                 convert.draw_refresh(context.active_object)
1193:             else:
1194:                 convert.flush(context.active_object)
1195:             self._last_flush = now
1196:             self._flush_frame = _frames_presented
1197:         # Region, not area: area.tag_redraw() would redraw every region of the
1198:         # View3D area per event -- header, toolbar, sidebar and the brush asset
1199:         # shelf, whose preview icons re-upload and re-mip ~10 textures a frame
1200:         # (immDrawPixels creates them from scratch). Native sculpt tags only
1201:         # the drawing region; match it.
1202:         context.region.tag_redraw()
1203: 
1204:     def _track_pivot(self, position):
1205:         """Fold one logical dab's object-space center into the stroke's running
1206:         pivot sum (see ``_publish_pivot``)."""
1207:         for i in range(3):
1208:             self._pivot_sum[i] += position[i]
1209:         self._pivot_n += 1
1210: 
1211:     def _publish_pivot(self, context, ob):
1212:         """Hand the stroke's average center to Blender as the orbit pivot.
1213: 
1214:         ``view3d_orbit_calc_center`` reads it back through
1215:         ``BKE_paint_stroke_get_average`` for a custom mode that declares
1216:         ``bl_use_sculpt_paint``, so "Orbit Around Selection" follows the last
1217:         stroke instead of sitting at the object origin. World space, because
1218:         that is what the Paint runtime stores."""
1219:         if not self._pivot_n:
1220:             return
1221:         import mathutils
1222:         mean = mathutils.Vector(self._pivot_sum) / self._pivot_n
1223:         context.tool_settings.sculpt.stroke_pivot = ob.matrix_world @ mean
1224: 
1225:     def _apply_one_image(self, position, normal, world_radius, due, snake_delta=None):
1226:         """Apply one dab image (primary or a symmetry mirror) through the active
1227:         path — plain, autosmooth-program, or dyntopo. Each image gets a unique
1228:         monotonic seed (dyntopo independent-set selection). ``snake_delta`` is
1229:         this image's drag step for the snake-hook kernel (already reflected for
1230:         a mirror image); None for every other brush."""
1231:         if self._engine_dead:
1232:             return
1233:         self._dab_count += 1
1234:         seed = self._dab_count
1235:         if self.session.multires_ptr and not self.session.last_stroke_cage:
1236:             # The region this dab paints, for the per-dab cage collapse: a dab
1237:             # smaller than a base face moves no cage vert, so the collapse has
1238:             # no other way to learn which grids to re-derive (see
1239:             # undo.scatter_cage_columns). Grab-class dabs skip this path and
1240:             # never write an attribute; cage-dab strokes write the cage
1241:             # directly, so there is nothing to collapse.
1242:             self.session.dab_regions.extend(
1243:                 (position[0], position[1], position[2], world_radius))
1244:         if snake_delta is not None:
1245:             set_snake_hook_state(self.session, position, snake_delta)
1246:         if self._dyntopo is not None:
1247:             moved = apply_dyntopo_dab(self.session, self._program, position, normal,
1248:                                      world_radius, self._dyntopo if due else None, seed)
1249:         elif self._program is not None:
1250:             moved = apply_dab_program(self.session, self._program, position, normal,
1251:                                      world_radius, kernel=self.kernel)
1252:         else:
1253:             moved = apply_dab(self.session, self.kernel, position, normal, world_radius)
1254:         if moved < 0:
1255:             self._engine_dead = True
1256: 
1257:     def _snake_hook_advance(self, context, point):
1258:         """The snake-hook dab center and drag step for one spacer-emitted point,
1259:         as ``(center, delta)``; None while the stroke has yet to find a surface
1260:         to start from.
1261: 
1262:         Vanilla decouples this brush from the surface after the first dab
1263:         (sculpt.cc ``brush_delta_update`` / ``stroke_cache_update``): the center
1264:         is seeded from the stroke's first hit and thereafter advanced only by the
1265:         previous dab's delta, never re-read from the sample under the cursor. So
1266:         the influence region walks out with the extruded tip instead of snapping
1267:         back to whatever surface the cursor still points at — and the stroke
1268:         keeps working once the tip has left the mesh entirely. The cursor
1269:         contributes only the step, measured on the view-facing plane through the
1270:         seed point (vanilla's ``orig_grab_location`` depth)."""
1271:         if self._sh_center is None:
1272:             origin, direction = _ray_origin_dir(context, point)
1273:             hit = raycast(self.session, origin, direction)
1274:             if hit is None:
1275:                 return None  # nothing to hook yet; the next sample retries
1276:             position, normal, _face = hit
1277:             self._sh_origin = position
1278:             self._sh_normal = normal
1279:             self._sh_center = position
1280:             self._sh_plane = _coord_on_plane(context, point, position)
1281:             self._sh_delta = (0.0, 0.0, 0.0)
1282:             return position, self._sh_delta
1283:         # Advance by the *previous* step before measuring the new one, so the
1284:         # region trails the tip by one dab exactly as vanilla's cache does.
1285:         center = tuple(self._sh_center[i] + self._sh_delta[i] for i in range(3))
1286:         plane = _coord_on_plane(context, point, self._sh_origin)
1287:         delta = tuple(plane[i] - self._sh_plane[i] for i in range(3))
1288:         self._sh_center = center
1289:         self._sh_plane = plane
1290:         self._sh_delta = delta
1291:         return center, delta
1292: 
1293:     def _apply_spaced_dab(self, context, point, sample):
1294:         """Resolve one spacer-emitted 2D point to a dab center — the surface hit
1295:         under it, or for snake hook the advancing tip center — and apply the
1296:         primary dab plus one reflected dab per symmetry mirror."""
1297:         if self._engine_dead:
1298:             return
1299:         invert, pressure = sample.invert, sample.pressure
1300:         sample.upload(self.session.brush_obj)
1301:         snake_delta = None
1302:         if self._snake_hook:
1303:             advance = self._snake_hook_advance(context, point)
1304:             if advance is None:
1305:                 return
1306:             position, snake_delta = advance
1307:             # No hit to sample once the region has walked off the surface, so
1308:             # the seed normal stands for the stroke. (Vanilla recomputes an area
1309:             # normal from the affected verts instead — and freezes it outright
1310:             # when normal_weight > 0.)
1311:             normal = self._sh_normal
1312:         else:
1313:             origin, direction = _ray_origin_dir(context, point)
1314:             hit = raycast(self.session, origin, direction)
1315:             if hit is None:
1316:                 return
1317:             position, normal, _face = hit
1318:         world_radius = _world_radius(context, self.brush, position)
1319:         self._track_pivot(position)
1320:         unified = context.tool_settings.sculpt.unified_paint_settings
1321:         # Advance the stroke arc length and decide the dyntopo cadence once per
1322:         # logical dab, so every mirror image remeshes on the same samples
1323:         # (a per-image decision would let the primary starve the mirrors).
1324:         self._stroke_s += self._last_spacing
1325:         due = (self._dyntopo is not None
1326:                and dyntopo_due(self._stroke_s, self._last_dyntopo_s, self._dyntopo_spacing))
1327:         if due:
1328:             self._last_dyntopo_s = self._stroke_s
1329:             if self._detail_factor is not None:
1330:                 # RELATIVE/BRUSH detail scales with the (depth-dependent)
1331:                 # world radius; refresh the bounds for this remesh pass.
1332:                 l_max = self._detail_factor * world_radius
1333:                 build_dyntopo_params(self.session, l_max,
1334:                                      l_max * DYNTOPO_EDGE_MIN_FACTOR)
1335: 
1336:         if self._smooth_stroke:
1337:             # Multi-pass smooth (vanilla semantics): strength maps to N
1338:             # relaxation passes at explicit per-pass strengths. Pressure and the
1339:             # overlap factor fold into the base Python-side (smooth registers no
1340:             # engine dynamics — see invoke); the pressure factor comes from the
1341:             # baked curve_strength / curve_size response LUTs.
1342:             strength = self.brush.strength
1343:             if unified.use_unified_strength:
1344:                 strength = unified.strength
1345:             if self._pressure_strength_lut is not None and pressure is not None:
1346:                 strength *= mapping.eval_pressure_lut(self._pressure_strength_lut, pressure)
1347:             if self._pressure_size_lut is not None and pressure is not None:
1348:                 world_radius *= mapping.eval_pressure_lut(self._pressure_size_lut, pressure)
1349:             for pass_strength in smooth_iteration_strengths(strength * self._overlap):
1350:                 # Smoothing has no inverse (see apply_dab_state): ignore Ctrl
1351:                 # and the brush direction for the smooth passes.
1352:                 mapping.apply_dab_state(self.brush, unified, self.session.brush_obj,
1353:                                         world_radius=world_radius, invert=False,
1354:                                         strength_override=pass_strength,
1355:                                         allow_invert=False)
1356:                 self._apply_one_image(position, normal, world_radius, due,
1357:                                       snake_delta=snake_delta)
1358:                 for sign in self._mirror_signs:
1359:                     self._apply_one_image(
1360:                         symmetry.reflect(position, sign),
1361:                         symmetry.reflect(normal, sign), world_radius, due,
1362:                         snake_delta=(None if snake_delta is None
1363:                                      else symmetry.reflect(snake_delta, sign)))
1364:                 due = False  # remesh at most once per logical dab
1365:             return
1366: 
1367:         mapping.apply_dab_state(self.brush, unified, self.session.brush_obj,
1368:                                 world_radius=world_radius, invert=invert, strength_scale=self._overlap)
1369:         self._apply_one_image(position, normal, world_radius, due,
1370:                               snake_delta=snake_delta)
1371:         # Symmetry mirror images: reflect the resolved primary center and normal
1372:         # directly (mirror the operation, as vanilla sculpt does), reusing the
1373:         # primary's world radius. Re-raycasting the mirrored view ray instead —
1374:         # as the reference app does — is only equivariant where the mirrored
1375:         # surface is identical and the mirrored ray hits at all; reflecting the
1376:         # resolved hit is exact and cannot drop a mirror image.
1377:         for sign in self._mirror_signs:
1378:             self._apply_one_image(
1379:                 symmetry.reflect(position, sign),
1380:                 symmetry.reflect(normal, sign), world_radius, due,
1381:                 snake_delta=(None if snake_delta is None
1382:                              else symmetry.reflect(snake_delta, sign)))
1383: 
1384:     def _apply_batch(self, context, points):
1385:         """The C++ dab loop (``sculptcore_cpp_dab_loop``): resolve and apply
1386:         every spacer-emitted point of one pointer event in two flat engine
1387:         calls — a batch raycast and a dab batch — instead of one Python
1388:         round-trip per dab. Ray synthesis and the post-cast world radius use
1389:         the exact math of ``_apply_spaced_dab``; the engine side runs the same
1390:         prop-write / device-refill / apply / symmetry cycle per dab (see
1391:         ``GridStroke_dabBatch`` / ``MeshStroke_dabBatch``). A negative return
1392:         is the engine's stroke-dead sentinel (stale grids domain, §7 of the
1393:         design): flag it and let invoke/modal tear the stroke down — never
1394:         fall back to the Python path mid-stroke."""
1395:         import numpy as np
1396: 
1397:         session = self.session
1398:         lib = engine.capi().lib
1399:         n = len(points)
1400:         rays = np.empty((n, 6), dtype=np.float32)
1401:         for i, (point, sample) in enumerate(points):
1402:             origin, direction = _ray_origin_dir(context, point)
1403:             rays[i, 0:3] = origin
1404:             rays[i, 3:6] = direction
1405:         hits = np.zeros((n, 6), dtype=np.float32)
1406:         hit_mask = np.zeros(n, dtype=np.uint8)
1407:         grids = bool(session.last_stroke_grids and session.grid_ptr)
1408:         if grids:
1409:             hit_count = lib.GridStroke_castBatch(
1410:                 session.grid_ptr, n, rays, hits, hit_mask)
1411:         else:
1412:             hit_count = lib.MeshStroke_castBatch(
1413:                 session.tree().ptr, n, rays, hits, hit_mask)
1414:         if hit_count < 0:
1415:             self._engine_dead = True
1416:             return
1417:         if hit_count == 0:
1418:             return
1419:         # Per logical dab: the depth-dependent world radius (the one per-dab
1420:         # quantity Python still owns — it needs the region/view matrices) and
1421:         # the pivot fold, primaries only, as the per-dab path does.
1422:         dabs = np.empty((hit_count, 7), dtype=np.float32)
1423:         inputs = np.empty((hit_count, 6), dtype=np.float32)
1424:         row = 0
1425:         for i in range(n):
1426:             if not hit_mask[i]:
1427:                 continue
1428:             position = (float(hits[i, 0]), float(hits[i, 1]), float(hits[i, 2]))
1429:             self._track_pivot(position)
1430:             dabs[row, 0:6] = hits[i]
1431:             dabs[row, 6] = _world_radius(context, self.brush, position)
1432:             sample = points[i][1]
1433:             inputs[row, :5] = sample.batch_row()
1434:             inputs[row, 5] = sample.invert ^ (self.brush.direction == 'SUBTRACT')
1435:             row += 1
1436:         if session.multires_ptr:
1437:             # The regions this batch paints, for the per-dab cage collapse (see
1438:             # undo.scatter_cage_columns). The mirror images are applied engine
1439:             # side, so reflect them here -- the collapse needs every sphere the
1440:             # kernel wrote into, not just the primaries.
1441:             for i in range(hit_count):
1442:                 centre = (float(dabs[i, 0]), float(dabs[i, 1]), float(dabs[i, 2]))
1443:                 radius = float(dabs[i, 6])
1444:                 session.dab_regions.extend(centre + (radius,))
1445:                 for sign in self._mirror_signs:
1446:                     session.dab_regions.extend(
1447:                         tuple(symmetry.reflect(centre, sign)) + (radius,))
1448:         # Strength/invert exactly as mapping.apply_dab_state folds them; both
1449:         # are constant across the event's batch (pressure reaches strength
1450:         # through the engine's device dynamics, not this scalar).
1451:         unified = context.tool_settings.sculpt.unified_paint_settings
1452:         strength = (unified.strength if unified.use_unified_strength
1453:                     else self.brush.strength) * self._overlap
1454:         self._dab_count += hit_count * (1 + len(self._mirror_signs))
1455:         if grids and self._program is not None:
1456:             moved = lib.GridStroke_dabBatchProgramInputs(
1457:                 session.grid_ptr, self._program.ptr, hit_count, dabs,
1458:                 strength, inputs,
1459:                 self._mirror_flat, len(self._mirror_signs), 2)
1460:         elif grids:
1461:             moved = lib.GridStroke_dabBatchInputs(
1462:                 session.grid_ptr, int(self.kernel), hit_count, dabs,
1463:                 strength, inputs,
1464:                 self._mirror_flat, len(self._mirror_signs), 2)
1465:         elif self._program is not None:
1466:             moved = lib.MeshStroke_dabBatchProgramInputs(
1467:                 _ensure_executor(session).ptr, session.tree().ptr,
1468:                 session.mesh().ptr, _ensure_brush(session).ptr,
1469:                 self._program.ptr, hit_count, dabs,
1470:                 strength, inputs,
1471:                 self._filter_mul, self._mirror_flat, len(self._mirror_signs), 2)
1472:         else:
1473:             moved = lib.MeshStroke_dabBatchInputs(
1474:                 _ensure_executor(session).ptr, session.tree().ptr,
1475:                 session.mesh().ptr, _ensure_brush(session).ptr,
1476:                 int(self.kernel), hit_count, dabs,
1477:                 strength, inputs,
1478:                 self._filter_mul, self._mirror_flat, len(self._mirror_signs), 2)
1479:         if moved < 0:
1480:             self._engine_dead = True
1481: 
1482:     def _finish(self, context, status):
1483:         ob = context.active_object
1484:         _draw_counter_pop()
1485:         cursor.set_size_scale(1.0)
1486:         # On commit, flush the trailing spline segment held back by the
1487:         # 1-segment lookahead (right-clamped); cancel drops it.
1488:         if status == 'FINISHED' and not self._grab_class:
1489:             points = self._spacer.flush(self._last_spacing)
1490:             if self._batch:
1491:                 if points and not self._engine_dead:
1492:                     self._apply_batch(context, points)
1493:             else:
1494:                 for point, sample in points:
1495:                     self._apply_spaced_dab(context, point, sample)
1496:         if self._engine_dead:
1497:             status = 'CANCELLED'
1498:         stroke_end(self.session)
1499:         # Deferred write-back: with the draw provider active the viewport only
1500:         # needs its GPU buffers; the Mesh ID syncs on demand through the
1501:         # mode's flush callback (memfile encode / save / render). This keeps
1502:         # stroke release free of the full Mesh (or MDISPS bake) write.
1503:         if self.session.draw_key:
1504:             convert.draw_refresh(ob)
1505:         else:
1506:             convert.flush(ob)
1507:         # The stroke mutated geometry (dabs applied before release/cancel), so
1508:         # push its delta-undo step regardless of finish vs cancel.
1509:         undo.push(context, ob, self.session)
1510:         self._publish_pivot(context, ob)
1511:         if context.area:  # absent on cancel() teardown (window close)
1512:             context.area.tag_redraw()
1513:         return {status}
1514: 
1515:     def _preview_apply_image(self, center, normal, world_radius, extend,
1516:                              snake_delta=None):
1517:         """Snapshot one dab image's region into the open preview session
1518:         (``begin`` for the primary, ``extend`` for each mirror), then deform it.
1519:         Snapshotting before the deform lets the whole group roll back together.
1520:         No dyntopo in the preview path (anchored/drag-dot deform only)."""
1521:         if self._engine_dead:
1522:             return
1523:         if snake_delta is not None:
1524:             set_snake_hook_state(self.session, center, snake_delta)
1525:         mgr = engine.manager()
1526:         executor = _ensure_executor(self.session)
1527:         center_v = _float3(mgr, *center)
1528:         # The snapshot must cover everything the dab will touch, so it takes the
1529:         # dab's node-filter radius, not the falloff radius — a preview sized
1530:         # smaller than an unbounded field would leave residue on rollback.
1531:         preview_r = brush_policy.field_radius(
1532:             self.kernel, world_radius, self.session.brush_obj)
1533:         try:
1534:             if extend:
1535:                 executor.extendPreviewDab(center_v, preview_r)
1536:             else:
1537:                 executor.beginPreviewDab(center_v, preview_r)
1538:         finally:
1539:             center_v.dispose()
1540:         if self._program is not None:
1541:             moved = apply_dab_program(self.session, self._program, center, normal,
1542:                                      world_radius, kernel=self.kernel)
1543:         else:
1544:             moved = apply_dab(self.session, self.kernel, center, normal, world_radius)
1545:         if moved < 0:
1546:             self._engine_dead = True
1547: 
1548:     def _dab_preview(self, context, event):
1549:         """Anchored / Drag-Dot: one live dab (plus mirrors) inside a preview
1550:         bracket so successive inputs never compound. Resolve the new dab first,
1551:         then roll back the previous provisional group and apply the new one."""
1552:         sample = self._read_input(event)
1553:         if sample is None:
1554:             return
1555:         sample.upload(self.session.brush_obj)
1556:         invert = sample.invert
1557:         executor = _ensure_executor(self.session)
1558:         coord = (event.mouse_region_x, event.mouse_region_y)
1559: 
1560:         if self._stroke_method == 'ANCHORED':
1561:             # Dab pinned at the anchor; radius grows with screen-space drag.
1562:             center = self._anchor
1563:             normal = self._anchor_normal
1564:             import mathutils
1565:             drag_px = (mathutils.Vector(coord)
1566:                        - mathutils.Vector(self._anchor_screen)).length
1567:             # Radius is the unprojected drag length (0 at the anchor, growing as
1568:             # the cursor pulls away); check `is None` so a genuine 0 is kept.
1569:             world_radius = _pixel_to_world_length(context, center, drag_px)
1570:             if world_radius is None:
1571:                 world_radius = self._anchor_radius
1572:         else:  # DRAG_DOT: one dab at the live cursor.
1573:             origin, direction = _ray_origin_dir(context, coord)
1574:             hit = raycast(self.session, origin, direction)
1575:             if hit is None:
1576:                 # Cursor off the surface: keep the previous provisional dab.
1577:                 return
1578:             center, normal, _ = hit
1579:             world_radius = _world_radius(context, self.brush, center)
1580:             if self._snake_hook and self._preview_origin is None:
1581:                 self._preview_origin = center
1582: 
1583:         # A preview dab is rolled back and re-applied from the same base on
1584:         # every input, so snake hook's drag is the whole drag since the stroke
1585:         # start (vanilla's anchored grab-delta branch), not the step since the
1586:         # last input. Anchored pins the center, so its drag comes from the
1587:         # cursor plane point; drag-dot's center moves with the cursor.
1588:         snake_delta = None
1589:         if self._snake_hook:
1590:             if self._stroke_method == 'ANCHORED':
1591:                 plane_point = _cursor_on_anchor_plane(context, event, self._anchor)
1592:                 snake_delta = tuple(plane_point[i] - self._drag_origin[i] for i in range(3))
1593:             else:
1594:                 snake_delta = tuple(center[i] - self._preview_origin[i] for i in range(3))
1595: 
1596:         unified = context.tool_settings.sculpt.unified_paint_settings
1597:         if self._smooth_stroke:
1598:             # Smooth registers no engine dynamics (see invoke): fold pressure
1599:             # into strength / radius Python-side through the baked LUTs.
1600:             strength = self.brush.strength
1601:             if unified.use_unified_strength:
1602:                 strength = unified.strength
1603:             strength *= self._overlap
1604:             if self._pressure_strength_lut is not None and sample.pressure is not None:
1605:                 strength *= mapping.eval_pressure_lut(self._pressure_strength_lut, sample.pressure)
1606:             if self._pressure_size_lut is not None and sample.pressure is not None:
1607:                 world_radius *= mapping.eval_pressure_lut(self._pressure_size_lut, sample.pressure)
1608:             mapping.apply_dab_state(self.brush, unified, self.session.brush_obj,
1609:                                     world_radius=world_radius, invert=invert,
1610:                                     strength_override=strength, allow_invert=False)
1611:         else:
1612:             mapping.apply_dab_state(self.brush, unified, self.session.brush_obj,
1613:                                     world_radius=world_radius, invert=invert,
1614:                                     strength_scale=self._overlap, allow_invert=True)
1615:         # Roll back the previous provisional group only now that a new dab is
1616:         # resolved (a drag-dot miss above leaves the last dab intact).
1617:         valid = (executor.preflightRawProgram(self._program) if self._program is not None
1618:                  else executor.preflightRaw(self.kernel))
1619:         if not valid:
1620:             self._engine_dead = True
1621:             return
1622:         if executor.previewActive():
1623:             executor.rollbackPreviewDab()
1624:             # The rollback moved verts back, so the node bounds are stale in the
1625:             # other direction now — refresh before this tick's dab filters.
1626:             _refresh_queries(self.session)
1627:         # Only the last provisional dab survives the preview bracket, so the
1628:         # pivot replaces rather than accumulates (an average over every input
1629:         # would drag it back toward the stroke's first position).
1630:         self._pivot_sum = list(center)
1631:         self._pivot_n = 1
1632:         self._preview_apply_image(center, normal, world_radius, extend=False,
1633:                                   snake_delta=snake_delta)
1634:         # Mirror images share the one preview bracket, so one rollback reverts
1635:         # the whole group.
1636:         for sign in self._mirror_signs:
1637:             self._preview_apply_image(
1638:                 symmetry.reflect(center, sign), symmetry.reflect(normal, sign),
1639:                 world_radius, extend=True,
1640:                 snake_delta=None if snake_delta is None else symmetry.reflect(snake_delta, sign))
1641:         self._mid_redraw(context)
1642: 
1643:     def _finish_preview(self, context, commit):
1644:         """End an anchored / drag-dot stroke: commit keeps the one live dab and
1645:         pushes an undo step; cancel rolls it back and pushes nothing (the mesh
1646:         is left exactly as the stroke began)."""
1647:         ob = context.active_object
1648:         _draw_counter_pop()
1649:         cursor.set_size_scale(1.0)
1650:         executor = _ensure_executor(self.session)
1651:         if executor.previewActive():
1652:             if commit:
1653:                 executor.commitPreviewDab()
1654:             else:
1655:                 executor.rollbackPreviewDab()
1656:         stroke_end(self.session)
1657:         if self.session.draw_key:
1658:             convert.draw_refresh(ob)
1659:         else:
1660:             convert.flush(ob)
1661:         if commit:
1662:             undo.push(context, ob, self.session)
1663:             # A rolled-back preview left the mesh as the stroke found it, so it
1664:             # gets no say in the pivot.
1665:             self._publish_pivot(context, ob)
1666:         if context.area:  # absent on cancel() teardown (window close)
1667:             context.area.tag_redraw()
1668:         return {'FINISHED' if commit else 'CANCELLED'}
1669: 
1670:     def _publish_cursor_pressure(self, pressure):
1671:         """Scale the viewport cursor circle by the current size-pressure factor
1672:         so it tracks the pen like the deformation does (1.0 when size pressure
1673:         is off)."""
1674:         scale = 1.0
1675:         if self._pressure_size_lut is not None:
1676:             scale = mapping.eval_pressure_lut(self._pressure_size_lut, pressure)
1677:         cursor.set_size_scale(scale)
1678: 
1679:     def _read_input(self, event):
1680:         return self._input_sampler.read(
1681:             event, (event.mouse_region_x, event.mouse_region_y), event.ctrl or self.mode == 'INVERT')
1682: 
1683:     def modal(self, context, event):
1684:         if event.type in _MOVE_EVENT_TYPES:
1685:             # Blender never drops a queued pointer sample: when moves pile up
1686:             # behind a busy main thread it retypes all but the newest of the run
1687:             # to INBETWEEN_MOUSEMOVE (#wm_event_add_mousemove) and delivers them
1688:             # all. Ignoring the inbetweens made the stroke jump straight to the
1689:             # newest position, discarding exactly the hand motion the spacer
1690:             # would have dabbed along -- the harder the scene, the more of the
1691:             # stroke went missing. Native sculpt consumes them too, skipping
1692:             # only the paint-cursor update (#paint_stroke_modal).
1693:             live = event.type == 'MOUSEMOVE'
1694:             if live:
1695:                 self._publish_cursor_pressure(event.pressure)
1696:             if self._preview_method:
1697:                 self._dab_preview(context, event)
1698:             else:
1699:                 # The backlog is sculpted but not presented per sample: the run
1700:                 # always ends on a live MOUSEMOVE, which carries the redraw for
1701:                 # the whole batch.
1702:                 self._dab_at(context, event, redraw=live)
1703:             if self._engine_dead:
1704:                 self.report({'WARNING'}, "SculptCore: engine refused the stroke; see the system console")
1705:                 if self._preview_method:
1706:                     return self._finish_preview(context, commit=False)
1707:                 return self._finish(context, 'CANCELLED')
1708:             return {'RUNNING_MODAL'}
1709:         if event.type == 'LEFTMOUSE' and event.value == 'RELEASE':
1710:             if self._preview_method:
1711:                 return self._finish_preview(context, commit=True)
1712:             if not self._grab_class:
1713:                 self._dab_at(context, event, redraw=False)
1714:             return self._finish(context, 'FINISHED')
1715:         if event.type in {'RIGHTMOUSE', 'ESC'}:
1716:             if self._preview_method:
1717:                 return self._finish_preview(context, commit=False)
1718:             return self._finish(context, 'CANCELLED')
1719:         return {'RUNNING_MODAL'}
1720: 
1721:     def cancel(self, context):
1722:         """System-side teardown — window close or a forced modal cancel, where
1723:         no release event will ever arrive. Same rollback path as ESC (the undo
1724:         step still lands for whatever dabs applied); Blender ignores the
1725:         return value here."""
1726:         if self._preview_method:
1727:             self._finish_preview(context, commit=False)
1728:         else:
1729:             self._finish(context, 'CANCELLED')
1730: 
