176: 
177: def grids_capable(session, brush_type):
178:     """Whether a stroke of ``brush_type`` can run grids-native (multires
179:     session + engine roster kernel). MASK qualifies since MK4 made the store
180:     the addon's one mask truth (the slot column is a cache the fold/sync
181:     machinery keeps honest).
182: 
183:     Brushes that write an attribute layer are answered by the engine roster
184:     itself, from the attribute's storage class: Blender declares only the mask
185:     as a host grid attribute, so colour and face sets are ``Derived`` and take
186:     the cage route (mesh path + a per-dab write-back) instead."""
187:     global _bsmooth_kernel_id
188:     if not session.multires_ptr:
189:         return False
190:     if _bsmooth_kernel_id is None:
191:         mgr = engine.manager()
192:         items = mgr.get("sculptcore::brush::SculptBrushes").items
193:         _bsmooth_kernel_id = int(items['BSMOOTH'])
194:     lib = engine.capi().lib
195:     # The multires is not optional here: an attribute brush's route is its
196:     # attribute's storage class, which is per-object state (a host that CAN
197:     # store multires attributes declares them, and only then may a kernel
198:     # write grid elements). session.multires_ptr is live -- the early return
199:     # above refused a session without one.
200:     return bool(lib.GridStroke_supported(session.multires_ptr, int(brush_type)))
201: 
202: 
203: def program_grids_capable(session, main_kernel):
204:     """Whether an autosmooth program ``[main_kernel, BSMOOTH]`` can run
205:     grids-native: both entries must pass ``grids_capable``."""
206:     if not grids_capable(session, main_kernel):
207:         return False
208:     return grids_capable(session, _bsmooth_kernel_id)
