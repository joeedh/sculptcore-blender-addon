408:   /** Set `ctx.renderMatrix` (ViewPlane/ViewRepeat texture UV) from 16 flat
409:    * floats, in the same element order as the debug app's `set_render_matrix`
410:    * verb. Bound-Vector arg = the marshal-safe bridge seam. Wrong size is a
411:    * no-op. */
412:   void setRenderMatrix(Vector<float> &m16)
413:   {
414:     if (m16.size() != 16) {
415:       return;
416:     }
417:     float *dst = &ctx.renderMatrix[0][0];
418:     for (int i = 0; i < 16; i++) {
419:       dst[i] = m16[i];
420:     }
421:   }
