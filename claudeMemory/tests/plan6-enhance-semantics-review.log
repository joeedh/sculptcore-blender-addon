329: def smooth_iteration_strengths(strength):
330:     """Vanilla smooth-brush semantics (#iteration_strengths): the strength
331:     (clamped to 1) maps to `int(strength * 4)` full-strength relaxation
332:     passes per dab plus one remainder pass, so higher strength iterates more
333:     instead of overshooting a single pass."""
334:     clamped = min(max(strength, 0.0), 1.0)
335:     count = int(clamped * 4)
336:     last = 4.0 * (clamped - count / 4.0)
337:     passes = [1.0] * count
338:     if last > 1e-4:
339:         passes.append(last)
340:     return passes
341: 
