116: // View-normal automask defaults (radians): fade to nothing at 90Â° off head-on,
117: // over a 25Â° ramp â€” so full strength holds until 65Â°. Live here rather than in
118: // automask.h so brush.h needn't pull mesh.h in; automask.h reads them back.
119: inline constexpr float kViewNormalLimitDefault = 1.5707964f;
