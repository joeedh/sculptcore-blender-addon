256: static void unboundedSnapshots()
257: {
258:   Brush brush;
259:   brush.unboundedExtent = 7;
260:   PreparedBrushScalars inherited, declared;
261:   test_assert(prepareBrushScalars(brush, {}, brush.deviceInputCtx, inherited).error ==
262:               PropError::ERROR_NONE);
263:   test_assert(inherited.unboundedExtent() == 7);
264:   const BrushUniformManifestEntry manifest{
265:       "unboundedExtent", true, true, 0, false, 0, 0, -1, props::Prop::FLOAT32, true};
266:   const BrushScalarOverride override{"unboundedExtent", props::Prop::FLOAT32, 3};
267:   test_assert(prepareBrushScalars(
268:                   brush, {&manifest, 1}, brush.deviceInputCtx, declared, {&override, 1})
269:                   .error == PropError::ERROR_NONE);
270:   test_assert(declared.unboundedExtent() == 3 && inherited.unboundedExtent() == 7 &&
271:               brush.unboundedExtent == 7);
272:   test_assert(
273:       prepareBrushScalars(brush, {}, brush.deviceInputCtx, inherited, {&override, 1})
274:           .error == PropError::ERROR_NOT_EXISTS);
275:   test_assert(inherited.unboundedExtent() == 7);
276:   test_assert(validateUnboundedSupport(inherited, .5f).error == PropError::ERROR_NONE);
277:   for (auto [radius, extent] : {std::pair{1e30f, 1e30f},
278:                                 std::pair{1e-20f, 1e-30f},
279:                                 std::pair{1.0f, std::numeric_limits<float>::denorm_min()},
280:                                 std::pair{1.0f, std::numeric_limits<float>::infinity()}})
281:   {
282:     brush.unboundedExtent = extent;
283:     test_assert(prepareBrushScalars(brush, {}, brush.deviceInputCtx, inherited).error ==
284:                 PropError::ERROR_NONE);
285:     test_assert(validateUnboundedSupport(inherited, radius).error ==
286:                 PropError::ERROR_INVALID_VALUE);
287:     test_assert(validateUnboundedSupport(inherited, 0).error == PropError::ERROR_NONE);
288:   }
289:   for (float extent : {-1.0f, 0.0f}) {
290:     brush.unboundedExtent = extent;
291:     test_assert(prepareBrushScalars(brush, {}, brush.deviceInputCtx, inherited).error ==
292:                 PropError::ERROR_NONE);
293:     test_assert(validateUnboundedSupport(inherited, std::ldexp(1.0f, -127)).error ==
294:                 PropError::ERROR_NONE);
295:     test_assert(
296:         validateUnboundedSupport(inherited, std::nextafter(std::ldexp(1.0f, -128), 1.0f))
297:             .error == PropError::ERROR_NONE);
298:     test_assert(validateUnboundedSupport(inherited, std::ldexp(1.0f, -128)).error ==
299:                 PropError::ERROR_INVALID_VALUE);
300:   }
301:   brush.grabTo[1] = std::numeric_limits<float>::quiet_NaN();
302:   test_assert(validateUnboundedSupport(inherited, 1).error ==
303:               PropError::ERROR_INVALID_VALUE);
304:   fprintf(stderr,
305:           "unbounded extent snapshots, override eligibility and numerical preflight "
306:           "passed\n");
307: }
