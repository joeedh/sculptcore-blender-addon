95: ScalarDeclaration declarationOf(const BrushUniformManifestEntry &entry)
96: {
97:   return {entry.name,
98:           entry.scalarType,
99:           entry.hasDefault,
100:           entry.def,
101:           entry.hasRange,
102:           entry.rangeMin,
103:           entry.rangeMax,
104:           entry.dynamic};
105: }
