218: class _PropertyAccess:
219:     def read(self, index, *, evaluate=False):
220:         uniform = self._uniform(index)
221:         if not isinstance(evaluate, bool):
222:             raise TypeError("evaluate must be boolean")
223:         with self._call("read{}ScalarChecked", uniform, evaluate) as result:
224:             _check(result.status)
225:             return bool(result.value) if uniform.scalar_type == BOOL else (
226:                 int(result.value) if uniform.scalar_type == INT32 else result.value)
227: 
228:     def write(self, index, value):
229:         uniform = self._uniform(index)
230:         _check(self._call("write{}ScalarChecked", uniform, _scalar(uniform.scalar_type, value)))
231: 
232:     def replace_stack(self, index, layers):
233:         uniform = self._uniform(index)
234:         arrays = _stack_arrays(layers)
235:         with ExitStack() as stack:
236:             vectors = [stack.enter_context(_primitive_vector(self.manager, kind, values))
237:                        for kind, values in arrays]
238:             _check(self._call("replace{}ResponseDynamicsChecked", uniform, *vectors))
239: 
240:     def set_sample(self, index, device, sample_index, count, value):
241:         uniform = self._uniform(index)
242:         device, sample_index, count = _integer(device), _integer(sample_index), _integer(count)
243:         if device not in range(4) or not 2 <= count <= MAX_SAMPLES or not 0 <= sample_index < count:
244:             raise ValueError("Invalid device or sample index/count")
245:         _check(self._call("set{}DynamicSampleChecked", uniform, device, sample_index, count, _float(value)))
246: 
247:     def clear_stack(self, index):
248:         uniform = self._uniform(index)
249:         _check(self._call("clear{}DynamicsChecked", uniform))
250: 
251:     def configure(self, index, device, mode=1, factor=1.0):
252:         uniform = self._uniform(index)
253:         device, mode, factor = _integer(device), _integer(mode), _float(factor)
254:         if device not in range(4) or mode not in range(5) or not 0 <= factor <= 1:
255:             raise ValueError("Invalid device, mode or mixing factor")
256:         _check(self._call("configure{}DynamicChecked", uniform, device, mode, factor))
257: 
258:     def enable(self, index, device, enabled):
259:         uniform = self._uniform(index)
260:         device = _integer(device)
261:         if device not in range(4) or not isinstance(enabled, bool):
262:             raise ValueError("Expected a supported device and a boolean enabled flag")
263:         _check(self._call("enable{}DynamicChecked", uniform, device, int(enabled)))
264: 
265:     def move(self, index, device, destination):
266:         uniform = self._uniform(index)
267:         device, destination = _integer(device), _integer(destination)
268:         if device not in range(4) or destination not in range(4):
269:             raise ValueError("Invalid device or destination index")
270:         _check(self._call("move{}DynamicChecked", uniform, device, destination))
271: 
272:     def replace_table(self, index, device, samples):
273:         uniform = self._uniform(index)
274:         device = _integer(device)
275:         if device not in range(4):
276:             raise ValueError("Invalid device")
277:         with _primitive_vector(self.manager, "float", _samples(samples)) as table:
278:             _check(self._call("replace{}DynamicTableChecked", uniform, device, table))
