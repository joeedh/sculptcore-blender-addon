189: def replace_command_stack(manager, program, command, name, scalar_type, layers):
190:     """Explicit empty disables inheritance; complete upload preserves state on failure."""
191:     command = _integer(command)
192:     if not isinstance(name, str) or not name or '\x00' in name:
193:         raise ValueError("Expected a nonempty property name without NUL")
194:     if _integer(scalar_type) not in (FLOAT32, INT32, BOOL):
195:         raise ValueError("Unsupported scalar type")
196:     arrays = _stack_arrays(layers)
197:     with ExitStack() as stack:
198:         vectors = [stack.enter_context(_primitive_vector(manager, kind, values)) for kind, values in arrays]
199:         function = manager.capi.lib.BrushProgram_replaceResponseDynamicsChecked
200:         function.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_int] + [ctypes.c_void_p] * 8
201:         function.restype = ctypes.c_int
202:         _check(function(program.ptr, command, name.encode('utf-8'), scalar_type, *(vector.ptr for vector in vectors)))
203: 
204: 
205: def inherit_command_stack(program, command, name, scalar_type):
206:     """Remove an explicit override to inherit the live brush stack."""
207:     command = _integer(command)
208:     if not isinstance(name, str) or not name or '\x00' in name:
209:         raise ValueError("Expected a nonempty property name without NUL")
210:     if _integer(scalar_type) not in (FLOAT32, INT32, BOOL):
211:         raise ValueError("Unsupported scalar type")
212:     function = program.manager.capi.lib.BrushProgram_removeDynamicsChecked
213:     function.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_int]
214:     function.restype = ctypes.c_int
215:     _check(function(program.ptr, command, name.encode('utf-8'), scalar_type))
