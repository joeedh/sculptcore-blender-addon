44: /** Restore the failing dab's temporary inputs; earlier accepted dabs stay committed. */
45: class DabInputOverlay {
46:   Brush &brush_;
47:   float radius_, strength_, authoredRadius_ = 0, authoredStrength_ = 0;
48:   bool invert_, authoredInvert_ = false, committed_ = false;
49:   props::Float32Prop *radiusProp_ = nullptr, *strengthProp_ = nullptr;
50:   props::BoolProp *invertProp_ = nullptr;
51:   props::DeviceInputCtx inputs_;
52: 
53:   template <typename P> P *property(const char *name, props::Prop type)
54:   {
55:     if (!brush_.props.struct_def)
56:       return nullptr;
57:     auto *p = brush_.props.struct_def->lookupLocal(name);
58:     if (!p || p->name != util::string(name) || p->type != type)
59:       return nullptr;
60:     auto *typed = static_cast<P *>(static_cast<props::detail::PropBaseType *>(p));
61:     if (typed->getter || typed->setter ||
62:         (typed->binding_offset != -1 && (typed->owner || brush_.props.owner)) ||
63:         (typed->flag & props::PropFlag::READ_ONLY) != props::PropFlag::NONE)
64:       return nullptr;
65:     return typed;
66:   }
67: 
68: public:
69:   explicit DabInputOverlay(Brush &brush)
70:       : brush_(brush), radius_(brush.radius), strength_(brush.strength),
71:         invert_(brush.invert), inputs_(brush.deviceInputCtx)
72:   {
73:     radiusProp_ = property<props::Float32Prop>("radius", props::Prop::FLOAT32);
74:     strengthProp_ = property<props::Float32Prop>("strength", props::Prop::FLOAT32);
75:     invertProp_ = property<props::BoolProp>("invert", props::Prop::BOOL);
76:     if (valid()) {
77:       authoredRadius_ = *radiusProp_->internal_value();
78:       authoredStrength_ = *strengthProp_->internal_value();
79:       authoredInvert_ = *invertProp_->internal_value();
80:     }
81:   }
82:   bool valid() const
83:   {
84:     return radiusProp_ && strengthProp_ && invertProp_;
85:   }
86:   void commit()
87:   {
88:     committed_ = true;
89:   }
90:   ~DabInputOverlay()
91:   {
92:     if (!valid() || committed_)
93:       return;
94:     brush_.radius = radius_;
95:     brush_.strength = strength_;
96:     brush_.invert = invert_;
97:     *radiusProp_->internal_value() = authoredRadius_;
98:     *strengthProp_->internal_value() = authoredStrength_;
99:     *invertProp_->internal_value() = authoredInvert_;
100:     brush_.deviceInputCtx = std::move(inputs_);
101:   }
102: };
103: 
104: /** Inputs rows contain pressure, tilt X/Y, speed, presence mask and invert.
105:  * All arrays are borrowed for the call. Each count describes complete rows. */
106: inline bool validDabInputs(int n,
107:                            const float *dabs,
108:                            float strength,
109:                            const float *inputs,
110:                            const float *signs,
111:                            int mirrors)
112: {
113:   if (n < 0 || n > INT_MAX / 7 || mirrors < 0 || mirrors > INT_MAX / 3 ||
114:       (n && (!dabs || !inputs)) || (mirrors && !signs) || !std::isfinite(strength))
115:     return false;
116:   for (int i = 0; i < n; i++) {
117:     const float *d = dabs + i * 7, *s = inputs + i * 6;
118:     for (int j = 0; j < 7; j++)
119:       if (!std::isfinite(d[j]))
120:         return false;
121:     if (d[6] < 0 || (d[6] > 0 && !std::isfinite(1.0f / d[6])))
122:       return false;
123:     for (int j = 0; j < 4; j++)
124:       if (!std::isfinite(s[j]) || s[j] < 0 || s[j] > 1)
125:         return false;
126:     if (!std::isfinite(s[4]) || s[4] < 0 || s[4] > 15 || std::floor(s[4]) != s[4] ||
127:         (s[5] != 0 && s[5] != 1))
128:       return false;
129:   }
130:   for (int i = 0; i < mirrors * 3; i++)
131:     if (signs[i] != -1 && signs[i] != 1)
132:       return false;
133:   return true;
134: }
135: 
136: /** Replace the host-owned dab values without copying evaluated working caches. */
137: inline void setDabInputs(Brush &brush, float radius, float strength, const float *inputs)
138: {
139:   brush.radius = radius;
140:   brush.strength = strength;
141:   brush.invert = inputs[5] != 0;
142:   brush.props.setValue<float>("radius", radius);
143:   brush.props.setValue<float>("strength", strength);
144:   brush.props.setValue<bool>("invert", brush.invert);
145:   brush.clearDeviceInputs();
146:   for (int i = 0; i < 4; i++)
147:     if (int(inputs[4]) & (1 << i))
148:       brush.pushDeviceInput(i, inputs[i]);
149: }
150: } // namespace sculptcore::brush
