309: static bool exactUnboundedPositions(const std::vector<float3> &a,
310:                                     const std::vector<float3> &b)
311: {
312:   if (a.size() != b.size())
313:     return false;
314:   for (size_t i = 0; i < a.size(); i++)
315:     for (int axis = 0; axis < 3; axis++)
316:       if (a[i][axis] != b[i][axis])
317:         return false;
318:   return true;
319: }
