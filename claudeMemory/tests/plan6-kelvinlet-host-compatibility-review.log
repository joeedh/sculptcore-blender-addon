6: // Included by test_brush_prepared_execution.cc so the numerical oracle and the
7: // actual executor regressions run in the same required native suite.
8: struct KelvinletProbe {
9:   struct Vertex {
10:     float3 co, no{0, 0, 1};
11:     float mask = 0;
12:     int v = 0;
13:   } point;
14:   struct Node {
15:     Vector<int> affected_verts;
16:     bool updated = false;
17:     template <class T> void update(T)
18:     {
19:       updated = true;
20:     }
21:   };
22:   using vertex_iter = Vertex;
23:   using vertex_iter_factory = int;
24:   using face_iter = int;
25:   using node_type = Node;
26:   using capture_policy = MeshCapturePolicy;
27:   static constexpr bool supportsFaceStages = false;
28:   template <class T> std::span<Vertex> makeVertexIter(Node &)
29:   {
30:     return {&point, 1};
31:   }
32:   const float3 *liveVertNoPtr(const CommandCtx<KelvinletProbe> &, int)
33:   {
34:     return &point.no;
35:   }
36: };
