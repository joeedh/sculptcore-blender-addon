321: static void unboundedExecution(bool grid,
322:                                bool programMode,
323:                                bool cavity,
324:                                bool deferred,
325:                                float extent,
326:                                CommandExecutor::NeighborMode neighbors)
327: {
328:   auto *mesh = mesh::createCube(grid ? 4 : 12, 2.0f);
329:   {
330:     subdiv::Multires mr;
331:     mr.init(*mesh, 2);
332:     auto *domain = mr.gridDomain(2);
333:     auto *gridTree = domain->ensureTree(50);
334:     spatial::SpatialTree tree(mesh);
335:     tree.leaf_limit = 32;
336:     tree.buildAll();
337:     test_assert(tree.leaves().size() > 1 && gridTree->leaves.size() > 1);
338:     meshlog::MeshLog meshLog;
339:     meshLog.setActiveMesh(mesh);
340:     subdiv::GridStrokeLog gridLog;
341:     Brush brush;
342:     brush.radius = .25f;
343:     brush.strength = .12f;
344:     brush.unboundedExtent = extent;
345:     brush.grabFrom = float3(.2f, -.1f, 1.1f);
346:     brush.grabTo = float3(.03f, -.02f, .08f);
347:     brush.automask_cavity = cavity;
348:     brush.cavity_factor = 0;
349:     brush.writeProps();
350:     CommandExecutor meshEx(&tree, &brush);
351:     meshEx.meshLog = &meshLog;
352:     meshEx.anchoredGrab = false;
353:     meshEx.neighborMode = neighbors;
354:     GridBrushExecutor gridEx(domain, &brush, &gridLog);
355:     gridEx.anchoredGrab = false;
356:     gridEx.deferNormals = deferred;
357:     if (grid)
358:       gridEx.beginStep();
359:     else
360:       meshEx.beginStep(false);
361:     auto positions = [&]() {
362:       std::vector<float3> output;
363:       const int count = grid ? domain->vertCount() : mesh->v.count;
364:       for (int v = 0; v < count; v++)
365:         output.push_back(grid ? domain->pos()[v] : mesh->v.co[v]);
366:       return output;
367:     };
368:     const auto original = positions();
369:     auto expected = original;
370:     std::vector<bool> contacted(original.size(), false);
371:     BrushProgram program;
372:     if (programMode)
373:       program.addCommand(int(SculptBrushes::DRAW));
374:     const int field = program.addCommand(int(SculptBrushes::KELVINLET));
375:     if (programMode) {
376:       program.setCommandScalarChecked(0, "radius", props::Prop::FLOAT32, .25);
377:       program.setCommandScalarChecked(field, "mu", props::Prop::FLOAT32, 2);
378:       BrushDynamicsOverride material{"mu", props::Prop::FLOAT32, {}};
379:       material.dynamics.configure(
380:           props::DeviceType::PRESSURE, math::BasicMix::MULTIPLY, 1);
381:       program.commands[field].dynamicsOverrides.append(std::move(material));
382:       program.setCommandScalarChecked(field, "nu", props::Prop::FLOAT32, .1f);
383:       BrushDynamicsOverride poisson{"nu", props::Prop::FLOAT32, {}};
384:       poisson.dynamics.configure(props::DeviceType::PRESSURE, math::BasicMix::ADD, .25f);
385:       program.commands[field].dynamicsOverrides.append(std::move(poisson));
386:     }
387:     const float3 center(0, 0, 1), normal(0, 0, 1);
388:     auto run = [&](bool validateOnly = false) {
389:       if (programMode)
390:         return grid ? gridEx.applyResolvedProgram(&program, center, normal, validateOnly)
391:                     : meshEx.applyResolvedProgram(&program, center, normal, validateOnly);
392:       return grid ? gridEx.applyResolvedDab(
393:                         SculptBrushes::KELVINLET, center, normal, validateOnly)
394:                   : meshEx.applyResolvedDab(
395:                         SculptBrushes::KELVINLET, center, normal, validateOnly);
396:     };
397:     for (int dab = 0; dab < 2; dab++) {
398:       const float radius = dab == 0 ? 1.3f : 2.7f;
399:       const float pressure = dab == 0 ? .4f : .8f;
400:       brush.pushDeviceInput(int(props::DeviceType::PRESSURE), pressure);
401:       if (programMode)
402:         program.setCommandScalarChecked(field, "radius", props::Prop::FLOAT32, radius);
403:       else
404:         *source(brush, "radius")->internal_value() = radius;
405:       // Validation must inspect the entire late candidate before any query/capture.
406:       const auto prior = positions();
407:       const auto oldPath = brush.strokePathCount;
408:       const auto oldGrid = grid ? gridState(gridEx) : std::string();
409:       const auto evaluations = grid ? gridEx.preparedCavity.evaluations()
410:                                     : meshEx.preparedCavity.evaluations();
411:       const auto topology = mesh->topo_stamp;
412:       auto rejected = [&]() {
413:         for (bool only : {false, true})
414:           test_assert(run(only).error == PropError::ERROR_INVALID_VALUE);
415:         test_assert(exactUnboundedPositions(positions(), prior) &&
416:                     brush.strokePathCount == oldPath);
417:         test_assert(mesh->topo_stamp == topology);
418:         test_assert((grid ? gridEx.preparedCavity.evaluations()
419:                           : meshEx.preparedCavity.evaluations()) == evaluations);
420:         if (grid)
421:           test_assert(gridState(gridEx) == oldGrid);
422:       };
423:       for (float invalid : {std::numeric_limits<float>::infinity(),
424:                             std::numeric_limits<float>::quiet_NaN(),
425:                             std::numeric_limits<float>::max()})
426:       {
427:         brush.unboundedExtent = invalid;
428:         rejected();
429:       }
430:       for (auto [badRadius, badExtent] :
431:            {std::pair{1e-20f, 1e-30f},
432:             std::pair{1.0f, std::numeric_limits<float>::denorm_min()}})
433:       {
434:         if (programMode)
435:           program.setCommandScalarChecked(
436:               field, "radius", props::Prop::FLOAT32, badRadius);
437:         else
438:           *source(brush, "radius")->internal_value() = badRadius;
439:         brush.unboundedExtent = badExtent;
440:         rejected();
441:       }
442:       if (programMode)
443:         program.setCommandScalarChecked(field, "radius", props::Prop::FLOAT32, radius);
444:       else
445:         *source(brush, "radius")->internal_value() = radius;
446:       brush.unboundedExtent = extent;
447:       for (auto *vector : {&brush.grabFrom, &brush.grabTo})
448:         for (int axis = 0; axis < 3; axis++) {
449:           const float saved = (*vector)[axis];
450:           for (float invalid : {std::numeric_limits<float>::infinity(),
451:                                 std::numeric_limits<float>::quiet_NaN()})
452:           {
453:             (*vector)[axis] = invalid;
454:             rejected();
455:           }
456:           (*vector)[axis] = saved;
457:         }
458:       test_assert(exactUnboundedPositions(positions(), prior) &&
459:                   brush.strokePathCount == oldPath);
460:       if (grid)
461:         test_assert(gridState(gridEx) == oldGrid);
462:       test_assert(run(true).error == PropError::ERROR_NONE);
463:       test_assert(exactUnboundedPositions(positions(), prior) &&
464:                   brush.strokePathCount == oldPath);
465:       const float mu = programMode ? 2.0f * pressure : 1.0f;
466:       const float nu = programMode ? .1f + pressure * .25f : .4f;
467:       for (size_t v = 0; v < expected.size(); v++) {
468:         auto &p = expected[v];
469:         if (programMode) {
470:           const float t = 1.0f - std::min((p - center).length() / .25f, 1.0f);
471:           const float falloff = t * t * (3.0f - 2.0f * t);
472:           if (cavity && t > 0)
473:             contacted[v] = true;
474:           p += normal * (falloff * .12f * .25f * .5f * (cavity ? .5f : 1.0f));
475:         }
476:         const double window = cutoffReference(p, center, radius, extent);
477:         if (cavity && (extent <= 0 || std::hypot(double(p[0]) - double(center[0]),
478:                                                  double(p[1]) - double(center[1]),
479:                                                  double(p[2]) - double(center[2])) <
480:                                           double(radius * extent)))
481:           contacted[v] = true;
482:         const auto delta =
483:             kelvinletReference(p, brush.grabFrom, brush.grabTo, radius, mu, nu);
484:         for (int axis = 0; axis < 3; axis++)
485:           p[axis] = float(double(p[axis]) + delta[axis] * window * (cavity ? .5 : 1.0));
486:       }
487:       test_assert(run().error == PropError::ERROR_NONE);
488:       const auto actual = positions();
489:       for (size_t v = 0; v < actual.size(); v++)
490:         test_assert((actual[v] - expected[v]).length() < 3e-6f);
491:       test_assert(brush.unboundedExtent == extent);
492:       if (programMode)
493:         test_assert(brush.radius == .25f && brush.mu == 1 && brush.nu == .4f);
494:       if (cavity) {
495:         size_t count = 0;
496:         for (bool touched : contacted)
497:           count += touched;
498:         test_assert((grid ? gridEx.preparedCavity.evaluations()
499:                           : meshEx.preparedCavity.evaluations()) == count);
500:       }
501:     }
502:     int outside = 0;
503:     const auto after = positions();
504:     for (size_t v = 0; v < after.size(); v++)
505:       outside += (original[v] - center).length() > .5f &&
506:                  (after[v] - original[v]).length() > 1e-5f;
507:     test_assert(outside > 0);
508:     if (grid) {
509:       gridEx.endStep();
510:       gridLog.undo();
511:     } else {
512:       meshEx.endStep();
513:       meshLog.undo(mesh, &tree);
514:     }
515:     test_assert(exactUnboundedPositions(positions(), original));
516:     if (grid)
517:       gridLog.redo();
518:     else
519:       meshLog.redo(mesh, &tree);
520:     test_assert(exactUnboundedPositions(positions(), after));
521:   }
522:   alloc::Delete(mesh);
523: }
