292: props::ScalarRegistrationResult PreparedBrushScalars::publish(Brush &brush) const
293: {
294:   if (brush_ != &brush || definition_ != brush.props.struct_def || !definition_) {
295:     return {PropError::ERROR_INVALID_OWNER, "brush"};
296:   }
297:   auto result = brush.props.struct_def->registerScalars(declarations());
298:   if (result.error != PropError::ERROR_NONE) {
299:     return result;
300:   }
301:   // All recoverable checks precede this barrier. These setters only write
302:   // working caches, including readonly authored sources, never their values.
303:   ensureExtraUniformDefaults(brush);
304:   applyWorking(brush);
305:   return {};
306: }
307: 
308: void PreparedBrushScalars::applyWorking(Brush &brush) const
309: {
310:   brush.cavity_curve = cavityCurve_;
311:   brush.unboundedExtent = unboundedExtent_;
312:   for (const auto &value : values_) {
313:     props::numtype_dispatch(value.type, [&]<typename P>() {
314:       using T = typename P::value_type;
315:       if (value.nativeMember >= 0) {
316:         *static_cast<T *>(Brush::builtinPropDescriptorSpan()[value.nativeMember].address(
317:             brush)) = T(value.value);
318:       } else if constexpr (std::is_same_v<T, float>) {
319:         brush.setEvaluatedNamedFloat(value.storeSlot, T(value.value));
320:       } else if constexpr (std::is_same_v<T, int32_t>) {
321:         brush.setEvaluatedNamedInt(value.storeSlot, T(value.value));
322:       } else if constexpr (std::is_same_v<T, bool>) {
323:         brush.setEvaluatedNamedBool(value.storeSlot, T(value.value));
324:       }
325:     });
326:   }
327: }
328: 
329: props::ScalarRegistrationResult
330: prepareBrushScalars(Brush &brush,
331:                     std::span<const BrushUniformManifestEntry> uniforms,
332:                     const props::DeviceInputCtx &inputs,
333:                     PreparedBrushScalars &output,
334:                     std::span<const BrushScalarOverride> overrides,
335:                     std::span<const BrushUniformManifestEntry> programUniforms,
336:                     ScalarSource source,
337:                     std::span<const BrushDynamicsOverride> dynamicsOverrides,
338:                     std::span<const float> cavityCurveOverride)
339: {
340:   if (!brush.props.struct_def)
341:     return {PropError::ERROR_INVALID_OWNER, "brush"};
342:   PreparedBrushScalars candidate;
343:   candidate.brush_ = &brush;
344:   candidate.definition_ = brush.props.struct_def;
345:   candidate.unboundedExtent_ = brush.unboundedExtent;
346:   static_assert(Brush::kCavityCurveLutSize == 256);
347:   if (!cavityCurveOverride.empty() && cavityCurveOverride.size() != 256)
348:     return {PropError::ERROR_INVALID_VALUE, "cavity curve"};
349:   for (size_t i = 0; i < 256; i++) {
350:     const float value =
351:         cavityCurveOverride.empty() ? brush.cavity_curve[i] : cavityCurveOverride[i];
352:     if (!std::isfinite(value))
353:       return {PropError::ERROR_INVALID_VALUE, "cavity curve"};
354:     candidate.cavityCurve_[i] = value;
355:   }
356:   for (size_t index = 0; index < uniforms.size(); index++) {
357:     const auto &entry = uniforms[index];
358:     for (size_t prior = 0; prior < index; prior++) {
359:       if (entry.name == uniforms[prior].name)
360:         return {PropError::ERROR_SCHEMA_CONFLICT, entry.name};
361:     }
362:     auto error = validateTarget(entry);
363:     if (error != PropError::ERROR_NONE)
364:       return {error, entry.name};
365:     if (executorSetting(entry.name)) {
366:       for (const auto &setting : executorSettingDeclarations()) {
367:         if (setting.name != entry.name)
368:           continue;
369:         if (entry.scalarType != setting.type || entry.dynamic || entry.hasDefault ||
370:             (entry.hasRange &&
371:              (entry.rangeMin != setting.rangeMin || entry.rangeMax != setting.rangeMax)))
372:           return {PropError::ERROR_SCHEMA_CONFLICT, entry.name};
373:       }
374:     } else if (scalar(entry.scalarType)) {
375:       candidate.declarations_.append(declarationOf(entry));
376:     }
377:   }
378:   auto validation =
379:       brush.props.struct_def->validateScalarDeclarations(candidate.declarations());
380:   if (validation.error != PropError::ERROR_NONE)
381:     return validation;
382: 
383:   auto append =
384:       [&](PreparedBrushScalar value, const ScalarDeclaration *declaration, bool common) {
385:         const BrushScalarOverride *override = nullptr;
386:         for (const auto &item : overrides) {
387:           if (item.name == value.name) {
388:             if (override)
389:               return PropError::ERROR_SCHEMA_CONFLICT;
390:             override = &item;
391:           }
392:         }
393:         const BrushDynamicsOverride *stackOverride = nullptr;
394:         for (const auto &item : dynamicsOverrides) {
395:           if (item.name == value.name) {
396:             if (stackOverride)
397:               return PropError::ERROR_SCHEMA_CONFLICT;
398:             if (item.type != value.type)
399:               return PropError::ERROR_INVALID_TYPE;
400:             if (!value.dynamic || source != ScalarSource::Authored ||
401:                 !props::Dynamics::validStack(item.dynamics.devices))
402:               return PropError::ERROR_INVALID_DYNAMICS;
403:             stackOverride = &item;
404:           }
405:         }
406:         auto error = prepareValue(
407:             brush, value, declaration, common, inputs, override, source, stackOverride);
408:         if (error == PropError::ERROR_NONE)
409:           candidate.values_.append(std::move(value));
410:         return error;
411:       };
412:   for (int id = 0; id <= int(BrushProp::Invert); id++) {
413:     util::string name(brushPropName(id));
414:     ScalarDeclaration declaration;
415:     bool declared = false;
416:     if (auto *entry = findUniform(uniforms, name)) {
417:       declaration = declarationOf(*entry);
418:       declared = true;
419:     } else if (auto *entry = findUniform(programUniforms, name)) {
420:       declaration = declarationOf(*entry);
421:       declared = true;
422:     } else {
423:       declared = brush.props.struct_def->scalarDeclaration(name, declaration);
424:     }
425:     const Prop type = id == int(BrushProp::Invert) ? Prop::BOOL : Prop::FLOAT32;
426:     if (declared && declaration.type != type)
427:       return {PropError::ERROR_INVALID_TYPE, name};
428:     auto error =
429:         append({name, type, 0, !declared || declaration.dynamic, nativeMember(name), -1},
430:                declared ? &declaration : nullptr,
431:                true);
432:     if (error != PropError::ERROR_NONE)
433:       return {error, name};
434:   }
435:   for (const auto &setting : executorSettingDeclarations()) {
436:     auto error =
437:         append({setting.name, setting.type, 0, false, nativeMember(setting.name), -1},
438:                &setting,
439:                false);
440:     if (error != PropError::ERROR_NONE)
441:       return {error, setting.name};
442:   }
443:   for (const auto &entry : uniforms) {
444:     if (!scalar(entry.scalarType) || commonMember(entry.name) >= 0 ||
445:         executorSetting(entry.name))
446:       continue;
447:     auto declaration = declarationOf(entry);
448:     auto error = append({entry.name,
449:                          entry.scalarType,
450:                          0,
451:                          entry.dynamic,
452:                          nativeMember(entry.name),
453:                          entry.storeSlot},
454:                         &declaration,
455:                         false);
456:     if (error != PropError::ERROR_NONE)
457:       return {error, entry.name};
458:   }
459:   for (const auto &override : overrides) {
460:     bool found = false;
461:     for (const auto &value : candidate.values_) {
462:       found |= value.name == override.name;
463:     }
464:     if (!found)
465:       return {PropError::ERROR_NOT_EXISTS, override.name};
466:   }
467:   for (const auto &item : dynamicsOverrides) {
468:     bool found = false;
469:     for (const auto &value : candidate.values_)
470:       found |= value.name == item.name;
471:     if (!found)
472:       return {PropError::ERROR_NOT_EXISTS, item.name};
473:   }
474:   for (auto *property : brush.props.struct_def->properties()) {
475:     auto *dynamics = dynamicsOf(property);
476:     if (!dynamics || dynamics->devices.size() == 0)
477:       continue;
478:     bool eligible = false;
479:     bool active = false;
480:     for (const auto &value : candidate.values_) {
481:       if (value.name == property->name && value.type == property->type &&
482:           brush.props.struct_def->lookupLocal(value.name) == property)
483:       {
484:         eligible = value.dynamic;
485:         active = true;
486:         break;
487:       }
488:     }
489:     if (!active) {
490:       bool belongsToProgram = false;
491:       for (const auto &entry : programUniforms) {
492:         if (entry.name == property->name && entry.scalarType == property->type &&
493:             brush.props.struct_def->lookupLocal(entry.name) == property)
494:         {
495:           belongsToProgram = true;
496:           break;
497:         }
498:       }
499:       // Every owning stage is prepared before execution; report its own errors there.
500:       if (belongsToProgram)
501:         continue;
502:     }
503:     if (!eligible || !props::Dynamics::validStack(dynamics->devices)) {
504:       return {PropError::ERROR_INVALID_DYNAMICS, property->name};
505:     }
506:   }
507:   for (const auto &value : candidate.values_)
508:     if (value.name == util::string("unboundedExtent"))
509:       candidate.unboundedExtent_ = float(value.value);
510:   output = std::move(candidate);
511:   return {};
512: }
513: 
514: props::ScalarRegistrationResult
515: validateUnboundedSupport(const PreparedBrushScalars &stage, float radius)
516: {
517:   using props::PropError;
518:   if (!std::isfinite(radius) || radius < 0 ||
519:       (radius > 0 && !std::isfinite(1.0f / radius)))
520:     return {PropError::ERROR_INVALID_VALUE, "radius"};
521:   if (radius == 0)
522:     return {};
523:   const Brush *brush = stage.sourceBrush();
524:   if (!brush)
525:     return {PropError::ERROR_INVALID_OWNER, "brush"};
526:   for (int axis = 0; axis < 3; axis++)
527:     if (!std::isfinite(brush->grabFrom[axis]) || !std::isfinite(brush->grabTo[axis]))
528:       return {PropError::ERROR_INVALID_VALUE, "unbounded frame"};
529:   const float extent = stage.unboundedExtent();
530:   if (!std::isfinite(extent))
531:     return {PropError::ERROR_INVALID_VALUE, "unboundedExtent"};
532:   if (extent <= 0)
533:     return {};
534:   const float cutoff = radius * extent;
535:   const float width = 0.2f * cutoff;
536:   if (!std::isfinite(cutoff) || cutoff <= 0 || !std::isfinite(width) || width <= 0)
537:     return {PropError::ERROR_INVALID_VALUE, "unbounded cutoff"};
538:   return {};
539: }
