326: class CommonProperties(_PropertyAccess):
327:     """Validated access to fixed BrushProp IDs: 0 strength, 1 radius, 2 autosmooth,
328:     3 plane offset, 4 spacing, 5 invert. Keep the native Brush alive.
329: 
330:     Native declaration eligibility remains authoritative after kernel queries.
331:     """
332: 
333:     def __init__(self, manager, brush):
334:         self.manager = manager
335:         self.brush = brush
336: 
337:     def _uniform(self, index):
