16: const NamedUniformDescriptor *extraNamedUniformDescriptor(const util::string &name,
17:                                                           int &slot)
18: {
19:   slot = -1;
20:   for (auto type : {props::Prop::FLOAT32, props::Prop::INT32, props::Prop::BOOL}) {
21:     for (int index = 0; index < kNamedUniformSlotLimit; index++) {
22:       auto *descriptor = generatedExtraNamedUniformDescriptor(type, index);
23:       if (!descriptor) {
24:         break;
25:       }
26:       if (std::strcmp(name.c_str(), descriptor->name) == 0) {
27:         slot = index;
28:         return descriptor;
29:       }
30:     }
31:   }
32:   return nullptr;
33: }
34: 
35: props::PropError Brush::setNamedScalar(props::Prop type, int slot, double value)
36: {
37:   using props::Prop;
38:   using props::PropError;
39:   if (slot < 0 || slot >= kNamedUniformSlotLimit) {
40:     return PropError::ERROR_INVALID_VALUE;
41:   }
42:   auto write = [&]<typename T>(NamedUniformStore<T> &store) {
43:     return named_uniform_detail::StoreAccess::write(
44:         store, props, extraNamedUniformDescriptor(type, slot), type, slot, value);
45:   };
46:   switch (type) {
47:   case Prop::FLOAT32:
48:     return write(namedFloats);
49:   case Prop::INT32:
50:     return write(namedInts);
51:   case Prop::BOOL:
52:     return write(namedBools);
53:   default:
54:     return PropError::ERROR_INVALID_TYPE;
55:   }
56: }
57: 
58: static void reportNamedWrite(props::PropError error, int slot)
59: {
60:   if (error != props::PropError::ERROR_NONE) {
61:     fprintf(stderr, "named uniform slot %d: write error %d\n", slot, int(error));
62:   }
63: }
64: 
65: void Brush::setNamedFloat(int slot, float value)
66: {
67:   reportNamedWrite(setNamedScalar(props::Prop::FLOAT32, slot, value), slot);
68: }
69: void Brush::setNamedInt(int slot, int32_t value)
70: {
71:   reportNamedWrite(setNamedScalar(props::Prop::INT32, slot, value), slot);
72: }
73: void Brush::setNamedBool(int slot, bool value)
74: {
75:   reportNamedWrite(setNamedScalar(props::Prop::BOOL, slot, value), slot);
76: }
