281: class UniformProperties(_PropertyAccess):
282:     """A query-scoped view; requerying its executor invalidates this view.
283: 
284:     The caller must keep the executor and its native Brush alive for this view.
285:     """
286: 
287:     def __init__(self, manager, executor, brush_type):
288:         self.manager = manager
289:         self.executor = executor
290:         count = executor.queryUniformManifest(_integer(brush_type))
291:         if count < 0:
292:             raise BrushPropertyError(-1)
293:         self._token = int(executor.uniformQueryToken())
294:         uniforms = []
295:         for index in range(count):
296:             with executor.uniformSnapshotChecked(self.token, index) as entry:
297:                 _check(entry.status)
298:                 uniforms.append(Uniform(
299:                     index, read_litestl_string(entry.name.ptr), int(entry.scalarType), bool(entry.dynamic),
300:                     getattr(entry, "def"), bool(entry.hasDefault),
301:                     entry.rangeMin if entry.hasRange else None, entry.rangeMax if entry.hasRange else None,
302:                 ))
303:         self.uniforms = tuple(uniforms)
304: 
305:     @property
306:     def token(self):
307:         return self._token
308: 
309:     def _uniform(self, index):
310:         index = _integer(index)
311:         if index < 0 or index >= len(self.uniforms):
312:             raise IndexError(index)
313:         return self.uniforms[index]
314: 
315:     def _call(self, method, uniform, *args):
316:         return getattr(self.executor, method.format("Uniform"))(
317:             self.token, uniform.index, uniform.scalar_type, *args)
