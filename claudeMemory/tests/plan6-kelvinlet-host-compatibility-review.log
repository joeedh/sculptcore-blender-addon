158: def _stack_arrays(layers):
159:     if len(layers) > 4:
160:         raise ValueError("At most four unique input devices are supported")
161:     devices, modes, factors, enabled, offsets, samples, kinds, parameters = [], [], [], [], [0], [], [], []
162:     for layer in layers:
163:         device, mode, factor = _integer(layer.device), _integer(layer.mode), _float(layer.factor)
164:         if device not in range(4) or device in devices or mode not in range(5) or not 0 <= factor <= 1:
165:             raise ValueError("Invalid or duplicate device, mode or mixing factor")
166:         if not isinstance(layer.enabled, bool):
167:             raise TypeError("enabled must be boolean")
168:         if layer.response_kind not in ('TABLE', 'CONSTANT', 'TWO_STEP'):
169:             raise ValueError("Unknown response kind")
170:         params = tuple(_double(value) for value in layer.parameters)
171:         kind = ('TABLE', 'CONSTANT', 'TWO_STEP').index(layer.response_kind)
172:         if len(params) != (0, 1, 3)[kind] or (kind and len(layer.samples)):
173:             raise ValueError("Invalid response parameters or analytic table payload")
174:         if kind == 2 and not 0 <= params[0] <= 1:
175:             raise ValueError("Response threshold must be in [0, 1]")
176:         kinds.append(kind)
177:         parameters.extend((0, 0, 0) if kind == 0 else (0, params[0], 0) if kind == 1 else params)
178:         devices.append(device)
179:         modes.append(mode)
180:         factors.append(factor)
181:         enabled.append(int(layer.enabled))
182:         samples.extend(_samples(layer.samples))
183:         offsets.append(len(samples))
184:     return (("int32", devices), ("int32", modes), ("float", factors),
185:             ("int32", enabled), ("int32", offsets), ("float", samples),
186:             ("int32", kinds), ("double", parameters))
187: 
