75: static void kelvinletNumerics()
76: {
77:   Brush brush;
78:   brush.unboundedExtent = 0;
79:   size_t cases = 0;
80:   for (int exponent : {-127, -126, -100, -80, -40, -10, 0, 10, 40, 80, 120}) {
81:     brush.radius = std::ldexp(1.0f, exponent);
82:     for (float mu : {std::nextafter(1e-6f, 1.0f), 1.0f, 100.0f})
83:       for (float nu : {0.0f, .4f, std::nextafter(.499f, 0.0f)}) {
84:         brush.mu = mu;
85:         brush.nu = nu;
86:         for (float3 offset : {float3(0.0f),
87:                               float3(brush.radius, 0, 0),
88:                               float3(brush.radius * .5f),
89:                               float3(1, 2, -1),
90:                               float3(std::ldexp(1.0f, 24), 0, 0)})
91:           for (float3 force : {float3(.1f, -.2f, .3f),
92:                                float3(0, std::ldexp(1.0f, 24), 0),
93:                                float3(std::numeric_limits<float>::max() * .5f)})
94:           {
95:             KelvinletProbe probe;
96:             KelvinletProbe::Node node;
97:             CommandCtxBase base;
98:             CommandCtx<KelvinletProbe> context(base, node, probe, brush);
99:             brush.grabFrom = offset * -1.0f;
100:             brush.grabTo = force;
101:             auto expected = kelvinletReference(
102:                 float3(0.0f), brush.grabFrom, force, brush.radius, mu, nu);
103:             command::kelvinlet<KelvinletProbe, AccumLive>(context);
104:             double forceScale = std::max({std::abs(double(force[0])),
105:                                           std::abs(double(force[1])),
106:                                           std::abs(double(force[2]))});
107:             double error[3];
108:             for (int axis = 0; axis < 3; axis++) {
109:               test_assert(std::isfinite(probe.point.co[axis]));
110:               error[axis] = double(probe.point.co[axis]) - expected[axis];
111:             }
112:             test_assert(std::hypot(error[0], error[1], error[2]) <=
113:                         4e-6 * forceScale +
114:                             8 * double(std::numeric_limits<float>::denorm_min()));
115:             test_assert(node.updated && node.affected_verts.size() == 1);
116:             cases++;
117:           }
118:       }
119:   }
120:   // The normalized coefficient must not round above one near the origin:
121:   // multiplying even one excess ulp by FLT_MAX overflows a representable field.
122:   const float largest = std::numeric_limits<float>::max();
123:   const float minimum = std::nextafter(std::ldexp(1.0f, -128), 1.0f);
124:   for (float radius : {minimum, 1.0f})
125:     for (int axis = 0; axis < 3; axis++)
126:       for (float distance : {0.0f, std::ldexp(1.0f, -20), std::ldexp(1.0f, -10)}) {
127:         KelvinletProbe probe;
128:         KelvinletProbe::Node node;
129:         CommandCtxBase base;
130:         CommandCtx<KelvinletProbe> context(base, node, probe, brush);
131:         brush.radius = radius;
132:         brush.mu = 1.0f - 6.0f * std::ldexp(1.0f, -24);
133:         brush.nu = 0;
134:         brush.grabFrom = float3(0.0f);
135:         brush.grabFrom[axis] = -distance;
136:         brush.grabTo = float3(0.0f);
137:         brush.grabTo[(axis + 1) % 3] = largest;
138:         const auto expected = kelvinletReference(
139:             probe.point.co, brush.grabFrom, brush.grabTo, radius, brush.mu, brush.nu);
140:         command::kelvinlet<KelvinletProbe, AccumLive>(context);
141:         double error[3];
142:         for (int i = 0; i < 3; i++) {
143:           test_assert(std::isfinite(probe.point.co[i]));
144:           error[i] = double(probe.point.co[i]) - expected[i];
145:         }
146:         test_assert(std::hypot(error[0], error[1], error[2]) <= 4e-6 * double(largest));
147:       }
148:   // Opposing finite endpoints overflow a float subtraction; transverse output
149:   // remains measurable even though adding a small axial result rounds away.
150:   {
151:     KelvinletProbe probe;
152:     probe.point.co = float3(largest, 0, 0);
153:     KelvinletProbe::Node node;
154:     CommandCtxBase base;
155:     CommandCtx<KelvinletProbe> context(base, node, probe, brush);
156:     brush.grabFrom = float3(-largest, 0, 0);
157:     brush.grabTo = float3(0, largest, 0);
158:     brush.radius = largest;
159:     brush.mu = 1;
160:     brush.nu = .4f;
161:     const auto expected = kelvinletReference(
162:         probe.point.co, brush.grabFrom, brush.grabTo, brush.radius, brush.mu, brush.nu);
163:     command::kelvinlet<KelvinletProbe, AccumLive>(context);
164:     test_assert(probe.point.co[0] == largest && std::isfinite(probe.point.co[1]));
165:     test_assert(std::abs(double(probe.point.co[1]) - expected[1]) <=
166:                 4e-6 * double(largest));
167:   }
168:   // Near-origin anisotropic addition must not overflow multi-component FLT_MAX
169:   // forces even when sqrt(1 + tiny squared distance) rounds back to one.
170:   for (float distance : {std::ldexp(1.0f, -15), std::ldexp(1.0f, -14), std::ldexp(1.0f, -13)})
171:     for (int axis = 0; axis < 3; axis++)
172:       for (float sign : {-1.0f, 1.0f}) {
173:         KelvinletProbe probe;
174:         KelvinletProbe::Node node;
175:         CommandCtxBase base;
176:         CommandCtx<KelvinletProbe> context(base, node, probe, brush);
177:         brush.radius = 1;
178:         brush.mu = 1;
179:         brush.nu = .49f;
180:         brush.grabFrom = float3(0.0f);
181:         brush.grabFrom[axis] = -4 * distance * sign;
182:         brush.grabFrom[(axis + 1) % 3] = -3 * distance;
183:         brush.grabFrom[(axis + 2) % 3] = -2 * distance;
184:         brush.grabTo = float3(largest);
185:         brush.grabTo[axis] *= sign;
186:         const auto expected = kelvinletReference(
187:             probe.point.co, brush.grabFrom, brush.grabTo, brush.radius, brush.mu, brush.nu);
188:         command::kelvinlet<KelvinletProbe, AccumLive>(context);
189:         double error[3];
190:         for (int i = 0; i < 3; i++) {
191:           test_assert(std::isfinite(probe.point.co[i]));
192:           error[i] = double(probe.point.co[i]) - expected[i];
193:         }
194:         test_assert(std::hypot(error[0], error[1], error[2]) <= 4e-6 * double(largest));
195:       }
196:   // Distinct window and field centers expose distance-square under/overflow.
197:   brush.grabFrom = float3(0.0f);
198:   brush.grabTo = float3(0, 1, 0);
199:   brush.mu = 1;
200:   brush.nu = .4f;
201:   brush.unboundedExtent = 1;
202:   for (int exponent : {-80, 80}) {
203:     brush.radius = std::ldexp(1.0f, exponent);
204:     for (float distance : {.5f,
205:                            std::nextafter(.8f, 0.0f),
206:                            .8f,
207:                            std::nextafter(.8f, 1.0f),
208:                            .9f,
209:                            std::nextafter(1.0f, 0.0f),
210:                            1.0f,
211:                            std::nextafter(1.0f, 2.0f),
212:                            2.0f})
213:     {
214:       KelvinletProbe probe;
215:       KelvinletProbe::Node node;
216:       CommandCtxBase base;
217:       base.surfacePos = float3(brush.radius * distance, 0, 0);
218:       CommandCtx<KelvinletProbe> context(base, node, probe, brush);
219:       const double expected =
220:           cutoffReference(float3(0.0f), base.surfacePos, brush.radius, 1);
221:       test_assert(std::abs(double(context.unboundedWindow(float3(0.0f))) - expected) <
222:                   1e-7);
223:       command::kelvinlet<KelvinletProbe, AccumLive>(context);
224:       test_assert(std::abs(double(probe.point.co[1]) - expected) < 1e-7);
225:       test_assert(node.updated == (expected != 0));
226:       test_assert(node.affected_verts.size() == size_t(expected != 0));
227:     }
228:   }
229:   static int textureCalls = 0;
230:   TextureProgram texture;
231:   texture.eval = [](const float *, const float *, const float *, const TexEvalCtx *) {
232:     textureCalls++;
233:     return 1.0f;
234:   };
235:   brush.texture_program = &texture;
236:   for (int skip = 0; skip < 3; skip++) {
237:     KelvinletProbe probe;
238:     KelvinletProbe::Node node;
239:     CommandCtxBase base;
240:     base.surfacePos = float3(skip == 2 ? 2.0f : 0.0f, 0, 0);
241:     CommandCtx<KelvinletProbe> context(base, node, probe, brush);
242:     brush.radius = skip == 0 ? 0 : 1;
243:     brush.grabTo = float3(0, skip == 1 ? 0.0f : 1.0f, 0);
244:     textureCalls = 0;
245:     command::kelvinlet<KelvinletProbe, AccumLive>(context);
246:     test_assert(textureCalls == 0 && !node.updated && node.affected_verts.size() == 0);
247:     test_assert(probe.point.co.length() == 0);
248:   }
249:   brush.texture_program = nullptr;
250:   fprintf(
251:       stderr,
252:       "Kelvinlet double reference passed %zu scalar endpoint cases and cutoff extremes\n",
253:       cases);
254: }
