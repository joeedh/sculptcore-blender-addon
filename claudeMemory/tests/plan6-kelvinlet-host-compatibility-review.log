525: template <class Executor, class Source, class Co>
526: static void unboundedCavity(Executor &ex, Brush &brush, Source source, Co co, int count)
527: {
528:   brush.automask_cavity = true;
529:   brush.cavity_factor = .05f;
530:   brush.cavity_blur_steps = 1;
531:   brush.grabTo = float3(0.0f);
532:   brush.writeProps();
533:   ex.anchoredGrab = false;
534:   BrushProgram program;
535:   program.addCommand(int(SculptBrushes::KELVINLET));
536:   std::vector<float> saved(count, -1);
537:   CavityParams params;
538:   params.enabled = true;
539:   params.factor = .05f;
540:   params.blur_steps = 1;
541:   params.curve_lut = brush.cavity_curve.data();
542:   CavityScratch scratch;
543:   for (int v = 0; v < count; v++)
544:     co(v)[2] += .17f * float(v % 5 - 2);
545:   size_t contacts = 0;
546:   for (int dab = 0; dab < 3; dab++) {
547:     if (dab)
548:       for (int v = 0; v < count; v++)
549:         co(v)[2] += .017f * float(v % 5 - 2);
550:     // Vertex zero is exactly on the first cutoff. No first contact occurs there.
551:     const float radius = dab == 0 ? .5f : 2;
552:     const float3 center = dab == 0 ? co(0) + float3(.5f, 0, 0) : float3(0.0f);
553:     brush.unboundedExtent = dab == 2 ? 0 : 1;
554:     program.setCommandScalarChecked(0, "radius", props::Prop::FLOAT32, radius);
555:     program.setCommandScalarChecked(0, "mu", props::Prop::FLOAT32, 1 + dab);
556:     program.setCommandScalarChecked(0, "nu", props::Prop::FLOAT32, .1f * dab);
557:     std::vector<bool> supported(count);
558:     for (int v = 0; v < count; v++) {
559:       supported[v] = dab == 2 || std::hypot(double(co(v)[0]) - center[0],
560:                                             double(co(v)[1]) - center[1],
561:                                             double(co(v)[2]) - center[2]) < radius;
562:       if (supported[v] && saved[v] < 0) {
563:         saved[v] = cavityRemap(params, cavityRawT(source, v, 1, scratch));
564:         contacts++;
565:       }
566:     }
567:     if (dab == 0)
568:       test_assert(!supported[0] && saved[0] < 0);
569:     test_assert(ex.applyResolvedProgram(&program, center, float3(0, 0, 1)).error ==
570:                 PropError::ERROR_NONE);
571:     test_assert(ex.preparedCavity.configurations() == 1);
572:     test_assert(ex.preparedCavity.evaluations() == contacts);
573:     for (int v = 0; v < count; v++)
574:       if (supported[v])
575:         test_assert((*ex.preparedCavity.active())[v] == saved[v]);
576:   }
577:   test_assert(contacts == size_t(count));
578:   const auto [minimum, maximum] = std::minmax_element(saved.begin(), saved.end());
579:   test_assert(*maximum - *minimum > .01f);
580: }
581: 
582: static void unboundedCavityMatrix()
583: {
584:   for (bool grid : {false, true}) {
585:     auto *mesh = mesh::createCube(4, 2.0f);
586:     mesh->topo_cache.ensureRing1(*mesh);
587:     {
588:       subdiv::Multires mr;
589:       mr.init(*mesh, 2);
590:       auto *domain = mr.gridDomain(2);
591:       domain->ensureTree(50);
592:       spatial::SpatialTree tree(mesh);
593:       tree.leaf_limit = 32;
594:       tree.buildAll();
595:       Brush brush;
596:       if (grid) {
597:         GridBrushExecutor ex(domain, &brush);
598:         ex.beginStep();
599:         unboundedCavity(
600:             ex,
601:             brush,
602:             GridBrushExecutor::GridCavitySrc{domain},
603:             [&](int v) -> float3 & { return domain->pos()[v]; },
604:             domain->vertCount());
605:         ex.endStep();
606:       } else {
607:         CommandExecutor ex(&tree, &brush);
608:         ex.beginStep(false);
609:         unboundedCavity(
610:             ex,
611:             brush,
612:             MeshCavitySrc{mesh},
613:             [&](int v) -> float3 & { return mesh->v.co[v]; },
614:             mesh->v.count);
615:         ex.endStep();
616:       }
617:     }
618:     alloc::Delete(mesh);
619:   }
620:   fprintf(stderr,
621:           "unbounded nonconstant cavity first-contact and strict support passed\n");
622: }
623: 
624: static void unboundedMatrix()
625: {
626:   unboundedCavityMatrix();
627:   for (bool grid : {false, true})
628:     for (bool program : {false, true})
629:       for (bool cavity : {false, true})
630:         for (float extent : {0.0f, 1.0f})
631:           for (bool deferred : {false, true}) {
632:             if (!grid && deferred)
633:               continue;
634:             for (auto neighbors : {CommandExecutor::NeighborMode::LiveDisk,
635:                                    CommandExecutor::NeighborMode::Csr})
636:             {
637:               if (grid && neighbors == CommandExecutor::NeighborMode::Csr)
638:                 continue;
639:               unboundedExecution(grid, program, cavity, deferred, extent, neighbors);
640:             }
641:           }
642:   fprintf(stderr,
643:           "prepared unbounded mesh/grid independent field oracle, growth, cavity and "
644:           "exact undo passed\n");
645: }
