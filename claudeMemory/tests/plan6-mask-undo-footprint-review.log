35: struct GridStrokeLog {
36:   using float3 = litestl::math::float3;
37:   template <typename T> using Vector = litestl::util::Vector<T>;
38: 
39:   /** Bind to a domain (and its tree). Clears history. */
40:   void attach(GridLevelDomain *d);
41: 
42:   /** Open a step (truncates any redo branch). */
43:   void beginStep();
44:   /** First-touch capture of `leaf` into the open step: owned pre-positions
45:    * when `positions`, owned pre-mask when `maskToo`. Store blocks are NOT
46:    * captured here — the store is untouched until the stroke-end fold, so
47:    * captureGrids() defers them to exactly the touched set. */
48:   void captureLeaf(int leaf, bool positions, bool maskToo);
49:   /** Capture `channel`'s store blocks for `grids` (the stroke's touched-grid
50:    * set), called at stroke end BEFORE the writeback/flush overwrites them. */
51:   void captureGrids(std::span<const int> grids, int channel);
52:   /** Close the step; `postDebt` is downPropDebt(level) after the stroke's
53:    * writeback. Empty steps are dropped. */
54:   void endStep(bool postDebt);
55: 
56:   /** Identifies the current capture transaction; zero means no open step. */
57:   uint64_t openStepSerial() const
58:   {
59:     return open_ ? stepSerial_ : 0;
60:   }
61: 
62:   bool canUndo() const
63:   {
64:     return cursor_ > 0;
65:   }
66:   bool canRedo() const
67:   {
68:     return cursor_ < int(steps_.size());
69:   }
70:   bool undo();
71:   bool redo();
72:   /** Evict the oldest APPLIED step (undo-limiter truncation from the front).
73:    * Refused while a step is open, when empty, or when everything is undone
74:    * (the front step would be redo history). Host absolute cursors stay
75:    * valid: eviction removes a step below the deepest reachable seek, so
76:    * seeks simply stop earlier. */
77:   bool dropOldest();
78: 
79:   int stepCount() const
80:   {
81:     return int(steps_.size());
82:   }
83:   /** The domain this log is bound to (null when unattached). */
84:   GridLevelDomain *domain() const
85:   {
86:     return d_;
87:   }
88:   /** Total captured bytes across the history (the undo-footprint gate). */
89:   size_t bytes() const;
90: 
91: private:
92:   struct LeafSnap {
93:     int leaf = -1;
94:     bool hasPos = false, hasMask = false;
95:     Vector<float3> pos; // owned-vert order
96:     Vector<float> mask; // owned-vert order
97:   };
98:   struct GridBlock {
99:     int grid = -1;
100:     // By NAME, not index: removeChannel shifts every later channel down, so an
101:     // index captured before it would swap bytes into the wrong column (or off
102:     // the end of the store) afterwards.
103:     litestl::util::string channel;
104:     Vector<float> data; // elemsPerGrid * elemSize floats, the store block layout
105:   };
106:   struct Step {
107:     Vector<LeafSnap> leaves;
108:     Vector<GridBlock> blocks;
109:     bool preDebt = false;
110:     bool postDebt = false;
111:     // The attribute half of the same debt, by channel NAME for the reason
112:     // GridBlock gives, and a set rather than a flag because the debt is per
113:     // channel (Multires::propagateAttrsDown).
114:     Vector<litestl::util::string> preAttrDebt, postAttrDebt;
115:   };
116: 
117:   void captureGridBlock(Step &s, int grid, int channel);
118:   /** Names of the channels owing the level below at this log's level. */
119:   void snapshotAttrDebt(Vector<litestl::util::string> &out);
120:   /** Make that set the live one: every other channel at this level ends up
121:    * owing nothing. */
122:   void applyAttrDebt(const Vector<litestl::util::string> &names);
123:   /** Swap a step's snapshots with the live domain/store state and refresh
124:    * normals/bounds/chain — symmetric, so it serves undo and redo alike. */
125:   void applySwap(Step &s);
126: 
127:   GridLevelDomain *d_ = nullptr;
128:   GridTree *tree_ = nullptr;
129:   Vector<Step> steps_;
130:   int cursor_ = 0;    // steps applied
131:   bool open_ = false; // a step is being captured
132:   uint64_t stepSerial_ = 0;
133:   /** First-touch dedup stamps for the open step. */
134:   Vector<uint32_t> leafStamp_;
135:   Vector<uint32_t> gridStamp_;
136:   /** Channels of `grid` already captured at gridStamp_[grid] == gen_. */
137:   Vector<uint32_t> gridChannels_;
138:   uint32_t gen_ = 0;
139: };
140: 
141: } // namespace sculptcore::subdiv
