278: bool GridStrokeLog::undo()
279: {
280:   if (!canUndo() || open_) {
281:     return false;
282:   }
283:   Step &s = steps_[cursor_ - 1];
284:   applySwap(s);
285:   d_->multires()->setDownPropDebt(d_->level(), s.preDebt);
286:   applyAttrDebt(s.preAttrDebt);
287:   cursor_--;
288:   return true;
289: }
290: 
291: bool GridStrokeLog::redo()
292: {
293:   if (!canRedo() || open_) {
294:     return false;
295:   }
296:   Step &s = steps_[cursor_];
297:   applySwap(s);
298:   d_->multires()->setDownPropDebt(d_->level(), s.postDebt);
299:   applyAttrDebt(s.postAttrDebt);
300:   cursor_++;
301:   return true;
302: }
303: 
304: bool GridStrokeLog::dropOldest()
305: {
306:   // Only an applied step may be evicted: cursor_ counts applied steps from
307:   // the front, so cursor_ == 0 means the front step is redo-only history and
308:   // dropping it would corrupt the redo chain, not trim the undo tail.
309:   if (open_ || steps_.size() == 0 || cursor_ < 1) {
310:     return false;
311:   }
312:   steps_.pop_front();
313:   cursor_--;
314:   return true;
315: }
316: 
317: size_t GridStrokeLog::bytes() const
318: {
319:   size_t n = 0;
320:   for (const Step &s : steps_) {
321:     for (const LeafSnap &ls : s.leaves) {
322:       n += ls.pos.size() * sizeof(float3) + ls.mask.size() * sizeof(float);
323:     }
324:     for (const GridBlock &b : s.blocks) {
325:       n += b.data.size() * sizeof(float);
326:     }
327:   }
328:   return n;
329: }
