3: /** Grids-native stroke undo (grids-native brush path, G2).
4:  *
5:  * Per stroke step, the first dab to touch a leaf snapshots that leaf's
6:  * owned-vert PRE-positions (and pre-mask for mask strokes) plus the write
7:  * target's store blocks of the leaf's grids — CCG-style block undo,
8:  * O(touched leaves) per stroke. Undo/redo SWAP the blocks back in, so
9:  * positions and store bytes restore bit-exact (copies, not re-derivations)
10:  * and one snapshot serves both directions; each seek refreshes the captured
11:  * leaves' normals + bounds, invalidates finer chain levels, and restores the
12:  * level's down-propagation debt flag.
13:  *
14:  * Seam coverage: stroke-end block capture follows each moved vert's occurrence
15:  * grids,
16:  * including adjacent leaves that were not selected by the dab. Undo
17:  * refreshes bounds
18:  * for every occurrence leaf of restored positions.
19:  * History is valid while the
20:  * domain/tree it was captured against stays alive (level switches fold through the
21:  * store-blob fallback — the addon phase). */
22: 
23: #include "grid_domain.h"
24: 
25: #include "litestl/math/vector.h"
26: #include "litestl/util/string.h"
27: #include "litestl/util/vector.h"
