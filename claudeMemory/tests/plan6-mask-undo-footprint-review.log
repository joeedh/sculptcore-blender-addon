149: void GridStrokeLog::endStep(bool postDebt)
150: {
151:   Assert(open_, "endStep pairs with beginStep");
152:   open_ = false;
153:   Step &s = steps_.last();
154:   if (s.leaves.size() == 0 && s.blocks.size() == 0) {
155:     steps_.pop_back();
156:     return;
157:   }
158:   s.postDebt = postDebt;
159:   snapshotAttrDebt(s.postAttrDebt);
160:   cursor_ = int(steps_.size());
161: }
