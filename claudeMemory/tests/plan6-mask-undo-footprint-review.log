190: void GridStrokeLog::applySwap(Step &s)
191: {
192:   Multires *mr = d_->multires();
193:   int level = d_->level();
194:   mr->store.ensureLevelResident(level);
195: 
196:   Vector<int> touchedVerts;
197:   Vector<GridBlock *> swappedSession;
198:   for (LeafSnap &ls : s.leaves) {
199:     const GridTree::Leaf &tl = tree_->leaves[ls.leaf];
200:     if (ls.hasPos) {
201:       for (int i = 0; i < int(tl.ownedVerts.size()); i++) {
202:         std::swap(ls.pos[i], d_->pos()[tl.ownedVerts[i]]);
203:         touchedVerts.append(tl.ownedVerts[i]);
204:       }
205:     }
206:     if (ls.hasMask) {
207:       for (int i = 0; i < int(tl.ownedVerts.size()); i++) {
208:         std::swap(ls.mask[i], d_->mask[tl.ownedVerts[i]]);
209:       }
210:     }
211:   }
212:   for (GridBlock &b : s.blocks) {
213:     const int channel = mr->store.findChannel(b.channel);
214:     if (channel < 0) {
215:       continue; // the channel was dropped since capture: nothing to restore to
216:     }
217:     const int floats = mr->store.channelElemsPerGrid(level, channel) *
218:                        mr->store.channelElemSize(channel);
219:     if (floats != int(b.data.size())) {
220:       continue; // re-added at another size or domain — not the block's column
221:     }
222:     float *dst = mr->store.elem(level, channel, b.grid, 0, 0);
223:     for (int i = 0; i < floats; i++) {
224:       std::swap(b.data[i], dst[i]);
225:     }
226:     if (mr->store.channelAuthored(channel)) {
227:       // An authored channel is what the draw path's derived samples mirror, so
228:       // the swap has to be pushed back out to them (no-op for the rest).
229:       swappedSession.append(&b);
230:     }
231:   }
232: 
233:   if (touchedVerts.size() > 0) {
234:     d_->refreshNormals(std::span<const int>(touchedVerts.data(), touchedVerts.size()));
235:   }
236:   tree_->refreshVertexBounds(
237:       std::span<const int>(touchedVerts.data(), touchedVerts.size()));
238:   if (GridDrawSource *ds = mr->drawSource()) {
239:     // Drawn pos/no/mask of the swapped leaves changed — mark by owned verts
240:     // (occurrence mapping also reaches the neighbor cells reading them).
241:     Vector<int> marked;
242:     for (LeafSnap &ls : s.leaves) {
243:       const GridTree::Leaf &tl = tree_->leaves[ls.leaf];
244:       for (int v : tl.ownedVerts) {
245:         marked.append(v);
246:       }
247:     }
248:     ds->markVerts(std::span<const int>(marked.data(), marked.size()));
249:   }
250:   /* One pass per distinct session channel: the derived samples the draw path
251:    * reads mirror the channel, so a swap has to be pushed back out to them. */
252:   for (size_t i = 0; i < swappedSession.size(); i++) {
253:     const litestl::util::string &name = swappedSession[i]->channel;
254:     bool seen = false;
255:     for (size_t j = 0; j < i && !seen; j++) {
256:       seen = swappedSession[j]->channel == name;
257:     }
258:     if (seen) {
259:       continue;
260:     }
261:     Vector<int> grids;
262:     for (GridBlock *b : swappedSession) {
263:       if (b->channel == name) {
264:         grids.append(b->grid);
265:       }
266:     }
267:     mr->gridAttrs().refreshSamplesFromChannel(
268:         name, level, grids.data(), int(grids.size()));
269:     if (GridDrawSource *ds = mr->drawSource()) {
270:       ds->markGrids(std::span<const int>(grids.data(), grids.size()));
271:     }
272:   }
273:   // Finer levels derive from this one's positions; the swapped state is new
274:   // to them either way.
275:   mr->invalidateAbove(level);
276: }
