334: void GridsStore::prolongateChannelEditUp(int channel,
335:                                          int level,
336:                                          std::span<const int> coords,
337:                                          std::span<const float> deltas)
338: {
339:   if (channel < 0 || channel >= int(channels_.size()) || level < 1 ||
340:       level >= levelCount_)
341:   {
342:     return; // out of range, or nothing finer to carry the edit into
343:   }
344:   Channel &ch = channels_[channel];
345:   if (ch.domain != GridElemDomain::Vertex || !interpolatableType(ch.type)) {
346:     return; // no float math on a typed channel (restrictChannelDown's rule)
347:   }
348:   const int fpe = ch.floatsPerElem;
349:   const int n = int(coords.size()) / 3;
350:   if (!n || int(deltas.size()) < n * fpe) {
351:     return;
352:   }
353: 
354:   // Bucket the touched slots per grid: the prolongation never crosses a grid,
355:   // and the C0 seam invariant holds because every replica arrives as its own
356:   // slot (occurrences()-shaped input) carrying the same delta.
357:   Vector<int> counts, offsets, order;
358:   counts.resize(gridCount_);
359:   for (int g = 0; g < gridCount_; g++) {
360:     counts[g] = 0;
361:   }
362:   for (int i = 0; i < n; i++) {
363:     counts[coords[i * 3]]++;
364:   }
365:   offsets.resize(gridCount_ + 1);
366:   offsets[0] = 0;
367:   for (int g = 0; g < gridCount_; g++) {
368:     offsets[g + 1] = offsets[g] + counts[g];
369:     counts[g] = 0;
370:   }
371:   order.resize(n);
372:   for (int i = 0; i < n; i++) {
373:     const int g = coords[i * 3];
374:     order[offsets[g] + counts[g]++] = i;
375:   }
376:   Vector<int> touched; // grids with at least one slot
377:   for (int g = 0; g < gridCount_; g++) {
378:     if (offsets[g + 1] > offsets[g]) {
379:       touched.append(g);
380:     }
381:   }
382:   const int nt = int(touched.size());
383: 
384:   // Dense per-touched-grid delta lattices at the current chain level, plus the
385:   // bounding box of the nonzero region so each level only walks what the edit
386:   // can reach (the box grows [2b0-1, 2b1+1] per step — one 4-tap footprint).
387:   int w = elemWidth(level, GridElemDomain::Vertex);
388:   Vector<float> cur, next;
389:   Vector<int> box; // per touched grid: u0, u1, v0, v1
390:   cur.resize(size_t(nt) * w * w * fpe);
391:   std::memset(cur.data(), 0, sizeof(float) * cur.size());
392:   box.resize(size_t(nt) * 4);
393:   for (int t = 0; t < nt; t++) {
394:     const int g = touched[t];
395:     int *b = &box[t * 4];
396:     b[0] = w, b[1] = -1, b[2] = w, b[3] = -1;
397:     float *dst = &cur[size_t(t) * w * w * fpe];
398:     for (int j = offsets[g]; j < offsets[g + 1]; j++) {
399:       const int i = order[j];
400:       const int u = coords[i * 3 + 1], v = coords[i * 3 + 2];
401:       for (int k = 0; k < fpe; k++) {
402:         dst[(size_t(v) * w + u) * fpe + k] = deltas[size_t(i) * fpe + k];
403:       }
404:       b[0] = u < b[0] ? u : b[0];
405:       b[1] = u > b[1] ? u : b[1];
406:       b[2] = v < b[2] ? v : b[2];
407:       b[3] = v > b[3] ? v : b[3];
408:     }
409:   }
410: 
411:   for (int f = level + 1; f <= levelCount_; f++) {
412:     const int wf = elemWidth(f, GridElemDomain::Vertex);
413:     // A level nothing ever authored holds implicit zeros, and zeros plus a
414:     // prolonged delta is just the prolongation of the (post-edit) level below
415:     // -- seed it whole instead and skip the add; the delta chain continues.
416:     const bool seeded = !channelLevelAllocated(f, channel);
417:     if (seeded) {
418:       seedLevelFromBelow(ch, f);
419:     }
420:     next.resize(size_t(nt) * wf * wf * fpe);
421:     std::memset(next.data(), 0, sizeof(float) * next.size());
422:     for (int t = 0; t < nt; t++) {
423:       int *b = &box[t * 4];
424:       if (b[1] < 0) {
425:         continue; // this grid's deltas were all exact zeros
426:       }
427:       const int g = touched[t];
428:       const int fu0 = b[0] * 2 - 1 < 0 ? 0 : b[0] * 2 - 1;
429:       const int fu1 = b[1] * 2 + 1 > wf - 1 ? wf - 1 : b[1] * 2 + 1;
430:       const int fv0 = b[2] * 2 - 1 < 0 ? 0 : b[2] * 2 - 1;
431:       const int fv1 = b[3] * 2 + 1 > wf - 1 ? wf - 1 : b[3] * 2 + 1;
432:       const float *src = &cur[size_t(t) * w * w * fpe];
433:       float *dst = &next[size_t(t) * wf * wf * fpe];
434:       for (int v = fv0; v <= fv1; v++) {
435:         for (int u = fu0; u <= fu1; u++) {
436:           // seedLevelFromBelow's 4-tap, run on the delta field (zeros outside
437:           // the box, so off-box taps contribute nothing).
438:           const int cu = u >> 1, cv = v >> 1;
439:           const int du = u & 1, dv = v & 1;
440:           const float *s00 = &src[(size_t(cv) * w + cu) * fpe];
441:           const float *s10 = &src[(size_t(cv) * w + cu + du) * fpe];
442:           const float *s01 = &src[(size_t(cv + dv) * w + cu) * fpe];
443:           const float *s11 = &src[(size_t(cv + dv) * w + cu + du) * fpe];
444:           float *out = &dst[(size_t(v) * wf + u) * fpe];
445:           float *store = seeded ? nullptr : elemIn(ch, f, g, u, v);
446:           for (int k = 0; k < fpe; k++) {
447:             out[k] = 0.25f * (s00[k] + s10[k] + s01[k] + s11[k]);
448:             if (store) {
449:               store[k] += out[k];
450:             }
451:           }
452:         }
453:       }
454:       b[0] = fu0, b[1] = fu1, b[2] = fv0, b[3] = fv1;
455:     }
456:     std::swap(cur, next);
457:     w = wf;
458:   }
459: }
