163: void GridStrokeLog::snapshotAttrDebt(Vector<litestl::util::string> &out)
164: {
165:   Multires *mr = d_->multires();
166:   const int level = d_->level();
167:   out.clear();
168:   for (int c = 0; c < mr->store.channelCount(); c++) {
169:     if (mr->store.channelLevelDebt(level, c)) {
170:       out.append(mr->store.channelName(c));
171:     }
172:   }
173: }
