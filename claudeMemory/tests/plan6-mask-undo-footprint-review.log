18: void GridStrokeLog::attach(GridLevelDomain *d)
19: {
20:   stepSerial_++;
21:   d_ = d;
22:   tree_ = d ? d->ensureTree() : nullptr;
23:   steps_.clear();
24:   cursor_ = 0;
25:   open_ = false;
26:   gen_ = 0;
27:   leafStamp_.clear();
28:   gridStamp_.clear();
29:   gridChannels_.clear();
30:   if (d_) {
31:     leafStamp_.resize(tree_->leaves.size());
32:     gridStamp_.resize(d_->gridCount());
33:     gridChannels_.resize(d_->gridCount());
34:     for (int i = 0; i < int(leafStamp_.size()); i++) {
35:       leafStamp_[i] = 0;
36:     }
37:     for (int i = 0; i < int(gridStamp_.size()); i++) {
38:       gridStamp_[i] = 0;
39:       gridChannels_[i] = 0;
40:     }
41:   }
42: }
43: 
44: void GridStrokeLog::beginStep()
45: {
46:   Assert(d_ && !open_, "log attached, no step open");
47:   // A fresh step invalidates any redo branch (linear history, meshlog-style).
48:   while (int(steps_.size()) > cursor_) {
49:     steps_.pop_back();
50:   }
51:   steps_.append(Step());
52:   Step &s = steps_.last();
53:   s.preDebt = d_->multires()->downPropDebt(d_->level());
54:   snapshotAttrDebt(s.preAttrDebt);
55:   open_ = true;
56:   stepSerial_++;
57:   gen_++;
58: }
59: 
60: void GridStrokeLog::captureGridBlock(Step &s, int grid, int channel)
61: {
62:   // A stroke can capture the same grid on several channels (positions + mask),
63:   // so the stamp carries a bitmask of the channels taken. Scanning s.blocks for
64:   // that instead made the dedup quadratic over the touched-grid set.
65:   const uint32_t bit = channel < 32 ? uint32_t(1) << channel : 0;
66:   if (gridStamp_[grid] != gen_) {
67:     gridStamp_[grid] = gen_;
68:     gridChannels_[grid] = 0;
69:   } else if (bit) {
70:     if (gridChannels_[grid] & bit) {
71:       return;
72:     }
73:   } else {
74:     for (const GridBlock &b : s.blocks) { // channel >= 32: no bit to spend
75:       if (b.grid == grid && b.channel == d_->multires()->store.channelName(channel)) {
76:         return;
77:       }
78:     }
79:   }
80:   gridChannels_[grid] |= bit;
81: 
82:   Multires *mr = d_->multires();
83:   int level = d_->level();
84:   mr->store.ensureLevelResident(level);
85:   int floats =
86:       mr->store.channelElemsPerGrid(level, channel) * mr->store.channelElemSize(channel);
87:   GridBlock b;
88:   b.grid = grid;
89:   b.channel = mr->store.channelName(channel);
90:   b.data.resize(floats);
91:   const float *src = mr->store.elem(level, channel, grid, 0, 0);
92:   std::memcpy(b.data.data(), src, size_t(floats) * sizeof(float));
93:   s.blocks.append(std::move(b));
94: }
95: 
96: void GridStrokeLog::captureLeaf(int leaf, bool positions, bool maskToo)
97: {
98:   Assert(open_, "captureLeaf inside a step");
99:   Step &s = steps_.last();
100: 
101:   LeafSnap *snap = nullptr;
102:   if (leafStamp_[leaf] == gen_) {
103:     for (LeafSnap &ls : s.leaves) {
104:       if (ls.leaf == leaf) {
105:         snap = &ls;
106:         break;
107:       }
108:     }
109:     if (snap && snap->hasPos >= positions && snap->hasMask >= maskToo) {
110:       return;
111:     }
112:   }
113:   leafStamp_[leaf] = gen_;
114:   if (!snap) {
115:     s.leaves.append(LeafSnap());
116:     snap = &s.leaves.last();
117:     snap->leaf = leaf;
118:   }
119: 
120:   const GridTree::Leaf &tl = tree_->leaves[leaf];
121:   if (positions && !snap->hasPos) {
122:     snap->hasPos = true;
123:     snap->pos.resize(tl.ownedVerts.size());
124:     for (int i = 0; i < int(tl.ownedVerts.size()); i++) {
125:       snap->pos[i] = d_->pos()[tl.ownedVerts[i]];
126:     }
127:   }
128:   if (maskToo && !snap->hasMask) {
129:     snap->hasMask = true;
130:     snap->mask.resize(tl.ownedVerts.size());
131:     for (int i = 0; i < int(tl.ownedVerts.size()); i++) {
132:       snap->mask[i] = d_->mask[tl.ownedVerts[i]];
133:     }
134:   }
135: }
136: 
137: void GridStrokeLog::captureGrids(std::span<const int> grids, int channel)
138: {
139:   Assert(open_, "captureGrids inside a step");
140:   if (channel < 0 || channel >= d_->multires()->store.channelCount()) {
141:     return;
142:   }
143:   Step &s = steps_.last();
144:   for (int g : grids) {
145:     captureGridBlock(s, g, channel);
146:   }
147: }
