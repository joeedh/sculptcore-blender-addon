175: void GridStrokeLog::applyAttrDebt(const Vector<litestl::util::string> &names)
176: {
177:   Multires *mr = d_->multires();
178:   const int level = d_->level();
179:   for (int c = 0; c < mr->store.channelCount(); c++) {
180:     mr->store.setChannelLevelDebt(level, c, false);
181:   }
182:   for (const litestl::util::string &nm : names) {
183:     const int c = mr->store.findChannel(nm);
184:     if (c >= 0) {
185:       mr->store.setChannelLevelDebt(level, c, true);
186:     }
187:   }
188: }
