292: void GridLevelDomain::flushMaskToStore()
293: {
294:   int ch = ensureMaskChannel();
295:   mr_->store.ensureLevelResident(level_);
296:   for (int v = 0; v < vertCount_; v++) {
297:     auto occs = occurrences(v);
298:     for (size_t i = 0; i < occs.size(); i += 3) {
299:       *mr_->store.elem(level_, ch, occs[i], occs[i + 1], occs[i + 2]) = mask[v];
300:     }
301:   }
302:   mr_->noteMaskChange();
303:   // Deliberately no noteAttrEdit: the whole-domain flush is the host SEEDING
304:   // this level from its own stored mask (Multires_writeDomainMask), not an edit
305:   // made here. Calling it a fine edit would push the seed down the stack on the
306:   // next level switch and overwrite the coarser levels with a filtered copy of
307:   // a level the user never painted.
308: }
309: 
310: void GridLevelDomain::flushMaskToStore(std::span<const int> verts)
311: {
312:   int ch = ensureMaskChannel();
313:   mr_->store.ensureLevelResident(level_);
314:   // Delta capture rides the write: the finer levels take new - old added onto
315:   // their own content (authored fine detail survives a coarse edit), so each
316:   // replica's previous value is read just before it is overwritten.
317:   Vector<int> coords;
318:   Vector<float> deltas;
319:   for (int v : verts) {
320:     auto occs = occurrences(v);
321:     for (size_t i = 0; i < occs.size(); i += 3) {
322:       float *dst = mr_->store.elem(level_, ch, occs[i], occs[i + 1], occs[i + 2]);
323:       const float d = mask[v] - *dst;
324:       *dst = mask[v];
325:       if (d != 0.0f) {
326:         coords.append(occs[i]);
327:         coords.append(occs[i + 1]);
328:         coords.append(occs[i + 2]);
329:         deltas.append(d);
330:       }
331:     }
332:   }
333:   // The touched-verts overload IS the edit: finer levels take the prolonged
334:   // delta now, the level below owes an update on the next level switch
335:   // (Multires::propagateAttrsDown), and alive finer domains re-mirror.
336:   mr_->store.prolongateChannelEditUp(
337:       ch,
338:       level_,
339:       std::span<const int>(coords.data(), coords.size()),
340:       std::span<const float>(deltas.data(), deltas.size()));
341:   mr_->noteAttrEdit(level_, ch);
342:   mr_->refreshFinerMaskMirrors(level_);
343:   mr_->noteMaskChange();
344: }
