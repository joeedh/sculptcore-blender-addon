39: bool GridBrushExecutor::resolvedCapability(const brush_command &command,
40:                                            SculptBrushes type) const
41: {
42:   return !(nonAccum || (anchoredGrab && command.grabModeCapable) || command.unbounded ||
43:            command.attrs.size() || command.faceMode || command.writesMask ||
44:            command.needsOrigNormals || command.execHost || !command.preparedScalarSafe ||
45:            brushHooksFor(type) || attrMirrors_.items.size() || brush->automask_cavity ||
46:            attachedMultires_->editTarget() != -1 ||
47:            attachedMultires_->writebackChannel() != 0 ||
48:            !resolvedFalloffSupported(*brush));
49: }
