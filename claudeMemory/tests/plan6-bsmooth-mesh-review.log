95: /** The store-channel / cage-layer name a handle binds under, matching the mesh
96:  * path's rule (brush_executor.h): an explicit boundName wins, else the handle. */
97: inline const string &gridAttrLayerName(const BrushAttrManifestEntry &entry)
98: {
99:   return entry.boundName.size() ? entry.boundName : entry.handle;
100: }
