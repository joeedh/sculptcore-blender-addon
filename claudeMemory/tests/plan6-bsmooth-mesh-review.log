145: props::ScalarRegistrationResult GridBrushExecutor::applyResolvedDab(
146:     SculptBrushes brushType, float3 origin, float3 normal, bool validateOnly)
147: {
148:   using props::PropError;
149:   auto fail = [&](PropError error, const char *name) {
150:     lastRegistration = {error, name};
151:     return lastRegistration;
152:   };
153:   lastRegistration = resolvedState(origin, normal);
154:   if (lastRegistration.error != PropError::ERROR_NONE)
155:     return lastRegistration;
156:   Brush scratch;
157:   brush_command command;
158:   if (!createCommandSwitch<AccumLive>(brushType, &scratch, command)) {
159:     return fail(PropError::ERROR_NOT_EXISTS, "kernel");
160:   }
161:   if (!resolvedCapability(command, brushType)) {
162:     return fail(PropError::ERROR_INVALID_VALUE, "unsupported resolved capability");
163:   }
164:   PreparedBrushScalars prepared;
165:   lastRegistration =
166:       prepareBrushScalars(*brush,
167:                           {command.uniforms.data(), command.uniforms.size()},
168:                           brush->deviceInputCtx,
169:                           prepared);
170:   if (lastRegistration.error != PropError::ERROR_NONE) {
171:     return lastRegistration;
172:   }
173:   float radius = -1;
174:   for (const auto &value : prepared.values()) {
175:     if (value.name == string("radius")) {
176:       radius = float(value.value);
177:     }
178:   }
179:   if (!std::isfinite(radius) || radius < 0 ||
180:       (radius > 0 && !std::isfinite(1.0f / radius)))
181:   {
182:     return fail(PropError::ERROR_INVALID_VALUE, "radius");
183:   }
184:   if (validateOnly)
185:     return {};
186:   lastRegistration = prepared.publish(*brush);
187:   if (lastRegistration.error != PropError::ERROR_NONE) {
188:     return lastRegistration;
189:   }
190:   stats.dabs++;
191:   dabMoved_.clear();
192:   dabGrids_.clear();
193:   dabLeaves_.clear();
194:   nodePtrs_.clear();
195:   if (radius > 0 && queryDabLeaves(false, radius, origin)) {
196:     updateStrokeFrame(origin);
197:     brush->pushStrokeSample(origin, normal);
198:     dabSeq_++;
199:     execStage(command, origin, normal);
200:     finishDab();
201:   }
202:   isFirstOfStep = false;
203:   return {};
204: }
