235:   }
236:   Vector<brush_command> commands;
237:   commands.resize(program->commands.size());
238:   Vector<std::span<const BrushUniformManifestEntry>> manifests;
239:   bool needsLive = keepTopoThawed;
240:   for (size_t i = 0; i < program->commands.size(); i++) {
241:     const auto &entry = program->commands[i];
242:     Brush scratch;
243:     auto &command = commands[i];
244:     if (!createCommandSwitch<AccumLive>(
245:             entry.type, effectiveNeighborMode() == NeighborMode::Csr, &scratch, command))
246:     {
247:       lastRegistration = programError(i, {PropError::ERROR_NOT_EXISTS, "kernel"});
248:       return lastRegistration;
249:     }
250:     if (entry.attrLayerOverrides.size() ||
