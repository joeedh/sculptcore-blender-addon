682:   void exec(brush_command &cmd,
683:             std::span<spatial::SpatialNode *> nodes,
684:             std::span<const BrushAttrLayerOverride> attrOverrides = {})
685:   {
686:     // Resolve declared attribute layers once per dab (shared across all nodes;
687:     // the AttrData pointers are mesh-wide and stable for the dab's duration).
688:     if (attrOverrides.size() == 0 && defaultAttrOverrides.size() > 0) {
689:       attrOverrides = std::span<const BrushAttrLayerOverride>(
690:           defaultAttrOverrides.data(), defaultAttrOverrides.size());
691:     }
692:     attrBindingStorage.clear();
693:     ctx.attrBindings = nullptr;
694:     if (cmd.attrs.size() > 0 && nodes.size() > 0) {
695:       mesh::Mesh *m = nodes[0]->data->m;
696:       for (int ai = 0; ai < int(cmd.attrs.size()); ai++) {
697:         auto &entry = cmd.attrs[ai];
698:         mesh::AttrGroup *grp = attrGroupForDomain(m, entry.domain);
699:         if (!grp)
700:           continue;
701: 
702:         // An override redirects this handle to the user-selected "active"
703:         // layer (by index). Honour it only when the layer exists and its type
704:         // matches the handle's declared type (the TS attribute manager already
705:         // constrains categories by type, so a mismatch means a stale index â€”
706:         // fall through to the default by-name binding rather than corrupt the
707:         // wrong-typed layer).
708:         int ovLayer = -1;
709:         for (const auto &ov : attrOverrides) {
710:           if (ov.attrIdx == ai) {
711:             ovLayer = ov.layerIndex;
712:             break;
713:           }
714:         }
715:         if (ovLayer >= 0 && ovLayer < int(grp->attrs.size()) &&
716:             grp->attrs[ovLayer].type == entry.type)
717:         {
718:           // Materialize the chosen layer by its (type,name) and bind it. Copy
719:           // the name first â€” ensure() of an existing layer won't realloc, but a
720:           // local keeps the AttrRef& from dangling regardless.
721:           string nm = grp->attrs[ovLayer].name;
722:           mesh::AttrRef ref = grp->ensure(entry.type, nm, /*materialize=*/true);
723:           attrBindingStorage.items.append(BrushAttrBinding{entry.handle, ref});
724:           continue;
725:         }
726: 
