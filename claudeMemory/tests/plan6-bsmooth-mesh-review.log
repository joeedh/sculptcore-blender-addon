123: props::ScalarRegistrationResult prepareProgramScalars(
124:     Brush &brush,
125:     const BrushProgram &program,
126:     std::span<const std::span<const BrushUniformManifestEntry>> manifests,
127:     const props::DeviceInputCtx &inputs,
128:     PreparedProgramScalars &output)
129: {
130:   if (!brush.props.struct_def || manifests.size() != program.commands.size())
131:     return {PropError::ERROR_INVALID_OWNER, "program"};
132:   util::Vector<props::ScalarDeclaration> declarations;
133:   util::Vector<BrushUniformManifestEntry> scope;
134:   for (size_t i = 0; i < manifests.size(); i++) {
135:     for (const auto &entry : manifests[i]) {
136:       if (entry.scalarType == Prop::FLOAT32 || entry.scalarType == Prop::INT32 ||
137:           entry.scalarType == Prop::BOOL)
138:       {
139:         declarations.append({entry.name,
140:                              entry.scalarType,
141:                              entry.hasDefault,
142:                              entry.def,
143:                              entry.hasRange,
144:                              entry.rangeMin,
145:                              entry.rangeMax,
146:                              entry.dynamic});
147:       }
148:       bool found = false;
149:       for (const auto &known : scope)
150:         found |= known.name == entry.name;
151:       if (!found)
152:         scope.append(entry);
153:     }
154:     auto result = brush.props.struct_def->validateScalarDeclarations(
155:         {declarations.data(), declarations.size()});
156:     if (result.error != PropError::ERROR_NONE)
157:       return programError(i, result);
158:   }
159:   PreparedProgramScalars candidate;
160:   for (size_t i = 0; i < manifests.size(); i++) {
161:     const auto &command = program.commands[i];
162:     util::Vector<BrushScalarOverride> overrides;
163:     for (const auto &item : command.floatOverrides) {
164:       if (!item.name.size() && (item.propId < 0 || item.propId > int(BrushProp::Invert)))
165:         return programError(i, {PropError::ERROR_NOT_EXISTS, "common property ID"});
166:       overrides.append(
167:           {item.name.size() ? item.name : util::string(brushPropName(item.propId)),
168:            Prop::FLOAT32,
169:            double(item.value)});
170:     }
171:     for (const auto &item : command.scalarOverrides)
172:       overrides.append(item);
173:     if (command.overrideInvert)
174:       overrides.append({"invert", Prop::BOOL, command.invertValue ? 1.0 : 0.0});
175:     for (const auto &item : overrides) {
176:       if (!item.name.size() || std::strlen(item.name.c_str()) != item.name.size())
177:         return programError(i, {PropError::ERROR_NOT_EXISTS, "property name"});
178:     }
179:     PreparedBrushScalars stage;
180:     auto result = prepareBrushScalars(
181:         brush,
182:         manifests[i],
183:         inputs,
184:         stage,
185:         {overrides.data(), overrides.size()},
186:         {scope.data(), scope.size()},
187:         ScalarSource::Authored,
188:         {command.dynamicsOverrides.size() ? &command.dynamicsOverrides[0] : nullptr,
189:          command.dynamicsOverrides.size()});
190:     if (result.error != PropError::ERROR_NONE)
191:       return programError(i, result);
192:     float radius = -1;
193:     for (const auto &value : stage.values())
194:       if (value.name == util::string("radius"))
195:         radius = float(value.value);
196:     if (!std::isfinite(radius) || radius < 0 ||
197:         (radius > 0 && !std::isfinite(1.0f / radius)))
198:       return programError(i, {PropError::ERROR_INVALID_VALUE, "radius"});
199:     candidate.radius = std::max(candidate.radius, radius);
200:     candidate.radii.append(radius);
201:     candidate.stages.append(std::move(stage));
202:   }
203:   output = std::move(candidate);
204:   return {};
205: }
