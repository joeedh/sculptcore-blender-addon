304: int CommandExecutor::allocateUniformQueryToken()
305: {
306:   static std::atomic<int> next{0};
307:   int current = next.load(std::memory_order_relaxed);
308:   while (current < std::numeric_limits<int>::max()) {
309:     if (next.compare_exchange_weak(current, current + 1, std::memory_order_relaxed)) {
310:       return current + 1;
311:     }
312:   }
313:   return 0;
314: }
