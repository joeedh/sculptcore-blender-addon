206: props::ScalarRegistrationResult GridBrushExecutor::applyResolvedProgram(
207:     BrushProgram *program, float3 origin, float3 normal, bool validateOnly)
208: {
209:   using props::PropError;
210:   lastRegistration = resolvedState(origin, normal);
211:   if (lastRegistration.error != PropError::ERROR_NONE)
212:     return lastRegistration;
213:   if (!program) {
214:     lastRegistration = {PropError::ERROR_INVALID_OWNER, "program"};
215:     return lastRegistration;
216:   }
217:   if (!program->commands.size()) {
218:     PreparedBrushScalars empty;
219:     lastRegistration = prepareBrushScalars(*brush, {}, brush->deviceInputCtx, empty);
220:     if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
221:       return lastRegistration;
222:     stats.dabs++;
223:     dabMoved_.clear();
224:     dabGrids_.clear();
225:     dabLeaves_.clear();
226:     nodePtrs_.clear();
227:     isFirstOfStep = false;
228:     return {};
229:   }
230:   Vector<brush_command> commands;
231:   commands.resize(program->commands.size());
232:   Vector<std::span<const BrushUniformManifestEntry>> manifests;
233:   for (size_t i = 0; i < program->commands.size(); i++) {
234:     const auto &entry = program->commands[i];
235:     Brush scratch;
236:     auto &command = commands[i];
237:     if (!createCommandSwitch<AccumLive>(entry.type, &scratch, command)) {
238:       lastRegistration = programError(i, {PropError::ERROR_NOT_EXISTS, "kernel"});
239:       return lastRegistration;
240:     }
241:     if (entry.attrLayerOverrides.size() || !resolvedCapability(command, entry.type)) {
242:       lastRegistration = programError(
243:           i, {PropError::ERROR_INVALID_VALUE, "unsupported resolved capability"});
244:       return lastRegistration;
245:     }
246:     manifests.append({command.uniforms.data(), command.uniforms.size()});
247:   }
248:   PreparedProgramScalars prepared;
249:   lastRegistration = prepareProgramScalars(*brush,
250:                                            *program,
251:                                            {manifests.data(), manifests.size()},
252:                                            brush->deviceInputCtx,
253:                                            prepared);
254:   if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
255:     return lastRegistration;
256:   stats.dabs++;
257:   dabMoved_.clear();
258:   dabGrids_.clear();
259:   dabLeaves_.clear();
260:   nodePtrs_.clear();
261:   if (prepared.radius > 0 && queryDabLeaves(false, prepared.radius, origin)) {
262:     ScopedBrushWorkingValues working(*brush,
263:                                      {prepared.stages.data(), prepared.stages.size()});
264:     updateStrokeFrame(origin);
265:     brush->pushStrokeSample(origin, normal);
266:     dabSeq_++;
267:     for (size_t i = 0; i < commands.size(); i++) {
268:       if (prepared.radii[i] == 0)
269:         continue;
270:       prepared.stages[i].applyWorking(*brush);
271:       execStage(commands[i], origin, normal);
272:     }
273:     finishDab();
274:   }
275:   isFirstOfStep = false;
276:   return {};
277: }
