79: bool GridBrushExecutor::preflightRawProgram(BrushProgram *program,
80:                                             float3 origin,
81:                                             float3 normal)
82: {
83:   lastRegistration = resolvedState(origin, normal);
84:   if (lastRegistration.error != props::PropError::ERROR_NONE)
85:     return false;
86:   auto validate = [&]() -> props::ScalarRegistrationResult {
87:     if (!program)
88:       return {props::PropError::ERROR_INVALID_OWNER, "program"};
89:     Vector<brush_command> commands;
90:     commands.resize(program->commands.size());
91:     Vector<std::span<const BrushUniformManifestEntry>> manifests;
92:     for (size_t i = 0; i < commands.size(); i++) {
93:       Brush scratch;
94:       const auto &entry = program->commands[i];
95:       if (entry.dynamicsOverrides.size() || entry.scalarOverrides.size() || entry.attrLayerOverrides.size())
96:         return programError(
97:             i, {props::PropError::ERROR_INVALID_VALUE, "unsupported raw grid override"});
98:       if (!createCommandSwitch<AccumLive>(entry.type, &scratch, commands[i]))
99:         return programError(i, {props::PropError::ERROR_NOT_EXISTS, "kernel"});
100:       if (commands[i].grabModeCapable && anchoredGrab)
101:         return programError(
102:             i, {props::PropError::ERROR_INVALID_VALUE, "anchored grid program"});
103:       manifests.append({commands[i].uniforms.data(), commands[i].uniforms.size()});
104:     }
105:     if (!commands.size()) {
106:       PreparedBrushScalars prepared;
107:       return prepareBrushScalars(*brush, {}, brush->deviceInputCtx, prepared);
108:     }
109:     PreparedProgramScalars prepared;
110:     return prepareProgramScalars(*brush,
111:                                  *program,
112:                                  {manifests.data(), manifests.size()},
113:                                  brush->deviceInputCtx,
114:                                  prepared);
115:   };
116:   lastRegistration = validate();
117:   if (lastRegistration.error != props::PropError::ERROR_NONE)
118:     fprintf(stderr,
119:             "SculptCore: rejected %s (property status %d)\n",
120:             lastRegistration.name.c_str(),
121:             int(lastRegistration.error));
122:   return lastRegistration.error == props::PropError::ERROR_NONE;
123: }
