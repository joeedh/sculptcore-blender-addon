255:       return lastRegistration;
256:     }
257:     needsLive |= brushNeedsLiveLinks(entry.type);
258:     manifests.append({command.uniforms.data(), command.uniforms.size()});
259:   }
260:   PreparedProgramScalars prepared;
261:   lastRegistration = prepareProgramScalars(*brush,
262:                                            *program,
263:                                            {manifests.data(), manifests.size()},
264:                                            brush->deviceInputCtx,
265:                                            prepared);
266:   if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
267:     return lastRegistration;
268:   dabNodes_.clear();
269:   if (prepared.radius > 0)
270:     tree->filterNodes(center, prepared.radius, dabNodes_);
271:   lastDabNodeCount = int(dabNodes_.size());
272:   if (dabNodes_.size()) {
273:     ScopedBrushWorkingValues working(*brush,
274:                                      {prepared.stages.data(), prepared.stages.size()});
275:     auto *mesh = tree->m;
276:     if (needsLive) {
277:       if (mesh->topo_frozen)
278:         mesh->thawTopo();
279:     } else if (!mesh->topo_frozen) {
280:       mesh->freezeTopo();
281:     }
282:     ctx.m = mesh;
283:     ctx.surfaceNo = normal;
284:     ctx.surfacePos = center;
285:     ctx.meshLog = meshLog;
286:     ctx.isFirstOfStep = isFirstOfStep;
287:     updateStrokeFrame(center);
288:     brush->pushStrokeSample(center, normal);
289:     for (size_t i = 0; i < commands.size(); i++) {
290:       if (prepared.radii[i] == 0)
291:         continue;
292:       prepared.stages[i].applyWorking(*brush);
293:       curCaptureSlot = int(i);
294:       curCaptureTool = int(program->commands[i].type);
295:       exec(commands[i], {dabNodes_.data(), dabNodes_.size()});
296:     }
297:     curCaptureSlot = -1;
298:     tree->updateQueries();
299:   }
300:   clearIsFirstOfStep();
301:   return {};
302: }
