46: // Codegen-emitted descriptor of one attribute a kernel touches.
47: struct BrushAttrManifestEntry {
48:   string handle;    // DSL field name (the handle)
49:   string boundName; // fixed layer, or "" => handle
50:   mesh::AttrType type = mesh::AttrType::FLOAT;
51:   AttrElemDomain domain = AttrElemDomain::Vertex;
52:   // The executor must ensure the layer exists before binding it. True for every
53:   // attr entry — a read-only handle still needs storage to read from. It says
54:   // nothing about whether the kernel stores to the layer; that is kernelWrites.
55:   bool materialize = false;
56:   // The kernel body stores to this handle, inferred by codegen from the stage
57:   // bodies (sbrush::brushScanMemberWrites). This is the bit that decides where a
58:   // write has to land — a read-only handle like bsmooth's `vclass` is
59:   // host-pre-pass scratch and needs no write-back path at all.
60:   bool kernelWrites = false;
61:   // DSL `@use(<category>)`: the mesh::AttrUse bit a host retargets this handle
62:   // by (0 = untagged / engine-internal). Only meaningful when boundName is
63:   // empty — a fixed layer name is not retargetable.
64:   int use = 0;
65: 
66:   // Bound read-only so the TS bridge can enumerate a kernel's attr manifest by
67:   // index and retarget each retargetable handle at the active layer for its
68:   // `use` category. Returned by pointer from CommandExecutor::queriedAttrEntry,
69:   // never marshalled by value.
70:   static litestl::binding::types::Struct<BrushAttrManifestEntry> *defineBindings()
71:   {
72:     using namespace litestl::binding;
73:     types::Struct<BrushAttrManifestEntry> *st = new types::Struct<BrushAttrManifestEntry>(
74:         "sculptcore::brush::BrushAttrManifestEntry", sizeof(BrushAttrManifestEntry));
75:     BIND_STRUCT_DEFAULT_CONSTRUCTOR(st);
76:     BIND_STRUCT_MEMBER(st, handle);
77:     BIND_STRUCT_MEMBER(st, boundName);
78:     BIND_STRUCT_MEMBER(st, type);
79:     BIND_STRUCT_MEMBER(st, domain);
80:     BIND_STRUCT_MEMBER(st, materialize);
81:     BIND_STRUCT_MEMBER(st, kernelWrites);
82:     BIND_STRUCT_MEMBER(st, use);
83:     return st;
84:   }
85: };
