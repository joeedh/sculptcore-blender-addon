14: props::ScalarRegistrationResult GridBrushExecutor::resolvedState(float3 origin,
15:                                                                  float3 normal) const
16: {
17:   using props::PropError;
18:   // Check the live owner before dereferencing a possibly freed domain or tree.
19:   if (!attachedMultires_ ||
20:       attachedMultires_->domainGeneration() != attachedGeneration_ || !domain ||
21:       domain != attachedDomain_ || !tree || tree != attachedTree_ || !brush)
22:   {
23:     return {PropError::ERROR_INVALID_OWNER, "grid attachment"};
24:   }
25:   if (!stepOpen_ || log != stepLog_ ||
26:       (log && (log->domain() != domain || !stepLogSerial_ ||
27:                log->openStepSerial() != stepLogSerial_)))
28:   {
29:     return {PropError::ERROR_INVALID_OWNER, "grid step"};
30:   }
31:   for (int axis = 0; axis < 3; axis++) {
32:     if (!std::isfinite(origin[axis]) || !std::isfinite(normal[axis])) {
33:       return {PropError::ERROR_INVALID_VALUE, "dab frame"};
34:     }
35:   }
36:   return {};
37: }
