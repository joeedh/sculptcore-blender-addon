214: {
215:   using props::PropError;
216:   auto fail = [&](PropError error, const char *name) {
217:     lastRegistration = {error, name};
218:     return lastRegistration;
219:   };
220:   if (!program || !brush || !tree || !tree->m || !tree->getRoot())
221:     return fail(PropError::ERROR_INVALID_OWNER, "program or mesh");
222:   for (int axis = 0; axis < 3; axis++)
223:     if (!std::isfinite(center[axis]) || !std::isfinite(normal[axis]))
224:       return fail(PropError::ERROR_INVALID_VALUE, "dab frame");
225:   if (!program->commands.size()) {
226:     PreparedBrushScalars empty;
227:     lastRegistration = prepareBrushScalars(*brush, {}, brush->deviceInputCtx, empty);
228:     if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
229:       return lastRegistration;
230:     lastRegistration = {};
231:     dabNodes_.clear();
232:     lastDabNodeCount = 0;
233:     clearIsFirstOfStep();
