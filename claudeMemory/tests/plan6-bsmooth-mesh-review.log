57: bool CommandExecutor::preflightRawProgram(BrushProgram *program)
58: {
59:   lastValidation = {};
60:   lastRegistration = {};
61:   auto validate = [&]() -> props::ScalarRegistrationResult {
62:     if (!brush || !program)
63:       return {props::PropError::ERROR_INVALID_OWNER, "program or brush"};
64:     Vector<brush_command> commands;
65:     commands.resize(program->commands.size());
66:     Vector<std::span<const BrushUniformManifestEntry>> manifests;
67:     for (size_t i = 0; i < commands.size(); i++) {
68:       Brush scratch;
69:       const auto &entry = program->commands[i];
