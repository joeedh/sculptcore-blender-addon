51: bool GridBrushExecutor::preflightRaw(SculptBrushes type, float3 origin, float3 normal)
52: {
53:   lastRegistration = resolvedState(origin, normal);
54:   if (lastRegistration.error != props::PropError::ERROR_NONE)
55:     return false;
56:   Brush scratch;
57:   brush_command command;
58:   if (!createCommandSwitch<AccumLive>(type, &scratch, command)) {
59:     lastRegistration = {props::PropError::ERROR_NOT_EXISTS, "kernel"};
60:     return false;
61:   }
62:   PreparedBrushScalars prepared;
63:   lastRegistration =
64:       prepareBrushScalars(*brush,
65:                           {command.uniforms.data(), command.uniforms.size()},
66:                           brush->deviceInputCtx,
67:                           prepared,
68:                           {},
69:                           {},
70:                           ScalarSource::RawStandalone);
71:   if (lastRegistration.error != props::PropError::ERROR_NONE)
72:     fprintf(stderr,
73:             "SculptCore: rejected %s (property status %d)\n",
74:             lastRegistration.name.c_str(),
75:             int(lastRegistration.error));
76:   return lastRegistration.error == props::PropError::ERROR_NONE;
77: }
