1404:         ref.type = entry.type;
1405:         attrBindings_.items.append(BrushAttrBinding{entry.handle, ref});
1406:         continue;
1407:       }
1408:       if (kind == GridAttrPlanKind::LayerScratch) {
1409:         // Pages materialize zero and the stage fold re-zeros every write, so
1410:         // resize alone keeps the column all-zero between dabs.
1411:         if (layerScratch_.size() != vc) {
1412:           layerScratch_.resize(vc);
1413:         }
1414:         ref.data = &layerScratch_;
1415:         ref.name = gridAttrLayerName(entry);
1416:         ref.type = entry.type;
