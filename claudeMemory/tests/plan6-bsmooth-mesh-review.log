124: props::ScalarRegistrationResult CommandExecutor::applyResolvedDab(SculptBrushes brushType,
125:                                                                   float3 center,
126:                                                                   float3 normal,
127:                                                                   bool validateOnly)
128: {
129:   using props::PropError;
130:   auto fail = [&](PropError error, const char *name) {
131:     lastRegistration = {error, name};
132:     return lastRegistration;
133:   };
134:   if (!brush || !tree || !tree->m || !tree->getRoot()) {
135:     return fail(PropError::ERROR_INVALID_OWNER, "mesh");
136:   }
137:   for (int axis = 0; axis < 3; axis++) {
138:     if (!std::isfinite(center[axis]) || !std::isfinite(normal[axis])) {
139:       return fail(PropError::ERROR_INVALID_VALUE, "dab frame");
140:     }
141:   }
142:   Brush scratch;
143:   brush_command command;
144:   if (!createCommandSwitch<AccumLive>(
145:           brushType, effectiveNeighborMode() == NeighborMode::Csr, &scratch, command))
146:   {
147:     return fail(PropError::ERROR_NOT_EXISTS, "kernel");
148:   }
149:   // These modes need additional region, host-state or attribute preflight.
150:   // Generated host stages may themselves change radius/center after selection.
151:   if (!resolvedCapability(*this, command, brushType)) {
152:     return fail(PropError::ERROR_INVALID_VALUE, "unsupported resolved capability");
153:   }
154:   PreparedBrushScalars prepared;
155:   lastRegistration =
156:       prepareBrushScalars(*brush,
157:                           {command.uniforms.data(), command.uniforms.size()},
158:                           brush->deviceInputCtx,
159:                           prepared);
160:   if (lastRegistration.error != PropError::ERROR_NONE) {
161:     return lastRegistration;
162:   }
163:   float radius = -1;
164:   for (const auto &value : prepared.values()) {
165:     if (value.name == string("radius")) {
166:       radius = float(value.value);
167:     }
168:   }
169:   if (!std::isfinite(radius) || radius < 0 ||
170:       (radius > 0 && !std::isfinite(1.0f / radius)))
171:   {
172:     return fail(PropError::ERROR_INVALID_VALUE, "radius");
173:   }
174:   // No callbacks or yields between preparation and publication. The exact
175:   // scratch command above executes below; no live factory or legacy loader.
176:   if (validateOnly)
177:     return {};
178:   lastRegistration = prepared.publish(*brush);
179:   if (lastRegistration.error != PropError::ERROR_NONE) {
180:     return lastRegistration;
181:   }
182:   dabNodes_.clear();
183:   if (radius > 0) {
184:     tree->filterNodes(center, radius, dabNodes_);
185:   }
186:   lastDabNodeCount = int(dabNodes_.size());
187:   if (dabNodes_.size()) {
188:     auto *mesh = tree->m;
189:     if (brushNeedsLiveLinks(brushType) || keepTopoThawed) {
190:       if (mesh->topo_frozen)
191:         mesh->thawTopo();
192:     } else if (!mesh->topo_frozen) {
193:       mesh->freezeTopo();
194:     }
195:     ctx.m = mesh;
196:     ctx.surfaceNo = normal;
197:     ctx.surfacePos = center;
198:     ctx.meshLog = meshLog;
199:     ctx.isFirstOfStep = isFirstOfStep;
200:     updateStrokeFrame(center);
201:     brush->pushStrokeSample(center, normal);
202:     curCaptureSlot = 0;
203:     curCaptureTool = int(brushType);
204:     exec(command, {dabNodes_.data(), dabNodes_.size()});
205:     curCaptureSlot = -1;
206:     tree->updateQueries();
207:   }
208:   clearIsFirstOfStep();
209:   return {};
210: }
