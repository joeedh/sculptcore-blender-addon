1727:     // tangent per image); the shared ring buffer would otherwise interleave
1728:     // primary + mirror origins. Derive from the buffer only when host didn't.
1729:     if (!brush->strokeDirHostSet) {
1730:       if (brush->strokePathCount == 0) {
1731:         // First dab of the stroke: no tangent exists yet, and the previous
1732:         // stroke's is not one (wing scrape would lean its wings along it).
1733:         brush->strokeDir = float3(0.0f, 0.0f, 0.0f);
1734:       } else {
1735:         float3 d = origin - brush->strokePath[brush->strokePathCount - 1].pos;
1736:         float len = d.length();
1737:         if (len > 1e-7f) {
