26: bool CommandExecutor::preflightRaw(SculptBrushes type)
27: {
28:   Brush scratch;
29:   brush_command command;
30:   if (!brush ||
31:       !createCommandSwitch<AccumLive>(
32:           type, effectiveNeighborMode() == NeighborMode::Csr, &scratch, command))
33:   {
34:     lastRegistration = {props::PropError::ERROR_NOT_EXISTS, "kernel or brush"};
35:   } else {
36:     PreparedBrushScalars prepared;
