767:     stats.dabs++;
768:     float floorR = cmd.unbounded ? brush->radius * brush->unboundedExtent : 0.0f;
769:     if (!queryDabLeaves(cmd.grabMode, std::fmax(brush->radius, floorR), origin)) {
770:       isFirstOfStep = false;
771:       return 0;
772:     }
773: 
774:     dabSeq_++;
775:     dabMoved_.clear();
776:     dabGrids_.clear();
777:     execStage(cmd, origin, normal);
778:     finishDab();
