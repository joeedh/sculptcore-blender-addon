274: int GridLevelDomain::ensureMaskChannel()
275: {
276:   int ch = mr_->store.findChannel(util::string(kMaskChannel));
277:   if (ch < 0) {
278:     // Both defaults are deliberate. The paint mask defaults to Authored, so
279:     // subdividing carries it up and deleting a level restricts it back down.
280:     // The paint mask also defaults to persistent, because Blender itself
281:     // provides a container for exactly this one grid layer.
282:     ch = mr_->store.addChannel(util::string(kMaskChannel), 1);
283:   }
284:   return ch;
