44: void GridStrokeLog::beginStep()
45: {
46:   Assert(d_ && !open_, "log attached, no step open");
47:   // A fresh step invalidates any redo branch (linear history, meshlog-style).
48:   while (int(steps_.size()) > cursor_) {
49:     steps_.pop_back();
50:   }
51:   steps_.append(Step());
52:   Step &s = steps_.last();
53:   s.preDebt = d_->multires()->downPropDebt(d_->level());
54:   snapshotAttrDebt(s.preAttrDebt);
55:   open_ = true;
56:   stepSerial_++;
57:   gen_++;
58: }
