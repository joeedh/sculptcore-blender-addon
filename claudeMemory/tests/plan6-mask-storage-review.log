137: void GridStrokeLog::captureGrids(std::span<const int> grids, int channel)
138: {
139:   Assert(open_, "captureGrids inside a step");
140:   if (channel < 0 || channel >= d_->multires()->store.channelCount()) {
141:     return;
142:   }
143:   Step &s = steps_.last();
144:   for (int g : grids) {
145:     captureGridBlock(s, g, channel);
146:   }
147: }
