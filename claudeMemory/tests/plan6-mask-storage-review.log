232:     BrushProgram *program, float3 center, float3 normal, bool validateOnly)
233: {
234:   using props::PropError;
235:   auto fail = [&](PropError error, const char *name) {
236:     lastRegistration = {error, name};
237:     return lastRegistration;
238:   };
239:   if (!program || !brush || !tree || !tree->m || !tree->getRoot())
240:     return fail(PropError::ERROR_INVALID_OWNER, "program or mesh");
241:   for (int axis = 0; axis < 3; axis++)
242:     if (!std::isfinite(center[axis]) || !std::isfinite(normal[axis]))
243:       return fail(PropError::ERROR_INVALID_VALUE, "dab frame");
244:   if (!program->commands.size()) {
245:     PreparedBrushScalars empty;
246:     lastRegistration = prepareBrushScalars(*brush, {}, brush->deviceInputCtx, empty);
247:     if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
248:       return lastRegistration;
249:     lastRegistration = {};
250:     dabNodes_.clear();
251:     lastDabNodeCount = 0;
252:     clearIsFirstOfStep();
253:     return {};
254:   }
255:   Vector<brush_command> commands;
256:   commands.resize(program->commands.size());
257:   Vector<std::span<const BrushUniformManifestEntry>> manifests;
258:   bool needsLive = keepTopoThawed;
259:   for (size_t i = 0; i < program->commands.size(); i++) {
260:     const auto &entry = program->commands[i];
261:     auto &command = commands[i];
262:     if (!createPreparedCommand(entry.type, command)) {
263:       lastRegistration = programError(i, {PropError::ERROR_NOT_EXISTS, "kernel"});
264:       return lastRegistration;
265:     }
266:     if (entry.attrLayerOverrides.size() ||
267:         !resolvedCapability(*this, command, entry.type))
268:     {
269:       lastRegistration = programError(
270:           i, {PropError::ERROR_INVALID_VALUE, "unsupported resolved capability"});
271:       return lastRegistration;
272:     }
273:     needsLive |= brushNeedsLiveLinks(entry.type);
274:     manifests.append({command.uniforms.data(), command.uniforms.size()});
275:   }
276:   PreparedProgramScalars prepared;
277:   lastRegistration = prepareProgramScalars(*brush,
278:                                            *program,
279:                                            {manifests.data(), manifests.size()},
280:                                            brush->deviceInputCtx,
281:                                            prepared);
282:   if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
283:     return lastRegistration;
284:   dabNodes_.clear();
285:   if (prepared.radius > 0)
286:     tree->filterNodes(center, prepared.radius, dabNodes_);
287:   lastDabNodeCount = int(dabNodes_.size());
288:   if (dabNodes_.size()) {
289:     ScopedBrushWorkingValues working(*brush,
290:                                      {prepared.stages.data(), prepared.stages.size()});
291:     auto *mesh = tree->m;
292:     Vector<BrushHookFn> completed;
293:     BrushHookCtx hc{*this, mesh, &dabNodes_, brush, isFirstOfStep};
294:     for (size_t i = 0; i < program->commands.size(); i++) {
295:       const auto *hooks = brushHooksFor(program->commands[i].type);
296:       if (!prepared.radii[i] || !hooks || !hooks->stepPreFreeze)
297:         continue;
298:       bool seen = false;
299:       for (auto fn : completed)
300:         seen |= fn == hooks->stepPreFreeze;
301:       if (!seen) {
302:         hooks->stepPreFreeze(hc);
303:         completed.append(hooks->stepPreFreeze);
304:       }
305:     }
306:     if (needsLive) {
307:       if (mesh->topo_frozen)
308:         mesh->thawTopo();
309:     } else if (!mesh->topo_frozen) {
310:       mesh->freezeTopo();
311:     }
312:     ctx.m = mesh;
313:     ctx.surfaceNo = normal;
314:     ctx.surfacePos = center;
315:     ctx.meshLog = meshLog;
316:     ctx.isFirstOfStep = isFirstOfStep;
317:     updateStrokeFrame(center);
318:     brush->pushStrokeSample(center, normal);
319:     for (size_t i = 0; i < commands.size(); i++) {
320:       if (prepared.radii[i] == 0)
321:         continue;
322:       prepared.stages[i].applyWorking(*brush);
323:       curCaptureSlot = int(i);
324:       curCaptureTool = int(program->commands[i].type);
325:       exec(commands[i], {dabNodes_.data(), dabNodes_.size()});
326:     }
327:     curCaptureSlot = -1;
328:     tree->updateQueries();
329:   }
330:   clearIsFirstOfStep();
331:   return {};
332: }
