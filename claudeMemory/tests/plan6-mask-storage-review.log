780:     isFirstOfStep = false;
781:     // A face stage moves no vertex, so it reports its own unit: the grids it
782:     // touched. Callers read this only as "did the dab land".
783:     return dabMoved_.size() > 0 ? int(dabMoved_.size()) : int(dabGrids_.size());
