276:     append(ex.domain->no[v]);
277:     append(ex.domain->mask[v]);
278:   }
279:   for (const auto &leaf : ex.tree->leaves) {
280:     append(leaf.aabb.min);
281:     append(leaf.aabb.max);
282:   }
283:   for (const auto *set :
284:        std::initializer_list<const Vector<int> *>{&ex.lastDabMoved(),
285:                                                   &ex.lastDabGrids(),
286:                                                   &ex.strokeTouchedVerts(),
287:                                                   &ex.strokeTouchedLeaves(),
288:                                                   &ex.strokeTouchedGrids()})
289:   {
290:     append(set->size());
291:     for (int v : *set)
292:       append(v);
293:   }
294:   append(ex.stats);
295:   append(ex.isFirstOfStep);
296:   append(ex.brush->radius);
297:   append(ex.brush->strength);
298:   append(ex.brush->strokePathCount);
299:   append(ex.brush->strokeDir);
300:   if (ex.log) {
301:     append(ex.log->bytes());
302:     append(ex.log->stepCount());
303:     append(ex.log->openStepSerial());
304:   }
305:   append(ex.domain->multires()->downPropDebt(ex.domain->level()));
306:   state += storeBlob(*ex.domain->multires());
307:   return state;
308: }
309: 
310: static void gridExecution()
311: {
312:   auto *cage = mesh::createCube(4, 2.0f);
313:   {
314:     subdiv::Multires mr;
315:     mr.init(*cage, 3);
316:     auto *domain = mr.gridDomain(2);
317:     auto *tree = domain->ensureTree(50);
318:     mr.gridDomain(3);
319:     subdiv::GridStrokeLog log;
320:     Brush brush;
321:     brush.radius = 1.5f;
322:     brush.strength = 0.2f;
323:     brush.writeProps();
324:     auto *radius = source(brush, "radius");
325:     auto *strength = source(brush, "strength");
326:     radius->dynamics.configure(props::DeviceType::PRESSURE, math::BasicMix::ADD, 1);
327:     brush.pushDeviceInput(int(props::DeviceType::PRESSURE), 0.5f);
328:     int owner = 17;
329:     radius->owner = &owner;
330:     radius->flag = props::PropFlag::READ_ONLY;
331:     radius->dynamics.devices[0].curDeviceValue = 0.9f;
332:     radius->dynamics.devices[0].hasDeviceValue = false;
333:     brush.radius = 0.01f;
334:     GridBrushExecutor ex(domain, &brush, &log);
335:     ex.deferNormals = true;
336:     ex.beginStep();
337:     const float3 center(0, 0, 1), normal(0, 0, 1);
338:     std::vector<float3> before, beforeNormals;
339:     for (int v = 0; v < domain->vertCount(); v++) {
340:       before.push_back(domain->pos()[v]);
341:       beforeNormals.push_back(domain->no[v]);
342:     }
343:     const auto beforeBlob = storeBlob(mr);
344:     const bool beforeDebt = mr.downPropDebt(2);
345:     Vector<int> rawLeaves;
346:     tree->query(center, brush.radius, rawLeaves);
347:     auto inRaw = [&](int v) {
348:       for (int leaf : rawLeaves)
349:         if (tree->leafOfVert[v] == leaf)
350:           return true;
351:       return false;
352:     };
353:     auto invalidStack = [&]() {
354:       strength->dynamics.configure(
355:           props::DeviceType::PRESSURE, math::BasicMix::MULTIPLY, 1);
356:       strength->dynamics.devices[0].curveTable.append(0.5f);
357:     };
358:     invalidStack();
359:     auto state = gridState(ex);
360:     test_assert(ex.applyResolvedDab(SculptBrushes::DRAW, float3(100), normal).error ==
361:                 PropError::ERROR_INVALID_DYNAMICS);
362:     test_assert(gridState(ex) == state);
363:     props::ScalarDeclaration retained;
364:     test_assert(!brush.props.struct_def->scalarDeclaration("radius", retained));
365:     test_assert(brush.namedFloats.size() == 0 && brush.namedInts.size() == 0);
366:     strength->dynamics.devices.clear();
367:     test_assert(ex.applyResolvedDab(SculptBrushes::DRAW, center, normal).error ==
368:                 PropError::ERROR_NONE);
369:     test_assert(brush.radius == 2 && brush.strokePathCount == 1 && !ex.isFirstOfStep);
370:     test_assert(radius->owner == &owner && *radius->internal_value() == 1.5f);
371:     test_assert(radius->dynamics.devices[0].curDeviceValue == 0.9f &&
372:                 !radius->dynamics.devices[0].hasDeviceValue);
373:     int outsideMoved = 0;
374:     std::vector<float3> after;
375:     for (int v = 0; v < domain->vertCount(); v++) {
376:       after.push_back(domain->pos()[v]);
377:       if (!inRaw(v) && domain->pos()[v][2] > before[v][2])
378:         outsideMoved++;
379:       test_assert((domain->no[v] - beforeNormals[v]).lengthSqr() == 0);
380:     }
