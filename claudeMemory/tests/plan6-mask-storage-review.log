334: int CommandExecutor::allocateUniformQueryToken()
335: {
336:   static std::atomic<int> next{0};
337:   int current = next.load(std::memory_order_relaxed);
338:   while (current < std::numeric_limits<int>::max()) {
339:     if (next.compare_exchange_weak(current, current + 1, std::memory_order_relaxed)) {
340:       return current + 1;
341:     }
342:   }
343:   return 0;
344: }
