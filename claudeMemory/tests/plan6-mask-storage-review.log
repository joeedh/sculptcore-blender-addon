81: bool GridBrushExecutor::preflightRawProgram(BrushProgram *program,
82:                                             float3 origin,
83:                                             float3 normal)
84: {
85:   lastRegistration = resolvedState(origin, normal);
86:   if (lastRegistration.error != props::PropError::ERROR_NONE)
87:     return false;
88:   auto validate = [&]() -> props::ScalarRegistrationResult {
89:     if (!program)
90:       return {props::PropError::ERROR_INVALID_OWNER, "program"};
91:     Vector<brush_command> commands;
92:     commands.resize(program->commands.size());
93:     Vector<std::span<const BrushUniformManifestEntry>> manifests;
94:     for (size_t i = 0; i < commands.size(); i++) {
95:       Brush scratch;
96:       const auto &entry = program->commands[i];
97:       if (entry.dynamicsOverrides.size() || entry.scalarOverrides.size() ||
98:           entry.attrLayerOverrides.size())
99:         return programError(
100:             i, {props::PropError::ERROR_INVALID_VALUE, "unsupported raw grid override"});
101:       if (!createCommandSwitch<AccumLive>(entry.type, &scratch, commands[i]))
102:         return programError(i, {props::PropError::ERROR_NOT_EXISTS, "kernel"});
103:       if (commands[i].grabModeCapable && anchoredGrab)
104:         return programError(
105:             i, {props::PropError::ERROR_INVALID_VALUE, "anchored grid program"});
106:       manifests.append({commands[i].uniforms.data(), commands[i].uniforms.size()});
107:     }
108:     if (!commands.size()) {
109:       PreparedBrushScalars prepared;
110:       return prepareBrushScalars(*brush, {}, brush->deviceInputCtx, prepared);
111:     }
112:     PreparedProgramScalars prepared;
113:     return prepareProgramScalars(*brush,
114:                                  *program,
115:                                  {manifests.data(), manifests.size()},
116:                                  brush->deviceInputCtx,
117:                                  prepared);
118:   };
119:   lastRegistration = validate();
120:   if (lastRegistration.error != props::PropError::ERROR_NONE)
121:     fprintf(stderr,
122:             "SculptCore: rejected %s (property status %d)\n",
123:             lastRegistration.name.c_str(),
124:             int(lastRegistration.error));
125:   return lastRegistration.error == props::PropError::ERROR_NONE;
126: }
