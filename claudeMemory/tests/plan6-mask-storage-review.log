162: props::ScalarRegistrationResult GridBrushExecutor::applyResolvedDab(
163:     SculptBrushes brushType, float3 origin, float3 normal, bool validateOnly)
164: {
165:   using props::PropError;
166:   auto fail = [&](PropError error, const char *name) {
167:     lastRegistration = {error, name};
168:     return lastRegistration;
169:   };
170:   lastRegistration = resolvedState(origin, normal);
171:   if (lastRegistration.error != PropError::ERROR_NONE)
172:     return lastRegistration;
173:   brush_command command;
174:   if (!createPreparedCommand(brushType, command)) {
175:     return fail(PropError::ERROR_NOT_EXISTS, "kernel");
176:   }
177:   if (!resolvedCapability(command, brushType)) {
178:     return fail(PropError::ERROR_INVALID_VALUE, "unsupported resolved capability");
179:   }
180:   PreparedBrushScalars prepared;
181:   lastRegistration =
182:       prepareBrushScalars(*brush,
183:                           {command.uniforms.data(), command.uniforms.size()},
184:                           brush->deviceInputCtx,
185:                           prepared);
186:   if (lastRegistration.error != PropError::ERROR_NONE) {
187:     return lastRegistration;
188:   }
189:   float radius = -1;
190:   for (const auto &value : prepared.values()) {
191:     if (value.name == string("radius")) {
192:       radius = float(value.value);
193:     }
194:   }
195:   if (!std::isfinite(radius) || radius < 0 ||
196:       (radius > 0 && !std::isfinite(1.0f / radius)))
197:   {
198:     return fail(PropError::ERROR_INVALID_VALUE, "radius");
199:   }
200:   if (validateOnly)
201:     return {};
202:   lastRegistration = prepared.publish(*brush);
203:   if (lastRegistration.error != PropError::ERROR_NONE) {
204:     return lastRegistration;
205:   }
206:   stats.dabs++;
207:   dabMoved_.clear();
208:   dabGrids_.clear();
209:   dabLeaves_.clear();
210:   nodePtrs_.clear();
211:   if (radius > 0 && queryDabLeaves(false, radius, origin)) {
212:     updateStrokeFrame(origin);
213:     brush->pushStrokeSample(origin, normal);
214:     dabSeq_++;
215:     execStage(command, origin, normal);
216:     finishDab();
217:   }
218:   isFirstOfStep = false;
219:   return {};
220: }
