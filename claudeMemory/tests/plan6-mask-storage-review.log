95: /** Stroke-end fold shared by the CPU executor and the GPU session: capture
96:  * the touched verts' occurrence-grid store blocks into the undo log FIRST
97:  * (the store is untouched until this fold), then the restricted writeback
98:  * (positions), mask flush and attr-mirror scatter, then close the undo step.
99:  * Each channel's capture precedes its own write. O(region). */
100: inline void gridsFoldStroke(subdiv::GridLevelDomain *domain,
101:                             subdiv::GridStrokeLog *log,
102:                             std::span<const int> touched,
103:                             bool wroteCo,
104:                             bool wroteMask,
105:                             std::span<GridAttrMirror *const> attrMirrors = {},
106:                             std::span<const int> touchedGrids = {})
107: {
108:   subdiv::Multires *mr = domain->multires();
109:   int level = domain->level();
110:   if (touched.size() > 0) {
111:     Vector<bool> changed;
112:     changed.resize(domain->vertCount());
113:     for (int i = 0; i < domain->vertCount(); i++) {
114:       changed[i] = false;
115:     }
116:     Vector<int> grids;
117:     Vector<uint8_t> gridStamp;
118:     gridStamp.resize(domain->gridCount());
119:     for (int i = 0; i < domain->gridCount(); i++) {
120:       gridStamp[i] = 0;
121:     }
122:     for (int v : touched) {
123:       changed[v] = true;
124:       auto occs = domain->occurrences(v);
125:       for (size_t k = 0; k < occs.size(); k += 3) {
126:         if (!gridStamp[occs[k]]) {
127:           gridStamp[occs[k]] = 1;
128:           grids.append(occs[k]);
129:         }
130:       }
131:     }
132:     std::span<const int> gridSpan(grids.data(), grids.size());
133:     if (wroteCo) {
134:       if (log) {
135:         log->captureGrids(gridSpan, mr->writebackChannel());
136:       }
137:       mr->gridsWriteback(level, changed, grids);
138:     }
139:     if (wroteMask) {
140:       if (log) {
141:         log->captureGrids(gridSpan, mr->store.findChannel(string("mask")));
142:       }
143:       domain->flushMaskToStore(touched);
144:     }
145:     for (GridAttrMirror *m : attrMirrors) {
146:       if (!m->dirty || m->channel < 0 || m->domain != subdiv::GridElemDomain::Vertex) {
147:         continue;
148:       }
149:       if (log) {
150:         log->captureGrids(gridSpan, m->channel);
151:       }
152:       gridAttrScatter(*m, domain, touched);
153:     }
154:   }
155:   // Face mirrors ride the stroke's touched-*grid* set instead: a face stage
156:   // moves no vertex, so the occurrence walk above has nothing to derive from.
157:   if (touchedGrids.size() > 0) {
158:     for (GridAttrMirror *m : attrMirrors) {
159:       if (!m->dirty || m->channel < 0 || m->domain != subdiv::GridElemDomain::Face) {
160:         continue;
161:       }
162:       if (log) {
163:         log->captureGrids(touchedGrids, m->channel);
164:       }
165:       gridAttrScatterFace(*m, domain, touchedGrids);
166:     }
167:   }
168:   if (log) {
169:     log->endStep(mr->downPropDebt(level));
170:   }
171: }
