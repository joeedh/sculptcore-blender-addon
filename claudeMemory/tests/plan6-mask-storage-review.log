222: props::ScalarRegistrationResult GridBrushExecutor::applyResolvedProgram(
223:     BrushProgram *program, float3 origin, float3 normal, bool validateOnly)
224: {
225:   using props::PropError;
226:   lastRegistration = resolvedState(origin, normal);
227:   if (lastRegistration.error != PropError::ERROR_NONE)
228:     return lastRegistration;
229:   if (!program) {
230:     lastRegistration = {PropError::ERROR_INVALID_OWNER, "program"};
231:     return lastRegistration;
232:   }
233:   if (!program->commands.size()) {
234:     PreparedBrushScalars empty;
235:     lastRegistration = prepareBrushScalars(*brush, {}, brush->deviceInputCtx, empty);
236:     if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
237:       return lastRegistration;
238:     stats.dabs++;
239:     dabMoved_.clear();
240:     dabGrids_.clear();
241:     dabLeaves_.clear();
242:     nodePtrs_.clear();
243:     isFirstOfStep = false;
244:     return {};
245:   }
246:   Vector<brush_command> commands;
247:   commands.resize(program->commands.size());
248:   Vector<std::span<const BrushUniformManifestEntry>> manifests;
249:   for (size_t i = 0; i < program->commands.size(); i++) {
250:     const auto &entry = program->commands[i];
251:     auto &command = commands[i];
252:     if (!createPreparedCommand(entry.type, command)) {
253:       lastRegistration = programError(i, {PropError::ERROR_NOT_EXISTS, "kernel"});
254:       return lastRegistration;
255:     }
256:     if (entry.attrLayerOverrides.size() || !resolvedCapability(command, entry.type)) {
257:       lastRegistration = programError(
258:           i, {PropError::ERROR_INVALID_VALUE, "unsupported resolved capability"});
259:       return lastRegistration;
260:     }
261:     manifests.append({command.uniforms.data(), command.uniforms.size()});
262:   }
263:   PreparedProgramScalars prepared;
264:   lastRegistration = prepareProgramScalars(*brush,
265:                                            *program,
266:                                            {manifests.data(), manifests.size()},
267:                                            brush->deviceInputCtx,
268:                                            prepared);
269:   if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
270:     return lastRegistration;
271:   stats.dabs++;
272:   dabMoved_.clear();
273:   dabGrids_.clear();
274:   dabLeaves_.clear();
275:   nodePtrs_.clear();
276:   if (prepared.radius > 0 && queryDabLeaves(false, prepared.radius, origin)) {
277:     ScopedBrushWorkingValues working(*brush,
278:                                      {prepared.stages.data(), prepared.stages.size()});
279:     updateStrokeFrame(origin);
280:     brush->pushStrokeSample(origin, normal);
281:     dabSeq_++;
282:     for (size_t i = 0; i < commands.size(); i++) {
283:       if (prepared.radii[i] == 0)
284:         continue;
285:       prepared.stages[i].applyWorking(*brush);
286:       execStage(commands[i], origin, normal);
287:     }
288:     finishDab();
289:   }
290:   isFirstOfStep = false;
291:   return {};
292: }
