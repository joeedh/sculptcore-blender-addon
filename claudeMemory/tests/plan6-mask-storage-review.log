53: bool GridBrushExecutor::preflightRaw(SculptBrushes type, float3 origin, float3 normal)
54: {
55:   lastRegistration = resolvedState(origin, normal);
56:   if (lastRegistration.error != props::PropError::ERROR_NONE)
57:     return false;
58:   Brush scratch;
59:   brush_command command;
60:   if (!createCommandSwitch<AccumLive>(type, &scratch, command)) {
61:     lastRegistration = {props::PropError::ERROR_NOT_EXISTS, "kernel"};
62:     return false;
63:   }
64:   PreparedBrushScalars prepared;
65:   lastRegistration =
66:       prepareBrushScalars(*brush,
67:                           {command.uniforms.data(), command.uniforms.size()},
68:                           brush->deviceInputCtx,
