207: ScopedBrushWorkingValues::ScopedBrushWorkingValues(
208:     Brush &brush, std::span<const PreparedBrushScalars> stages)
209:     : brush_(brush), floatSize_(brush.namedFloats.size()),
210:       intSize_(brush.namedInts.size()), boolSize_(brush.namedBools.size())
211: {
212:   for (const auto &stage : stages) {
213:     for (const auto &value : stage.values()) {
214:       bool found = false;
215:       for (const auto &known : saved_)
216:         found |= known.type == value.type && known.member == value.nativeMember &&
217:                  known.slot == value.storeSlot;
218:       if (found)
219:         continue;
220:       Saved saved{value.type, value.nativeMember, value.storeSlot};
221:       props::numtype_dispatch(value.type, [&]<typename P>() {
222:         using T = typename P::value_type;
223:         static_assert(sizeof(T) <= 4);
224:         if (value.nativeMember >= 0) {
225:           std::memcpy(
226:               saved.bytes.data(),
227:               Brush::builtinPropDescriptorSpan()[value.nativeMember].address(brush),
228:               sizeof(T));
229:         } else {
230:           const auto &store = [&]() -> const NamedUniformStore<T> & {
231:             if constexpr (std::is_same_v<T, float>)
232:               return brush.namedFloats;
233:             else if constexpr (std::is_same_v<T, int32_t>)
234:               return brush.namedInts;
235:             else
236:               return brush.namedBools;
237:           }();
238:           if (size_t(value.storeSlot) < store.size())
239:             std::memcpy(saved.bytes.data(), &store.values_[value.storeSlot], sizeof(T));
240:           saved.initialized = store.initialized(value.storeSlot);
241:         }
242:       });
243:       saved_.append(saved);
244:     }
245:   }
246: }
