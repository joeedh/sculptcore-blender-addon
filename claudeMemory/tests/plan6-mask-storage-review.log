128: bool GridBrushExecutor::createPreparedCommand(SculptBrushes type, brush_command &command)
129: {
130:   Brush scratch;
131:   brush_command candidate;
132:   if (!createCommandSwitch<AccumLive>(type, &scratch, candidate))
133:     return false;
134:   if (nonAccum && candidate.accumulable && !candidate.relaxesBase) {
135:     brush_command original;
136:     if (!createCommandSwitch<AccumOrig>(type, &scratch, original))
137:       return false;
138:     candidate = std::move(original);
139:   }
140:   command = std::move(candidate);
141:   return true;
142: }
