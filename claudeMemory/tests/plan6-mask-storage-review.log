1537: inline void GridCapturePolicy::capture(CommandCtxBase & /*ctx*/,
1538:                                        std::span<GridExecNode *> nodes,
1539:                                        std::span<const CaptureSaveDesc> saves)
1540: {
1541:   if constexpr (Domain != mesh::ElemType::VERTEX) {
1542:     return; // face saves are derived state on the grids domain
1543:   } else {
1544:     if (nodes.empty() || saves.empty()) {
1545:       return;
1546:     }
1547:     GridBrushExecutor *ex = nodes[0]->exec;
1548:     if (!ex || !ex->log) {
1549:       return;
1550:     }
1551:     bool positions = false, maskToo = false;
1552:     for (const CaptureSaveDesc &sv : saves) {
1553:       positions |= sv.field == CaptureField::Co;
1554:       maskToo |= sv.field == CaptureField::Mask;
1555:       // No: derived (refreshed after a seek). Attr: covered by the stroke-end
1556:       // channel capture in gridsFoldStroke, which is where the store is first
1557:       // written — a per-dab snapshot here would capture nothing.
1558:     }
1559:     if (!positions && !maskToo) {
1560:       return;
1561:     }
1562:     for (GridExecNode *node : nodes) {
1563:       ex->log->captureLeaf(node->leaf, positions, maskToo);
1564:     }
1565:   }
1566: }
