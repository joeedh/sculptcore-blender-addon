71:                           {},
72:                           ScalarSource::RawStandalone);
73:   if (lastRegistration.error != props::PropError::ERROR_NONE)
74:     fprintf(stderr,
75:             "SculptCore: rejected %s (property status %d)\n",
76:             lastRegistration.name.c_str(),
77:             int(lastRegistration.error));
78:   return lastRegistration.error == props::PropError::ERROR_NONE;
