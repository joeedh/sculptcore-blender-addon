142: props::ScalarRegistrationResult CommandExecutor::applyResolvedDab(SculptBrushes brushType,
143:                                                                   float3 center,
144:                                                                   float3 normal,
145:                                                                   bool validateOnly)
146: {
147:   using props::PropError;
148:   auto fail = [&](PropError error, const char *name) {
149:     lastRegistration = {error, name};
150:     return lastRegistration;
151:   };
152:   if (!brush || !tree || !tree->m || !tree->getRoot()) {
153:     return fail(PropError::ERROR_INVALID_OWNER, "mesh");
154:   }
155:   for (int axis = 0; axis < 3; axis++) {
156:     if (!std::isfinite(center[axis]) || !std::isfinite(normal[axis])) {
157:       return fail(PropError::ERROR_INVALID_VALUE, "dab frame");
158:     }
159:   }
160:   brush_command command;
161:   if (!createPreparedCommand(brushType, command)) {
162:     return fail(PropError::ERROR_NOT_EXISTS, "kernel");
163:   }
164:   // These modes need additional region, host-state or attribute preflight.
165:   // Generated host stages may themselves change radius/center after selection.
166:   if (!resolvedCapability(*this, command, brushType)) {
167:     return fail(PropError::ERROR_INVALID_VALUE, "unsupported resolved capability");
168:   }
169:   PreparedBrushScalars prepared;
170:   lastRegistration =
171:       prepareBrushScalars(*brush,
172:                           {command.uniforms.data(), command.uniforms.size()},
173:                           brush->deviceInputCtx,
174:                           prepared);
175:   if (lastRegistration.error != PropError::ERROR_NONE) {
176:     return lastRegistration;
177:   }
178:   float radius = -1;
179:   for (const auto &value : prepared.values()) {
180:     if (value.name == string("radius")) {
181:       radius = float(value.value);
182:     }
183:   }
184:   if (!std::isfinite(radius) || radius < 0 ||
185:       (radius > 0 && !std::isfinite(1.0f / radius)))
186:   {
187:     return fail(PropError::ERROR_INVALID_VALUE, "radius");
188:   }
189:   // No callbacks or yields between preparation and publication. The exact
190:   // scratch command above executes below; no live factory or legacy loader.
191:   if (validateOnly)
192:     return {};
193:   lastRegistration = prepared.publish(*brush);
194:   if (lastRegistration.error != PropError::ERROR_NONE) {
195:     return lastRegistration;
196:   }
197:   dabNodes_.clear();
198:   if (radius > 0) {
199:     tree->filterNodes(center, radius, dabNodes_);
200:   }
201:   lastDabNodeCount = int(dabNodes_.size());
202:   if (dabNodes_.size()) {
203:     auto *mesh = tree->m;
204:     if (const auto *hooks = brushHooksFor(brushType); hooks && hooks->stepPreFreeze) {
205:       BrushHookCtx hc{*this, mesh, &dabNodes_, brush, isFirstOfStep};
206:       hooks->stepPreFreeze(hc);
207:     }
208:     if (brushNeedsLiveLinks(brushType) || keepTopoThawed) {
209:       if (mesh->topo_frozen)
210:         mesh->thawTopo();
211:     } else if (!mesh->topo_frozen) {
212:       mesh->freezeTopo();
213:     }
214:     ctx.m = mesh;
215:     ctx.surfaceNo = normal;
216:     ctx.surfacePos = center;
217:     ctx.meshLog = meshLog;
218:     ctx.isFirstOfStep = isFirstOfStep;
219:     updateStrokeFrame(center);
220:     brush->pushStrokeSample(center, normal);
221:     curCaptureSlot = 0;
222:     curCaptureTool = int(brushType);
223:     exec(command, {dabNodes_.data(), dabNodes_.size()});
224:     curCaptureSlot = -1;
225:     tree->updateQueries();
226:   }
227:   clearIsFirstOfStep();
228:   return {};
229: }
