182: props::ScalarRegistrationResult GridBrushExecutor::applyResolvedDab(
183:     SculptBrushes brushType, float3 origin, float3 normal, bool validateOnly)
184: {
185:   using props::PropError;
186:   auto fail = [&](PropError error, const char *name) {
187:     lastRegistration = {error, name};
188:     return lastRegistration;
189:   };
190:   lastRegistration = resolvedState(origin, normal);
191:   if (lastRegistration.error != PropError::ERROR_NONE)
192:     return lastRegistration;
193:   brush_command command;
194:   if (!createPreparedCommand(brushType, command)) {
195:     return fail(PropError::ERROR_NOT_EXISTS, "kernel");
196:   }
197:   if (!resolvedCapability(command, brushType)) {
198:     return fail(PropError::ERROR_INVALID_VALUE, "unsupported resolved capability");
199:   }
200:   PreparedBrushScalars prepared;
201:   lastRegistration =
202:       prepareBrushScalars(*brush,
203:                           {command.uniforms.data(), command.uniforms.size()},
204:                           brush->deviceInputCtx,
205:                           prepared);
206:   if (lastRegistration.error != PropError::ERROR_NONE) {
207:     return lastRegistration;
208:   }
209:   float radius = -1;
210:   for (const auto &value : prepared.values()) {
211:     if (value.name == string("radius")) {
212:       radius = float(value.value);
213:     }
214:   }
215:   if (!std::isfinite(radius) || radius < 0 ||
216:       (radius > 0 && !std::isfinite(1.0f / radius)))
217:   {
218:     return fail(PropError::ERROR_INVALID_VALUE, "radius");
219:   }
220:   if (validateOnly)
221:     return {};
222:   ScopedBrushWorkingValues executorSettings(*brush, {&prepared, 1}, true);
223:   lastRegistration = prepared.publish(*brush);
224:   if (lastRegistration.error != PropError::ERROR_NONE) {
225:     return lastRegistration;
226:   }
227:   stats.dabs++;
228:   dabMoved_.clear();
229:   dabGrids_.clear();
230:   dabLeaves_.clear();
231:   nodePtrs_.clear();
232:   if (radius > 0 && queryDabLeaves(false, radius, origin)) {
233:     updateStrokeFrame(origin);
234:     brush->pushStrokeSample(origin, normal);
235:     dabSeq_++;
236:     ScopedPreparedCavity cavityScope(preparedCavityActive);
237:     execStage(command, origin, normal);
238:     finishDab();
239:   }
240:   isFirstOfStep = false;
241:   return {};
242: }
