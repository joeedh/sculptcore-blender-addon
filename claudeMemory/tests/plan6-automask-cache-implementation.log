16: /** One sparse float override applied on top of a brush's authored props for the
17:  * duration of a single sub-command. Resolved by `name` when set (the generated
18:  * per-kernel uniforms — `mu`, `planeoff`, ...), else by `BrushProp` id for the
19:  * common props (the TS binding runtime can't marshal a JS string into a
20:  * `util::string` arg, so the int path stays for that bridge surface). */
21: struct BrushFloatOverride {
22:   int propId = 0;
23:   float value = 0.0f;
24:   util::string name;
25: };
26: 
27: /** Typed base-value override for checked program execution. */
28: struct BrushScalarOverride {
29:   util::string name;
30:   props::Prop type = props::Prop::INVALID_TYPE;
31:   double value = 0;
32: };
33: 
34: /** Present empty dynamics explicitly disable the inherited brush stack. */
35: struct BrushDynamicsOverride {
36:   util::string name;
37:   props::Prop type = props::Prop::INVALID_TYPE;
38:   props::Dynamics dynamics;
39: };
40: 
41: /** Redirects one of a kernel's declared attribute handles (by its 0-based index
42:  * in the kernel's attr manifest) to a specific existing mesh layer (by its
43:  * index in that domain's AttrGroup), instead of the codegen default of
44:  * ensure-by-handle-name. This is how the TS attribute manager points the
45:  * color/poly-group/UV brushes at the user-selected "active" layer per category
46:  * — all ints, since the TS binding runtime can't marshal a JS string into a
47:  * `util::string` method arg (same reason BrushFloatOverride is propId-keyed). */
48: struct BrushAttrLayerOverride {
49:   int attrIdx = 0;    // index into BrushCommandDef::attrs (the manifest)
50:   int layerIndex = 0; // index into the domain's AttrGroup::attrs
51: };
52: 
53: /** A single sub-command in a composite brush program: a brush type plus a set of
54:  * sparse property overrides. Overrides are pushed onto the brush's authored
55:  * props before the command runs and rolled back after, so the brush's base
56:  * props survive the dab unmodified. */
57: struct BrushCommandEntry {
58:   SculptBrushes type = SculptBrushes::DRAW;
59:   Vector<BrushFloatOverride> floatOverrides;
60:   Vector<BrushScalarOverride> scalarOverrides;
61:   Vector<BrushDynamicsOverride> dynamicsOverrides;
62:   Vector<BrushAttrLayerOverride> attrLayerOverrides;
63:   // Empty inherits the brush table; replacement requires exactly 256 samples.
64:   Vector<float> cavityCurveOverride;
65:   bool overrideInvert = false;
66:   bool invertValue = false;
67: };
68: 
69: /** An ordered list of brush sub-commands run over the *same* node set per dab —
70:  * the composite-brush ("command list") abstraction the brush executor doc
71:  * describes. Autosmooth is a `[main, SMOOTH]` program; a future dyntopo pass is
72:  * just an entry prepended to `commands` with no API change. Built from TS via
73:  * the bound methods below and handed to `CommandExecutor::execProgram` (or the
74:  * grid executor's `applyProgram`). */
75: struct BrushProgram {
76:   Vector<BrushCommandEntry> commands;
77: 
78:   void clear()
79:   {
80:     commands.clear();
81:   }
82: 
83:   /** Append a command for the given SculptBrushes value (passed as int so the
84:    * binding stays a plain scalar method); returns its index. */
85:   int addCommand(int type)
86:   {
87:     BrushCommandEntry entry;
88:     entry.type = static_cast<SculptBrushes>(type);
89:     commands.append(std::move(entry));
90:     return int(commands.size()) - 1;
91:   }
92: 
93:   void setCommandFloat(int idx, int propId, float v)
94:   {
95:     if (idx < 0 || idx >= int(commands.size())) {
96:       return;
97:     }
98:     commands[idx].floatOverrides.append(BrushFloatOverride{propId, v});
99:   }
100: 
101:   /** Override a kernel uniform by its declared name (the generated per-kernel
102:    * props: `mu`, `nu`, `planeoff`, ...). Distinct from setCommandFloat, which
103:    * keys the common props by int id. */
104:   void setCommandFloatByName(int idx, util::string name, float v)
105:   {
106:     if (idx < 0 || idx >= int(commands.size())) {
107:       return;
108:     }
109:     BrushFloatOverride ov;
110:     ov.value = v;
111:     ov.name = name;
112:     commands[idx].floatOverrides.append(std::move(ov));
113:   }
114: 
115:   /** Checks scalar transport; the resolved executor validates manifest membership. */
116:   props::PropError
117:   setCommandScalarChecked(int idx, util::string name, props::Prop type, double value);
118: 
119:   /** Candidate replacement; kernel membership is validated before execution. */
120:   int replaceCommandResponseDynamicsChecked(int idx,
121:                                             util::string name,
122:                                             int scalarType,
123:                                             util::Vector<int> &devices,
124:                                             util::Vector<int> &modes,
125:                                             util::Vector<float> &factors,
126:                                             util::Vector<int> &enabled,
127:                                             util::Vector<int> &offsets,
128:                                             util::Vector<float> &samples,
129:                                             util::Vector<int> &kinds,
130:                                             util::Vector<double> &parameters);
131:   /** Remove the local stack so this command inherits the brush again. */
132:   int removeCommandDynamicsChecked(int idx, util::string name, int scalarType);
133:   int replaceCommandCavityCurveChecked(int idx, Vector<float> &samples);
134:   int removeCommandCavityCurveChecked(int idx);
135: 
136:   void setCommandInvert(int idx, bool inv)
137:   {
138:     if (idx < 0 || idx >= int(commands.size())) {
139:       return;
140:     }
141:     commands[idx].overrideInvert = true;
142:     commands[idx].invertValue = inv;
143:   }
144: 
145:   /** Redirect declared attr handle `attrIdx` of command `idx` to the mesh layer
146:    * at `layerIndex` in that attr's domain group (see BrushAttrLayerOverride). */
147:   void setCommandAttrLayer(int idx, int attrIdx, int layerIndex)
148:   {
149:     if (idx < 0 || idx >= int(commands.size())) {
150:       return;
151:     }
152:     commands[idx].attrLayerOverrides.append(BrushAttrLayerOverride{attrIdx, layerIndex});
153:   }
154: 
155:   static litestl::binding::types::Struct<BrushProgram> *defineBindings()
156:   {
157:     using namespace litestl::binding;
158:     types::Struct<BrushProgram> *st = new types::Struct<BrushProgram>(
159:         "sculptcore::brush::BrushProgram", sizeof(BrushProgram));
160: 
161:     BIND_STRUCT_DEFAULT_CONSTRUCTOR(st);
162:     BIND_STRUCT_METHOD(st, clear, MARGS());
163:     BIND_STRUCT_METHOD(st, addCommand, MARGS("type"));
164:     BIND_STRUCT_METHOD(st, setCommandFloat, MARGS("idx", "propId", "v"));
165:     BIND_STRUCT_METHOD(st, setCommandFloatByName, MARGS("idx", "name", "v"));
166:     BIND_STRUCT_METHOD(st,
167:                        replaceCommandResponseDynamicsChecked,
168:                        MARGS("idx",
169:                              "name",
170:                              "scalarType",
171:                              "devices",
172:                              "modes",
173:                              "factors",
174:                              "enabled",
175:                              "offsets",
176:                              "samples",
177:                              "kinds",
178:                              "parameters"));
179:     BIND_STRUCT_METHOD(
180:         st, removeCommandDynamicsChecked, MARGS("idx", "name", "scalarType"));
181:     BIND_STRUCT_METHOD(st, replaceCommandCavityCurveChecked, MARGS("idx", "samples"));
182:     BIND_STRUCT_METHOD(st, removeCommandCavityCurveChecked, MARGS("idx"));
183:     BIND_STRUCT_METHOD(st, setCommandInvert, MARGS("idx", "inv"));
184:     BIND_STRUCT_METHOD(st, setCommandAttrLayer, MARGS("idx", "attrIdx", "layerIndex"));
185: 
186:     return st;
187:   }
188: };
