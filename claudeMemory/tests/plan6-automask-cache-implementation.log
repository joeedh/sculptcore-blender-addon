45:     """Resume inheritance of the authoritative Brush table on the next preparation."""
46:     function = manager.capi.lib.BrushProgram_removeCavityCurveChecked
47:     function.argtypes = [ctypes.c_void_p, ctypes.c_int]
48:     function.restype = ctypes.c_int
