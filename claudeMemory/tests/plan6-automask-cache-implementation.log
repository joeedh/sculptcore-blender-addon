3: #pragma once
4: 
5: #include "brush/brush_program_preparation.h"
6: 
7: static void cavityPreparation()
8: {
9:   Brush brush;
10:   brush.cavity_factor = 1.25f;
11:   brush.cavity_blur_steps = 3;
12:   brush.cavity_inverted = true;
13:   auto &property = brush.props.struct_def->Float32("cavity_factor", "Cavity", -1);
14:   property.min = 10;
15:   property.max = 11;
16:   *property.internal_value() = 10.5f;
17:   PreparedBrushScalars prepared;
18:   auto prepare = [&]() {
19:     return prepareBrushScalars(brush, {}, brush.deviceInputCtx, prepared).error;
20:   };
21:   test_assert(prepare() == PropError::ERROR_NONE);
22:   auto value = [&](const char *name) {
23:     for (const auto &item : prepared.values())
24:       if (item.name == string(name))
25:         return item.value;
26:     return -999.0;
27:   };
28:   test_assert(value("cavity_factor") == 1.25 && value("cavity_blur_steps") == 3 &&
29:               value("cavity_inverted") == 1);
30:   test_assert(prepared.declarations().empty());
