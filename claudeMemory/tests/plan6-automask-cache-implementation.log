112: /** Replace the host-owned dab values without copying evaluated working caches. */
113: inline void setDabInputs(Brush &brush, float radius, float strength, const float *inputs)
114: {
115:   brush.radius = radius;
116:   brush.strength = strength;
117:   brush.invert = inputs[5] != 0;
118:   brush.props.setValue<float>("radius", radius);
119:   brush.props.setValue<float>("strength", strength);
120:   brush.props.setValue<bool>("invert", brush.invert);
121:   brush.clearDeviceInputs();
122:   for (int i = 0; i < 4; i++)
123:     if (int(inputs[4]) & (1 << i))
124:       brush.pushDeviceInput(i, inputs[i]);
125: }
