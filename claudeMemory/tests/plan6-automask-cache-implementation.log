354: int CommandExecutor::allocateUniformQueryToken()
355: {
356:   static std::atomic<int> next{0};
357:   int current = next.load(std::memory_order_relaxed);
358:   while (current < std::numeric_limits<int>::max()) {
359:     if (next.compare_exchange_weak(current, current + 1, std::memory_order_relaxed)) {
360:       return current + 1;
361:     }
362:   }
363:   return 0;
364: }
