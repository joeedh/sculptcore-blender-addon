3: #pragma once
4: 
5: #include "automask.h"
6: #include "litestl/util/map.h"
7: 
8: #include <array>
9: #include <memory>
10: 
11: namespace sculptcore::brush {
12: 
13: /** First-contact cavity factors owned by one prepared stroke transaction. */
14: class PreparedCavityCache {
15: public:
16:   struct Key {
17:     int blur;
18:     float factor;
19:     bool inverted, useCurve;
20:     std::array<float, Brush::kCavityCurveLutSize> curve;
21: 
22:     bool operator==(const Key &b) const
23:     {
24:       return blur == b.blur && factor == b.factor && inverted == b.inverted &&
25:              useCurve == b.useCurve && curve == b.curve;
26:     }
27:   };
28:   struct Entry {
29:     Key key;
30:     litestl::util::Map<int, float> factors;
31:   };
32: 
33:   void reset()
34:   {
35:     entries_.clear();
36:     active_.resize(0, false);
37:     scratch_ = CavityScratch();
38:     geometry_ = nullptr;
39:     topology_ = 0;
40:     evaluations_ = 0;
41:   }
42: 
43:   void beginGeometry(const void *geometry, uint64_t topology, int capacity)
44:   {
45:     if (geometry_ != geometry || topology_ != topology) {
46:       reset();
47:       geometry_ = geometry;
48:       topology_ = topology;
49:     }
50:     active_.resize(capacity, false);
51:   }
52: 
53:   Entry &entry(const Brush &brush)
54:   {
55:     const Key key{brush.cavity_blur_steps,
56:                   brush.cavity_factor,
57:                   brush.cavity_inverted,
58:                   brush.cavity_use_curve,
59:                   brush.cavity_curve};
60:     for (auto &item : entries_) {
61:       if (item->key == key)
62:         return *item;
63:     }
64:     auto created = std::make_unique<Entry>();
65:     created->key = key;
66:     entries_.append(std::move(created));
67:     return *entries_.last();
68:   }
69: 
70:   template <class Source> void fill(Entry &entry, const Source &source, int vertex)
71:   {
72:     float *cached = entry.factors.lookup_ptr(vertex);
73:     if (!cached) {
74:       CavityParams params;
75:       params.enabled = true;
76:       params.blur_steps = entry.key.blur;
77:       params.factor = entry.key.factor;
78:       params.inverted = entry.key.inverted;
79:       params.use_curve = entry.key.useCurve;
80:       params.curve_lut = entry.key.curve.data();
81:       const float value =
82:           cavityRemap(params, cavityRawT(source, vertex, params.blur_steps, scratch_));
83:       entry.factors.add(vertex, value);
84:       evaluations_++;
85:       write(vertex, value);
86:     } else {
87:       write(vertex, *cached);
88:     }
89:   }
90: 
91:   void write(int vertex, float value)
92:   {
93:     active_.materialize(vertex);
94:     active_[vertex] = value;
95:   }
96: 
97:   mesh::AttrData<float> *active()
98:   {
99:     return &active_;
100:   }
101:   size_t evaluations() const
102:   {
103:     return evaluations_;
104:   }
105:   size_t configurations() const
106:   {
107:     return entries_.size();
108:   }
109:   size_t storedFactors() const
110:   {
111:     size_t count = 0;
112:     for (const auto &item : entries_)
113:       count += item->factors.size();
114:     return count;
115:   }
116: 
117: private:
118:   litestl::util::Vector<std::unique_ptr<Entry>> entries_;
119:   mesh::AttrData<float> active_{util::string(".prepared.cavity"), 0};
120:   CavityScratch scratch_;
121:   const void *geometry_ = nullptr;
122:   uint64_t topology_ = 0;
123:   size_t evaluations_ = 0;
124: };
125: 
126: /** Select prepared cache behavior only while an accepted prepared stage executes. */
127: struct ScopedPreparedCavity {
128:   bool &flag;
129:   bool previous;
130:   explicit ScopedPreparedCavity(bool &flag) : flag(flag), previous(flag)
131:   {
132:     flag = true;
133:   }
134:   ~ScopedPreparedCavity()
135:   {
136:     flag = previous;
137:   }
138: };
139: 
140: } // namespace sculptcore::brush
