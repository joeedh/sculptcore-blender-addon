80: /** Inputs rows contain pressure, tilt X/Y, speed, presence mask and invert.
81:  * All arrays are borrowed for the call. Each count describes complete rows. */
82: inline bool validDabInputs(int n,
83:                            const float *dabs,
84:                            float strength,
85:                            const float *inputs,
86:                            const float *signs,
87:                            int mirrors)
88: {
89:   if (n < 0 || n > INT_MAX / 7 || mirrors < 0 || mirrors > INT_MAX / 3 ||
90:       (n && (!dabs || !inputs)) || (mirrors && !signs) || !std::isfinite(strength))
91:     return false;
92:   for (int i = 0; i < n; i++) {
93:     const float *d = dabs + i * 7, *s = inputs + i * 6;
94:     for (int j = 0; j < 7; j++)
95:       if (!std::isfinite(d[j]))
96:         return false;
97:     if (d[6] < 0 || (d[6] > 0 && !std::isfinite(1.0f / d[6])))
98:       return false;
99:     for (int j = 0; j < 4; j++)
100:       if (!std::isfinite(s[j]) || s[j] < 0 || s[j] > 1)
101:         return false;
102:     if (!std::isfinite(s[4]) || s[4] < 0 || s[4] > 15 || std::floor(s[4]) != s[4] ||
103:         (s[5] != 0 && s[5] != 1))
104:       return false;
105:   }
106:   for (int i = 0; i < mirrors * 3; i++)
107:     if (signs[i] != -1 && signs[i] != 1)
108:       return false;
109:   return true;
110: }
