52: class BrushPropertyError(RuntimeError):
53:     def __init__(self, status):
54:         self.status = int(status)
55:         super().__init__("Brush property operation failed (status {})".format(status))
56: 
57: 
58: def _check(status):
59:     if status:
60:         raise BrushPropertyError(status)
61: 
62: 
63: def _integer(value):
64:     if isinstance(value, bool) or not isinstance(value, int) or not -(2 ** 31) <= value < 2 ** 31:
65:         raise ValueError("Expected a signed 32-bit integer")
66:     return int(value)
67: 
68: 
69: def _float(value):
70:     if isinstance(value, bool) or not isinstance(value, (int, float)):
71:         raise TypeError("Expected a numeric value")
72:     value = float(value)
73:     if not math.isfinite(value) or abs(value) > 3.4028234663852886e38:
74:         raise ValueError("Expected a finite float32 value")
75:     return value
76: 
77: 
78: def _scalar(scalar_type, value):
79:     if scalar_type == BOOL:
80:         if not isinstance(value, bool):
81:             raise TypeError("Expected a boolean property value")
82:         return float(value)
83:     if scalar_type == INT32:
84:         return float(_integer(value))
85:     if scalar_type == FLOAT32:
86:         return _float(value)
87:     raise ValueError("Unsupported scalar type")
88: 
89: 
90: def _samples(samples):
91:     count = len(samples)
92:     if count == 1 or count > MAX_SAMPLES:
93:         raise ValueError("A response table needs zero or 2..65536 samples")
94:     return [_float(value) for value in samples]
95: 
96: 
97: def _double(value):
98:     if isinstance(value, bool) or not isinstance(value, (int, float)):
99:         raise TypeError("Expected a numeric response parameter")
100:     value = float(value)
