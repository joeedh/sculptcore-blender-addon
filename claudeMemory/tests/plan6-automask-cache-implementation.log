84: const BrushUniformManifestEntry *
85: findUniform(std::span<const BrushUniformManifestEntry> uniforms, const util::string &name)
86: {
87:   for (const auto &entry : uniforms) {
88:     if (entry.name == name) {
89:       return &entry;
90:     }
91:   }
92:   return nullptr;
93: }
94: 
95: ScalarDeclaration declarationOf(const BrushUniformManifestEntry &entry)
96: {
97:   return {entry.name,
98:           entry.scalarType,
99:           entry.hasDefault,
100:           entry.def,
101:           entry.hasRange,
102:           entry.rangeMin,
103:           entry.rangeMax,
104:           entry.dynamic};
105: }
106: 
107: // Every NumBase has a device stack, including types unsupported by execution.
108: const props::Dynamics *dynamicsOf(props::Property *property)
109: {
110:   auto *base = static_cast<props::detail::PropBaseType *>(property);
111: #define DYNAMICS_CASE(type, cls)                                                         \
112:   case Prop::type:                                                                       \
113:     return &static_cast<props::cls *>(base)->dynamics
114:   switch (property->type) {
115:     DYNAMICS_CASE(FLOAT32, Float32Prop);
116:     DYNAMICS_CASE(FLOAT64, Float64Prop);
117:     DYNAMICS_CASE(INT32, Int32Prop);
118:     DYNAMICS_CASE(INT64, Int64Prop);
119:     DYNAMICS_CASE(UINT32, Uint32Prop);
120:     DYNAMICS_CASE(UINT64, Uint64Prop);
121:     DYNAMICS_CASE(INT16, Int16Prop);
122:     DYNAMICS_CASE(UINT16, Uint16Prop);
123:     DYNAMICS_CASE(INT8, Int8Prop);
124:     DYNAMICS_CASE(UINT8, Uint8Prop);
125:     DYNAMICS_CASE(BOOL, BoolProp);
126:     DYNAMICS_CASE(VEC2F, Vec2Prop);
127:     DYNAMICS_CASE(VEC3F, Vec3Prop);
128:     DYNAMICS_CASE(VEC4F, Vec4Prop);
129:   default:
130:     return nullptr;
131:   }
132: #undef DYNAMICS_CASE
133: }
134: 
135: PropError validateTarget(const BrushUniformManifestEntry &entry)
136: {
137:   if (entry.status || entry.isFloat != (entry.scalarType == Prop::FLOAT32)) {
138:     return PropError::ERROR_SCHEMA_CONFLICT;
139:   }
140:   int member = nativeMember(entry.name);
141:   if (member >= 0) {
142:     const auto &native = Brush::builtinPropDescriptorSpan()[member];
143:     if (entry.storeSlot != -1 || (entry.dynamic && !native.dynamic)) {
144:       return PropError::ERROR_SCHEMA_CONFLICT;
145:     }
146:     if (!scalar(entry.scalarType)) {
147:       // Nonscalar native uniforms stay raw; this helper prepares scalar values only.
148:       return entry.scalarType == Prop::INVALID_TYPE && !scalar(native.type) &&
149:                      !entry.dynamic && !entry.hasDefault && !entry.hasRange
150:                  ? PropError::ERROR_NONE
151:                  : PropError::ERROR_INVALID_TYPE;
152:     }
153:     return native.type == entry.scalarType ? PropError::ERROR_NONE
154:                                            : PropError::ERROR_INVALID_TYPE;
155:   }
156:   auto *extra = extraNamedUniformDescriptor(entry.scalarType, entry.storeSlot);
157:   return scalar(entry.scalarType) && extra &&
158:                  std::strcmp(entry.name.c_str(), extra->name) == 0 &&
159:                  entry.scalarType == extra->type && entry.dynamic == extra->dynamic
160:              ? PropError::ERROR_NONE
161:              : PropError::ERROR_SCHEMA_CONFLICT;
162: }
163: 
164: PropError prepareValue(Brush &brush,
165:                        PreparedBrushScalar &result,
166:                        const ScalarDeclaration *declaration,
167:                        bool common,
168:                        const props::DeviceInputCtx &inputs,
169:                        const BrushScalarOverride *override,
170:                        ScalarSource source,
171:                        const BrushDynamicsOverride *stackOverride)
172: {
173:   auto &definition = *brush.props.struct_def;
174:   auto *property = definition.lookup(result.name);
175:   if (property && definition.lookupLocal(result.name) != property) {
176:     return PropError::ERROR_INVALID_OWNER;
177:   }
178:   if (common && !property) {
179:     return PropError::ERROR_NOT_EXISTS;
180:   }
181:   if (property && property->type != result.type) {
182:     return PropError::ERROR_INVALID_TYPE;
183:   }
184:   if (property && property->name != result.name) {
185:     return PropError::ERROR_SCHEMA_CONFLICT;
186:   }
187:   if (definition.validateScalarSchema(result.name) != PropError::ERROR_NONE) {
188:     return PropError::ERROR_SCHEMA_CONFLICT;
189:   }
190:   props::ScalarDomain domain;
191:   if (declaration) {
192:     auto error = props::normalizeScalarDeclaration(*declaration, domain);
193:     if (error != PropError::ERROR_NONE) {
194:       return error;
195:     }
196:   }
197:   PropError error = PropError::ERROR_INVALID_VALUE;
198:   props::numtype_dispatch(result.type, [&]<typename P>() {
199:     using T = typename P::value_type;
200:     auto *typed =
201:         property ? static_cast<P *>(static_cast<props::detail::PropBaseType *>(property))
202:                  : nullptr;
203:     if (!declaration) {
204:       if (!typed) {
205:         error = PropError::ERROR_NOT_EXISTS;
206:         return;
207:       }
208:       domain = {double(typed->min), double(typed->max), 0};
209:     }
210:     if (typed && !result.dynamic && typed->dynamics.devices.size() != 0) {
211:       error = PropError::ERROR_INVALID_DYNAMICS;
212:       return;
213:     }
214:     T base{};
215:     if (!common && source == ScalarSource::RawStandalone && typed &&
216:         typed->dynamics.devices.size())
217:     {
218:       error = PropError::ERROR_INVALID_DYNAMICS;
219:       return;
220:     }
221:     if (override && (override->type != result.type ||
222:                      !named_uniform_detail::convert(override->value, base)))
223:     {
224:       error = override->type != result.type ? PropError::ERROR_INVALID_TYPE
225:                                             : PropError::ERROR_INVALID_VALUE;
226:       return;
227:     }
228:     if (common || (result.dynamic && source == ScalarSource::Authored)) {
229:       if (typed) {
230:         if (typed->getter || (typed->binding_offset != -1 && brush.props.owner)) {
231:           error = PropError::ERROR_INVALID_OWNER;
232:           return;
233:         }
234:         if (!override)
235:           base = *typed->internal_value();
236:       } else if (!override) {
237:         base = T(domain.initial);
238:       }
239:     } else if (!override && result.nativeMember >= 0) {
240:       base = *static_cast<T *>(
241:           Brush::builtinPropDescriptorSpan()[result.nativeMember].address(brush));
242:     } else if (!override) {
243:       const auto &store = [&]() -> const NamedUniformStore<T> & {
244:         if constexpr (std::is_same_v<T, float>)
245:           return brush.namedFloats;
246:         else if constexpr (std::is_same_v<T, int32_t>)
247:           return brush.namedInts;
248:         else
249:           return brush.namedBools;
250:       }();
251:       base = store.initialized(result.storeSlot) ? store.get(result.storeSlot)
252:                                                  : T(domain.initial);
253:     }
254:     if (!std::isfinite(double(base)) || !std::isfinite(domain.min) ||
255:         !std::isfinite(domain.max) || domain.min > domain.max ||
256:         double(base) < domain.min || double(base) > domain.max)
257:     {
258:       return;
259:     }
260:     T evaluated = base;
261:     const props::Dynamics *dynamics = stackOverride ? &stackOverride->dynamics
262:                                       : typed       ? &typed->dynamics
263:                                                     : nullptr;
264:     if (dynamics && result.dynamic &&
265:         !dynamics->evaluateChecked(base, T(domain.min), T(domain.max), inputs, evaluated))
266:     {
267:       error = PropError::ERROR_INVALID_DYNAMICS;
268:       return;
269:     }
270:     result.value = double(evaluated);
271:     error = PropError::ERROR_NONE;
272:   });
273:   return error;
274: }
275: } // namespace
276: 
277: bool resolvedFalloffSupported(const Brush &brush)
278: {
279:   if (brush.falloff_shape != FalloffShape::Spherical)
280:     return false;
281:   if (brush.falloff_kind == FalloffKind::Smoothstep ||
282:       brush.falloff_kind == FalloffKind::Linear)
283:     return true;
284:   if (brush.falloff_kind != FalloffKind::Curve || brush.falloff_curve[0] != 0.0f)
285:     return false;
286:   for (float value : brush.falloff_curve)
287:     if (!std::isfinite(value) || value < 0.0f || value > 1.0f)
288:       return false;
289:   return true;
290: }
291: 
292: props::ScalarRegistrationResult PreparedBrushScalars::publish(Brush &brush) const
293: {
294:   if (brush_ != &brush || definition_ != brush.props.struct_def || !definition_) {
295:     return {PropError::ERROR_INVALID_OWNER, "brush"};
296:   }
297:   auto result = brush.props.struct_def->registerScalars(declarations());
298:   if (result.error != PropError::ERROR_NONE) {
299:     return result;
300:   }
301:   // All recoverable checks precede this barrier. These setters only write
302:   // working caches, including readonly authored sources, never their values.
303:   ensureExtraUniformDefaults(brush);
304:   applyWorking(brush);
305:   return {};
306: }
307: 
308: void PreparedBrushScalars::applyWorking(Brush &brush) const
309: {
310:   brush.cavity_curve = cavityCurve_;
311:   for (const auto &value : values_) {
312:     props::numtype_dispatch(value.type, [&]<typename P>() {
313:       using T = typename P::value_type;
314:       if (value.nativeMember >= 0) {
315:         *static_cast<T *>(Brush::builtinPropDescriptorSpan()[value.nativeMember].address(
316:             brush)) = T(value.value);
317:       } else if constexpr (std::is_same_v<T, float>) {
318:         brush.setEvaluatedNamedFloat(value.storeSlot, T(value.value));
319:       } else if constexpr (std::is_same_v<T, int32_t>) {
320:         brush.setEvaluatedNamedInt(value.storeSlot, T(value.value));
321:       } else if constexpr (std::is_same_v<T, bool>) {
322:         brush.setEvaluatedNamedBool(value.storeSlot, T(value.value));
323:       }
324:     });
325:   }
326: }
327: 
328: props::ScalarRegistrationResult
329: prepareBrushScalars(Brush &brush,
330:                     std::span<const BrushUniformManifestEntry> uniforms,
331:                     const props::DeviceInputCtx &inputs,
332:                     PreparedBrushScalars &output,
333:                     std::span<const BrushScalarOverride> overrides,
334:                     std::span<const BrushUniformManifestEntry> programUniforms,
335:                     ScalarSource source,
336:                     std::span<const BrushDynamicsOverride> dynamicsOverrides,
337:                     std::span<const float> cavityCurveOverride)
338: {
339:   if (!brush.props.struct_def)
340:     return {PropError::ERROR_INVALID_OWNER, "brush"};
341:   PreparedBrushScalars candidate;
342:   candidate.brush_ = &brush;
343:   candidate.definition_ = brush.props.struct_def;
344:   static_assert(Brush::kCavityCurveLutSize == 256);
345:   if (!cavityCurveOverride.empty() && cavityCurveOverride.size() != 256)
346:     return {PropError::ERROR_INVALID_VALUE, "cavity curve"};
347:   for (size_t i = 0; i < 256; i++) {
348:     const float value =
349:         cavityCurveOverride.empty() ? brush.cavity_curve[i] : cavityCurveOverride[i];
350:     if (!std::isfinite(value))
351:       return {PropError::ERROR_INVALID_VALUE, "cavity curve"};
352:     candidate.cavityCurve_[i] = value;
353:   }
354:   for (size_t index = 0; index < uniforms.size(); index++) {
355:     const auto &entry = uniforms[index];
356:     for (size_t prior = 0; prior < index; prior++) {
357:       if (entry.name == uniforms[prior].name)
358:         return {PropError::ERROR_SCHEMA_CONFLICT, entry.name};
359:     }
360:     auto error = validateTarget(entry);
361:     if (error != PropError::ERROR_NONE)
362:       return {error, entry.name};
363:     if (executorSetting(entry.name)) {
364:       for (const auto &setting : executorSettingDeclarations()) {
365:         if (setting.name != entry.name)
366:           continue;
367:         if (entry.scalarType != setting.type || entry.dynamic || entry.hasDefault ||
368:             (entry.hasRange &&
369:              (entry.rangeMin != setting.rangeMin || entry.rangeMax != setting.rangeMax)))
370:           return {PropError::ERROR_SCHEMA_CONFLICT, entry.name};
371:       }
372:     } else if (scalar(entry.scalarType)) {
373:       candidate.declarations_.append(declarationOf(entry));
374:     }
375:   }
376:   auto validation =
377:       brush.props.struct_def->validateScalarDeclarations(candidate.declarations());
378:   if (validation.error != PropError::ERROR_NONE)
379:     return validation;
380: 
381:   auto append =
382:       [&](PreparedBrushScalar value, const ScalarDeclaration *declaration, bool common) {
383:         const BrushScalarOverride *override = nullptr;
384:         for (const auto &item : overrides) {
385:           if (item.name == value.name) {
386:             if (override)
387:               return PropError::ERROR_SCHEMA_CONFLICT;
388:             override = &item;
389:           }
390:         }
391:         const BrushDynamicsOverride *stackOverride = nullptr;
392:         for (const auto &item : dynamicsOverrides) {
393:           if (item.name == value.name) {
394:             if (stackOverride)
395:               return PropError::ERROR_SCHEMA_CONFLICT;
396:             if (item.type != value.type)
397:               return PropError::ERROR_INVALID_TYPE;
398:             if (!value.dynamic || source != ScalarSource::Authored ||
399:                 !props::Dynamics::validStack(item.dynamics.devices))
400:               return PropError::ERROR_INVALID_DYNAMICS;
401:             stackOverride = &item;
402:           }
403:         }
404:         auto error = prepareValue(
405:             brush, value, declaration, common, inputs, override, source, stackOverride);
406:         if (error == PropError::ERROR_NONE)
407:           candidate.values_.append(std::move(value));
408:         return error;
409:       };
410:   for (int id = 0; id <= int(BrushProp::Invert); id++) {
411:     util::string name(brushPropName(id));
412:     ScalarDeclaration declaration;
413:     bool declared = false;
414:     if (auto *entry = findUniform(uniforms, name)) {
415:       declaration = declarationOf(*entry);
416:       declared = true;
417:     } else if (auto *entry = findUniform(programUniforms, name)) {
418:       declaration = declarationOf(*entry);
419:       declared = true;
420:     } else {
421:       declared = brush.props.struct_def->scalarDeclaration(name, declaration);
422:     }
423:     const Prop type = id == int(BrushProp::Invert) ? Prop::BOOL : Prop::FLOAT32;
424:     if (declared && declaration.type != type)
425:       return {PropError::ERROR_INVALID_TYPE, name};
426:     auto error =
427:         append({name, type, 0, !declared || declaration.dynamic, nativeMember(name), -1},
428:                declared ? &declaration : nullptr,
429:                true);
430:     if (error != PropError::ERROR_NONE)
431:       return {error, name};
432:   }
433:   for (const auto &setting : executorSettingDeclarations()) {
434:     auto error =
435:         append({setting.name, setting.type, 0, false, nativeMember(setting.name), -1},
436:                &setting,
437:                false);
438:     if (error != PropError::ERROR_NONE)
439:       return {error, setting.name};
440:   }
441:   for (const auto &entry : uniforms) {
442:     if (!scalar(entry.scalarType) || commonMember(entry.name) >= 0 ||
443:         executorSetting(entry.name))
444:       continue;
445:     auto declaration = declarationOf(entry);
446:     auto error = append({entry.name,
447:                          entry.scalarType,
448:                          0,
449:                          entry.dynamic,
450:                          nativeMember(entry.name),
451:                          entry.storeSlot},
452:                         &declaration,
453:                         false);
454:     if (error != PropError::ERROR_NONE)
455:       return {error, entry.name};
456:   }
457:   for (const auto &override : overrides) {
458:     bool found = false;
459:     for (const auto &value : candidate.values_) {
460:       found |= value.name == override.name;
461:     }
462:     if (!found)
463:       return {PropError::ERROR_NOT_EXISTS, override.name};
464:   }
465:   for (const auto &item : dynamicsOverrides) {
466:     bool found = false;
467:     for (const auto &value : candidate.values_)
468:       found |= value.name == item.name;
469:     if (!found)
470:       return {PropError::ERROR_NOT_EXISTS, item.name};
471:   }
472:   for (auto *property : brush.props.struct_def->properties()) {
473:     auto *dynamics = dynamicsOf(property);
474:     if (!dynamics || dynamics->devices.size() == 0)
475:       continue;
476:     bool eligible = false;
477:     bool active = false;
478:     for (const auto &value : candidate.values_) {
479:       if (value.name == property->name && value.type == property->type &&
480:           brush.props.struct_def->lookupLocal(value.name) == property)
481:       {
482:         eligible = value.dynamic;
483:         active = true;
484:         break;
485:       }
486:     }
487:     if (!active) {
488:       bool belongsToProgram = false;
489:       for (const auto &entry : programUniforms) {
490:         if (entry.name == property->name && entry.scalarType == property->type &&
491:             brush.props.struct_def->lookupLocal(entry.name) == property)
492:         {
493:           belongsToProgram = true;
494:           break;
495:         }
496:       }
497:       // Every owning stage is prepared before execution; report its own errors there.
498:       if (belongsToProgram)
499:         continue;
500:     }
501:     if (!eligible || !props::Dynamics::validStack(dynamics->devices)) {
502:       return {PropError::ERROR_INVALID_DYNAMICS, property->name};
503:     }
504:   }
505:   output = std::move(candidate);
506:   return {};
507: }
508: } // namespace sculptcore::brush
