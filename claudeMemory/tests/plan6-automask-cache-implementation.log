165: static void cavityExecutors()
166: {
167:   for (auto mode : {CommandExecutor::NeighborMode::LiveDisk, CommandExecutor::NeighborMode::Csr}) {
168:     auto *mesh = mesh::createCube(12, 2.0f);
169:     {
170:       spatial::SpatialTree tree(mesh);
171:       tree.leaf_limit = 32;
172:       tree.buildAll();
173:       Brush brush;
174:       brush.cavity_factor = 1;
175:       CommandExecutor ex(&tree, &brush);
176:       ex.neighborMode = mode;
177:       ex.beginStep(false);
178:       cavityExecutionCases(ex, brush, MeshCavitySrc{mesh},
179:                            [&](int v) -> float3 & { return mesh->v.co[v]; }, mesh->v.count);
180:       test_assert(mesh->topo_cache.valid(*mesh));
181:       ex.endStep();
182:       ex.beginStep(false);
183:       test_assert(ex.preparedCavity.evaluations() == 0);
184:       brush.automask_cavity = true;
185:       test_assert(ex.applyResolvedDab(SculptBrushes::DRAW, float3(0, 0, 1), float3(0, 0, 1)).error ==
186:                   PropError::ERROR_NONE);
187:       test_assert(brush.automask_cavity && ex.preparedCavity.evaluations() > 0);
188:       ex.endStep();
189:     }
190:     alloc::Delete(mesh);
191:   }
192:   for (bool deferred : {false, true}) {
193:     auto *cage = mesh::createCube(4, 2.0f);
194:     {
195:       subdiv::Multires mr;
196:       mr.init(*cage, 2);
197:       auto *domain = mr.gridDomain(2);
198:       domain->ensureTree(50);
199:       Brush brush;
200:       brush.cavity_factor = 1;
201:       GridBrushExecutor ex(domain, &brush);
202:       ex.deferNormals = deferred;
203:       ex.beginStep();
204:       cavityExecutionCases(ex, brush, GridBrushExecutor::GridCavitySrc{domain},
205:                            [&](int v) -> float3 & { return domain->pos()[v]; }, domain->vertCount());
206:       ex.endStep();
207:       ex.beginStep();
208:       test_assert(ex.preparedCavity.evaluations() == 0);
209:       ex.endStep();
210:       ex.attach(domain);
211:       test_assert(ex.preparedCavity.configurations() == 0);
212:     }
213:     alloc::Delete(cage);
214:   }
215:   fprintf(stderr, "prepared cavity mesh/grid first-contact cache and lifecycle passed\n");
216: }
