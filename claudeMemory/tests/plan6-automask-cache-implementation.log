17: 
18: props::PropError BrushProgram::setCommandScalarChecked(int idx,
19:                                                        util::string name,
20:                                                        props::Prop type,
21:                                                        double value)
22: {
23:   if (idx < 0 || size_t(idx) >= commands.size() || !name.size() ||
24:       std::strlen(name.c_str()) != name.size())
25:     return PropError::ERROR_NOT_EXISTS;
26:   if (type != Prop::FLOAT32 && type != Prop::INT32 && type != Prop::BOOL)
27:     return PropError::ERROR_INVALID_TYPE;
28:   bool valid = false;
29:   props::numtype_dispatch(type, [&]<typename P>() {
30:     typename P::value_type typed;
31:     valid = named_uniform_detail::convert(value, typed);
32:   });
33:   if (!valid)
34:     return PropError::ERROR_INVALID_VALUE;
35:   for (auto &item : commands[idx].scalarOverrides) {
36:     if (item.name == name) {
37:       item = {name, type, value};
38:       return PropError::ERROR_NONE;
39:     }
40:   }
41:   commands[idx].scalarOverrides.append({name, type, value});
42:   return PropError::ERROR_NONE;
43: }
44: 
45: static PropError commandStackTarget(const BrushProgram &program,
46:                                     int idx,
47:                                     const util::string &name,
48:                                     int scalarType)
49: {
50:   if (idx < 0 || size_t(idx) >= program.commands.size() || !name.size() ||
51:       std::strlen(name.c_str()) != name.size())
52:     return PropError::ERROR_NOT_EXISTS;
53:   if (scalarType != int(Prop::FLOAT32) && scalarType != int(Prop::INT32) &&
54:       scalarType != int(Prop::BOOL))
55:     return PropError::ERROR_INVALID_TYPE;
56:   return PropError::ERROR_NONE;
57: }
58: 
59: int BrushProgram::replaceCommandResponseDynamicsChecked(int idx,
60:                                                         util::string name,
61:                                                         int scalarType,
62:                                                         util::Vector<int> &devices,
63:                                                         util::Vector<int> &modes,
64:                                                         util::Vector<float> &factors,
65:                                                         util::Vector<int> &enabled,
66:                                                         util::Vector<int> &offsets,
67:                                                         util::Vector<float> &samples,
68:                                                         util::Vector<int> &kinds,
69:                                                         util::Vector<double> &parameters)
70: {
71:   auto error = commandStackTarget(*this, idx, name, scalarType);
72:   if (error != PropError::ERROR_NONE)
73:     return int(error);
74:   BrushDynamicsOverride candidate{name, Prop(scalarType), {}};
75:   int status = decodeResponseDynamics(devices,
76:                                       modes,
77:                                       factors,
78:                                       enabled,
79:                                       offsets,
80:                                       samples,
81:                                       kinds,
82:                                       parameters,
83:                                       candidate.dynamics);
84:   if (status)
85:     return status;
86:   for (auto &item : commands[idx].dynamicsOverrides) {
87:     if (item.name == name) {
88:       item = std::move(candidate);
89:       return 0;
90:     }
91:   }
92:   commands[idx].dynamicsOverrides.append(std::move(candidate));
93:   return 0;
94: }
95: 
96: int BrushProgram::removeCommandDynamicsChecked(int idx, util::string name, int scalarType)
97: {
98:   auto error = commandStackTarget(*this, idx, name, scalarType);
99:   if (error != PropError::ERROR_NONE)
100:     return int(error);
101:   Vector<BrushDynamicsOverride> candidate;
102:   for (const auto &item : commands[idx].dynamicsOverrides) {
103:     if (item.name == name) {
104:       if (item.type != Prop(scalarType))
105:         return int(PropError::ERROR_INVALID_TYPE);
106:     } else {
107:       candidate.append(item);
108:     }
109:   }
110:   commands[idx].dynamicsOverrides = std::move(candidate);
111:   return 0;
112: }
113: 
114: int BrushProgram::replaceCommandCavityCurveChecked(int idx, Vector<float> &samples)
115: {
116:   if (idx < 0 || size_t(idx) >= commands.size())
117:     return int(PropError::ERROR_NOT_EXISTS);
118:   if (samples.size() != Brush::kCavityCurveLutSize)
119:     return int(PropError::ERROR_INVALID_VALUE);
120:   for (float sample : samples) {
121:     if (!std::isfinite(sample))
122:       return int(PropError::ERROR_INVALID_VALUE);
123:   }
124:   Vector<float> candidate(samples);
125:   commands[idx].cavityCurveOverride = std::move(candidate);
126:   return 0;
127: }
128: 
129: int BrushProgram::removeCommandCavityCurveChecked(int idx)
130: {
131:   if (idx < 0 || size_t(idx) >= commands.size())
132:     return int(PropError::ERROR_NOT_EXISTS);
133:   commands[idx].cavityCurveOverride.clear();
134:   return 0;
135: }
136: 
137: props::ScalarRegistrationResult programError(size_t index,
138:                                              props::ScalarRegistrationResult error)
139: {
140:   char prefix[64];
141:   std::snprintf(prefix, sizeof(prefix), "command[%zu].", index);
142:   error.name = util::string(prefix) + error.name;
143:   return error;
144: }
145: 
146: props::ScalarRegistrationResult prepareProgramScalars(
147:     Brush &brush,
148:     const BrushProgram &program,
149:     std::span<const std::span<const BrushUniformManifestEntry>> manifests,
150:     const props::DeviceInputCtx &inputs,
151:     PreparedProgramScalars &output)
152: {
153:   if (!brush.props.struct_def || manifests.size() != program.commands.size())
154:     return {PropError::ERROR_INVALID_OWNER, "program"};
155:   util::Vector<props::ScalarDeclaration> declarations;
156:   util::Vector<BrushUniformManifestEntry> scope;
157:   for (size_t i = 0; i < manifests.size(); i++) {
158:     for (const auto &entry : manifests[i]) {
159:       if (!executorSetting(entry.name) &&
160:           (entry.scalarType == Prop::FLOAT32 || entry.scalarType == Prop::INT32 ||
161:            entry.scalarType == Prop::BOOL))
162:       {
163:         declarations.append({entry.name,
164:                              entry.scalarType,
165:                              entry.hasDefault,
166:                              entry.def,
167:                              entry.hasRange,
168:                              entry.rangeMin,
169:                              entry.rangeMax,
170:                              entry.dynamic});
171:       }
172:       bool found = false;
173:       for (const auto &known : scope)
174:         found |= known.name == entry.name;
175:       if (!found)
176:         scope.append(entry);
177:     }
178:     auto result = brush.props.struct_def->validateScalarDeclarations(
179:         {declarations.data(), declarations.size()});
180:     if (result.error != PropError::ERROR_NONE)
181:       return programError(i, result);
182:   }
183:   PreparedProgramScalars candidate;
184:   for (size_t i = 0; i < manifests.size(); i++) {
185:     const auto &command = program.commands[i];
186:     util::Vector<BrushScalarOverride> overrides;
187:     for (const auto &item : command.floatOverrides) {
188:       if (!item.name.size() && (item.propId < 0 || item.propId > int(BrushProp::Invert)))
189:         return programError(i, {PropError::ERROR_NOT_EXISTS, "common property ID"});
190:       overrides.append(
191:           {item.name.size() ? item.name : util::string(brushPropName(item.propId)),
192:            Prop::FLOAT32,
193:            double(item.value)});
194:     }
195:     for (const auto &item : command.scalarOverrides)
196:       overrides.append(item);
197:     if (command.overrideInvert)
198:       overrides.append({"invert", Prop::BOOL, command.invertValue ? 1.0 : 0.0});
199:     for (const auto &item : overrides) {
200:       if (!item.name.size() || std::strlen(item.name.c_str()) != item.name.size())
201:         return programError(i, {PropError::ERROR_NOT_EXISTS, "property name"});
202:     }
203:     PreparedBrushScalars stage;
204:     auto result = prepareBrushScalars(
205:         brush,
206:         manifests[i],
207:         inputs,
208:         stage,
209:         {overrides.data(), overrides.size()},
210:         {scope.data(), scope.size()},
211:         ScalarSource::Authored,
212:         {command.dynamicsOverrides.size() ? &command.dynamicsOverrides[0] : nullptr,
213:          command.dynamicsOverrides.size()},
214:         {command.cavityCurveOverride.size() ? &command.cavityCurveOverride[0] : nullptr,
215:          command.cavityCurveOverride.size()});
216:     if (result.error != PropError::ERROR_NONE)
217:       return programError(i, result);
218:     float radius = -1;
219:     for (const auto &value : stage.values())
220:       if (value.name == util::string("radius"))
221:         radius = float(value.value);
222:     if (!std::isfinite(radius) || radius < 0 ||
223:         (radius > 0 && !std::isfinite(1.0f / radius)))
224:       return programError(i, {PropError::ERROR_INVALID_VALUE, "radius"});
225:     candidate.radius = std::max(candidate.radius, radius);
226:     candidate.radii.append(radius);
227:     candidate.stages.append(std::move(stage));
228:   }
229:   output = std::move(candidate);
230:   return {};
231: }
232: 
233: ScopedBrushWorkingValues::ScopedBrushWorkingValues(
234:     Brush &brush, std::span<const PreparedBrushScalars> stages, bool executorOnly)
235:     : brush_(brush), executorOnly_(executorOnly), floatSize_(brush.namedFloats.size()),
236:       intSize_(brush.namedInts.size()), boolSize_(brush.namedBools.size()),
237:       cavityCurve_(brush.cavity_curve)
238: {
239:   for (const auto &stage : stages) {
240:     for (const auto &value : stage.values()) {
241:       if (executorOnly && !executorSetting(value.name))
242:         continue;
243:       bool found = false;
244:       for (const auto &known : saved_)
245:         found |= known.type == value.type && known.member == value.nativeMember &&
246:                  known.slot == value.storeSlot;
247:       if (found)
248:         continue;
249:       Saved saved{value.type, value.nativeMember, value.storeSlot};
250:       props::numtype_dispatch(value.type, [&]<typename P>() {
251:         using T = typename P::value_type;
252:         static_assert(sizeof(T) <= 4);
253:         if (value.nativeMember >= 0) {
254:           std::memcpy(
255:               saved.bytes.data(),
256:               Brush::builtinPropDescriptorSpan()[value.nativeMember].address(brush),
257:               sizeof(T));
258:         } else {
259:           const auto &store = [&]() -> const NamedUniformStore<T> & {
260:             if constexpr (std::is_same_v<T, float>)
261:               return brush.namedFloats;
262:             else if constexpr (std::is_same_v<T, int32_t>)
263:               return brush.namedInts;
264:             else
265:               return brush.namedBools;
266:           }();
267:           if (size_t(value.storeSlot) < store.size())
268:             std::memcpy(saved.bytes.data(), &store.values_[value.storeSlot], sizeof(T));
269:           saved.initialized = store.initialized(value.storeSlot);
270:         }
271:       });
272:       saved_.append(saved);
273:     }
274:   }
275: }
276: 
277: ScopedBrushWorkingValues::~ScopedBrushWorkingValues()
278: {
279:   brush_.cavity_curve = cavityCurve_;
280:   for (const auto &saved : saved_) {
281:     props::numtype_dispatch(saved.type, [&]<typename P>() {
282:       using T = typename P::value_type;
283:       if (saved.member >= 0) {
284:         std::memcpy(Brush::builtinPropDescriptorSpan()[saved.member].address(brush_),
285:                     saved.bytes.data(),
286:                     sizeof(T));
287:       } else {
288:         auto &store = [&]() -> NamedUniformStore<T> & {
289:           if constexpr (std::is_same_v<T, float>)
290:             return brush_.namedFloats;
291:           else if constexpr (std::is_same_v<T, int32_t>)
292:             return brush_.namedInts;
293:           else
294:             return brush_.namedBools;
295:         }();
296:         if (size_t(saved.slot) < store.size()) {
297:           std::memcpy(&store.values_[saved.slot], saved.bytes.data(), sizeof(T));
298:           store.initialized_[saved.slot] = saved.initialized;
299:         }
300:       }
301:     });
302:   }
303:   if (executorOnly_)
304:     return;
305:   brush_.namedFloats.values_.resize(floatSize_);
306:   brush_.namedFloats.initialized_.resize(floatSize_);
307:   brush_.namedInts.values_.resize(intSize_);
308:   brush_.namedInts.initialized_.resize(intSize_);
309:   brush_.namedBools.values_.resize(boolSize_);
310:   brush_.namedBools.initialized_.resize(boolSize_);
311: }
312: 
313: } // namespace sculptcore::brush
