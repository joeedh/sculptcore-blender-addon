34:       {"cavity_inverted", Prop::BOOL, false, 0, true, 0, 1, false},
35:       {"cavity_use_curve", Prop::BOOL, false, 0, true, 0, 1, false},
36:       {"automask_view_normal", Prop::BOOL, false, 0, true, 0, 1, false},
37:       {"cull_backfaces", Prop::BOOL, false, 0, true, 0, 1, false},
38:       {"view_normal_limit", Prop::FLOAT32, false, 0, true, -maxFloat, maxFloat, false},
39:       {"view_normal_falloff", Prop::FLOAT32, false, 0, true, -maxFloat, maxFloat, false},
40:   };
41:   return settings;
42: }
