31: def replace_command_cavity_curve(manager, program, command, samples):
32:     """Replace the command's owned table atomically; exactly 256 finite float32 samples."""
33:     command = _integer(command)
34:     samples = tuple(_scalar(FLOAT32, value) for value in samples)
35:     if len(samples) != 256:
36:         raise ValueError("Cavity curve requires exactly 256 samples")
37:     function = manager.capi.lib.BrushProgram_replaceCavityCurveChecked
38:     function.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p]
39:     function.restype = ctypes.c_int
40:     with _primitive_vector(manager, 'float', samples) as values:
41:         _check(function(program.ptr, command, values.ptr))
