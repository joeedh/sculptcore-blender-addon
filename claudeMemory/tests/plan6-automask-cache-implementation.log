45:   explicit DabInputOverlay(Brush &brush)
46:       : brush_(brush), radius_(brush.radius), strength_(brush.strength),
47:         invert_(brush.invert), inputs_(brush.deviceInputCtx)
48:   {
49:     radiusProp_ = property<props::Float32Prop>("radius", props::Prop::FLOAT32);
50:     strengthProp_ = property<props::Float32Prop>("strength", props::Prop::FLOAT32);
51:     invertProp_ = property<props::BoolProp>("invert", props::Prop::BOOL);
52:     if (valid()) {
53:       authoredRadius_ = *radiusProp_->internal_value();
54:       authoredStrength_ = *strengthProp_->internal_value();
55:       authoredInvert_ = *invertProp_->internal_value();
56:     }
57:   }
58:   bool valid() const
59:   {
60:     return radiusProp_ && strengthProp_ && invertProp_;
61:   }
62:   void commit()
63:   {
64:     committed_ = true;
65:   }
66:   ~DabInputOverlay()
67:   {
68:     if (!valid() || committed_)
69:       return;
70:     brush_.radius = radius_;
71:     brush_.strength = strength_;
72:     brush_.invert = invert_;
73:     *radiusProp_->internal_value() = authoredRadius_;
74:     *strengthProp_->internal_value() = authoredStrength_;
75:     *invertProp_->internal_value() = authoredInvert_;
76:     brush_.deviceInputCtx = std::move(inputs_);
77:   }
78: };
