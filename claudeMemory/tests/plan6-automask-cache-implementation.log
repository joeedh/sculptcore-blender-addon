19: def set_command_scalar(manager, program, command, name, scalar_type, value):
20:     """Set an exact typed command override; execution checks its manifest membership."""
21:     command = _integer(command)
22:     if not isinstance(name, str) or not name or '\x00' in name:
23:         raise ValueError("Expected a nonempty property name without NUL")
24:     value = _scalar(scalar_type, value)
25:     function = manager.capi.lib.BrushProgram_setScalarChecked
26:     function.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_double]
27:     function.restype = ctypes.c_int
28:     _check(function(program.ptr, command, name.encode('utf-8'), scalar_type, value))
