172: bool GridBrushExecutor::supportsResolvedProgram(BrushProgram *program)
173: {
174:   if (!program)
175:     return false;
176:   for (const auto &entry : program->commands)
177:     if (entry.attrLayerOverrides.size() || !supportsResolved(entry.type))
178:       return false;
179:   return true;
