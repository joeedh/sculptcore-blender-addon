82: template<class Executor, class Source, class Co>
83: static void cavityExecutionCases(Executor &ex, Brush &brush, Source source, Co co, int count)
84: {
85:   const float3 center(0, 0, 1), normal(0, 0, 1);
86:   BrushProgram program;
87:   program.addCommand(int(SculptBrushes::DRAW));
88:   program.addCommand(int(SculptBrushes::DRAW));
89:   // A disabled large first command must not claim first contact for the small cavity command.
90:   program.setCommandFloat(0, int(BrushProp::Radius), 3);
91:   program.setCommandFloat(0, int(BrushProp::Strength), 0);
92:   program.setCommandFloat(1, int(BrushProp::Radius), .9f);
93:   program.setCommandFloat(1, int(BrushProp::Strength), 0);
94:   program.setCommandScalarChecked(1, "automask_cavity", props::Prop::BOOL, 1);
95:   program.setCommandScalarChecked(1, "cavity_factor", props::Prop::FLOAT32, .7);
96:   auto run = [&](float3 position = float3(0, 0, 1)) {
97:     test_assert(ex.applyResolvedProgram(&program, position, normal).error == PropError::ERROR_NONE);
98:     test_assert(!brush.automask_cavity && brush.cavity_factor == 1.0f &&
99:                 !ex.preparedCavityActive);
100:   };
101:   run(float3(100));
102:   test_assert(ex.preparedCavity.configurations() == 0);
103:   run();
104:   test_assert(ex.preparedCavity.configurations() == 1);
105:   size_t contacts = 0;
106:   CavityParams params;
107:   params.enabled = true;
108:   params.factor = .7f;
109:   params.blur_steps = brush.cavity_blur_steps;
110:   params.inverted = brush.cavity_inverted;
111:   params.use_curve = brush.cavity_use_curve;
112:   params.curve_lut = brush.cavity_curve.data();
113:   CavityScratch scratch;
114:   std::vector<float> first(count, -1);
115:   for (int v = 0; v < count; v++) {
116:     if ((co(v) - center).length() / .9f < 1) {
117:       contacts++;
118:       first[v] = cavityRemap(params, cavityRawT(source, v, params.blur_steps, scratch));
119:       test_assert((*ex.preparedCavity.active())[v] == first[v]);
120:     }
121:   }
122:   test_assert(contacts > 0 && ex.preparedCavity.evaluations() == contacts &&
123:               ex.preparedCavity.storedFactors() == contacts);
124:   run();
125:   test_assert(ex.preparedCavity.evaluations() == contacts);
126:   // Alter only neighboring geometry, then revisit A through B: A remains first-contact frozen.
127:   for (int v = 0; v < count; v++)
128:     co(v)[2] += .015f * float((v % 5) - 2);
129:   program.setCommandScalarChecked(1, "cavity_factor", props::Prop::FLOAT32, .8);
130:   run();
131:   test_assert(ex.preparedCavity.configurations() == 2);
132:   const auto afterB = ex.preparedCavity.evaluations();
133:   program.setCommandScalarChecked(1, "cavity_factor", props::Prop::FLOAT32, .7);
134:   run();
135:   for (int v = 0; v < count; v++)
136:     if (first[v] >= 0 && (co(v) - center).length() / .9f < 1)
137:       test_assert((*ex.preparedCavity.active())[v] == first[v]);
138:   const auto afterA = ex.preparedCavity.evaluations();
139:   test_assert(afterA >= afterB);
140:   run();
141:   test_assert(ex.preparedCavity.evaluations() == afterA);
142:   // Every configuration field participates in identity, including a disabled curve's samples.
143:   for (const auto &override : std::initializer_list<BrushScalarOverride>{
144:            {"cavity_blur_steps", props::Prop::INT32, 2},
145:            {"cavity_inverted", props::Prop::BOOL, 1},
146:            {"cavity_use_curve", props::Prop::BOOL, 1}}) {
147:     const auto configs = ex.preparedCavity.configurations();
148:     program.setCommandScalarChecked(1, override.name, override.type, override.value);
149:     run();
150:     test_assert(ex.preparedCavity.configurations() == configs + 1);
151:   }
152:   const auto oldCurve = brush.cavity_curve;
153:   brush.cavity_curve[4] += .01f;
154:   const auto configs = ex.preparedCavity.configurations();
155:   run();
156:   test_assert(ex.preparedCavity.configurations() == configs + 1 &&
157:               brush.cavity_curve[4] == oldCurve[4] + .01f);
158:   // A malformed later command fails before any cache or topology work.
159:   const auto evaluations = ex.preparedCavity.evaluations();
160:   program.commands[1].cavityCurveOverride.append(0);
161:   test_assert(ex.applyResolvedProgram(&program, center, normal).error == PropError::ERROR_INVALID_VALUE);
162:   test_assert(ex.preparedCavity.evaluations() == evaluations && !ex.preparedCavityActive);
163: }
