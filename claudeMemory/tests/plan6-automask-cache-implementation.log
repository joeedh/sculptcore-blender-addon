14: /**
15:  * Automasking: per-vertex 0..1 scalars that scale the *effective brush
16:  * strength* — Blender's `factor_get()` idea, distinct from the painted `mask`
17:  * attribute layer. Two contributors with deliberately different evaluation
18:  * models:
19:  *
20:  *  - Cavity (documentation/plans/2026-07-14-2007-cavity-automasking.md) is
21:  *    CACHED per vertex per stroke in `.brush.automask.cavity` (keyed by
22:  *    `strokeGen` via `.brush.automask.gen`, first dab to reach a vertex wins;
23:  *    freshly split dyntopo verts miss the stamp and fill on first touch). The
24:  *    BFS ring-blur is too expensive per dab, and freezing the estimate at
25:  *    first contact keeps the mask from chasing the surface it is deforming.
26:  *    The BFS needs the ring1 CSR, ensured live before the per-dab topology
27:  *    freeze; a frozen-topo dab that cannot get one simply sits cavity out.
28:  *  - View normal (documentation/plans/2026-07-25-1138-view-normal-automasking.md)
29:  *    is DYNAMIC: fade geometry whose normal turns edge-on to the camera
30:  *    (optionally culling back faces). viewNormalFactor is a few flops, so
31:  *    CommandCtx::strength evaluates it fresh against each vertex's LIVE normal
32:  *    on every call, from ViewNormalParams resolved once per dab — no cache, no
33:  *    stamp ordering, no per-vertex ray history to go stale. Every symmetry
34:  *    image shares the SAME stroke-pinned camera ray: the mask is
35:  *    camera-relative and the camera doesn't mirror. (The original design
36:  *    cached a per-stroke product with per-image reflected rays; first-image-
37:  *    wins stamping then mixed opposed rays in leaf-sized blocks — the
38:  *    node-boundary tearing.)
39:  *
40:  * GPU strokes read one packed per-vertex buffer (binding 24) holding
41:  * cavity x viewNormal, built by packAutomask at beginStroke. That static pack
42:  * matches the CPU's dynamic evaluation because a GPU stroke's normal buffer is
43:  * itself stroke-static (the CPU mesh syncs at stroke end).
44:  */
45: namespace sculptcore::brush {
46: using litestl::math::float3;
47: 
48: /** Cavity settings resolved from the brush once per stroke. */
49: inline constexpr int kCavityCurveSize = 256;
50: 
51: struct CavityParams {
52:   bool enabled = false;
53:   // Number of BFS blur rings; the walk reaches `blur_steps + 1` rings so the
54:   // wide average includes one ring beyond the inner subset.
55:   int blur_steps = 2;
56:   // User strength; scaled by an arbitrary 50x in the remap (Blender parity).
57:   float factor = 1.0f;
58:   // Flip the mask (mask concavities instead of convexities).
59:   bool inverted = false;
60:   // Optional curve remap: when `use_curve`, the linear 0..1 factor is reshaped
61:   // through `curve_lut` (a `kCavityCurveSize`-entry LUT, e.g. Brush::cavity_curve),
62:   // applied before the inversion. Null LUT disables it. Because the GPU path packs
63:   // the same cavityFactor host-side, the curve applies identically on both
64:   // backends and parity holds.
65:   bool use_curve = false;
66:   const float *curve_lut = nullptr;
67: };
68: 
69: /** Clamped linear-interpolated sample of a `kCavityCurveSize` LUT at t in 0..1.
70:  * Mirrors Brush::falloffEval's Curve branch. */
71: inline float sampleCavityCurve(const float *lut, float t)
72: {
73:   float clamped = t < 0.0f ? 0.0f : (t > 1.0f ? 1.0f : t);
74:   float scaled = clamped * float(kCavityCurveSize - 1);
75:   int i0 = int(scaled);
76:   if (i0 >= kCavityCurveSize - 1) {
77:     return lut[kCavityCurveSize - 1];
78:   }
79:   float frac = scaled - float(i0);
80:   return lut[i0] * (1.0f - frac) + lut[i0 + 1] * frac;
81: }
82: 
83: /** Reusable BFS scratch so the per-vertex fill allocates once per stroke, not
84:  * once per vertex. `visitStamp` is a monotonic-token visited set sized to the
85:  * vertex capacity; bumping `token` logically clears it in O(1). */
86: struct CavityScratch {
87:   litestl::util::Vector<uint32_t> visitStamp;
88:   uint32_t token = 0;
89:   litestl::util::Vector<int> frontier;
90:   litestl::util::Vector<int> nextFrontier;
91: 
92:   void ensure(int vertCap)
93:   {
94:     if (int(visitStamp.size()) < vertCap) {
95:       visitStamp.resize(vertCap);
96:       for (int i = 0; i < vertCap; i++) {
97:         visitStamp[i] = 0;
98:       }
99:     }
100:   }
101: };
102: 
103: /**
104:  * Raw signed local-convexity estimate at vertex `v`, generic over the geometry
105:  * source (grids-native brush path): `src` supplies `co(v)` / `no(v)` reads, a
106:  * `neighbors(v)` 1-ring span, and `vertCap()`. BFS-walks the ring out to
107:  * `blur_steps + 1` rings, accumulating a wide average (all visited) and an
108:  * inner average (depth <= blur_steps) of position and normal; returns
109:  * `dot(wideCo - innerCo, normalize(innerNo)) / meanRadius`. Sign encodes
110:  * convex/concave. Returns 0 (flat/neutral) for degenerate neighborhoods.
111:  */
112: template <class Src>
113: inline float cavityRawT(const Src &src, int v, int blur_steps, CavityScratch &scr)
114: {
115:   scr.ensure(src.vertCap());
116:   scr.token++;
117:   const uint32_t tok = scr.token;
118: 
119:   const float3 originCo = src.co(v);
120: 
121:   float3 wideCo{0, 0, 0}, wideNo{0, 0, 0};
122:   float3 innerCo{0, 0, 0}, innerNo{0, 0, 0};
123:   int nWide = 0, nInner = 0;
124:   float lenSum = 0.0f;
125: 
126:   auto visit = [&](int idx, int depth) {
127:     const float3 co = src.co(idx);
128:     wideCo += co;
129:     wideNo += src.no(idx);
130:     nWide++;
131:     lenSum += (co - originCo).length();
132:     if (depth <= blur_steps) {
133:       innerCo += co;
134:       innerNo += src.no(idx);
135:       nInner++;
136:     }
137:   };
138: 
139:   scr.frontier.clear();
140:   scr.visitStamp[v] = tok;
141:   scr.frontier.append(v);
142:   visit(v, 0);
143: 
144:   const int maxDepth = blur_steps + 1;
145:   for (int depth = 1; depth <= maxDepth; depth++) {
146:     scr.nextFrontier.clear();
147:     for (int u : scr.frontier) {
148:       for (int nb : src.neighbors(u)) {
149:         if (scr.visitStamp[nb] == tok) {
150:           continue;
151:         }
152:         scr.visitStamp[nb] = tok;
153:         scr.nextFrontier.append(nb);
154:         visit(nb, depth);
155:       }
156:     }
157:     std::swap(scr.frontier, scr.nextFrontier);
158:     if (scr.frontier.size() == 0) {
159:       break;
160:     }
161:   }
162: 
163:   if (nWide == 0 || nInner == 0) {
164:     return 0.0f;
165:   }
166:   const float meanLen = lenSum / float(nWide);
167:   if (meanLen <= 1e-9f) {
168:     return 0.0f;
169:   }
170: 
171:   wideCo /= float(nWide);
172:   innerCo /= float(nInner);
173:   innerNo /= float(nInner);
174: 
175:   float3 nrm = innerNo;
176:   const float nlen = nrm.length();
177:   // Opposing normals can average to ~0; fall back to the vertex normal so the
178:   // projection stays well-defined.
179:   nrm = nlen > 1e-6f ? nrm / nlen : src.no(v);
180: 
181:   return (wideCo - innerCo).dot(nrm) / meanLen;
182: }
183: 
184: /** cavityRawT source over a mesh's topo-cache ring1 + live co/no. */
185: struct MeshCavitySrc {
186:   mesh::Mesh *m;
187:   int vertCap() const
188:   {
189:     return m->v.count;
190:   }
191:   float3 co(int v) const
192:   {
193:     return m->v.co[v];
194:   }
195:   float3 no(int v) const
196:   {
197:     return m->v.no[v];
198:   }
199:   std::span<const int> neighbors(int v) const
200:   {
201:     // Non-const data(): litestl Vector has no const accessor; read-only here.
202:     mesh::VertNbrCSR &csr = m->topo_cache.ring1;
203:     uint32_t off = csr.offsets[v];
204:     return std::span<const int>(csr.nbr_verts.data() + off, csr.offsets[v + 1] - off);
205:   }
206: };
207: 
208: /** The historical mesh entry: cavityRawT over the topo-cache ring1. Requires
209:  * `m->topo_cache.ring1` current (caller ensures it) and live `v.co` / `v.no`. */
210: inline float cavityRaw(mesh::Mesh *m, int v, int blur_steps, CavityScratch &scr)
211: {
212:   if (int(m->topo_cache.ring1.offsets.size()) <= v + 1) {
213:     return 0.0f;
214:   }
215:   return cavityRawT(MeshCavitySrc{m}, v, blur_steps, scr);
216: }
217: 
218: /**
219:  * Remap a raw signed cavity estimate to a 0..1 mask factor. Ported from Blender's
220:  * `calc_cavity_factor`: concave pushes toward 1 and convex toward 0, so the brush
221:  * effect stays in cavities (flipped when inverted). Flat surfaces read exactly the
222:  * 0.5 center. The 50x is Blender's arbitrary strength scale.
223:  */
224: inline float cavityRemap(const CavityParams &p, float raw)
225: {
226:   float sign = raw < 0.0f ? -1.0f : 1.0f;
227:   float factor = std::fabs(raw) * p.factor * 50.0f;
228:   factor = factor * sign * 0.5f + 0.5f;
229:   factor = factor < 0.0f ? 0.0f : (factor > 1.0f ? 1.0f : factor);
230:   // Optional user curve reshapes the linear factor before the inversion, so the
231:   // curve is authored in un-inverted space (matches Blender's CAVITY_USE_CURVE).
232:   if (p.use_curve && p.curve_lut) {
233:     factor = sampleCavityCurve(p.curve_lut, factor);
234:   }
235:   return p.inverted ? 1.0f - factor : factor;
