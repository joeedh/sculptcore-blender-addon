142:   // Reflected fields are mutable. Legacy queriedUniformEntry returns a borrowed
143:   // pointer invalidated by requery; uniformSnapshotChecked returns an owned copy.
144:   // Checked operations use a separate private canonical mapping.
145:   static litestl::binding::types::Struct<BrushUniformManifestEntry> *defineBindings()
146:   {
147:     using namespace litestl::binding;
148:     types::Struct<BrushUniformManifestEntry> *st =
149:         new types::Struct<BrushUniformManifestEntry>(
150:             "sculptcore::brush::BrushUniformManifestEntry",
151:             sizeof(BrushUniformManifestEntry));
152:     BIND_STRUCT_DEFAULT_CONSTRUCTOR(st);
153:     BIND_STRUCT_MEMBER(st, name);
154:     BIND_STRUCT_MEMBER(st, isFloat);
155:     BIND_STRUCT_MEMBER(st, dynamic);
156:     BIND_STRUCT_MEMBER(st, def);
157:     BIND_STRUCT_MEMBER(st, hasRange);
158:     BIND_STRUCT_MEMBER(st, rangeMin);
159:     BIND_STRUCT_MEMBER(st, rangeMax);
160:     BIND_STRUCT_MEMBER(st, storeSlot);
161:     BIND_STRUCT_MEMBER(st, scalarType);
162:     BIND_STRUCT_MEMBER(st, hasDefault);
163:     BIND_STRUCT_MEMBER(st, status);
164:     return st;
165:   }
