51:       std::strlen(name.c_str()) != name.size())
52:     return PropError::ERROR_NOT_EXISTS;
53:   if (scalarType != int(Prop::FLOAT32) && scalarType != int(Prop::INT32) &&
54:       scalarType != int(Prop::BOOL))
