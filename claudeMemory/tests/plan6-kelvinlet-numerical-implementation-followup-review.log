75: static void kelvinletNumerics()
76: {
77:   Brush brush;
78:   brush.unboundedExtent = 0;
79:   size_t cases = 0;
80:   for (int exponent : {-127, -126, -100, -80, -40, -10, 0, 10, 40, 80, 120}) {
81:     brush.radius = std::ldexp(1.0f, exponent);
82:     for (float mu : {std::nextafter(1e-6f, 1.0f), 1.0f, 100.0f})
83:       for (float nu : {0.0f, .4f, std::nextafter(.499f, 0.0f)}) {
84:         brush.mu = mu;
85:         brush.nu = nu;
86:         for (float3 offset : {float3(0.0f),
87:                               float3(brush.radius, 0, 0),
88:                               float3(brush.radius * .5f),
89:                               float3(1, 2, -1),
90:                               float3(std::ldexp(1.0f, 24), 0, 0)})
91:           for (float3 force : {float3(.1f, -.2f, .3f),
92:                                float3(0, std::ldexp(1.0f, 24), 0),
93:                                float3(std::numeric_limits<float>::max() * .5f)})
94:           {
95:             KelvinletProbe probe;
96:             KelvinletProbe::Node node;
97:             CommandCtxBase base;
98:             CommandCtx<KelvinletProbe> context(base, node, probe, brush);
99:             brush.grabFrom = offset * -1.0f;
100:             brush.grabTo = force;
101:             auto expected = kelvinletReference(
102:                 float3(0.0f), brush.grabFrom, force, brush.radius, mu, nu);
103:             command::kelvinlet<KelvinletProbe, AccumLive>(context);
104:             double forceScale = std::max({std::abs(double(force[0])),
105:                                           std::abs(double(force[1])),
106:                                           std::abs(double(force[2]))});
107:             double error[3];
108:             for (int axis = 0; axis < 3; axis++) {
109:               test_assert(std::isfinite(probe.point.co[axis]));
110:               error[axis] = double(probe.point.co[axis]) - expected[axis];
111:             }
112:             test_assert(std::hypot(error[0], error[1], error[2]) <=
113:                         4e-6 * forceScale +
114:                             8 * double(std::numeric_limits<float>::denorm_min()));
115:             test_assert(node.updated && node.affected_verts.size() == 1);
116:             cases++;
117:           }
118:       }
119:   }
120:   // The normalized coefficient must not round above one near the origin:
121:   // multiplying even one excess ulp by FLT_MAX overflows a representable field.
122:   const float largest = std::numeric_limits<float>::max();
123:   const float minimum = std::nextafter(std::ldexp(1.0f, -128), 1.0f);
124:   for (float radius : {minimum, 1.0f})
125:     for (int axis = 0; axis < 3; axis++)
126:       for (float distance : {0.0f, std::ldexp(1.0f, -20), std::ldexp(1.0f, -10)}) {
127:         KelvinletProbe probe;
128:         KelvinletProbe::Node node;
129:         CommandCtxBase base;
130:         CommandCtx<KelvinletProbe> context(base, node, probe, brush);
131:         brush.radius = radius;
132:         brush.mu = 1.0f - 6.0f * std::ldexp(1.0f, -24);
133:         brush.nu = 0;
134:         brush.grabFrom = float3(0.0f);
135:         brush.grabFrom[axis] = -distance;
136:         brush.grabTo = float3(0.0f);
137:         brush.grabTo[(axis + 1) % 3] = largest;
138:         const auto expected = kelvinletReference(
139:             probe.point.co, brush.grabFrom, brush.grabTo, radius, brush.mu, brush.nu);
140:         command::kelvinlet<KelvinletProbe, AccumLive>(context);
141:         double error[3];
142:         for (int i = 0; i < 3; i++) {
143:           test_assert(std::isfinite(probe.point.co[i]));
144:           error[i] = double(probe.point.co[i]) - expected[i];
145:         }
146:         test_assert(std::hypot(error[0], error[1], error[2]) <= 4e-6 * double(largest));
147:       }
148:   // Opposing finite endpoints overflow a float subtraction; transverse output
149:   // remains measurable even though adding a small axial result rounds away.
150:   {
151:     KelvinletProbe probe;
152:     probe.point.co = float3(largest, 0, 0);
153:     KelvinletProbe::Node node;
154:     CommandCtxBase base;
155:     CommandCtx<KelvinletProbe> context(base, node, probe, brush);
156:     brush.grabFrom = float3(-largest, 0, 0);
157:     brush.grabTo = float3(0, largest, 0);
158:     brush.radius = largest;
159:     brush.mu = 1;
160:     brush.nu = .4f;
161:     const auto expected = kelvinletReference(
162:         probe.point.co, brush.grabFrom, brush.grabTo, brush.radius, brush.mu, brush.nu);
163:     command::kelvinlet<KelvinletProbe, AccumLive>(context);
164:     test_assert(probe.point.co[0] == largest && std::isfinite(probe.point.co[1]));
165:     test_assert(std::abs(double(probe.point.co[1]) - expected[1]) <=
166:                 4e-6 * double(largest));
167:   }
168:   // Distinct window and field centers expose distance-square under/overflow.
169:   brush.grabFrom = float3(0.0f);
170:   brush.grabTo = float3(0, 1, 0);
171:   brush.mu = 1;
172:   brush.nu = .4f;
173:   brush.unboundedExtent = 1;
174:   for (int exponent : {-80, 80}) {
175:     brush.radius = std::ldexp(1.0f, exponent);
176:     for (float distance : {.5f,
177:                            std::nextafter(.8f, 0.0f),
178:                            .8f,
179:                            std::nextafter(.8f, 1.0f),
180:                            .9f,
181:                            std::nextafter(1.0f, 0.0f),
182:                            1.0f,
183:                            std::nextafter(1.0f, 2.0f),
184:                            2.0f})
185:     {
186:       KelvinletProbe probe;
187:       KelvinletProbe::Node node;
188:       CommandCtxBase base;
189:       base.surfacePos = float3(brush.radius * distance, 0, 0);
190:       CommandCtx<KelvinletProbe> context(base, node, probe, brush);
191:       const double expected =
192:           cutoffReference(float3(0.0f), base.surfacePos, brush.radius, 1);
193:       test_assert(std::abs(double(context.unboundedWindow(float3(0.0f))) - expected) <
194:                   1e-7);
195:       command::kelvinlet<KelvinletProbe, AccumLive>(context);
196:       test_assert(std::abs(double(probe.point.co[1]) - expected) < 1e-7);
197:       test_assert(node.updated == (expected != 0));
198:       test_assert(node.affected_verts.size() == size_t(expected != 0));
199:     }
200:   }
201:   static int textureCalls = 0;
202:   TextureProgram texture;
203:   texture.eval = [](const float *, const float *, const float *, const TexEvalCtx *) {
204:     textureCalls++;
205:     return 1.0f;
206:   };
207:   brush.texture_program = &texture;
208:   for (int skip = 0; skip < 3; skip++) {
209:     KelvinletProbe probe;
210:     KelvinletProbe::Node node;
211:     CommandCtxBase base;
212:     base.surfacePos = float3(skip == 2 ? 2.0f : 0.0f, 0, 0);
213:     CommandCtx<KelvinletProbe> context(base, node, probe, brush);
214:     brush.radius = skip == 0 ? 0 : 1;
215:     brush.grabTo = float3(0, skip == 1 ? 0.0f : 1.0f, 0);
216:     textureCalls = 0;
217:     command::kelvinlet<KelvinletProbe, AccumLive>(context);
218:     test_assert(textureCalls == 0 && !node.updated && node.affected_verts.size() == 0);
219:     test_assert(probe.point.co.length() == 0);
220:   }
221:   brush.texture_program = nullptr;
222:   fprintf(
223:       stderr,
224:       "Kelvinlet double reference passed %zu scalar endpoint cases and cutoff extremes\n",
225:       cases);
226: }
