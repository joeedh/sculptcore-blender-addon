38: static std::array<double, 3> kelvinletReference(
39:     float3 point, float3 from, float3 force, float radius, float mu, float nu)
40: {
41:   // Original formula, with promotion BEFORE subtraction, squaring and products.
42:   const double a = (1.0 + double(nu)) / (2.0 * double(mu));
43:   const double b = a / (4.0 * (1.0 - double(nu)));
44:   std::array<double, 3> r, output;
45:   double rr = double(radius) * double(radius), dot = 0;
46:   for (int axis = 0; axis < 3; axis++) {
47:     r[axis] = double(point[axis]) - double(from[axis]);
48:     rr += r[axis] * r[axis];
49:     dot += double(force[axis]) * r[axis];
50:   }
51:   const double e = std::sqrt(rr), inverseCube = 1.0 / (e * e * e);
52:   const double c1 = (a - b) / e + .5 * a * double(radius) * double(radius) * inverseCube;
53:   const double c2 = b * dot * inverseCube;
54:   const double normalize = double(radius) / std::max(1.5 * a - b, 1e-6);
55:   for (int axis = 0; axis < 3; axis++)
56:     output[axis] = (double(force[axis]) * c1 + r[axis] * c2) * normalize;
57:   return output;
58: }
59: 
60: static double cutoffReference(float3 point, float3 center, float radius, float extent)
61: {
62:   if (extent <= 0)
63:     return 1;
64:   // The cutoff is explicitly a float product in the native execution contract.
65:   const double cutoff = double(radius * extent);
66:   double squared = 0;
67:   for (int axis = 0; axis < 3; axis++) {
68:     const double d = double(point[axis]) - double(center[axis]);
69:     squared += d * d;
70:   }
71:   const double t = std::clamp((cutoff - std::sqrt(squared)) / (.2 * cutoff), 0.0, 1.0);
72:   return t * t * (3.0 - 2.0 * t);
73: }
