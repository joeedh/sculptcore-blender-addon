310:     meshlog::MeshLog meshLog;
311:     meshLog.setActiveMesh(mesh);
312:     subdiv::GridStrokeLog gridLog;
313:     Brush brush;
314:     brush.radius = .25f;
315:     brush.strength = .12f;
316:     brush.unboundedExtent = extent;
317:     brush.grabFrom = float3(.2f, -.1f, 1.1f);
318:     brush.grabTo = float3(.03f, -.02f, .08f);
319:     brush.automask_cavity = cavity;
320:     brush.cavity_factor = 0;
321:     brush.writeProps();
322:     CommandExecutor meshEx(&tree, &brush);
323:     meshEx.meshLog = &meshLog;
324:     meshEx.anchoredGrab = false;
325:     meshEx.neighborMode = neighbors;
326:     GridBrushExecutor gridEx(domain, &brush, &gridLog);
327:     gridEx.anchoredGrab = false;
328:     gridEx.deferNormals = deferred;
329:     if (grid)
330:       gridEx.beginStep();
331:     else
332:       meshEx.beginStep(false);
333:     auto positions = [&]() {
334:       std::vector<float3> output;
335:       const int count = grid ? domain->vertCount() : mesh->v.count;
336:       for (int v = 0; v < count; v++)
337:         output.push_back(grid ? domain->pos()[v] : mesh->v.co[v]);
338:       return output;
339:     };
340:     const auto original = positions();
341:     auto expected = original;
342:     std::vector<bool> contacted(original.size(), false);
343:     BrushProgram program;
344:     if (programMode)
345:       program.addCommand(int(SculptBrushes::DRAW));
346:     const int field = program.addCommand(int(SculptBrushes::KELVINLET));
347:     if (programMode) {
348:       program.setCommandScalarChecked(0, "radius", props::Prop::FLOAT32, .25);
349:       program.setCommandScalarChecked(field, "mu", props::Prop::FLOAT32, 2);
350:       BrushDynamicsOverride material{"mu", props::Prop::FLOAT32, {}};
351:       material.dynamics.configure(
352:           props::DeviceType::PRESSURE, math::BasicMix::MULTIPLY, 1);
353:       program.commands[field].dynamicsOverrides.append(std::move(material));
354:       program.setCommandScalarChecked(field, "nu", props::Prop::FLOAT32, .1f);
355:       BrushDynamicsOverride poisson{"nu", props::Prop::FLOAT32, {}};
356:       poisson.dynamics.configure(props::DeviceType::PRESSURE, math::BasicMix::ADD, .25f);
357:       program.commands[field].dynamicsOverrides.append(std::move(poisson));
358:     }
359:     const float3 center(0, 0, 1), normal(0, 0, 1);
360:     auto run = [&](bool validateOnly = false) {
361:       if (programMode)
362:         return grid ? gridEx.applyResolvedProgram(&program, center, normal, validateOnly)
363:                     : meshEx.applyResolvedProgram(&program, center, normal, validateOnly);
364:       return grid ? gridEx.applyResolvedDab(
365:                         SculptBrushes::KELVINLET, center, normal, validateOnly)
366:                   : meshEx.applyResolvedDab(
367:                         SculptBrushes::KELVINLET, center, normal, validateOnly);
368:     };
369:     for (int dab = 0; dab < 2; dab++) {
370:       const float radius = dab == 0 ? 1.3f : 2.7f;
371:       const float pressure = dab == 0 ? .4f : .8f;
372:       brush.pushDeviceInput(int(props::DeviceType::PRESSURE), pressure);
373:       if (programMode)
374:         program.setCommandScalarChecked(field, "radius", props::Prop::FLOAT32, radius);
375:       else
376:         *source(brush, "radius")->internal_value() = radius;
377:       // Validation must inspect the entire late candidate before any query/capture.
378:       const auto prior = positions();
379:       const auto oldPath = brush.strokePathCount;
380:       const auto oldGrid = grid ? gridState(gridEx) : std::string();
381:       const auto evaluations = grid ? gridEx.preparedCavity.evaluations()
382:                                     : meshEx.preparedCavity.evaluations();
383:       const auto topology = mesh->topo_stamp;
384:       auto rejected = [&]() {
385:         for (bool only : {false, true})
386:           test_assert(run(only).error == PropError::ERROR_INVALID_VALUE);
387:         test_assert(exactUnboundedPositions(positions(), prior) &&
388:                     brush.strokePathCount == oldPath);
389:         test_assert(mesh->topo_stamp == topology);
390:         test_assert((grid ? gridEx.preparedCavity.evaluations()
391:                           : meshEx.preparedCavity.evaluations()) == evaluations);
392:         if (grid)
393:           test_assert(gridState(gridEx) == oldGrid);
394:       };
395:       for (float invalid : {std::numeric_limits<float>::infinity(),
396:                             std::numeric_limits<float>::quiet_NaN(),
397:                             std::numeric_limits<float>::max()})
398:       {
399:         brush.unboundedExtent = invalid;
400:         rejected();
401:       }
402:       for (auto [badRadius, badExtent] :
403:            {std::pair{1e-20f, 1e-30f},
404:             std::pair{1.0f, std::numeric_limits<float>::denorm_min()}})
405:       {
406:         if (programMode)
407:           program.setCommandScalarChecked(
408:               field, "radius", props::Prop::FLOAT32, badRadius);
409:         else
410:           *source(brush, "radius")->internal_value() = badRadius;
411:         brush.unboundedExtent = badExtent;
412:         rejected();
413:       }
414:       if (programMode)
415:         program.setCommandScalarChecked(field, "radius", props::Prop::FLOAT32, radius);
416:       else
417:         *source(brush, "radius")->internal_value() = radius;
418:       brush.unboundedExtent = extent;
419:       for (auto *vector : {&brush.grabFrom, &brush.grabTo})
420:         for (int axis = 0; axis < 3; axis++) {
421:           const float saved = (*vector)[axis];
422:           for (float invalid : {std::numeric_limits<float>::infinity(),
423:                                 std::numeric_limits<float>::quiet_NaN()})
424:           {
425:             (*vector)[axis] = invalid;
426:             rejected();
427:           }
428:           (*vector)[axis] = saved;
429:         }
430:       test_assert(exactUnboundedPositions(positions(), prior) &&
431:                   brush.strokePathCount == oldPath);
432:       if (grid)
433:         test_assert(gridState(gridEx) == oldGrid);
434:       test_assert(run(true).error == PropError::ERROR_NONE);
435:       test_assert(exactUnboundedPositions(positions(), prior) &&
436:                   brush.strokePathCount == oldPath);
437:       const float mu = programMode ? 2.0f * pressure : 1.0f;
438:       const float nu = programMode ? .1f + pressure * .25f : .4f;
439:       for (size_t v = 0; v < expected.size(); v++) {
440:         auto &p = expected[v];
441:         if (programMode) {
442:           const float t = 1.0f - std::min((p - center).length() / .25f, 1.0f);
443:           const float falloff = t * t * (3.0f - 2.0f * t);
444:           if (cavity && t > 0)
445:             contacted[v] = true;
446:           p += normal * (falloff * .12f * .25f * .5f * (cavity ? .5f : 1.0f));
447:         }
448:         const double window = cutoffReference(p, center, radius, extent);
449:         if (cavity && (extent <= 0 || std::hypot(double(p[0]) - double(center[0]),
450:                                                  double(p[1]) - double(center[1]),
451:                                                  double(p[2]) - double(center[2])) <
452:                                           double(radius * extent)))
453:           contacted[v] = true;
454:         const auto delta =
455:             kelvinletReference(p, brush.grabFrom, brush.grabTo, radius, mu, nu);
456:         for (int axis = 0; axis < 3; axis++)
457:           p[axis] = float(double(p[axis]) + delta[axis] * window * (cavity ? .5 : 1.0));
458:       }
459:       test_assert(run().error == PropError::ERROR_NONE);
460:       const auto actual = positions();
461:       for (size_t v = 0; v < actual.size(); v++)
462:         test_assert((actual[v] - expected[v]).length() < 3e-6f);
463:       test_assert(brush.unboundedExtent == extent);
464:       if (programMode)
465:         test_assert(brush.radius == .25f && brush.mu == 1 && brush.nu == .4f);
466:       if (cavity) {
467:         size_t count = 0;
468:         for (bool touched : contacted)
469:           count += touched;
470:         test_assert((grid ? gridEx.preparedCavity.evaluations()
471:                           : meshEx.preparedCavity.evaluations()) == count);
472:       }
473:     }
474:     int outside = 0;
475:     const auto after = positions();
476:     for (size_t v = 0; v < after.size(); v++)
477:       outside += (original[v] - center).length() > .5f &&
478:                  (after[v] - original[v]).length() > 1e-5f;
479:     test_assert(outside > 0);
480:     if (grid) {
481:       gridEx.endStep();
482:       gridLog.undo();
483:     } else {
484:       meshEx.endStep();
485:       meshLog.undo(mesh, &tree);
486:     }
487:     test_assert(exactUnboundedPositions(positions(), original));
488:     if (grid)
489:       gridLog.redo();
490:     else
491:       meshLog.redo(mesh, &tree);
492:     test_assert(exactUnboundedPositions(positions(), after));
493:   }
494:   alloc::Delete(mesh);
495: }
