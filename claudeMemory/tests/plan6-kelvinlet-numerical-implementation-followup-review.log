236:   const BrushUniformManifestEntry manifest{
237:       "unboundedExtent", true, true, 0, false, 0, 0, -1, props::Prop::FLOAT32, true};
238:   const BrushScalarOverride override{"unboundedExtent", props::Prop::FLOAT32, 3};
239:   test_assert(prepareBrushScalars(
