281: static bool exactUnboundedPositions(const std::vector<float3> &a,
282:                                     const std::vector<float3> &b)
283: {
284:   if (a.size() != b.size())
285:     return false;
286:   for (size_t i = 0; i < a.size(); i++)
287:     for (int axis = 0; axis < 3; axis++)
288:       if (a[i][axis] != b[i][axis])
289:         return false;
290:   return true;
291: }
