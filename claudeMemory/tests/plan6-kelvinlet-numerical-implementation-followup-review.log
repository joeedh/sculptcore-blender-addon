497: template <class Executor, class Source, class Co>
498: static void unboundedCavity(Executor &ex, Brush &brush, Source source, Co co, int count)
499: {
500:   brush.automask_cavity = true;
501:   brush.cavity_factor = .7f;
502:   brush.cavity_blur_steps = 1;
503:   brush.grabTo = float3(0.0f);
504:   brush.writeProps();
505:   ex.anchoredGrab = false;
506:   BrushProgram program;
507:   program.addCommand(int(SculptBrushes::KELVINLET));
508:   std::vector<float> saved(count, -1);
509:   CavityParams params;
510:   params.enabled = true;
511:   params.factor = .7f;
512:   params.blur_steps = 1;
513:   params.curve_lut = brush.cavity_curve.data();
514:   CavityScratch scratch;
515:   size_t contacts = 0;
516:   for (int dab = 0; dab < 3; dab++) {
517:     if (dab)
518:       for (int v = 0; v < count; v++)
519:         co(v)[2] += .017f * float(v % 5 - 2);
520:     // Vertex zero is exactly on the first cutoff. No first contact occurs there.
521:     const float radius = dab == 0 ? .5f : 2;
522:     const float3 center = dab == 0 ? co(0) + float3(.5f, 0, 0) : float3(0.0f);
523:     brush.unboundedExtent = dab == 2 ? 0 : 1;
524:     program.setCommandScalarChecked(0, "radius", props::Prop::FLOAT32, radius);
525:     program.setCommandScalarChecked(0, "mu", props::Prop::FLOAT32, 1 + dab);
526:     program.setCommandScalarChecked(0, "nu", props::Prop::FLOAT32, .1f * dab);
527:     std::vector<bool> supported(count);
528:     for (int v = 0; v < count; v++) {
529:       supported[v] = dab == 2 || std::hypot(double(co(v)[0]) - center[0],
530:                                             double(co(v)[1]) - center[1],
531:                                             double(co(v)[2]) - center[2]) < radius;
532:       if (supported[v] && saved[v] < 0) {
533:         saved[v] = cavityRemap(params, cavityRawT(source, v, 1, scratch));
534:         contacts++;
535:       }
536:     }
537:     if (dab == 0)
538:       test_assert(!supported[0] && saved[0] < 0);
539:     test_assert(ex.applyResolvedProgram(&program, center, float3(0, 0, 1)).error ==
540:                 PropError::ERROR_NONE);
541:     test_assert(ex.preparedCavity.configurations() == 1);
542:     test_assert(ex.preparedCavity.evaluations() == contacts);
543:     for (int v = 0; v < count; v++)
544:       if (supported[v])
545:         test_assert((*ex.preparedCavity.active())[v] == saved[v]);
546:   }
547:   test_assert(contacts == size_t(count));
548:   const auto [minimum, maximum] = std::minmax_element(saved.begin(), saved.end());
549:   test_assert(*maximum - *minimum > .01f);
550: }
