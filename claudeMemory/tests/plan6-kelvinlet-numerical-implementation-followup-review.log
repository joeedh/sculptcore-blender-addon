190: struct CommandCtxBase {
191:   float2 mouse;
192:   float3 mousePos;
193:   float3 surfacePos; // pos of vertex at center of brush dot
194:   float3 surfaceNo;  // normal of vertex at center of brush dot
195:   float3 mouseDir;
196:   mat4 renderMatrix;
197: 
198:   bool isFirstOfStep = false;
199: 
200:   meshlog::MeshLog *meshLog = nullptr;
201:   mesh::Mesh *m = nullptr;
202: 
203:   // Pre-dab snapshot of the whole mesh's vertex positions, owned by the
204:   // executor and populated before the parallel per-node loop when a brush
205:   // needs it (see BrushCommandDef::needsCoPrev). for_neighbor reads neighbor
206:   // positions from here so smoothing is Jacobi — order-independent and
207:   // race-free across the parallel node loop, and bit-modulo-fp identical to
208:   // the GPU kernel (which reads its own co_prev binding).
209:   litestl::util::Vector<litestl::math::float3> *co_prev = nullptr;
210: 
211:   // Resolved DSL attribute bindings for this dab (owned by the executor),
212:   // looked up by handle in generated kernels via boundAttr<T>().
213:   const BrushAttrBindings *attrBindings = nullptr;
214: 
215:   // Displacement base (the `.brush.disp.*` TEMP attrs, see
216:   // plans/2026-07-26-0909-brush-displacement-base-attribute.md): `dispVec`
217:   // accumulates what the brush has moved each vert this stroke, so the
218:   // stroke-start base is `co - disp` and advects with the surface under dyntopo
219:   // instead of being pinned to a stale snapshot. Valid iff dispGen[v] ==
220:   // strokeGen; null when no from-base consumer is active.
221:   mesh::AttrData<litestl::math::float3> *dispVec = nullptr;
222:   mesh::AttrData<int> *dispGen = nullptr;
223:   uint32_t strokeGen = 0;
224: 
225:   // Stroke-start NORMAL snapshot (`.brush.orig.no`), stamped at first touch
226:   // alongside dispVec and sharing its generation, only for kernels that opt in
227:   // via BrushCommandDef::needsOrigNormals (no consumer yet — the view-normal
228:   // mask evaluates live normals dynamically); null otherwise.
229:   mesh::AttrData<litestl::math::float3> *origNo = nullptr;
230: 
231:   // Grab-class symmetry first-touch stamp (#35): `dabGen` is the `.brush.dab.gen`
232:   // TEMP attr, a vert counts as written this dab iff dabGen[v] == curDabGen.
233:   // Drives the AccumOrigGrab re-base/add choice. Null/0 outside a grab dab.
234:   mesh::AttrData<int> *dabGen = nullptr;
235:   uint32_t curDabGen = 0;
236: 
237:   // Automasking (automask.h), two independent contributors:
238:   //  - Cavity is CACHED: `automaskFactor` is the `.brush.automask.cavity` TEMP
239:   //    attr, filled host-side once per vertex per stroke (keyed by strokeGen via
240:   //    `.brush.automask.gen`) — the BFS ring-blur is too expensive per dab, and
241:   //    freezing it at first contact keeps the mask from chasing the deforming
242:   //    surface. Null / automaskEnabled=false when inactive.
243:   //  - View-normal is DYNAMIC: `viewNormal` holds this dab's resolved params
244:   //    (the acting symmetry image's own reflected ray); strength() evaluates
245:   //    viewNormalFactor against the vertex's LIVE normal on every call, so
246:   //    there is no per-vertex ray history to go stale.
247:   mesh::AttrData<float> *automaskFactor = nullptr;
248:   bool automaskEnabled = false;
249:   ViewNormalParams viewNormal;
250: 
251:   // Fetch a bound non-bool attribute's data by kernel handle. Returns nullptr
252:   // when unbound (an optional layer that was absent); write kernels always
253:   // declare their target, so it's non-null there.
254:   template <typename T> mesh::AttrData<T> *boundAttr(const char *handle) const
255:   {
256:     if (!attrBindings)
257:       return nullptr;
258:     const mesh::AttrRef *ref = attrBindings->find(handle);
259:     return ref ? static_cast<mesh::AttrData<T> *>(ref->data) : nullptr;
260:   }
261: 
262:   // Resolved AttrRef for a bound DSL attribute handle (the BrushAttrLayerOverride
263:   // target), or null when unbound. Undo-capture codegen snapshots through this so
264:   // it records the layer actually written, not the declared name.
265:   const mesh::AttrRef *boundAttrRef(const char *handle) const
266:   {
267:     return attrBindings ? attrBindings->find(handle) : nullptr;
268:   }
269: 
270:   CommandCtxBase() = default;
271:   CommandCtxBase(const CommandCtxBase &) = default;
272:   CommandCtxBase(CommandCtxBase &&) = default;
273:   CommandCtxBase &operator=(const CommandCtxBase &) = default;
274:   CommandCtxBase &operator=(CommandCtxBase &&) = default;
275: };
