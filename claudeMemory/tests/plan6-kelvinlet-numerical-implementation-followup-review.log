10: namespace sculptcore::brush::sbrush {
11: 
12: // These certificates prove shared-state preservation and definite initialization,
13: // not finite output from arbitrary kernel arithmetic. Unknown syntax fails closed.
14: class PreparedPreludeProof {
15:   const Brush &brush_;
16: 
17:   static const Expr *unparen(const Expr *expr)
18:   {
19:     while (expr && expr->kind == ExprKind::Paren)
20:       expr = expr->lhs.get();
21:     return expr;
22:   }
23: 
24:   const Field *field(const string &name) const
25:   {
26:     for (const auto &f : brush_.fields)
27:       if (f.name == name)
28:         return &f;
29:     return nullptr;
30:   }
31: 
32:   static bool contains(const Vector<string> &names, const string &name)
33:   {
34:     for (const auto &n : names)
35:       if (n == name)
36:         return true;
37:     return false;
38:   }
39: 
40:   static bool literal(const Expr *expr, double &value)
41:   {
42:     expr = unparen(expr);
43:     if (!expr)
44:       return false;
45:     if (expr->kind == ExprKind::LitFloat) {
46:       value = expr->fvalue;
47:       return std::isfinite(value) && std::isfinite(float(value));
48:     }
49:     if (expr->kind == ExprKind::Unary && expr->unaryop == UnaryOp::Neg &&
50:         literal(expr->lhs.get(), value))
51:     {
52:       value = -value;
53:       return true;
54:     }
55:     return false;
56:   }
57: 
58:   bool hostStatement(const Stmt &stmt) const
59:   {
60:     if (stmt.kind == StmtKind::Block) {
61:       for (const auto &child : stmt.stmts)
62:         if (!hostStatement(*child))
63:           return false;
64:       return true;
65:     }
66:     if (stmt.kind != StmtKind::If || stmt.elseBranch || !stmt.thenBranch)
67:       return false;
68:     const Expr *cond = unparen(stmt.cond.get());
69:     if (!cond || cond->kind != ExprKind::Binary ||
70:         (cond->binop != BinOp::Lt && cond->binop != BinOp::Gt))
71:       return false;
72:     const Expr *name = unparen(cond->lhs.get());
73:     if (!name || name->kind != ExprKind::Ident)
74:       return false;
75:     const Field *f = field(name->name);
76:     if (!f || f->kind != FieldKind::Uniform || f->type != TypeKind::Float || !f->hasRange)
77:       return false;
78:     const Stmt *assignment = stmt.thenBranch.get();
79:     while (assignment->kind == StmtKind::Block && assignment->stmts.size() == 1)
80:       assignment = assignment->stmts[0].get();
81:     if (assignment->kind != StmtKind::Assign || assignment->assignOp != AssignOp::Assign)
82:       return false;
83:     const Expr *target = unparen(assignment->lvalue.get());
84:     double threshold, assigned;
85:     if (!target || target->kind != ExprKind::Ident || target->name != f->name ||
86:         !literal(cond->rhs.get(), threshold) ||
87:         !literal(assignment->rvalue.get(), assigned) || threshold != assigned ||
88:         threshold != (cond->binop == BinOp::Lt ? f->rangeMin : f->rangeMax))
89:       return false;
90:     props::ScalarDeclaration declaration{f->name,
91:                                          props::Prop::FLOAT32,
92:                                          f->hasDefault,
93:                                          f->defaultValue,
94:                                          true,
95:                                          f->rangeMin,
96:                                          f->rangeMax,
97:                                          false};
98:     props::ScalarDomain domain;
99:     if (props::normalizeScalarDeclaration(declaration, domain) !=
100:         props::PropError::ERROR_NONE)
101:       return false;
102:     // emitExpr writes 17 significant decimal digits followed by 'f'; the
103:     // comparison therefore uses the float rounding of this parsed double.
104:     return cond->binop == BinOp::Lt ? domain.min >= double(float(threshold))
105:                                     : domain.max <= double(float(threshold));
106:   }
107: 
108:   bool floatExpression(const Expr *expr, const Vector<string> &initialized) const
109:   {
110:     expr = unparen(expr);
111:     if (!expr)
112:       return false;
113:     if (expr->kind == ExprKind::LitFloat)
114:       return std::isfinite(expr->fvalue) && std::isfinite(float(expr->fvalue));
115:     if (expr->kind == ExprKind::Ident) {
116:       if (contains(initialized, expr->name))
117:         return true;
118:       const Field *f = field(expr->name);
119:       return f && f->kind == FieldKind::Uniform && f->type == TypeKind::Float;
120:     }
121:     if (expr->kind == ExprKind::Unary)
122:       return expr->unaryop == UnaryOp::Neg &&
123:              floatExpression(expr->lhs.get(), initialized);
124:     if (expr->kind == ExprKind::Binary)
125:       return (expr->binop == BinOp::Add || expr->binop == BinOp::Sub ||
126:               expr->binop == BinOp::Mul || expr->binop == BinOp::Div) &&
127:              floatExpression(expr->lhs.get(), initialized) &&
128:              floatExpression(expr->rhs.get(), initialized);
129:     return false;
130:   }
131: 
132: public:
133:   explicit PreparedPreludeProof(const Brush &brush) : brush_(brush)
134:   {
135:   }
136: 
137:   bool host(const Stage &stage) const
138:   {
139:     return stage.kind == StageKind::Host && stage.returnType == TypeKind::Void &&
140:            stage.params.size() == 0 && stage.body && hostStatement(*stage.body);
141:   }
142: 
143:   bool reduce(const Stage &stage) const
144:   {
145:     if (stage.kind != StageKind::Reduce || stage.returnType != TypeKind::Void ||
146:         !stage.body || stage.body->kind != StmtKind::Block)
147:       return false;
148:     Vector<string> writable, initialized;
149:     for (const auto &param : stage.params) {
150:       if (param.type != TypeKind::Float || param.dir != ParamDir::Out ||
151:           field(param.name) || contains(writable, param.name))
152:         return false;
153:       writable.append(param.name);
154:     }
155:     for (const auto &stmt : stage.body->stmts) {
156:       string target;
157:       if (stmt->kind == StmtKind::DeclLocal) {
158:         if (stmt->declType != TypeKind::Float || field(stmt->name) ||
159:             contains(writable, stmt->name) ||
160:             !floatExpression(stmt->expr.get(), initialized))
161:           return false;
162:         target = stmt->name;
163:         writable.append(target);
164:       } else if (stmt->kind == StmtKind::Assign && stmt->assignOp == AssignOp::Assign) {
165:         const Expr *lvalue = unparen(stmt->lvalue.get());
166:         if (!lvalue || lvalue->kind != ExprKind::Ident ||
167:             !contains(writable, lvalue->name) ||
168:             !floatExpression(stmt->rvalue.get(), initialized))
169:           return false;
170:         target = lvalue->name;
171:       } else {
172:         return false;
173:       }
174:       if (!contains(initialized, target))
175:         initialized.append(target);
176:     }
177:     for (const auto &param : stage.params)
178:       if (!contains(initialized, param.name))
179:         return false;
180:     return true;
181:   }
182: 
183:   bool reduceCalls(const Stage *vertex) const
184:   {
185:     if (!vertex)
186:       return false;
187:     Vector<string> inputs, produced;
188:     for (size_t i = 1; i < vertex->params.size(); i++) {
189:       const auto &p = vertex->params[i];
190:       if (p.type != TypeKind::Float || p.dir != ParamDir::In || field(p.name) ||
191:           contains(inputs, p.name) || p.name == vertex->params[0].name)
192:         return false;
193:       inputs.append(p.name);
194:     }
195:     for (const auto &stage : brush_.stages) {
196:       if (stage.kind != StageKind::Reduce)
197:         continue;
198:       if (!reduce(stage))
199:         return false;
200:       for (const auto &p : stage.params) {
201:         if (!contains(inputs, p.name))
202:           return false;
203:         if (!contains(produced, p.name))
204:           produced.append(p.name);
205:       }
206:     }
207:     for (const auto &name : inputs)
208:       if (!contains(produced, name))
209:         return false;
210:     return true;
211:   }
212: };
213: 
214: } // namespace sculptcore::brush::sbrush
