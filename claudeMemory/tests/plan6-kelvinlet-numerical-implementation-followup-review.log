277: template <CommandTypes TYPES> struct CommandCtx : public CommandCtxBase {
278:   /** The executor type, reachable from the CTX parameter of BrushCommandDef
279:    * (which needs its node_type for the Pre/Post signatures). */
280:   using types = TYPES;
281:   using node_type = typename TYPES::node_type;
282: 
283:   Brush &brush;
284:   node_type &node;
285:   TYPES &executor;
286: 
287:   CommandCtx(const CommandCtxBase &base, node_type &node, TYPES &executor, Brush &brush)
288:       : CommandCtxBase(base), node(node), executor(executor), brush(brush)
289:   {
290:   }
291:   CommandCtx(const CommandCtx &b)
292:       : CommandCtxBase(b), node(b.node), executor(b.executor), brush(b.brush)
293:   {
294:   }
295: 
296:   // Per-call iterator factories. The vertex iterator is parameterized by the
297:   // AccumMode policy so a generated kernel reads stroke-start positions
298:   // (AccumOrig) or live positions (AccumLive) with no per-vertex branch.
299:   template <class AccMode> auto vertexIter(node_type &node)
300:   {
301:     return executor.template makeVertexIter<AccMode>(node);
302:   }
303:   auto faceIter(node_type &node)
304:   {
305:     return executor.makeFaceIter(node);
306:   }
307:   /** Spatial + scalar term only: slider x distance falloff x brush texture,
308:    * invert-signed. The per-vertex masking factors live in automasks()/masks() —
309:    * a kernel that wants them multiplies one of those in. Kernels with unbounded
310:    * support (whose field is its own falloff) must not call this at all; they
311:    * multiply sampleBrushTex() explicitly to keep texture parity. */
312:   float strength(float3 co)
313:   {
314:     float t = 1.0f - std::min(brush.falloffDist(co - surfacePos, surfaceNo), 1.0f);
315:     float s = brush.strength * brush.falloffEval(t);
316:     // Node iteration hands kernels every vert of every overlapping leaf, so
317:     // out-of-radius verts land here with s == 0 — skip the texture eval they
318:     // would zero anyway (runtime texture programs make it the dominant cost).
319:     if (s == 0.0f) {
320:       return 0.0f;
321:     }
322:     s *= sampleBrushTex(co, surfaceNo);
323:     return brush.invert ? -s : s;
324:   }
325: 
326:   /** The *automatic* masks — cavity automask x view-normal — which a kernel has
327:    * no other way to reach. `v` is the mesh vertex index, threaded from the kernel
328:    * loop by the intrinsic's `$v` placeholder; face stages pass -1, where both
329:    * factors are identity. */
330:   float automasks(int v)
331:   {
332:     float s = 1.0f;
333:     if (automaskEnabled && automaskFactor && v >= 0) {
334:       s *= (*automaskFactor)[v];
335:     }
336:     // The live normal comes from the executor (domain seam): the mesh
337:     // executor reads ctx.m->v.no, the grids executor its domain normals.
338:     if (viewNormal.enabled && v >= 0) {
339:       if (const float3 *n = executor.liveVertNoPtr(*this, v)) {
340:         s *= viewNormalFactor(*n, viewNormal);
341:       }
342:     }
343:     return s;
344:   }
345: 
346:   /** Every mask: automasks() x the painted mask. What deforming and painting
347:    * kernels want. `mask` is the kernel's own live value, threaded by the
348:    * intrinsic's `$vm` placeholder, so a kernel that writes v.mask still sees
349:    * its local copy rather than stale storage. Face stages pass 0. */
350:   float masks(int v, float mask)
351:   {
352:     return automasks(v) * (1.0f - mask);
353:   }
354: 
355:   /** C1 cutoff window for an `@unbounded` field: 1 inside 0.8R, smoothstepped
356:    * to exactly 0 at R = radius * unboundedExtent. The host filters spatial
357:    * nodes against the same R, so the field vanishes before the region boundary
358:    * and no seam can form on a leaf edge. Extent <= 0 disables it. */
359:   float unboundedWindow(float3 co)
360:   {
361:     float R = brush.radius * brush.unboundedExtent;
362:     if (!(R > 0.0f)) {
363:       return 1.0f;
364:     }
365:     // Promote before subtraction/squaring: a valid float cutoff can be far
366:     // below sqrt(FLT_MIN) or above sqrt(FLT_MAX).
367:     const double d = std::hypot(double(co[0]) - double(surfacePos[0]),
368:                                 double(co[1]) - double(surfacePos[1]),
369:                                 double(co[2]) - double(surfacePos[2]));
370:     float t = float(std::clamp((double(R) - d) / (0.2 * double(R)), 0.0, 1.0));
371:     return t * t * (3.0f - 2.0f * t);
372:   }
373: 
374:   /** Sample the brush texture at world point `co` with surface normal `no`. A
375:    * runtime texture program takes precedence and consumes `no` directly (its
376:    * eval does its own point mapping — `coord_space` is bitmap-path-only). The
377:    * bitmap path maps co to UV per `brush.coord_space`; there `no` is unused —
378:    * every mode (including Projected) reads the brush-center ctx surfaceNo so
379:    * the C++ and WGSL paths key off the same value; the arg is kept for DSL
380:    * signature parity with the generated kernel. Returns 1.0 with nothing
381:    * bound (kernels multiply by this unconditionally). */
382:   float sampleBrushTex(float3 co, float3 no)
383:   {
384:     if (const TextureProgram *tp = brush.texture_program) {
385:       const float P[3] = {co[0], co[1], co[2]};
386:       const float N[3] = {no[0], no[1], no[2]};
387:       const float *params =
388:           brush.texture_params.size() > 0 ? brush.texture_params.data() : nullptr;
389:       if (tp->usesMap) {
390:         // TexEvalCtx.map_matrix shares mat4's flat layout (texture_eval.h).
391:         TexEvalCtx tctx;
392:         const float *src = &renderMatrix[0][0];
393:         for (int i = 0; i < 16; i++) {
394:           tctx.map_matrix[i] = src[i];
395:         }
396:         return tp->eval(P, N, params, &tctx);
397:       }
398:       return tp->eval(P, N, params, nullptr);
399:     }
400:     float2 uv;
401:     switch (brush.coord_space) {
402:     case TexCoordSpace::Global:
403:       // The bitmap square spans world [-1, 1]^2 (the host bake domain) and
404:       // tiles beyond it — unbounded sources must keep sampling past the
405:       // baked square instead of clamp-streaking at its edge.
406:       uv = float2{fractf(co[0] * 0.5f + 0.5f), fractf(co[1] * 0.5f + 0.5f)};
407:       break;
408:     case TexCoordSpace::ViewPlane: {
409:       uv = sampleViewUv(co);
410:       break;
411:     }
412:     case TexCoordSpace::ViewRepeat: {
413:       // Aspect-correct x into viewport-height units so tiles stay square,
414:       // then tile: tex_repeat is tiles per viewport height.
415:       uv = sampleViewUv(co);
416:       uv = float2{fractf(uv[0] * viewAspect() * brush.tex_repeat),
417:                   fractf(uv[1] * brush.tex_repeat)};
418:       break;
419:     }
420:     case TexCoordSpace::StrokeCurved:
421:       uv = brush.sampleStrokeUV(co);
422:       break;
423:     case TexCoordSpace::Projected: {
424:       // Project onto the tangent plane at the brush center, normalized so
425:       // the texture tile spans the brush circle (uv 0..1 across the
426:       // diameter, centered on the dab). The reference axis pick (and thus
427:       // the basis) must match the WGSL branch bit-for-bit in structure, so
428:       // both flip on the same |n.z| < 0.999 test against the shared ctx
429:       // surfaceNo.
430:       float3 n = surfaceNo.normalized();
431:       float3 ref =
432:           std::abs(n[2]) < 0.999f ? float3{0.0f, 0.0f, 1.0f} : float3{1.0f, 0.0f, 0.0f};
433:       float3 t1 = ref.cross(n).normalized();
434:       float3 t2 = n.cross(t1);
435:       float3 rel = co - surfacePos;
436:       float inv_d = 1.0f / (brush.radius > 1e-6f ? 2.0f * brush.radius : 1.0f);
437:       uv = float2{rel.dot(t1) * inv_d + 0.5f, rel.dot(t2) * inv_d + 0.5f};
438:       break;
439:     }
440:     }
441:     return brush.sampleTexBilinear(uv);
442:   }
443: 
444:   // View-pinned texture UV: perspective-project `co` through renderMatrix
445:   // (world -> clip) and remap NDC to [0,1] across the viewport. The w divide
446:   // is what makes a perspective view sample sensibly; kept in lockstep with
447:   // the WGSL emitter's brush_sample_tex.
448:   float2 sampleViewUv(float3 co) const
449:   {
450:     float4 p = renderMatrix * float4{co[0], co[1], co[2], 1.0f};
451:     float w = std::abs(p[3]) > 1e-6f ? p[3] : 1.0f;
452:     return float2{p[0] / w * 0.5f + 0.5f, p[1] / w * 0.5f + 0.5f};
453:   }
454: 
455:   // Repeat-wrap into [0, 1); identical formula to WGSL fract() so backends
456:   // agree bitwise.
457:   static float fractf(float x)
458:   {
459:     return x - std::floor(x);
460:   }
461: 
462:   // Viewport width/height from renderMatrix (world -> clip): its x/y rows
463:   // are the projection diagonal times unit view rows, so |row1|/|row0| is
464:   // w/h for perspective and ortho alike. 1.0 for identity/degenerate.
465:   float viewAspect()
466:   {
467:     const float *m = &renderMatrix[0][0];
468:     float r0 = float3{m[0], m[1], m[2]}.length();
469:     float r1 = float3{m[4], m[5], m[6]}.length();
470:     return (r0 > 1e-12f && r1 > 1e-12f) ? r1 / r0 : 1.0f;
471:   }
472: };
473: 
474: enum _BrushFlags { None = 0, Serial = 1 << 0 };
475: MAKE_FLAGS_CLASS(BrushFlags, _BrushFlags, int);
476: 
477: template <typename CTX> struct BrushCommandDef {
478:   /** The executor's spatial unit (SpatialNode for the mesh path, the grid
479:    * executor's leaf node for the grids path) — the Pre/Post span type. */
480:   using node_type = typename CTX::node_type;
481: 
482:   // Optional `host` stage from the DSL — runs once per dab on CPU before
483:   // any per-node work. Used to mutate ctx state / populate query buffers
484:   // that the per-vertex stage then reads. Never lowered to GPU backends.
485:   std::function<void(CommandCtxBase &, Brush &)> execHost;
486:   std::function<void(CommandCtxBase &, std::span<node_type *>)> execPre;
487:   std::function<void(CTX &)> exec;
488:   std::function<void(CommandCtxBase &, std::span<node_type *>)> execPost;
489:   // Generated conservative eligibility for immutable prepared scalar execution.
490:   // Default false keeps hand-authored/stale factories out of the checked path.
491:   bool preparedScalarSafe = false;
492:   // Every composed host callback is proven a no-op over validated scalar domains.
493:   bool preparedHostNoop = false;
494:   BrushFlags flags = BrushFlags::None;
495:   // Set by codegen for brushes that use for_neighbor: the executor snapshots
496:   // the mesh's vertex positions into ctx.co_prev before the per-node loop.
497:   bool needsCoPrev = false;
498:   // Set by codegen: true unless the kernel is @paint (writes an attribute) or
499:   // @unbounded (anchored field), for which from-base re-derivation is
500:   // meaningless. Eligible for non-accumulate mode; see plans/nonAccumMode.md.
501:   bool accumulable = false;
502:   // Set by codegen from `@relaxation`: the kernel relaxes the field it edits
503:   // toward a neighborhood mean instead of displacing it, so it must not
504:   // contribute to `.brush.disp.vec`. The executor keeps it on AccumLive even in a
505:   // non-accumulate stroke — reading and writing the live surface is exactly "move
506:   // co, leave disp alone". Hosts also read it as "inverting this diverges".
507:   bool relaxesBase = false;
508:   // Set by codegen from `@grabmode`, meaning the kernel supports running the grab
509:   // policy. The stroke, not the kernel, decides whether it actually runs; that
510:   // decision is made in `CommandExecutor::anchoredGrab`.
511:   bool grabModeCapable = false;
512:   // Set by codegen from `@unbounded`: the field carries no distance falloff of
513:   // its own, only `unboundedWindow`'s cutoff at R = radius * unboundedExtent.
514:   // The executor floors the node-filter radius at R (`filterRadiusFloor`).
515:   bool unbounded = false;
516:   // Set by codegen from `@incremental`: a stage input is a per-dab delta rather
517:   // than an absolute stroke quantity, so the host must feed a step-since-last-dab
518:   // rather than an anchor-relative drag. Implies !accumulable, but the converse
519:   // does not hold — @paint and @unbounded also clear accumulable.
520:   bool incremental = false;
521:   // Set by codegen when the kernel declares a `face` stage: it is dispatched
522:   // per-face rather than per-vertex.
523:   bool faceMode = false;
524:   // Set by codegen when a stage assigns `v.mask`. `mask` is a builtin Vertex
525:   // field, not an `attr`, so it leaves no entry in `attrs` to key off.
526:   bool writesMask = false;
527:   // Set by the executor: this stroke deforms from the stroke-start position with
528:   // the AccumOrigGrab policy + a fixed region, independent of the ACCUMULATE flag
529:   // (#35). Drives the `.brush.disp.*` + `.brush.dab.gen` stamps even when
530:   // `accumulable` is false. True iff `grabModeCapable && anchoredGrab`.
531:   bool grabMode = false;
532:   // Opt-in: also snapshot each vert's stroke-start NORMAL into `.brush.orig.no`
533:   // (alongside the disp stamp, extended over each region leaf's skirt so the
534:   // capture stays ahead of the spatial halo normal refresh). No kernel consumes
535:   // it yet; default off.
536:   bool needsOrigNormals = false;
537:   // Attribute layers this kernel reads/writes, emitted by codegen. The executor
538:   // resolves these to live mesh layers and binds them before the per-node loop.
539:   Vector<BrushAttrManifestEntry> attrs;
540:   // Scalar uniforms this kernel declares, emitted by codegen. The executor
541:   // registers these as props, applies device dynamics in loadProps, and
542:   // validates dynamic bindings before a stroke.
543:   Vector<BrushUniformManifestEntry> uniforms;
544:   void appendScalarDeclarations(Vector<props::ScalarDeclaration> &out) const
545:   {
546:     for (const auto &uniform : uniforms) {
547:       props::Prop type = uniform.scalarType;
548:       if (type == props::Prop::INVALID_TYPE && uniform.isFloat) {
549:         type = props::Prop::FLOAT32;
550:       }
551:       if (type == props::Prop::FLOAT32 || type == props::Prop::INT32 ||
552:           type == props::Prop::BOOL)
553:       {
554:         out.append(props::ScalarDeclaration{uniform.name,
555:                                             type,
556:                                             uniform.hasDefault,
557:                                             uniform.def,
558:                                             uniform.hasRange,
559:                                             uniform.rangeMin,
560:                                             uniform.rangeMax,
561:                                             uniform.dynamic});
562:       }
563:     }
564:   }
565: 
566:   props::ScalarRegistrationResult registerProps(props::StructDef &definition) const
567:   {
568:     Vector<props::ScalarDeclaration> declarations;
569:     appendScalarDeclarations(declarations);
570:     return definition.registerScalars({declarations.data(), declarations.size()});
571:   }
572: 
573:   std::function<void(Brush &, props::DeviceInputCtx *)> loadUniformProps;
574: };
