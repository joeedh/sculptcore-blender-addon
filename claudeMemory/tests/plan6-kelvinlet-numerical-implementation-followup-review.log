552: static void unboundedCavityMatrix()
553: {
554:   for (bool grid : {false, true}) {
555:     auto *mesh = mesh::createCube(4, 2.0f);
556:     {
557:       subdiv::Multires mr;
558:       mr.init(*mesh, 2);
559:       auto *domain = mr.gridDomain(2);
