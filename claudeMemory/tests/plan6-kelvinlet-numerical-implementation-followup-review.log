123: // Codegen-emitted descriptor of one `uniform` a kernel declares. The executor
124: // uses the active brush's manifest to register props, apply device dynamics in
125: // loadProps, and validate dynamic bindings before a stroke. See
126: // documentation/plans/sbrush-dynamic-uniforms.md.
127: struct BrushUniformManifestEntry {
