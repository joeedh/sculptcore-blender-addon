10: namespace {
11: 
12: // Wave 1 intrinsics — just the minimum to express draw.sbrush.
13: // The kernels/ir/ author surface grows as new brushes need more ops:
14: // length/dot/distance/min/max/mix in Wave 2, sample_tex/sample_falloff
15: // in Wave 2's falloff & texture work, neighbor_* in Wave 2's smooth
16: // support, bvh_query in Wave 4's global brushes.
17: // Pattern slots are indexed by BackendKind; nullptr means "not lowered on
18: // this backend" and the emitter will report an error if the intrinsic is
19: // used. Wave 3 adds the WGSL slot; SPIR-V reaches GPU via the WGSL slot
20: // (lowered through tint), so it stays nullptr. Wave 5 fills the CUDA + HIP
21: // slots — both share one pattern (GPU) since the emit_cuda prelude defines
22: // the same helper/math surface for either target. The OpenCL slot tracks
23: // WGSL's native math, differing only in spelling (fmin/fmax/fabs, no fract).
24: #define INTR_CW(NAME, RET, ARITY, ARGS, CPP, WGSL)                                       \
25:   {                                                                                      \
26:     NAME, RET, ARITY, ARGS,                                                              \
27:     {                                                                                    \
28:       {CPP}, {WGSL}, {nullptr}, {nullptr}, {nullptr},                                    \
29:       {                                                                                  \
30:         nullptr                                                                          \
31:       }                                                                                  \
32:     }                                                                                    \
33:   }
34: #define INTR_CWG(NAME, RET, ARITY, ARGS, CPP, WGSL, GPU)                                 \
35:   {                                                                                      \
36:     NAME, RET, ARITY, ARGS,                                                              \
37:     {                                                                                    \
38:       {CPP}, {WGSL}, {nullptr}, {GPU}, {GPU},                                            \
39:       {                                                                                  \
40:         nullptr                                                                          \
41:       }                                                                                  \
42:     }                                                                                    \
43:   }
44: // OpenCL C has native float2/3/4 + matching free-function math builtins, so
45: // its slot tracks WGSL closely; brush_strength/falloff/sample_tex come from
46: // the emit_opencl prelude. `OCL` differs only where the spelling does.
47: #define INTR_CWGO(NAME, RET, ARITY, ARGS, CPP, WGSL, GPU, OCL)                           \
48:   {                                                                                      \
49:     NAME, RET, ARITY, ARGS,                                                              \
50:     {                                                                                    \
51:       {CPP}, {WGSL}, {nullptr}, {GPU}, {GPU},                                            \
52:       {                                                                                  \
53:         OCL                                                                              \
54:       }                                                                                  \
55:     }                                                                                    \
56:   }
57: 
58: #define ARG0()                                                                           \
59:   {TypeKind::Unknown, TypeKind::Unknown, TypeKind::Unknown, TypeKind::Unknown}
60: #define ARG1(A) {A, TypeKind::Unknown, TypeKind::Unknown, TypeKind::Unknown}
61: #define ARG2(A, B) {A, B, TypeKind::Unknown, TypeKind::Unknown}
62: #define ARG3(A, B, C) {A, B, C, TypeKind::Unknown}
63: 
64: static IntrinsicDef sIntrinsicsRaw[] = {
65:     // strength(co) — brush slider x distance falloff x brush-texture sample at a
66:     // world-space position, invert-signed. Spatial + scalar only: the per-vertex
67:     // masking factors are automasks()/masks() below, so `strength(co) * masks()`
68:     // applies each factor exactly once. Kernels whose field has unbounded support
69:     // (no radius at which it dies) must not call this — the field is its own
70:     // falloff — and multiply sampleBrushTex() explicitly for texture parity.
71:     INTR_CWGO("strength",
72:               TypeKind::Float,
73:               1,
74:               ARG1(TypeKind::Float3),
75:               "ctx.strength($0)",
76:               "brush_strength($0)",
77:               "brush_strength($0)",
78:               "brush_strength($0)"),
79: 
80:     // automasks() / masks() — per-vertex masking, no spatial term. Deliberately
81:     // argument-free: nothing here depends on position, so the signature can't
82:     // silently regrow a falloff. Both hidden operands ride in on placeholders —
83:     // `$v` (current vertex index) and `$vm` (the kernel's live painted mask).
84:     //   automasks() — cavity automask x view-normal; the masks a kernel cannot
85:     //                 otherwise reach. Used by kernels that *write* v.mask.
86:     //   masks()     — automasks() x (1 - painted mask). The common case.
87:     // CUDA/HIP/OpenCL have no automask binding yet, so they degrade to the
88:     // painted mask alone (matching the pre-split 1-arg brush_strength there).
