359: static Vector<IntrinsicDef> &table()
360: {
361:   // One-off bootstrap allocation; guard it so the leak tracker doesn't
362:   // report it in tests that link the compiler.
363:   static Vector<IntrinsicDef> *t = [] {
364:     litestl::alloc::PermanentGuard guard;
365:     auto *v = new Vector<IntrinsicDef>();
366:     for (auto &d : sIntrinsicsRaw)
367:       v->append(d);
368:     return v;
369:   }();
370:   return *t;
371: }
372: 
373: } // namespace
374: 
375: const IntrinsicDef *findIntrinsic(stringref name)
376: {
377:   for (const auto &d : table()) {
378:     if (std::strcmp(d.name, name.c_str()) == 0)
379:       return &d;
380:   }
381:   return nullptr;
382: }
383: 
384: const Vector<IntrinsicDef> &allIntrinsics()
385: {
386:   return table();
387: }
