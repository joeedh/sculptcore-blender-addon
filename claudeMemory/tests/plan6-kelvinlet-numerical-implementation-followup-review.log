566:         GridBrushExecutor ex(domain, &brush);
567:         ex.beginStep();
568:         unboundedCavity(
569:             ex,
570:             brush,
571:             GridBrushExecutor::GridCavitySrc{domain},
572:             [&](int v) -> float3 & { return domain->pos()[v]; },
573:             domain->vertCount());
574:         ex.endStep();
575:       } else {
576:         CommandExecutor ex(&tree, &brush);
577:         ex.beginStep(false);
578:         unboundedCavity(
579:             ex,
580:             brush,
581:             MeshCavitySrc{mesh},
582:             [&](int v) -> float3 & { return mesh->v.co[v]; },
583:             mesh->v.count);
584:         ex.endStep();
585:       }
586:     }
587:     alloc::Delete(mesh);
588:   }
589:   fprintf(stderr,
590:           "unbounded nonconstant cavity first-contact and strict support passed\n");
591: }
