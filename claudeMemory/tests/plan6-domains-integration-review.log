87: def sample(function, config):
88:     """Bake at synchronization time; preserve legacy falloff hardness ordering."""
89:     if type(config) is not SampleConfig:
90:         raise PropertyError("Expected a sampling configuration")
91:     values = []
92:     for index in range(config.count):
93:         x = index / (config.count - 1)
94:         distance = 1.0 - x
95:         if config.hardness == 1:
96:             value = 1.0 if distance < 1 else 0.0
97:         elif config.hardness > 0 and distance < config.hardness:
98:             value = 1.0
99:         else:
100:             if config.hardness:
101:                 x = 1.0 - (distance - config.hardness) / (1.0 - config.hardness)
102:             value = function(1.0 - x if config.reverse else x)
103:         if not finite(value):
104:             raise PropertyError("Curve produced a nonfinite sample")
105:         if config.clamp_output:
106:             value = min(1.0, max(0.0, value))
107:         values.append(scalar('FLOAT32', value))
108:     return tuple(values)
