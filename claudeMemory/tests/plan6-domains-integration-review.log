276: struct Dynamics {
277:   util::Vector<DynamicDevice> devices;
278: 
279:   Dynamics() = default;
280:   Dynamics(const Dynamics &other) : devices(other.devices)
281:   {
282:     resetInputs();
283:   }
284:   Dynamics &operator=(const Dynamics &other)
285:   {
286:     devices = other.devices;
287:     resetInputs();
288:     return *this;
289:   }
290: 
291:   void resetInputs()
292:   {
293:     for (auto &layer : devices) {
294:       layer.hasDeviceValue = false;
295:       layer.curDeviceValue = 0.0f;
296:     }
297:   }
298: 
299:   static bool validStack(const util::Vector<DynamicDevice> &layers,
300:                          bool allowPending = false)
301:   {
302:     unsigned seen = 0;
303:     for (const auto &layer : layers) {
304:       if (!layer.valid(allowPending)) {
305:         return false;
306:       }
307:       unsigned bit = 1u << unsigned(layer.type);
308:       if (seen & bit) {
309:         return false;
310:       }
311:       seen |= bit;
312:     }
313:     return true;
314:   }
315: 
316:   bool replaceStack(const util::Vector<DynamicDevice> &layers)
317:   {
318:     if (!validStack(layers)) {
319:       return false;
320:     }
321:     devices = layers;
322:     resetInputs();
323:     return true;
324:   }
325: 
326:   bool configure(DeviceType type, math::BasicMix mode, float factor)
327:   {
328:     DynamicDevice candidate;
329:     candidate.type = type;
330:     candidate.mixMode = mode;
331:     candidate.mixFactor = factor;
332:     if (!candidate.valid() || !validStack(devices, true)) {
333:       return false;
334:     }
335:     for (auto &layer : devices) {
336:       if (layer.type == type) {
337:         layer.mixMode = mode;
338:         layer.mixFactor = factor;
339:         return true;
340:       }
341:     }
342:     devices.append(candidate);
343:     return true;
344:   }
345: 
346:   void inputDeviceDatas(const DeviceInputCtx &ctx)
347:   {
348:     resetInputs();
349:     for (auto &device : ctx.inputs) {
350:       for (auto &layer : devices) {
351:         if (layer.type == device.type) {
352:           layer.curDeviceValue = device.value;
353:           layer.hasDeviceValue = std::isfinite(device.value);
354:         }
355:       }
356:     }
357:   }
358: 
359:   template <typename T>
360:   bool evaluateChecked(T value, T minimum, T maximum, T &result) const
361:   {
362:     return evaluateCheckedImpl(value, minimum, maximum, nullptr, result);
363:   }
364: 
365:   // Preparation reads the current samples without changing cached inputs or
366:   // copying response tables. The cached compatibility path shares the math.
367:   template <typename T>
368:   bool evaluateChecked(
369:       T value, T minimum, T maximum, const DeviceInputCtx &ctx, T &result) const
370:   {
371:     return evaluateCheckedImpl(value, minimum, maximum, &ctx, result);
372:   }
373: 
374: private:
375:   template <typename T>
376:   bool evaluateCheckedImpl(
377:       T value, T minimum, T maximum, const DeviceInputCtx *ctx, T &result) const
378:   {
379:     static_assert(std::is_same_v<T, float> || std::is_same_v<T, int32_t> ||
380:                   std::is_same_v<T, bool>);
381:     using Real = std::conditional_t<std::is_same_v<T, float>, float, double>;
382:     if (!std::isfinite(Real(value)) || !std::isfinite(Real(minimum)) ||
383:         !std::isfinite(Real(maximum)) || minimum > maximum || !validStack(devices))
384:     {
385:       return false;
386:     }
387:     Real f = Real(value);
388:     bool applied = false;
389:     for (const auto &device : devices) {
390:       float input = device.curDeviceValue;
391:       bool present = device.hasDeviceValue;
392:       if (ctx) {
393:         present = false;
394:         for (size_t i = ctx->inputs.size(); i > 0; i--) {
395:           if (ctx->inputs[i - 1].type == device.type) {
396:             input = ctx->inputs[i - 1].value;
397:             present = std::isfinite(input);
398:             break;
399:           }
400:         }
401:       }
402:       if ((int(device.flag) & int(DynamicFlags::DISABLED)) != 0 || !present ||
403:           !std::isfinite(input))
404:       {
405:         continue;
406:       }
407:       f = device.apply(f, input);
408:       applied = true;
409:     }
410:     if (!applied && value >= minimum && value <= maximum) {
411:       result = value;
412:       return true;
413:     }
414:     f = std::clamp(f, Real(minimum), Real(maximum));
415:     if constexpr (std::is_same_v<T, int32_t>) {
416:       f = std::clamp(std::round(f),
417:                      double(std::numeric_limits<int32_t>::lowest()),
418:                      double(std::numeric_limits<int32_t>::max()));
419:       result = int32_t(f);
420:     } else if constexpr (std::is_same_v<T, bool>) {
421:       result = f >= 0.5;
422:     } else {
423:       result = f;
424:     }
425:     return true;
426:   }
427: 
428: public:
429:   float evaluate(float value) const
430:   {
431:     float result = value;
432:     evaluateChecked(value,
433:                     std::numeric_limits<float>::lowest(),
434:                     std::numeric_limits<float>::max(),
435:                     result);
436:     return result;
437:   }
438: }; //
439: } // namespace sculptcore::props
