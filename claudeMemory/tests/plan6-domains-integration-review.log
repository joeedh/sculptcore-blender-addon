152:     properties: tuple
153: 
154:     def __post_init__(self):
155:         _name(self.name)
156:         if type(self.kernel) is not int or not 0 <= self.kernel <= 2147483647:
157:             raise PropertyError("Invalid resolved kernel")
158:         properties = tuple(self.properties)
159:         if any(type(item) is not ExecutionValue for item in properties):
160:             raise PropertyError("Expected immutable execution properties")
161:         if len({item.definition.identifier for item in properties}) != len(properties):
162:             raise PropertyError("Duplicate resolved property")
