58: struct DynamicDevice {
59:   DeviceType type = DeviceType::PRESSURE;
60:   util::string name;
61:   util::string uiName;
62:   util::string description;
63: 
64:   float curDeviceValue = 0.0f;
65:   bool hasDeviceValue = false;
66:   // Zero samples means identity; a response table requires at least two samples.
67:   util::Vector<float> curveTable;
68:   // 0 table/identity, 1 constant, 2 two-step. Parameters stay double even for float
69:   // inputs.
70:   int responseKind = 0;
71:   double responseThreshold = 0, responseLow = 0, responseHigh = 0;
72:   math::BasicMix mixMode = math::BasicMix::MULTIPLY;
73:   float mixFactor = 1.0f;
74: 
75:   DynamicFlags flag = DynamicFlags::NONE;
76: 
77:   DynamicDevice() = default;
78: 
79:   bool valid(bool allowPending = false) const
80:   {
81:     if (int(type) < int(DeviceType::PRESSURE) || int(type) > int(DeviceType::SPEED) ||
82:         !std::isfinite(mixFactor) || mixFactor < 0.0f || mixFactor > 1.0f ||
83:         curveTable.size() == 1 || curveTable.size() > kDeviceCurveSampleLimit ||
84:         (int(flag) & ~int(DynamicFlags::DISABLED | DynamicFlags::NO_INHERIT)) != 0 ||
85:         (!allowPending && hasPendingCurve()))
86:     {
87:       return false;
88:     }
89:     if (responseKind < 0 || responseKind > 2 || !std::isfinite(responseThreshold) ||
90:         !std::isfinite(responseLow) || !std::isfinite(responseHigh) ||
91:         responseThreshold < 0 || responseThreshold > 1 ||
92:         (responseKind == 0 &&
93:          (responseThreshold != 0 || responseLow != 0 || responseHigh != 0)) ||
94:         (responseKind == 1 && (responseThreshold != 0 || responseHigh != 0)) ||
95:         (responseKind != 0 && curveTable.size() != 0))
96:     {
97:       return false;
98:     }
99:     switch (mixMode) {
100:     case math::BasicMix::MULTIPLY:
101:     case math::BasicMix::ADD:
102:     case math::BasicMix::SUBTRACT:
103:     case math::BasicMix::DIFFERENCE:
104:     case math::BasicMix::LINEAR:
105:       break;
106:     default:
107:       return false;
108:     }
109:     for (float sample : curveTable) {
110:       if (!std::isfinite(sample)) {
111:         return false;
112:       }
113:     }
114:     return true;
115:   }
116: 
117:   bool hasPendingCurve() const
118:   {
119:     return pendingSamples_.size() != 0;
120:   }
121: 
122:   bool setCurveTable(const util::Vector<float> &samples)
123:   {
124:     if (samples.size() == 1 || samples.size() > kDeviceCurveSampleLimit) {
125:       return false;
126:     }
127:     for (float sample : samples) {
128:       if (!std::isfinite(sample)) {
129:         return false;
130:       }
131:     }
132:     curveTable = samples;
133:     responseKind = 0;
134:     responseThreshold = responseLow = responseHigh = 0;
135:     pendingSamples_.clear();
136:     pendingPresent_.clear();
137:     pendingCount_ = 0;
138:     return true;
139:   }
140: 
141:   /** Resized uploads publish only when every sample has been provided. */
142:   bool setCurveSample(int index, int count, float value)
143:   {
144:     if (count < 2 || count > kDeviceCurveSampleLimit || index < 0 || index >= count ||
145:         !std::isfinite(value))
146:     {
147:       return false;
148:     }
149:     if (!hasPendingCurve() && int(curveTable.size()) == count) {
150:       curveTable[index] = value;
151:       return true;
152:     }
153:     if (int(pendingSamples_.size()) != count) {
154:       pendingSamples_.resize(count);
155:       pendingPresent_.resize(count);
156:       for (int i = 0; i < count; i++) {
157:         pendingSamples_[i] = 0;
158:         pendingPresent_[i] = false;
159:       }
160:       pendingCount_ = 0;
161:     }
162:     pendingSamples_[index] = value;
163:     if (!pendingPresent_[index]) {
164:       pendingPresent_[index] = true;
165:       pendingCount_++;
166:     }
167:     if (pendingCount_ == count) {
168:       curveTable = std::move(pendingSamples_);
169:       responseKind = 0;
170:       responseThreshold = responseLow = responseHigh = 0;
171:       pendingSamples_.clear();
172:       pendingPresent_.clear();
173:       pendingCount_ = 0;
174:     }
175:     return true;
176:   }
177: 
178:   bool sameConfiguration(const DynamicDevice &other) const
179:   {
180:     auto equal = [](const auto &a, const auto &b) {
181:       if (a.size() != b.size()) {
182:         return false;
183:       }
184:       for (size_t i = 0; i < a.size(); i++) {
185:         if (a[i] != b[i]) {
186:           return false;
187:         }
188:       }
189:       return true;
190:     };
191:     return responseKind == other.responseKind &&
192:            responseThreshold == other.responseThreshold &&
193:            responseLow == other.responseLow && responseHigh == other.responseHigh &&
194:            type == other.type && name == other.name && uiName == other.uiName &&
195:            description == other.description && mixMode == other.mixMode &&
196:            mixFactor == other.mixFactor && flag == other.flag &&
197:            equal(curveTable, other.curveTable) &&
198:            equal(pendingSamples_, other.pendingSamples_) &&
199:            equal(pendingPresent_, other.pendingPresent_) &&
200:            pendingCount_ == other.pendingCount_;
201:   }
202: 
203: private:
204:   util::Vector<float> pendingSamples_;
205:   util::Vector<bool> pendingPresent_;
206:   int pendingCount_ = 0;
207: 
208: public:
209:   template <typename Real = float> Real deviceFactor() const
210:   {
211:     return deviceFactor<Real>(curDeviceValue);
212:   }
213: 
214:   template <typename Real = float> Real deviceFactor(float input) const
215:   {
216:     if (responseKind == 1) {
217:       return Real(responseLow);
218:     }
219:     if (responseKind == 2) {
220:       // Do not round the threshold onto the input before choosing the branch.
221:       return Real(std::clamp(double(input), 0.0, 1.0) < responseThreshold ? responseLow
222:                                                                           : responseHigh);
223:     }
224:     int n = int(curveTable.size());
225:     Real x = std::clamp(Real(input), Real(0), Real(1));
226:     if (n < 2) {
227:       return x;
228:     }
229:     x *= Real(n - 1);
230:     int i = int(x);
231:     if (i >= n - 1) {
232:       return curveTable[n - 1];
233:     }
234:     Real t = x - Real(i);
235:     return Real(curveTable[i]) * (Real(1) - t) + Real(curveTable[i + 1]) * t;
236:   }
237: 
238:   template <typename Real> Real apply(Real value) const
239:   {
240:     return apply(value, curDeviceValue);
241:   }
242: 
243:   template <typename Real> Real apply(Real value, float input) const
244:   {
245:     Real factor = deviceFactor<Real>(input);
246:     if (!std::isfinite(factor)) {
247:       return value;
248:     }
249:     Real combined;
250:     switch (mixMode) {
251:     case math::BasicMix::MULTIPLY:
252:       combined = value * factor;
253:       break;
254:     case math::BasicMix::ADD:
255:       combined = value + factor;
256:       break;
257:     case math::BasicMix::SUBTRACT:
258:       combined = value - factor;
259:       break;
260:     case math::BasicMix::DIFFERENCE:
261:       combined = value > factor ? value - factor : factor - value;
262:       break;
263:     case math::BasicMix::LINEAR:
264:     default:
265:       combined = factor;
266:       break;
267:     }
268:     if (!std::isfinite(combined)) {
269:       return value;
270:     }
271:     Real result = value + (combined - value) * Real(mixFactor);
272:     return std::isfinite(result) ? result : value;
273:   }
274: };
