224: def _upload_lut(cache, key, values, sc_brush):
225:     """Keep immutable table installation scoped to a live target and lifecycle epoch."""
226:     from .brush_properties import sampling
227:     values = tuple(values)
228:     previous = cache.get(key) if cache is not None else None
229:     if (previous is not None and previous[0] is sc_brush
230:             and previous[1:] == (sampling.epoch, values)):
231:         return
232:     if len(values) != 256:
233:         raise ValueError("Legacy falloff and cavity tables require exactly 256 entries")
234:     from . import engine
235:     from sculptcore.brush_properties import replace_fixed_curve
236:     replace_fixed_curve(engine.manager(), sc_brush, key, values)
237:     if cache is not None:
238:         cache[key] = (sc_brush, sampling.epoch, values)
239:         cache['table_uploads'] = cache.get('table_uploads', 0) + 1
240: 
241: 
242: def _bake_falloff(bl_brush, sc_brush, cache=None):
243:     from .brush_properties import sampling
244:     from .brush_properties.responses import PreparedResponse, SampleConfig, sample
245:     preset = bl_brush.curve_distance_falloff_preset
246:     fn = _PRESET_FALLOFF.get(preset)
247:     config = SampleConfig(reverse=fn is None, clamp_output=True,
248:                           hardness=min(1.0, max(0.0, bl_brush.hardness)))
249:     if fn is None:
250:         response = sampling.native_response(bl_brush, 'curve_distance_falloff', config)
251:     else:
252:         key = ('LEGACY_FALLOFF', preset, config)
253:         response = sampling.cache.get(key)
254:         if response is None:
255:             response = PreparedResponse('TABLE', sample(fn, config))
256:             sampling.cache.bakes += 1
257:             sampling.cache.put(key, response, config)
258:     _upload_lut(cache, 'falloff', response.samples, sc_brush)
259:     sc_brush.falloff_kind = _FALLOFF_KIND_CURVE
260:     sc_brush.falloff_shape = _FALLOFF_SHAPE_SPHERICAL
261: 
262: 
263: # Cavity automasking. The engine mirrors Blender's estimator and remap
264: # (automask.h, ported from `calc_cavity_factor`), so the mapping is a direct
265: # field copy plus the optional custom curve baked into the engine's LUT.
266: 
267: 
268: def cavity_settings(bl_brush, paint):
269:     """The `MeshAutomaskingSettings` that governs cavity for this stroke, or
270:     None when cavity automasking is off.
271: 
272:     Mirrors Blender's `automasking_flags_get` precedence: the brush's own
273:     cavity flags win when it enables either cavity mode, otherwise the
274:     Paint-level settings apply."""
275:     for settings in (bl_brush.mesh_automasking_settings if bl_brush else None,
276:                      paint.mesh_automasking_settings if paint else None):
277:         if settings is not None and (settings.use_automasking_cavity
278:                                      or settings.use_automasking_cavity_inverted):
279:             return settings
280:     return None
281: 
282: 
283: def _apply_cavity(settings, sc_brush, cache=None):
284:     """Copy the resolved cavity settings onto the engine brush. The executor
285:     pre-fills a per-vertex factor once per stroke when `automask_cavity` is
286:     set; every kernel that reads the strength intrinsic is masked by it."""
287:     if settings is None:
288:         sc_brush.automask_cavity = False
289:         return
290: 
291:     sc_brush.automask_cavity = True
292:     sc_brush.cavity_inverted = bool(settings.use_automasking_cavity_inverted)
293:     sc_brush.cavity_factor = settings.cavity_factor
294:     sc_brush.cavity_blur_steps = settings.cavity_blur_steps
295: 
296:     use_curve = bool(settings.use_automasking_custom_cavity_curve)
297:     sc_brush.cavity_use_curve = use_curve
298:     if not use_curve:
299:         return
300:     # The engine samples the LUT in un-inverted space and inverts afterwards,
301:     # the same order Blender evaluates the curve in, so bake it as authored.
302:     from .brush_properties import sampling
303:     from .brush_properties.responses import SampleConfig
304:     owner = settings.id_data
305:     path = ('mesh_automasking_settings.cavity_curve' if owner.bl_rna.identifier == 'Brush'
306:             else 'tool_settings.sculpt.mesh_automasking_settings.cavity_curve')
307:     response = sampling.native_response(owner, path, SampleConfig(clamp_output=True))
308:     _upload_lut(cache, 'cavity', response.samples, sc_brush)
309: 
310: 
311: 
312: # Pen-pressure response curves. Blender maps tablet pressure to a strength /
313: # size factor through the Brush.curve_strength / Brush.curve_size
314: # CurveMappings (vanilla BKE_curvemapping_evaluateF(curve, 0, pressure)). The
315: # engine mirrors this with a per-device response table (prop_dynamics.h
316: # DynamicDevice.curveTable); the smooth brush folds pressure in Python-side, so
317: # the same table is also sampled directly. Definitions synchronize at stroke
318: # start; unchanged curves reuse immutable tables. No baking occurs per dab.
319: 
320: 
321: def sample_pressure_curve(owner, path):
322:     """Resolve native authority once at stroke start; unchanged definitions reuse samples."""
323:     from .brush_properties.sampling import native_response
324:     return native_response(owner, path).samples
325: 
326: 
327: def eval_pressure_lut(lut, pressure):
328:     """Look up a pressure factor in a table from ``sample_pressure_curve``,
329:     using the same clamped linear interpolation as the engine's ``deviceFactor``
330:     so the Python-side (smooth) and engine-side paths agree."""
331:     n = len(lut)
332:     x = min(1.0, max(0.0, pressure)) * (n - 1)
333:     i = int(x)
334:     if i >= n - 1:
335:         return lut[n - 1]
336:     t = x - i
337:     return lut[i] * (1.0 - t) + lut[i + 1] * t
338: 
339: 
340: def apply_pressure_dynamics(bl_brush, sc_brush, *, use_strength, use_size, cache=None):
341:     """Configure the engine's per-stroke pressure dynamics: a MULTIPLY device
342:     layer per pressure-enabled channel, carrying the cached response curve from
343:     the matching Brush CurveMapping. Runs once per stroke; the operator refills the device sample
344:     with the event pressure each dab. Passing both flags false — a smooth or
345:     grab-class stroke — clears both channels, so no stale dynamic survives.
346: 
347:     ``cache`` is the session's curve memo: a stroke asking for the configuration
348:     the engine already holds reuses it instead of re-marshalling 512 samples
349:     across the ctypes boundary."""
350:     from . import engine
351:     from .brush_properties.uploads import StackUploads
352:     from sculptcore.brush_properties import CommonProperties, DeviceLayer
353:     want = (sample_pressure_curve(bl_brush, 'curve_strength') if use_strength else None,
354:             sample_pressure_curve(bl_brush, 'curve_size') if use_size else None)
355:     memo = cache.setdefault('pressure_uploads', StackUploads()) if cache is not None else StackUploads()
356:     stacks = tuple((prop, () if table is None else (DeviceLayer(DEVICE_PRESSURE, samples=table),))
357:                    for prop, table in ((PROP_STRENGTH, want[0]), (PROP_RADIUS, want[1])))
358:     memo.install(sc_brush, CommonProperties(engine.manager(), sc_brush), stacks, command='legacy-pressure')
359: 
360: 
361: 
362: # For UI / diagnostics: every mapped type (supported or not).
363: KERNEL_BY_TYPE = {t: v[0] for t, v in _MAP.items()}
364: 
365: 
366: def is_supported(bl_brush):
367:     return bl_brush is not None and bl_brush.sculpt_brush_type in _MAP
368: 
369: 
370: def kernel_enum(mgr, bl_brush):
371:     """The SculptBrushes enum value for a Blender brush, or None when the
372:     brush type is not supported for sculpting yet — or when the loaded DLL
373:     lacks the kernel (a stale vendored build without an extra kernel)."""
374:     entry = _MAP.get(bl_brush.sculpt_brush_type)
375:     if entry is None:
376:         return None
377:     value = mgr.get("sculptcore::brush::SculptBrushes").items.get(entry[0])
378:     return None if value is None else int(value)
379: 
380: 
381: def apply_brush_settings(bl_brush, unified, sc_brush, *, paint=None, cache=None):
382:     """Configure the stroke-constant part of a SculptCore Brush from a
383:     Blender Brush: scalar settings, per-type extras, and cached falloff/cavity
384:     tables. Changed tables upload in bulk; their inputs stay fixed while
385:     a stroke is running, so this runs once at stroke start and
386:     ``apply_dab_state`` writes the per-dab values on top.
387: 
388:     ``unified`` is the per-Paint ``UnifiedPaintSettings`` (may be None).
389:     ``paint`` is the owning ``Paint`` (``tool_settings.sculpt``), consulted
390:     for automasking settings the brush itself does not override; without it
391:     only the brush's own settings apply.
392:     """
393:     strength = bl_brush.strength
394:     if unified is not None and unified.use_unified_strength:
395:         strength = unified.strength
396: 
397:     sc_brush.strength = strength
398:     sc_brush.spacing = max(bl_brush.spacing, 1) / 100.0  # percent -> fraction
399: 
400:     entry = _MAP.get(bl_brush.sculpt_brush_type)
401:     if entry is not None:
402:         for field, value in entry[1].items():
403:             setattr(sc_brush, field, value(bl_brush) if callable(value) else value)
404: 
405:     if bl_brush.sculpt_brush_type == 'PAINT':
406:         col = bl_brush.color  # linear RGB
407:         bc = sc_brush.brushColor.vec
408:         bc[0], bc[1], bc[2], bc[3] = col[0], col[1], col[2], 1.0
409: 
410:     _bake_falloff(bl_brush, sc_brush, cache)
411:     _apply_cavity(cavity_settings(bl_brush, paint), sc_brush, cache)
412: 
413:     # Generated engine-only uniforms (Brush.sculptcore, brush-mapping M2) —
414:     # after the mapping so table-driven fields keep authority.
415:     from . import engine_props
416:     engine_props.apply(bl_brush, sc_brush)
417:     sc_brush.writeProps()
418: 
419: 
420: def overlap_attenuation(bl_brush, cache=None):
421:     """Vanilla's "Adjust Strength for Spacing"
422:     (#paint_stroke_integrate_overlap): normalize the strength by the
423:     worst-case sum of overlapping falloff dabs along the stroke line,
424:     sampled at 10 phase offsets. 1.0 when the flag is off or spacing has no
425:     overlap (>= 100%).
426: 
427:     Never applied to the drag brushes (is_grab_class / is_snake_hook): vanilla
428:     reads their strength straight off the brush (`brush_strength`'s
429:     `root_alpha * feather` for GRAB and SNAKE_HOOK, no `overlap` term), and the
430:     compensation would be wrong anyway — it cancels the repeated *additive*
431:     dabs of an offset brush, whereas a drag brush's dabs each carry their own
432:     step, summing to the cursor's total drag no matter how many there are.
433:     Attenuating it just leaves the hook short of the cursor by 1/peak (a 5x
434:     shortfall at the Snake Hook asset's 10% spacing)."""
435:     if not (bl_brush.use_space_attenuation and bl_brush.spacing < 100):
436:         return 1.0
437:     if is_grab_class(bl_brush) or is_snake_hook(bl_brush):
438:         return 1.0
439:     from .brush_properties import sampling
440:     preset = bl_brush.curve_distance_falloff_preset
441:     source = (bl_brush.authoring_native_curve_key('curve_distance_falloff') if preset == 'CUSTOM' else preset)
442:     key = (sampling.epoch, source, bl_brush.spacing)
443:     previous = cache.get('overlap') if cache is not None else None
444:     if previous is not None and previous[0] == key:
445:         return previous[1]
446:     fn = _PRESET_FALLOFF.get(bl_brush.curve_distance_falloff_preset)
447:     if fn is None:  # CUSTOM: strength(p) = curve(1 - p), matching BKE.
448:         cumap = bl_brush.curve_distance_falloff
449:         cumap.update()
450:         curve = cumap.curves[0]
451: 
452:         def fn(t, _c=cumap, _cv=curve):
453:             return _c.evaluate(_cv, 1.0 - t)
454: 
455:     spacing = max(bl_brush.spacing, 0.1)
456:     count = int(100 / spacing)
457:     h = spacing / 50.0
458:     peak = 0.0
459:     for i in range(10):
460:         x0 = i / 10.0 - 1.0
461:         total = 0.0
462:         for j in range(count):
463:             xx = abs(x0 + j * h)
464:             if xx < 1.0:
465:                 total += fn(1.0 - xx)
466:         peak = max(peak, abs(total))
467:     result = 1.0 / peak if peak > 0.0 else 1.0
468:     if cache is not None:
469:         cache['overlap'] = (key, result)
470:         cache['overlap_bakes'] = cache.get('overlap_bakes', 0) + 1
471:     return result
472: 
473: 
474: def pixel_radius(sculpt, bl_brush):
475:     """The dab radius in screen pixels — the port of #BKE_brush_radius_get.
476: 
477:     ``Brush.size`` is a **diameter**: ``DNA_brush_types.h`` documents
478:     ``unprojected_size`` as "diameter of the brush in Blender units", both RNA
479:     properties are ``PROP_DISTANCE_DIAMETER``, and ``versioning_500.cc`` doubles
480:     the field when reading pre-5.0 files. Native sculpt never reads it raw —
481:     every consumer (``paint_stroke.cc``'s ``pixel_radius``, the spacing walk,
482:     ``paint_cursor.cc``) goes through ``BKE_brush_radius_get()``, which halves
483:     it. Taking ``.size`` for a radius makes every dab twice as wide as vanilla's
484:     and so covers four times the area.
485:     """
486:     size = unified_size(sculpt, bl_brush)
487:     return size / 2.0
488: 
489: 
490: def unified_size(sculpt, bl_brush):
491:     """The brush's pixel *diameter*, honouring the unified-size override."""
492:     unified = sculpt.unified_paint_settings
493:     return unified.size if unified.use_unified_size else bl_brush.size
494: 
495: 
496: def unprojected_radius(bl_brush):
497:     """Object-space fallback radius when a dab centre projects off-screen.
498:     ``unprojected_size`` is a diameter too (#BKE_brush_unprojected_radius_get)."""
499:     return bl_brush.unprojected_size / 2.0
500: 
501: 
502: def apply_dab_state(bl_brush, unified, sc_brush, *, world_radius, invert,
503:                     strength_scale=1.0, strength_override=None,
504:                     allow_invert=True):
505:     """Write the per-dab brush state: strength, radius and the invert flag
506:     (a live Ctrl toggles it mid-stroke), folded with the brush direction.
507:     Assumes ``apply_brush_settings`` ran at stroke start. ``strength_scale``
508:     folds per-stroke factors in (overlap attenuation). ``allow_invert=False``
509:     forces the invert flag off regardless of Ctrl/direction — smoothing has no
510:     inverse (the engine negates kernel strength on invert, and an inverted
511:     Laplacian moves verts away from their ring average, diverging within a few
512:     dabs), matching vanilla, where smooth ignores the direction.
513: 
514:     Strength and radius must be rewritten every dab, not only at stroke
515:     start: the engine's per-dab ``loadProps`` assigns the post-dynamics
516:     values (e.g. strength x pen pressure) back into the Brush *fields*, so
517:     the ``writeProps`` below would otherwise persist the decayed field into
518:     the prop store and a pressure stroke would fade to nothing after the
519:     first dab. Radius varies per dab anyway (depth-dependent unproject)."""
520:     if strength_override is not None:
521:         # Caller-computed strength (multi-pass smooth); scale/unified already
522:         # folded in.
523:         strength = strength_override
524:     else:
525:         strength = bl_brush.strength
526:         if unified is not None and unified.use_unified_strength:
527:             strength = unified.strength
528:         strength *= strength_scale
529: 
530:     sc_brush.strength = strength
531:     sc_brush.radius = world_radius
532:     if allow_invert:
533:         sc_brush.invert = bool(invert) ^ bool(bl_brush.direction == 'SUBTRACT')
534:     else:
535:         sc_brush.invert = False
536: 
537:     sc_brush.writeDabProps()
538: 
539: 
540: def apply_brush(bl_brush, unified, sc_brush, *, world_radius, invert, paint=None):
541:     """Configure a SculptCore Brush from a Blender Brush in one call —
542:     ``apply_brush_settings`` plus ``apply_dab_state``. Single-dab convenience
543:     for the headless tests; the stroke operator calls the two parts itself so
544:     the curve bakes run once per stroke, not per dab."""
545:     apply_brush_settings(bl_brush, unified, sc_brush, paint=paint)
546:     apply_dab_state(bl_brush, unified, sc_brush,
547:                     world_radius=world_radius, invert=invert)
