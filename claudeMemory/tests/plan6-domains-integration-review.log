222: 
223: def radius_from_diameter(diameter):
224:     return scalar('FLOAT32', diameter) / 2.0
225: 
226: 
227: def spacing_fraction(percent):
228:     return max(1, percent) / 100.0
229: 
230: 
231: def snake_pinch(factor):
232:     return 2.0 * (.5 - factor)
233: 
234: 
235: def strength_multiplier(brush_type):
236:     return 2.0 if brush_type == 'DRAW_SHARP' else 1.0
237: 
238: 
239: def accumulate_value(brush_type, authored, *, has_accumulate=True, operation_mode=None):
240:     return (operation_mode in ('SMOOTH', 'MASK') or brush_type == 'DRAW_SHARP'
241:             or not has_accumulate or authored)
