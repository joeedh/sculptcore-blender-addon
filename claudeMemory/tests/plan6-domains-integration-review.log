4: """Immutable device samples and acquisition-time derivatives for a stroke."""
5: 
6: from dataclasses import dataclass
7: import math
8: 
9: 
10: def _finite(value, low, high):
11:     value = float(value)
12:     return min(high, max(low, value)) if math.isfinite(value) else None
13: 
14: 
15: @dataclass(frozen=True)
16: class InputSample:
17:     pressure: float | None = None
18:     tilt_x: float | None = None
19:     tilt_y: float | None = None
20:     speed: float | None = None
21:     time: float | None = None
22:     invert: bool = False
23: 
24:     @property
25:     def channels(self):
26:         return (self.pressure, self.tilt_x, self.tilt_y, self.speed)
27: 
28:     def upload(self, brush):
29:         brush.clearDeviceInputs()
30:         for device, value in enumerate(self.channels):
31:             if value is not None:
32:                 brush.pushDeviceInput(device, value)
33: 
34:     def batch_row(self):
35:         """Four normalized values followed by their exact small integer presence mask."""
36:         mask = sum(1 << i for i, value in enumerate(self.channels) if value is not None)
37:         return tuple(0.0 if value is None else value for value in self.channels) + (mask,)
38: 
39:     @staticmethod
40:     def interpolate(a, b, fraction):
41:         fraction = min(1.0, max(0.0, fraction))
42: 
43:         def mix(x, y):
44:             return None if x is None or y is None else x + (y - x) * fraction
45: 
46:         return InputSample(
47:             mix(a.pressure, b.pressure), mix(a.tilt_x, b.tilt_x), mix(a.tilt_y, b.tilt_y),
48:             b.speed if a.time is not None and b.time is not None else None,
49:             mix(a.time, b.time), b.invert,
50:         )
51: 
52: 
53: class InputSampler:
54:     def __init__(self, speed_reference=1000.0):
55:         self.speed_reference = float(speed_reference)
56:         if not math.isfinite(self.speed_reference) or self.speed_reference <= 0:
57:             raise ValueError("Speed reference must be finite and positive")
58:         self._anchor = None
59: 
60:     def read(self, event, coord, invert=False):
61:         # A redraw-generated move must not change spacing or derivative history.
62:         if not getattr(event, "is_input_sample", True):
63:             return None
64:         tablet = bool(event.is_tablet)
65:         pressure = 1.0 if not tablet else (
66:             _finite(event.pressure, 0.0, 1.0) if getattr(event, "has_pressure", True) else None)
67:         tilt = event.tilt if tablet else (0.0, 0.0)
68:         axes = []
69:         for index, name in enumerate(("has_tilt_x", "has_tilt_y")):
70:             value = _finite(tilt[index], -1.0, 1.0) if tablet and getattr(event, name, False) else None
71:             axes.append(None if value is None else (value + 1.0) * 0.5)
72:         time = float(event.time) if getattr(event, "has_time", False) else None
73:         if time is not None and (not math.isfinite(time) or time < 0):
74:             time = None
75:         speed = None
76:         if time is None:
77:             self._anchor = None
78:         elif self._anchor is None:
79:             speed = 0.0
80:             self._anchor = (tuple(coord), time)
81:         else:
82:             previous, previous_time = self._anchor
83:             if time <= previous_time:
84:                 # Do not interpolate a segment through an invalid time transition.
85:                 time = None
86:                 self._anchor = None
87:             else:
88:                 speed = min(1.0, math.dist(previous, coord) / (time - previous_time) / self.speed_reference)
89:                 self._anchor = (tuple(coord), time)
90:         return InputSample(pressure, *axes, speed, time, bool(invert))
