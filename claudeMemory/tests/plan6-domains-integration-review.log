5: """
6: Blender Brush -> SculptCore Brush mapping (declarative table).
7: 
8: M1: the per-dab sculpting brushes. Each entry names the SculptCore kernel
9: and (optionally) per-type field values applied on stroke start. World-space
10: radius unprojection is the stroke operator's job; this layer copies
11: engine-space fields only.
12: 
13: Pose is intentionally *not* supported yet: it needs per-stroke pose-cage
14: anchor state a bare per-dab ``execBrush`` doesn't set up (and crashes
15: without it). ``kernel_enum`` returns None for it so the stroke operator
16: refuses cleanly rather than crashing.
17: """
18: 
19: # Engine constants for the device-dynamics seam (brush.h BrushProp ids,
20: # prop_dynamics.h DeviceType, litestl mix.h BasicMix). Legacy pressure uses
21: # the checked CommonProperties adapter with these fixed property IDs.
22: PROP_STRENGTH = 0
23: PROP_RADIUS = 1
24: DEVICE_PRESSURE = 0
25: MIX_MULTIPLY = 1
26: 
27: # Blender sculpt_brush_type -> (SculptCore SculptBrushes name, extra fields).
28: # `extra` is a dict of SculptCore Brush field -> value/callable(bl_brush).
29: # Verified per-dab via the parity harness (test_brush_parity).
30: _MAP = {
31:     'DRAW': ("DRAW", {}),
32:     # Vanilla Draw Sharp is a plain normal-offset draw with falloff factors
33:     # from original coordinates (do_draw_sharp_brush) — no pinch. pinch is
34:     # reset explicitly because the session Brush is shared across strokes and
35:     # a prior PINCH stroke would otherwise leak its value into SHARP.
36:     'DRAW_SHARP': ("SHARP", {"pinch": 0.0}),
37:     'INFLATE': ("INFLATE", {}),
38:     # Layer rides the layerdraw kernel: the dab writes a sculpt-layer channel
39:     # (recomposited by weight) instead of base co, so a stroke can be
40:     # re-weighted or disabled after the fact. The stroke operator creates the
41:     # write target on first use (layers.ensure_stroke_target); vanilla's
42:     # height cap and persistent base are out of scope for now.
43:     'LAYER': ("LAYERDRAW", {}),
44:     # Clay + plane family: map the plane offset; the default plane side (+1)
45:     # produces sensible output at a convex surface (a -1 scrape side finds
46:     # nothing above the tangent plane on a sphere). Blender's 'PLANE' is the
47:     # unified flatten/fill brush and 'MULTIPLANE_SCRAPE' the scrape; precise
48:     # per-mode side/offset semantics is a later refinement.
49:     'CLAY': ("CLAY", {"planeoff": lambda b: b.plane_offset}),
50:     'CLAY_STRIPS': ("CLAY", {"planeoff": lambda b: b.plane_offset}),
51:     'PLANE': ("FILL", {"planeoff": lambda b: b.plane_offset}),
52:     'MULTIPLANE_SCRAPE': ("SCRAPE", {"planeoff": lambda b: b.plane_offset}),
53:     # BSMOOTH (boundary-aware smooth): identical to plain SMOOTH on meshes
54:     # with no marked feature edges. Seam/sharp edge flags transfer to the
55:     # engine on enter (convert._load_edge_flags), so marked features hold
56:     # under smoothing (verified: a sharp-marked crest erodes 0% vs 66% of its
57:     # height unmarked — claudeMemory/tests/bsmooth_boundary_test.py).
58:     'SMOOTH': ("BSMOOTH", {}),
59:     'PINCH': ("PINCH", {"pinch": lambda b: b.strength}),
60:     # Nudge runs an addon-carried extra kernel (brushes/nudge.sbrush), compiled
61:     # into the DLL at build time; a stale vendored DLL without it makes
62:     # kernel_enum return None and the stroke cancel cleanly. Its tunable
63:     # (nudgeProjection) is a namedFloats store uniform written by
64:     # engine_props.apply, so no per-stroke field reset is needed here.
65:     'NUDGE': ("NUDGE", {}),
66:     'MASK': ("MASK", {}),
67:     # Vertex paint: brushColor synced from the Blender brush color (see
68:     # apply_brush); writes the `color` float4 vertex attr.
69:     'PAINT': ("COLOR", {}),
70:     # Face sets: paint the `group` face attr; the stroke operator assigns a
71:     # fresh active group id per stroke (see FACE_SET_TYPES).
72:     'DRAW_FACE_SETS': ("POLYGROUP", {}),
73:     # Snake hook dabs along the stroke, but its kernel is driven by the grab
74:     # ctx vectors (`@incremental`, see is_snake_hook); the stroke operator sets
75:     # them per dab image and advances the dab center with the extruded tip.
76:     # Blender's pinch
77:     # control (crease_pinch_factor, labelled "Magnify" for this brush) is 0..1
78:     # with 0.5 neutral and pinching below it; the kernel takes the engine's
79:     # 0-means-off convention, so remap here — 2 * (0.5 - factor), positive
80:     # pinching in, negative inflating. Written on every snake-hook stroke, so
81:     # the shared `pinch` member cannot leak in from a prior PINCH stroke.
82:     'SNAKE_HOOK': ("SNAKEHOOK", {"pinch": lambda b: 2.0 * (0.5 - b.crease_pinch_factor)}),
83:     # Grab dabs at a fixed anchor and reads the cumulative cursor delta
84:     # (grabTo/grabFrom); the stroke operator drives it via the grab-class path.
85:     'GRAB': ("GRAB", {}),
86:     # Elastic deform = a Kelvinlet soft-body grab (same grabFrom/grabTo state,
87:     # engine mu/nu defaults ~ soft rubber).
88:     'ELASTIC_DEFORM': ("KELVINLET", {}),
89:     # Thumb is Grab with the drag flattened into the surface, so it smears
90:     # sideways instead of pulling out — same kernel, different vector (see
91:     # TANGENT_DRAG).
92:     'THUMB': ("GRAB", {}),
93: }
94: 
95: # Brush types whose cursor drag is projected into the tangent plane of the
96: # stroke's sculpt normal before the GRAB kernel sees it, and scaled by strength
97: # — vanilla's do_thumb_brush (`cross(cross(n, delta), n) * bstrength`; Grab
98: # itself drags by the raw delta and ignores strength). This is not engine
99: # policy: the kernel is the same anchored from-orig grab either way and only
100: # the vector the host hands it differs, so it belongs in a host table next to
101: # _MAP rather than in a kernel annotation.
102: TANGENT_DRAG = {'THUMB'}
103: 
104: 
105: def drag_offset(bl_brush, delta, normal, strength):
106:     """The object-space drag to hand the GRAB kernel for one grab dab, given the
107:     raw cursor delta. Identity outside TANGENT_DRAG."""
108:     if bl_brush.sculpt_brush_type not in TANGENT_DRAG:
109:         return delta
110: 
111:     import mathutils
112: 
113:     n = mathutils.Vector(normal)
114:     if n.length_squared == 0.0:
115:         return delta
116:     n.normalize()
117:     d = mathutils.Vector(delta)
118:     return tuple(n.cross(d).cross(n) * strength)
