243: 
244: def direction_sign(direction, invert=False):
245:     if direction not in ('ADD', 'SUBTRACT') or type(invert) is not bool:
246:         raise PropertyError("Invalid brush direction")
247:     return -1 if (direction == 'SUBTRACT') != invert else 1
