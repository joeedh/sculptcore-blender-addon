206: 
207: # Closed-form preset falloffs, keyed by `curve_distance_falloff_preset`. `t`
208: # is 1 - normalized distance (1 at center, 0 at edge) — the same value the
209: # engine feeds falloffEval. Mirrors BKE_brush_curve_strength so brush feel
210: # matches Blender exactly; CUSTOM samples the editable CurveMapping instead.
211: _PRESET_FALLOFF = {
212:     'SHARP': lambda t: t * t,
213:     'SMOOTH': lambda t: 3.0 * t * t - 2.0 * t * t * t,
214:     'SMOOTHER': lambda t: t * t * t * (t * (t * 6.0 - 15.0) + 10.0),
215:     'ROOT': lambda t: t ** 0.5,
216:     'LIN': lambda t: t,
217:     'CONSTANT': lambda t: 1.0,
218:     'SPHERE': lambda t: max(0.0, 2.0 * t - t * t) ** 0.5,
219:     'POW4': lambda t: t * t * t * t,
220:     'INVSQUARE': lambda t: t * (2.0 - t),
221: }
