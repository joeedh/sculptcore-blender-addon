142:                 raise PropertyError("Stack override requires a target dynamic property: " + identifier)
143:         object.__setattr__(self, 'definitions', definitions)
144:         object.__setattr__(self, 'values', tuple((key, by_id[key].validate(value)) for key, value in values))
145:         object.__setattr__(self, 'stacks', stacks)
