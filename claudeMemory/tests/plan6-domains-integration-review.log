92: def capture(registry, identifiers, local, parent=None):
93:     """Resolve a complete candidate; failure returns no partial snapshot.
94: 
95:     Fresh resolution validates owner lifetimes even when stacks are empty. Native
96:     size uses its effective value owner's entire pair, independent of stack owner.
97:     Execution capability remains exactly as reported by the authoring resolver.
98:     """
99:     _main_thread()
100:     identifiers = tuple(identifiers)
101:     if any(type(identifier) is not str for identifier in identifiers) or len(set(identifiers)) != len(identifiers):
102:         raise PropertyError("Snapshot IDs must be unique strings")
103:     for identifier in identifiers:
104:         registry.get(identifier)
105:     properties = []
106:     for identifier in identifiers:
107:         resolved = resolve(registry, identifier, local, parent)
108:         size = None
109:         if identifier == SIZE:
110:             native = getattr(resolved.value_owner, '_native', None)
111:             if native is None:
112:                 raise PropertyError("Semantic size requires an authoritative native owner")
113:             block = native.size_block()
114:             size = SizeSnapshot(block.pixels, block.world, block.mode,
115:                                 native.value_domain(BY_ID[PIXELS]), native.value_domain(BY_ID[WORLD]))
116:         stack = (prepare_stack(resolved) if resolved.stack_available else ())
117:         properties.append(PropertySnapshot(
118:             resolved.definition, resolved.value_domain, resolved.value,
119:             resolved.value_source.present, resolved.value_source.source, stack,
120:             resolved.stack_available, resolved.execution_available, resolved.diagnostics, size))
121:     return tuple(properties)
