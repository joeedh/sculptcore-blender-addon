44:         raise PropertyError("Expected a finite scalar with a supported type")
45:     try:
46:         result = struct.unpack('f', struct.pack('f', value))[0]
47:     except (OverflowError, struct.error):
48:         raise PropertyError("Float value is outside float32 storage") from None
49:     if not math.isfinite(result):
50:         raise PropertyError("Float value is outside float32 storage")
