120: # Types whose vanilla brush adds its offset EVERY dab regardless of the
121: # Accumulate toggle (do_draw_sharp_brush has no accumulate branch; its
122: # "sharp" stability comes from orig-coordinate falloff factors, not from
123: # capping displacement). The engine's nonAccum instead freezes the stroke at
124: # single-dab depth — near-invisible for a subtle brush — so the operator
125: # forces per-dab accumulation for these.
126: FORCE_ACCUMULATE = {'DRAW_SHARP'}
127: 
128: # Per-type strength compensation folded into every dab. The engine SHARP
129: # kernel displaces by strength * radius * 0.5; vanilla's draw-sharp offset is
130: # normal * radius * strength (no 0.5), so double the strength to match.
131: STRENGTH_SCALE = {'DRAW_SHARP': 2.0}
132: 
133: # Brush types that paint face sets — the operator assigns a fresh `activeGroup`
134: # id (max existing + 1) at stroke start.
135: FACE_SET_TYPES = {'DRAW_FACE_SETS'}
136: 
137: # Brush types that paint the `color` vertex attr — on multires, the only ones
138: # that pay for the cage colour write-back (convert.sync_cage_vert_color).
139: COLOR_TYPES = {'PAINT'}
140: 
141: # Kernels that exist but need infrastructure not wired yet — kept for
142: # reference / a future UI "unsupported" hint, never entered.
143: UNSUPPORTED = {
144:     'POSE': "needs the pose-cage anchor path",
145: }
