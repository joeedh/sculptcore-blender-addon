250: def invert_for_dab(direction, invert, *, allow_invert=True):
251:     """Preserve the existing bridge's SUBTRACT test and smoothing override."""
252:     if type(direction) is not str or type(invert) is not bool or type(allow_invert) is not bool:
253:         raise PropertyError("Invalid dab direction policy")
