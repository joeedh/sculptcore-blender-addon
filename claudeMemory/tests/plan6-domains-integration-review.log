147: 
148: def _policy(bl_brush):
149:     """The engine-declared policy for the kernel this Blender brush maps to.
150:     Which brush type maps to which kernel is a host decision (the table above);
151:     how that kernel wants to be driven is not — it is queried, never listed
152:     here, so a kernel's annotations can change without a host edit."""
153:     from . import brush_policy, engine
154: 
155:     if bl_brush is None:
156:         return brush_policy.for_kernel(None)
157:     return brush_policy.for_kernel(kernel_enum(engine.manager(), bl_brush))
158: 
159: 
160: def is_grab_class(bl_brush):
161:     """Anchored, from-orig grab (`@grabmode`): the dab stays at the stroke's
162:     anchor and the deform follows the cumulative cursor delta, rather than
163:     dabbing along the stroke at the moving cursor."""
164:     return _policy(bl_brush).grab_mode_capable
165: 
166: 
167: def is_snake_hook(bl_brush):
168:     """Path-style grab (`@incremental`): the kernel reads the grab ctx vectors
169:     — grabFrom is the dab center, grabTo the step since the previous dab, and
170:     it gathers toward grabFrom + grabTo — but keeps dabbing along the stroke, so
171:     it takes the normal (spacer / preview) path rather than the anchored one.
172:     Left unset, both vectors default to the origin and the kernel contracts
173:     geometry toward the object origin instead of hooking. The spacer path also
174:     walks the dab center out with the extruded tip rather than raycasting each
175:     sample — see stroke._snake_hook_advance."""
176:     return _policy(bl_brush).incremental
177: 
178: 
179: def pressure_prop_names(bl_brush):
180:     """The ``(strength, size)`` pen-pressure toggle property names to draw and
181:     read for ``bl_brush`` — Blender's own where they mean something there, this
182:     addon's shadow toggles (props._PRESSURE_PROPS) where they do not.
183: 
184:     Vanilla gates each row on ``sculpt_capabilities.has_*_pressure``, so on a
185:     brush where that reads False its ``use_pressure_*`` is never drawn and never
186:     consulted; whatever the shipped asset happens to store is noise (the Snake
187:     Hook asset stores strength pressure on). This mode drives those brushes with
188:     pressure all the same, so it substitutes toggles it owns — same rows, same
189:     response curves, but a default it controls: off, which is what vanilla
190:     effectively does. Brushes vanilla does support keep their own flags, so
191:     nothing an artist already set changes.
192:     """
193:     caps = bl_brush.sculpt_capabilities
194:     return (
195:         "use_pressure_strength" if caps.has_strength_pressure
196:         else "sculptcore_use_pressure_strength",
197:         "use_pressure_size" if caps.has_size_pressure
198:         else "sculptcore_use_pressure_size",
199:     )
