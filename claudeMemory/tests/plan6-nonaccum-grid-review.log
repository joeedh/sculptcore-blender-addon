804:         outside++;
805:     }
806:     test_assert(outside > 0);
807:     if (grid)
808:       for (int v = 0; v < count; v++)
809:         output.push_back(domain->no[v]);
810:     if (resolved) {
811:       test_assert(brush.strokePathCount == 3);
812:       const auto blobAfter = storeBlob(mr);
813:       if (grid)
814:         test_assert(gridLog.undo());
815:       else
816:         meshLog.undo(cage, &tree);
817:       for (int v = 0; v < count; v++) {
818:         const auto &co = grid ? domain->pos()[v] : cage->v.co[v];
819:         test_assert(std::memcmp(&co, &before[v], sizeof(float3)) == 0);
820:       }
821:       if (grid) {
822:         test_assert(storeBlob(mr) == blobBefore);
823:         checkGridNormals(*domain);
824:         test_assert(gridLog.redo());
825:         test_assert(storeBlob(mr) == blobAfter);
826:         checkGridNormals(*domain);
827:       } else
828:         meshLog.redo(cage, &tree);
829:       for (int v = 0; v < count; v++) {
830:         const auto &co = grid ? domain->pos()[v] : cage->v.co[v];
831:         test_assert(std::memcmp(&co, &output[v], sizeof(float3)) == 0);
832:       }
833:       test_assert(mr.store.channelCount() == channelCount);
