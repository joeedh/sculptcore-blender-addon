649:    * path; a null one just means extra kernels report unhandled. */
650:   template <class AccMode>
651:   static bool
652:   createCommandSwitch(SculptBrushes brushType, Brush *brushOrNull, brush_command &def)
653:   {
654:     if (command::createBuiltinBrush<GridBrushExecutor, GridCsrNbr, GridCsrNbr, AccMode>(
