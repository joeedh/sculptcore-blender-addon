667:     program.commands[draw].dynamicsOverrides.append(main);
668:     BrushDynamicsOverride later{"radius", props::Prop::FLOAT32, {}};
669:     later.dynamics.configure(props::DeviceType::TILTX, math::BasicMix::ADD, 1);
670:     program.commands[smooth].dynamicsOverrides.append(later);
671:     program.commands[smooth].dynamicsOverrides.append(
672:         {"strength", props::Prop::FLOAT32, {}});
