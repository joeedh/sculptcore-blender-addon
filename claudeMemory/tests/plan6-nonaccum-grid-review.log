500:   brush_command createCommand(SculptBrushes brushType)
501:   {
502:     brush_command def;
503:     createCommandImpl<AccumLive>(brushType, def);
504:     if (def.grabModeCapable && anchoredGrab) {
505:       // Always deform from each vert's stroke-start position, so the region is
506:       // fixed at stroke start and the grab follows the cursor (#35). One write-
507:       // back (AccumOrigGrab) serves every symmetry image: the first image to
508:       // touch a vert this dab re-bases it from orig, later images of the same
509:       // dab add their displacement onto it (arbitrated by the per-vert dab
510:       // stamp). Forced on regardless of the ACCUMULATE flag. The op marks each
511:       // image via setGrabAccumAdd, which advances the per-dab generation on the
512:       // primary.
513:       def.grabMode = true;
514:       /* The second impl call re-appends the same uniform + attr manifests â€”
515:          clear them first or grab-class brushes report every entry twice (the
516:          wave-5 queryUniformManifest / queryAttrManifest bridge). */
517:       def.uniforms = decltype(def.uniforms)();
518:       def.attrs = decltype(def.attrs)();
519:       createCommandImpl<AccumOrigGrab>(brushType, def);
520:     } else if (nonAccum && def.accumulable && !def.relaxesBase) {
521:       def.uniforms = decltype(def.uniforms)();
522:       def.attrs = decltype(def.attrs)();
523:       createCommandImpl<AccumOrig>(brushType, def);
524:     }
525:     return def;
526:   }
