128: props::ScalarRegistrationResult CommandExecutor::applyResolvedDab(SculptBrushes brushType,
129:                                                                   float3 center,
130:                                                                   float3 normal,
131:                                                                   bool validateOnly)
132: {
133:   using props::PropError;
134:   auto fail = [&](PropError error, const char *name) {
135:     lastRegistration = {error, name};
136:     return lastRegistration;
137:   };
138:   if (!brush || !tree || !tree->m || !tree->getRoot()) {
139:     return fail(PropError::ERROR_INVALID_OWNER, "mesh");
140:   }
141:   for (int axis = 0; axis < 3; axis++) {
142:     if (!std::isfinite(center[axis]) || !std::isfinite(normal[axis])) {
143:       return fail(PropError::ERROR_INVALID_VALUE, "dab frame");
144:     }
145:   }
146:   Brush scratch;
147:   brush_command command;
148:   if (!createCommandSwitch<AccumLive>(
149:           brushType, effectiveNeighborMode() == NeighborMode::Csr, &scratch, command))
150:   {
151:     return fail(PropError::ERROR_NOT_EXISTS, "kernel");
152:   }
153:   // These modes need additional region, host-state or attribute preflight.
154:   // Generated host stages may themselves change radius/center after selection.
155:   if (!resolvedCapability(*this, command, brushType)) {
156:     return fail(PropError::ERROR_INVALID_VALUE, "unsupported resolved capability");
157:   }
158:   PreparedBrushScalars prepared;
159:   lastRegistration =
160:       prepareBrushScalars(*brush,
161:                           {command.uniforms.data(), command.uniforms.size()},
162:                           brush->deviceInputCtx,
163:                           prepared);
164:   if (lastRegistration.error != PropError::ERROR_NONE) {
165:     return lastRegistration;
166:   }
167:   float radius = -1;
168:   for (const auto &value : prepared.values()) {
169:     if (value.name == string("radius")) {
170:       radius = float(value.value);
171:     }
172:   }
173:   if (!std::isfinite(radius) || radius < 0 ||
174:       (radius > 0 && !std::isfinite(1.0f / radius)))
175:   {
176:     return fail(PropError::ERROR_INVALID_VALUE, "radius");
177:   }
178:   // No callbacks or yields between preparation and publication. The exact
179:   // scratch command above executes below; no live factory or legacy loader.
180:   if (validateOnly)
181:     return {};
182:   lastRegistration = prepared.publish(*brush);
183:   if (lastRegistration.error != PropError::ERROR_NONE) {
184:     return lastRegistration;
185:   }
186:   dabNodes_.clear();
187:   if (radius > 0) {
188:     tree->filterNodes(center, radius, dabNodes_);
189:   }
190:   lastDabNodeCount = int(dabNodes_.size());
191:   if (dabNodes_.size()) {
192:     auto *mesh = tree->m;
193:     if (const auto *hooks = brushHooksFor(brushType); hooks && hooks->stepPreFreeze) {
194:       BrushHookCtx hc{*this, mesh, &dabNodes_, brush, isFirstOfStep};
195:       hooks->stepPreFreeze(hc);
196:     }
197:     if (brushNeedsLiveLinks(brushType) || keepTopoThawed) {
198:       if (mesh->topo_frozen)
199:         mesh->thawTopo();
200:     } else if (!mesh->topo_frozen) {
201:       mesh->freezeTopo();
202:     }
203:     ctx.m = mesh;
204:     ctx.surfaceNo = normal;
205:     ctx.surfacePos = center;
206:     ctx.meshLog = meshLog;
207:     ctx.isFirstOfStep = isFirstOfStep;
208:     updateStrokeFrame(center);
209:     brush->pushStrokeSample(center, normal);
210:     curCaptureSlot = 0;
211:     curCaptureTool = int(brushType);
212:     exec(command, {dabNodes_.data(), dabNodes_.size()});
213:     curCaptureSlot = -1;
214:     tree->updateQueries();
215:   }
216:   clearIsFirstOfStep();
217:   return {};
218: }
