209: props::ScalarRegistrationResult GridBrushExecutor::applyResolvedProgram(
210:     BrushProgram *program, float3 origin, float3 normal, bool validateOnly)
211: {
212:   using props::PropError;
213:   lastRegistration = resolvedState(origin, normal);
214:   if (lastRegistration.error != PropError::ERROR_NONE)
215:     return lastRegistration;
216:   if (!program) {
217:     lastRegistration = {PropError::ERROR_INVALID_OWNER, "program"};
218:     return lastRegistration;
219:   }
220:   if (!program->commands.size()) {
221:     PreparedBrushScalars empty;
222:     lastRegistration = prepareBrushScalars(*brush, {}, brush->deviceInputCtx, empty);
223:     if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
224:       return lastRegistration;
225:     stats.dabs++;
226:     dabMoved_.clear();
227:     dabGrids_.clear();
228:     dabLeaves_.clear();
229:     nodePtrs_.clear();
230:     isFirstOfStep = false;
231:     return {};
232:   }
233:   Vector<brush_command> commands;
234:   commands.resize(program->commands.size());
235:   Vector<std::span<const BrushUniformManifestEntry>> manifests;
236:   for (size_t i = 0; i < program->commands.size(); i++) {
237:     const auto &entry = program->commands[i];
238:     Brush scratch;
239:     auto &command = commands[i];
240:     if (!createCommandSwitch<AccumLive>(entry.type, &scratch, command)) {
241:       lastRegistration = programError(i, {PropError::ERROR_NOT_EXISTS, "kernel"});
242:       return lastRegistration;
243:     }
244:     if (entry.attrLayerOverrides.size() || !resolvedCapability(command, entry.type)) {
245:       lastRegistration = programError(
246:           i, {PropError::ERROR_INVALID_VALUE, "unsupported resolved capability"});
247:       return lastRegistration;
248:     }
249:     manifests.append({command.uniforms.data(), command.uniforms.size()});
250:   }
251:   PreparedProgramScalars prepared;
252:   lastRegistration = prepareProgramScalars(*brush,
253:                                            *program,
254:                                            {manifests.data(), manifests.size()},
255:                                            brush->deviceInputCtx,
256:                                            prepared);
257:   if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
258:     return lastRegistration;
259:   stats.dabs++;
260:   dabMoved_.clear();
261:   dabGrids_.clear();
262:   dabLeaves_.clear();
263:   nodePtrs_.clear();
264:   if (prepared.radius > 0 && queryDabLeaves(false, prepared.radius, origin)) {
265:     ScopedBrushWorkingValues working(*brush,
266:                                      {prepared.stages.data(), prepared.stages.size()});
267:     updateStrokeFrame(origin);
268:     brush->pushStrokeSample(origin, normal);
269:     dabSeq_++;
270:     for (size_t i = 0; i < commands.size(); i++) {
271:       if (prepared.radii[i] == 0)
272:         continue;
273:       prepared.stages[i].applyWorking(*brush);
274:       execStage(commands[i], origin, normal);
275:     }
276:     finishDab();
277:   }
278:   isFirstOfStep = false;
279:   return {};
280: }
