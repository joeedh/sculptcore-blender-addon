992:       for (auto *node : nodes) {
993:         if (elideStamp && node->baseStampGen == strokeGen &&
994:             node->baseStampOpts == stampOpts)
995:         {
996:           continue;
997:         }
998:         for (int v : node->data->unique_verts) {
999:           if (ctx.dabGen) {
1000:             ctx.dabGen->materialize(v);
1001:           }
1002:           stampBase(v);
