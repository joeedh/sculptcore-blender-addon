189:   lastRegistration = prepared.publish(*brush);
190:   if (lastRegistration.error != PropError::ERROR_NONE) {
191:     return lastRegistration;
192:   }
193:   stats.dabs++;
194:   dabMoved_.clear();
195:   dabGrids_.clear();
196:   dabLeaves_.clear();
197:   nodePtrs_.clear();
198:   if (radius > 0 && queryDabLeaves(false, radius, origin)) {
199:     updateStrokeFrame(origin);
200:     brush->pushStrokeSample(origin, normal);
201:     dabSeq_++;
202:     execStage(command, origin, normal);
203:     finishDab();
204:   }
205:   isFirstOfStep = false;
206:   return {};
