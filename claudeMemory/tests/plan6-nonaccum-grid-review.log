30: bool CommandExecutor::preflightRaw(SculptBrushes type)
31: {
32:   Brush scratch;
33:   brush_command command;
34:   if (!brush ||
35:       !createCommandSwitch<AccumLive>(
36:           type, effectiveNeighborMode() == NeighborMode::Csr, &scratch, command))
37:   {
38:     lastRegistration = {props::PropError::ERROR_NOT_EXISTS, "kernel or brush"};
39:   } else {
40:     PreparedBrushScalars prepared;
41:     lastRegistration =
42:         prepareBrushScalars(*brush,
43:                             {command.uniforms.data(), command.uniforms.size()},
44:                             brush->deviceInputCtx,
45:                             prepared,
