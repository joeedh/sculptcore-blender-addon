701: 
702:         // An override redirects this handle to the user-selected "active"
703:         // layer (by index). Honour it only when the layer exists and its type
704:         // matches the handle's declared type (the TS attribute manager already
705:         // constrains categories by type, so a mismatch means a stale index â€”
706:         // fall through to the default by-name binding rather than corrupt the
707:         // wrong-typed layer).
708:         int ovLayer = -1;
709:         for (const auto &ov : attrOverrides) {
710:           if (ov.attrIdx == ai) {
711:             ovLayer = ov.layerIndex;
712:             break;
713:           }
714:         }
715:         if (ovLayer >= 0 && ovLayer < int(grp->attrs.size()) &&
716:             grp->attrs[ovLayer].type == entry.type)
