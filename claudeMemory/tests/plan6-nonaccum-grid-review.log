484:   /** Fill `def` for `brushType` under a fixed AccumMode policy. createCommand
485:    * calls this once for AccumLive, then again for AccumOrig when non-accumulate
486:    * is active and the brush is accumulable â€” the second call overwrites def.exec
487:    * with the AccumOrig kernel while keeping the rest of the (identical) manifest. */
488:   template <class AccMode>
489:   void createCommandImpl(SculptBrushes brushType, brush_command &def)
490:   {
491:     if (createCommandSwitch<AccMode>(
492:             brushType, effectiveNeighborMode() == NeighborMode::Csr, brush, def))
493:     {
494:       return;
495:     }
496:     printf("Unknown brush type %d\n", static_cast<int>(brushType));
497:     abort();
498:   }
