101:       if (!createCommandSwitch<AccumLive>(entry.type, &scratch, commands[i]))
102:         return programError(i, {props::PropError::ERROR_NOT_EXISTS, "kernel"});
103:       if (commands[i].grabModeCapable && anchoredGrab)
