718:           // Materialize the chosen layer by its (type,name) and bind it. Copy
719:           // the name first â€” ensure() of an existing layer won't realloc, but a
720:           // local keeps the AttrRef& from dangling regardless.
721:           string nm = grp->attrs[ovLayer].name;
722:           mesh::AttrRef ref = grp->ensure(entry.type, nm, /*materialize=*/true);
723:           attrBindingStorage.items.append(BrushAttrBinding{entry.handle, ref});
724:           continue;
725:         }
726: 
727:         string layer = entry.boundName.size() ? entry.boundName : entry.handle;
728:         bool existed = grp->has(entry.type, layer);
729:         mesh::AttrRef ref = grp->ensure(entry.type, layer, /*materialize=*/true);
730:         if (!existed) {
731:           // Value-init a freshly created layer so unpainted elements are
732:           // deterministic: paint reads+writes the layer, and an uninitialized
733:           // page would make output depend on heap garbage (breaking GPU A/B +
