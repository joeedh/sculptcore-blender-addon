326: int CommandExecutor::allocateUniformQueryToken()
327: {
328:   static std::atomic<int> next{0};
329:   int current = next.load(std::memory_order_relaxed);
330:   while (current < std::numeric_limits<int>::max()) {
331:     if (next.compare_exchange_weak(current, current + 1, std::memory_order_relaxed)) {
332:       return current + 1;
333:     }
334:   }
335:   return 0;
336: }
