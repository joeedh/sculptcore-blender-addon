42:   static constexpr AccumKind kind = AccumKind::Live;
43:   template <class Ctx> static float3 neighborCo(Ctx &ctx, int nb)
44:   {
45:     return (*ctx.co_prev)[nb];
46:   }
47: };
48: 
49: /** Neighbor lookup shared by the from-base modes. Returns by value because the
50:  * base is *derived*: `co_prev[nb] - disp[nb]`, the Jacobi snapshot minus what
51:  * the brush put there. The Jacobi snapshot, not live `co`, keeps the stencil
52:  * order-independent and GPU-parity-exact. An untouched neighbor has `disp == 0`,
53:  * so an unstamped vert needs no special case beyond the generation test. */
54: struct OrigNbrBase {
55:   template <class Ctx> static float3 neighborCo(Ctx &ctx, int nb)
56:   {
57:     if (ctx.dispVec && ctx.dispGen->safe_get(nb) == int(ctx.strokeGen)) {
58:       return (*ctx.co_prev)[nb] - ctx.dispVec->safe_get(nb);
59:     }
60:     return (*ctx.co_prev)[nb];
61:   }
62: };
63: 
64: /** Non-accumulate (Blender "Accumulate off"): from-original with additive
65:  * write-back. Displacement is measured from the frozen stroke-start position and
66:  * added to the live position each dab, so the brush footprint stays pinned to the
67:  * original surface and repeated coverage sums without a height cap. */
68: struct AccumOrig : OrigNbrBase {
69:   static constexpr bool is_accum_mode = true;
70:   static constexpr bool reads_base = true;
71:   static constexpr AccumKind kind = AccumKind::Additive;
72: };
73: 
74: /** Grab-class write-back (grab / kelvinlet, all symmetry images): from-original
75:  * with per-dab first-touch arbitration. The first image to write a vert in a dab
76:  * re-bases it absolutely from orig (`live = want`, follows the cursor); later
77:  * images of the same dab add their displacement-from-orig onto it, so a shared
78:  * seam vert gets orig + Σ disp_i and the mirror side never accumulates across
79:  * dabs. See AccumKind::Grab and grabClaimFirstTouch (#35). */
80: struct AccumOrigGrab : OrigNbrBase {
81:   static constexpr bool is_accum_mode = true;
82:   static constexpr bool reads_base = true;
83:   static constexpr AccumKind kind = AccumKind::Grab;
84: };
85: 
86: struct CommandExecutor;
87: struct GridBrushExecutor;
88: /** Grab-class per-dab first-touch arbitration (AccumKind::Grab). Returns true and
89:  * stamps `ctx.curDabGen` onto vert `v` if this is the first image to write `v`
90:  * this dab (so it re-bases absolutely); returns false if `v` was already written
91:  * this dab (a later image must add). Defined inline in brush_executor.h (mesh)
92:  * and grid_executor.h (grids), overloaded on the executor type. Always true
93:  * when the dab-gen stamp is absent (single-image strokes). */
94: bool grabClaimFirstTouch(const CommandExecutor &exec, int v);
95: bool grabClaimFirstTouch(const GridBrushExecutor &exec, int v);
96: 
97: /** Read-base / write-live proxy standing in for a vertex's `v.co` inside a
98:  * generated kernel. Under AccumOrig, reads return the base position until the
99:  * first write; a write computes from that base and latches to live, so
100:  * subsequent reads in the same kernel see the new value. Under AccumLive it is
101:  * a thin reference to the live position. The explicit LHS arithmetic operators
102:  * are required because litestl's Vec arithmetic operators are members (so
103:  * `proxy - float3` would otherwise need an implicit conversion the compiler
104:  * won't chain through the member operator).
105:  *
106:  * `base` is held **by value**: on the displacement path it is derived
107:  * (`co - disp`), not stored, so there is no pointer to hold. Caching it across
108:  * the dab is exact rather than approximate — every write moves `live` and
109:  * `disp` by the same delta, so their difference is invariant.
110:  *
111:  * The write-back depends on AccMode::kind (see AccumKind). Additive (AccumOrig)
112:  * matches Blender's "Accumulate off": the dab's displacement (`want - base`) is
113:  * added to the live position, so the footprint stays pinned to the base surface
114:  * and repeated coverage sums with no height cap. Grab (AccumOrigGrab) writes
115:  * `live = want` on the first image to touch a vert this dab (re-base, follows
116:  * the cursor) and `live += want - base` on later images of the same dab
117:  * (symmetry summation), arbitrated by grabClaimFirstTouch. Mirrored in WGSL by
118:  * emit_wgsl.cc's write-back.
119:  *
120:  * When `disp` is set (the displacement path), the same delta that moves `live`
121:  * is accumulated into it — the §2 invariant: whoever moves a vertex as brush
122:  * displacement adds the same delta to `disp`. */
123: template <class AccMode, class Exec = CommandExecutor> struct CoProxy {
124:   float3 &live;
125:   float3 base;
126:   const Exec *exec = nullptr;
127:   mesh::AttrData<float3> *disp = nullptr;
128:   int v = -1;
129:   bool written = false;
130: 
131:   float3 cur() const
132:   {
133:     return (AccMode::reads_base && !written) ? base : live;
134:   }
135:   operator float3() const
136:   {
137:     return cur();
138:   }
139: 
140:   void commit(const float3 &want)
141:   {
142:     if constexpr (AccMode::kind == AccumKind::Grab) {
143:       // First image to write this vert this dab re-bases it (follows the
144:       // cursor); a later image of the same dab adds its displacement-from-base
145:       // (`want - base`, cur() returns base pre-write) so seam verts sum. The
146:       // re-base is written as a delta so `disp` stays in step with `live`;
147:       // first-touch must be `want - live` (not `want - base`) because the
148:       // kernel's `want` already carries the whole cumulative drag from the base.
149:       float3 d = (exec && grabClaimFirstTouch(*exec, v)) ? want - live : want - base;
150:       live += d;
151:       if (disp) {
152:         (*disp)[v] += d;
153:       }
154:     } else if constexpr (AccMode::kind == AccumKind::Additive) {
155:       // Blender "Accumulate off": add the dab's displacement, measured from the
156:       // base (`want - base`, since cur() returns base until the first write), to
157:       // the live position. The footprint stays pinned to the base surface;
158:       // repeated coverage sums with no height cap. A no-write kernel path leaves
159:       // want == base, so the added delta is zero.
160:       float3 d = want - base;
161:       live += d;
162:       if (disp) {
163:         (*disp)[v] += d;
164:       }
165:     } else {
166:       // Live: write the wanted position directly.
167:       live = want;
168:     }
169:     written = true;
170:   }
171: 
172:   CoProxy &operator=(const float3 &r)
173:   {
174:     commit(r);
175:     return *this;
176:   }
177:   CoProxy &operator+=(const float3 &r)
178:   {
179:     commit(cur() + r);
180:     return *this;
181:   }
182:   CoProxy &operator-=(const float3 &r)
183:   {
184:     commit(cur() - r);
185:     return *this;
186:   }
187: 
188:   float3 operator+(const float3 &r) const
189:   {
190:     return cur() + r;
191:   }
192:   float3 operator-(const float3 &r) const
193:   {
194:     return cur() - r;
195:   }
196:   float3 operator*(const float3 &r) const
197:   {
198:     return cur() * r;
199:   }
200:   float3 operator/(const float3 &r) const
201:   {
202:     return cur() / r;
203:   }
204:   float3 operator*(float r) const
205:   {
206:     return cur() * r;
207:   }
208:   float3 operator/(float r) const
209:   {
210:     return cur() / r;
211:   }
212: };
