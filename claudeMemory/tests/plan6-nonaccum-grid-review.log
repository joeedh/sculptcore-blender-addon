1004:         if (ctx.origNo) {
1005:           for (const auto &tri : node->data->skirt_tris) {
1006:             for (int k = 0; k < 3; k++) {
1007:               stampBase(m->c.v[tri.c[k]]);
1008:             }
1009:           }
