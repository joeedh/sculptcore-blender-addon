39: bool GridBrushExecutor::resolvedCapability(const brush_command &command,
40:                                            SculptBrushes type) const
41: {
42:   return !(
43:       nonAccum || (anchoredGrab && command.grabModeCapable) || command.unbounded ||
44:       !resolvedAttributesSupported(
45:           {command.attrs.size() ? &command.attrs[0] : nullptr, command.attrs.size()}) ||
46:       command.faceMode || command.writesMask || command.needsOrigNormals ||
47:       command.execHost || !command.preparedScalarSafe ||
48:       !preparedHooksSupported(type, true) || attrMirrors_.items.size() ||
49:       brush->automask_cavity || attachedMultires_->editTarget() != -1 ||
50:       attachedMultires_->writebackChannel() != 0 || !resolvedFalloffSupported(*brush));
51: }
