457:   /** Type-dispatch half of createCommandImpl, stateless so `queryBrushFlags` can
458:    * reach a kernel's manifest without a live stroke. `brushOrNull` is only used
459:    * by the extra-kernel registry (uniform defaults); a null one just means extra
460:    * kernels report unhandled. Returns false when `brushType` matched nothing.
461:    *
462:    * Both halves are generated: the built-ins from the kernels' @tool annotations
463:    * (brushes/generated/builtin_brushes.gen.h, graded by tests/test_brush_registry.cc)
464:    * and the extras from the configured extra-kernel dirs. Adding a brush touches
465:    * neither this function nor any other host conditional. */
466:   template <class AccMode>
467:   static bool createCommandSwitch(SculptBrushes brushType,
468:                                   bool csrNeighbors,
469:                                   Brush *brushOrNull,
470:                                   brush_command &def)
471:   {
472:     if (command::createBuiltinBrush<CommandExecutor, CsrNbr, LiveDiskNbr, AccMode>(
473:             int(brushType), csrNeighbors, def))
474:     {
475:       return true;
476:     }
477:     // Extra (out-of-repo) kernels dispatch through the generated registry;
478:     // a no-op fallback compiles in when no extra kernel dirs are configured.
479:     return brushOrNull &&
480:            command::createExtraBrush<CommandExecutor, CsrNbr, LiveDiskNbr, AccMode>(
481:                int(brushType), csrNeighbors, *brushOrNull, def);
482:   }
