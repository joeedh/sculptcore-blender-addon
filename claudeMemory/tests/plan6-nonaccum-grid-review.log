220: props::ScalarRegistrationResult CommandExecutor::applyResolvedProgram(
221:     BrushProgram *program, float3 center, float3 normal, bool validateOnly)
222: {
223:   using props::PropError;
224:   auto fail = [&](PropError error, const char *name) {
225:     lastRegistration = {error, name};
226:     return lastRegistration;
227:   };
228:   if (!program || !brush || !tree || !tree->m || !tree->getRoot())
229:     return fail(PropError::ERROR_INVALID_OWNER, "program or mesh");
230:   for (int axis = 0; axis < 3; axis++)
231:     if (!std::isfinite(center[axis]) || !std::isfinite(normal[axis]))
232:       return fail(PropError::ERROR_INVALID_VALUE, "dab frame");
233:   if (!program->commands.size()) {
234:     PreparedBrushScalars empty;
235:     lastRegistration = prepareBrushScalars(*brush, {}, brush->deviceInputCtx, empty);
236:     if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
237:       return lastRegistration;
238:     lastRegistration = {};
239:     dabNodes_.clear();
240:     lastDabNodeCount = 0;
241:     clearIsFirstOfStep();
242:     return {};
243:   }
244:   Vector<brush_command> commands;
245:   commands.resize(program->commands.size());
246:   Vector<std::span<const BrushUniformManifestEntry>> manifests;
247:   bool needsLive = keepTopoThawed;
248:   for (size_t i = 0; i < program->commands.size(); i++) {
249:     const auto &entry = program->commands[i];
250:     Brush scratch;
251:     auto &command = commands[i];
252:     if (!createCommandSwitch<AccumLive>(
253:             entry.type, effectiveNeighborMode() == NeighborMode::Csr, &scratch, command))
254:     {
255:       lastRegistration = programError(i, {PropError::ERROR_NOT_EXISTS, "kernel"});
256:       return lastRegistration;
257:     }
258:     if (entry.attrLayerOverrides.size() ||
259:         !resolvedCapability(*this, command, entry.type))
260:     {
261:       lastRegistration = programError(
262:           i, {PropError::ERROR_INVALID_VALUE, "unsupported resolved capability"});
263:       return lastRegistration;
264:     }
265:     needsLive |= brushNeedsLiveLinks(entry.type);
266:     manifests.append({command.uniforms.data(), command.uniforms.size()});
267:   }
268:   PreparedProgramScalars prepared;
269:   lastRegistration = prepareProgramScalars(*brush,
270:                                            *program,
271:                                            {manifests.data(), manifests.size()},
272:                                            brush->deviceInputCtx,
273:                                            prepared);
274:   if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
275:     return lastRegistration;
276:   dabNodes_.clear();
277:   if (prepared.radius > 0)
278:     tree->filterNodes(center, prepared.radius, dabNodes_);
279:   lastDabNodeCount = int(dabNodes_.size());
280:   if (dabNodes_.size()) {
281:     ScopedBrushWorkingValues working(*brush,
282:                                      {prepared.stages.data(), prepared.stages.size()});
283:     auto *mesh = tree->m;
284:     Vector<BrushHookFn> completed;
285:     BrushHookCtx hc{*this, mesh, &dabNodes_, brush, isFirstOfStep};
286:     for (size_t i = 0; i < program->commands.size(); i++) {
287:       const auto *hooks = brushHooksFor(program->commands[i].type);
288:       if (!prepared.radii[i] || !hooks || !hooks->stepPreFreeze)
289:         continue;
290:       bool seen = false;
291:       for (auto fn : completed)
292:         seen |= fn == hooks->stepPreFreeze;
293:       if (!seen) {
294:         hooks->stepPreFreeze(hc);
295:         completed.append(hooks->stepPreFreeze);
296:       }
297:     }
298:     if (needsLive) {
299:       if (mesh->topo_frozen)
300:         mesh->thawTopo();
301:     } else if (!mesh->topo_frozen) {
302:       mesh->freezeTopo();
303:     }
304:     ctx.m = mesh;
305:     ctx.surfaceNo = normal;
306:     ctx.surfacePos = center;
307:     ctx.meshLog = meshLog;
308:     ctx.isFirstOfStep = isFirstOfStep;
309:     updateStrokeFrame(center);
310:     brush->pushStrokeSample(center, normal);
311:     for (size_t i = 0; i < commands.size(); i++) {
312:       if (prepared.radii[i] == 0)
313:         continue;
314:       prepared.stages[i].applyWorking(*brush);
315:       curCaptureSlot = int(i);
316:       curCaptureTool = int(program->commands[i].type);
317:       exec(commands[i], {dabNodes_.data(), dabNodes_.size()});
318:     }
319:     curCaptureSlot = -1;
320:     tree->updateQueries();
321:   }
322:   clearIsFirstOfStep();
323:   return {};
324: }
