3: """Authoritative native numeric settings; no engine loading or shadow values."""
4: from dataclasses import dataclass
5: from types import MappingProxyType
6: 
7: from .lifecycle import OwnerGuard
8: from .native import STRENGTH, STRENGTH_DEFINITION
9: from .native_v0 import ROWS
10: from .registry import Definition, Position, PropertyError, NativeCurveReference, scalar
11: from .resolver import Capability, ValueSource
12: 
13: SIZE = 'sculptcore.brush.size'
14: PIXELS = SIZE + '_pixels'
15: WORLD = SIZE + '_world'
16: SIZE_ALIASES = (PIXELS, WORLD)
17: CAVITY = 'sculptcore.brush.cavity'
18: SIZE_DEFINITION = Definition(SIZE, "Size", 'FLOAT32', 70.0, .0010000000474974513,
19:                              3.4028234663852886e38, 1.0, 1000.0,
20:                              "Native brush diameter in the selected size mode",
21:                              positions=(Position('VIEW3D_HEADER', 10), Position('BRUSH_SETTINGS', 10)))
22: DEFINITIONS = (STRENGTH_DEFINITION, SIZE_DEFINITION) + tuple(
23:     Definition(identifier, path.rsplit('.', 1)[-1].replace('_', ' ').title(), kind, default,
24:                minimum, maximum, soft_min, soft_max, description, dynamic=dynamic,
25:                positions=(Position('BRUSH_SETTINGS', 30 + index),))
26:     for index, (identifier, path, kind, default, minimum, maximum, soft_min, soft_max,
27:                 description, dynamic) in enumerate(ROWS))
28: BY_ID = MappingProxyType({definition.identifier: definition for definition in DEFINITIONS})
29: PATHS = MappingProxyType({row[0]: row[1] for row in ROWS} | {STRENGTH: 'strength'})
30: 
31: 
32: def policy_identifier(identifier):
33:     if identifier in SIZE_ALIASES:
34:         return SIZE
35:     if identifier.startswith(CAVITY + '.'):
36:         return CAVITY + '.cavity_factor'
37:     return identifier
