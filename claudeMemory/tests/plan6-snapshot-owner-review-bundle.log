69: def record_key(identifier):
70:     digest = hashlib.sha256(identifier.encode('utf-8')).digest()
71:     return 'p_' + base64.b32encode(digest).decode('ascii').rstrip('=').lower()
72: 
73: 
74: def _group(value):
75:     from idprop.types import IDPropertyGroup
76:     return isinstance(value, IDPropertyGroup)
