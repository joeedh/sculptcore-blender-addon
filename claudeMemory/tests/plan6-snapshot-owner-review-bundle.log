40: @dataclass(frozen=True)
41: class ValueDomain:
42:     kind: str
43:     minimum: float
44:     maximum: float
45:     soft_minimum: float
46:     soft_maximum: float
47:     unit: str
48:     path: str
49: 
50:     def validate(self, value):
51:         # The common semantic size may arrive as an exactly integral FLOAT32.
52:         if self.kind == 'INT32' and type(value) is float and value.is_integer():
53:             value = int(value)
54:         converted = scalar(self.kind, value)
55:         if not self.minimum <= value <= self.maximum or not self.minimum <= converted <= self.maximum:
56:             raise PropertyError("Value is outside the current native domain")
57:         return converted
58: 
59: 
60: @dataclass(frozen=True)
61: class SizeBlock:
62:     pixels: int
63:     world: float
64:     mode: str
65:     owner_identity: tuple
66: 
67: 
68: class NativeOwner:
69:     def __init__(self, owner, *, epoch=0):
70:         self._guard = OwnerGuard(owner, epoch=epoch)
71:         self.owner = owner
72:         self.kind = self._guard.kind
73: 
74:     def handles(self, identifier):
75:         self._guard.check()
76:         return (identifier in BY_ID and
77:                 (self.kind == 'BRUSH' or identifier in (STRENGTH, SIZE, *SIZE_ALIASES)
78:                  or identifier.startswith(CAVITY + '.')))
79: 
80:     def settings(self):
81:         self._guard.check()
82:         if self.kind == 'BRUSH':
83:             return self.owner
84:         sculpt = self.owner.tool_settings.sculpt
85:         return sculpt.unified_paint_settings if sculpt is not None else None
86: 
87:     def cavity(self):
88:         self._guard.check()
89:         parent = self.owner if self.kind == 'BRUSH' else self.owner.tool_settings.sculpt
90:         return parent.mesh_automasking_settings if parent is not None else None
91: 
92:     def binding(self, identifier):
93:         if not self.handles(identifier):
94:             raise PropertyError("No authoritative native value binding")
95:         if identifier.startswith(CAVITY + '.'):
96:             parent, path = self.cavity(), PATHS[identifier].split('.', 1)[1]
97:         else:
98:             parent = self.settings() if identifier in (STRENGTH, SIZE, *SIZE_ALIASES) else self.owner
99:             path = ('unprojected_size' if parent and parent.use_locked_size == 'SCENE' else 'size'
100:                     ) if identifier == SIZE else PATHS[identifier]
101:         if parent is None:
102:             raise PropertyError("Native settings are unavailable")
103:         return parent, path
104: 
105:     def capability(self, definition):
106:         try:
107:             self.binding(definition.identifier)
108:         except PropertyError:
109:             return Capability(False, False, False, 'native_owner_unavailable')
110:         return Capability(True, definition.identifier not in SIZE_ALIASES, False,
111:                           'generic_execution_adapter_pending')
112: 
113:     def value_domain(self, definition):
114:         parent, path = self.binding(definition.identifier)
115:         prop = parent.bl_rna.properties[path]
116:         kind = {'FLOAT': 'FLOAT32', 'INT': 'INT32', 'BOOLEAN': 'BOOL'}[prop.type]
117:         if kind == 'BOOL':
118:             return ValueDomain(kind, 0, 1, 0, 1, 'NONE', path)
119:         return ValueDomain(kind, prop.hard_min, prop.hard_max, prop.soft_min, prop.soft_max, prop.unit, path)
120: 
121:     def read_value(self, definition):
122:         parent, path = self.binding(definition.identifier)
123:         return ValueSource(getattr(parent, path), True, 'NATIVE')
124: 
125:     def validate_value(self, definition, value):
126:         # Frozen registry validation remains fixed; native bounds further constrain it.
127:         value = definition.validate(value)
128:         return self.value_domain(definition).validate(value)
129: 
130:     def write_value(self, definition, value):
131:         self._guard.check(write=True)
132:         value = self.validate_value(definition, value)
133:         parent, path = self.binding(definition.identifier)
134:         if getattr(parent, path) == value:
135:             return
136:         if definition.identifier in (SIZE, *SIZE_ALIASES):
137:             pixels, world = parent.size, parent.unprojected_size
138:             if path == 'size':
139:                 world = scalar('FLOAT32', world * scalar('FLOAT32', value / pixels))
140:                 pixels = value
141:             else:
142:                 world = value
143:             # Blender's pixel setter rescales its world partner without clamping.
144:             for name, paired in (('size', pixels), ('unprojected_size', world)):
145:                 prop = parent.bl_rna.properties[name]
146:                 if not prop.hard_min <= paired <= prop.hard_max:
147:                     raise PropertyError("Size edit would put the paired native value outside its range")
148:         setattr(parent, path, value)
149: 
150:     def size_block(self):
151:         parent = self.settings()
152:         if parent is None:
153:             raise PropertyError("Native size settings are unavailable")
154:         return SizeBlock(parent.size, parent.unprojected_size, parent.use_locked_size, self._guard.identity)
155: 
156:     def write_size_mode(self, mode):
157:         self._guard.check(write=True)
158:         if mode not in ('VIEW', 'SCENE'):
159:             raise PropertyError("Unknown native size mode")
160:         parent = self.settings()
161:         if parent is None:
162:             raise PropertyError("Native size settings are unavailable")
163:         if parent.use_locked_size != mode:
164:             parent.use_locked_size = mode
165: 
166:     def unified(self, identifier):
167:         parent = self.settings()
168:         if self.kind != 'SCENE' or parent is None:
169:             return False
170:         return getattr(parent, 'use_unified_size' if policy_identifier(identifier) == SIZE
171:                        else 'use_unified_strength')
172: 
173:     def write_unified(self, identifier, enabled):
174:         self._guard.check(write=True)
175:         if self.kind != 'SCENE' or type(enabled) is not bool:
176:             raise PropertyError("Unified native flags belong to Scene")
177:         parent = self.settings()
178:         if parent is None:
179:             raise PropertyError("Native unified settings are unavailable")
180:         path = 'use_unified_size' if policy_identifier(identifier) == SIZE else 'use_unified_strength'
181:         if getattr(parent, path) != enabled:
182:             setattr(parent, path, enabled)
183: 
184:     def pressure_path(self, identifier):
185:         self._guard.check()
186:         if self.kind != 'BRUSH' or identifier not in (STRENGTH, SIZE):
187:             raise PropertyError("Native pressure belongs to Brush strength/size")
188:         suffix = 'strength' if identifier == STRENGTH else 'size'
189:         supported = getattr(self.owner.sculpt_capabilities, 'has_' + suffix + '_pressure')
190:         path = ('use_pressure_' if supported else 'sculptcore_use_pressure_') + suffix
191:         if not hasattr(self.owner, path):
192:             raise PropertyError("Native/shadow pressure capability is unavailable")
193:         return path
