296:     def _publish(self, definition, field, value, ui=None):
297:         return self._publish_fields(definition, (((field,), value, ui),))
298: 
299:     def _publish_fields(self, definition, fields, *, delete_paths=()):
300:         self._write_allowed()
301:         self._checked_definition(definition)
302:         prefix = ('records', record_key(definition.identifier))
303:         operations = (
304:             ('SET', ('schema_version',), SCHEMA_VERSION, None),
305:             ('SET', (*prefix, 'identifier'), definition.identifier, None),
306:             ('SET', (*prefix, 'scalar_type'), definition.scalar_type, None),
307:         ) + tuple(('SET', (*prefix, *path), value, ui) for path, value, ui in fields)
308:         operations += tuple(('DELETE', (*prefix, *path)) for path in delete_paths)
309:         try:
310:             return self.owner.id_properties_update_atomic(ROOT, operations)
311:         except (ValueError, TypeError, OverflowError, PermissionError) as error:
312:             raise PropertyError(str(error)) from error
313: 
314:     def read_positions(self, definition):
315:         """Local placement override, independent of resolved value/stack owners."""
316:         record = self._checked_definition(definition)
317:         if not _positions_header(record, reading=True):
318:             return definition.positions
319:         encoded = record['positions_order']
320:         if type(encoded) is not str or len(encoded) > 16384:
321:             raise PropertyError("Malformed positions order")
322:         try:
323:             keys = json.loads(encoded)
324:         except (ValueError, RecursionError):
325:             raise PropertyError("Malformed positions order JSON") from None
326:         if (type(keys) is not list or len(keys) > 128
327:                 or any(type(key) is not str or not re.fullmatch(r'p_[a-z2-7]{52}', key) for key in keys)
328:                 or len(set(keys)) != len(keys)):
329:             raise PropertyError("Malformed or duplicate position keys")
330:         entries = record.get('positions')
331:         if keys and entries is None:
332:             raise PropertyError("Missing positions group")
333:         result = []
334:         for key in keys:
335:             entry = entries.get(key)
336:             if not _group(entry):
337:                 raise PropertyError("Malformed active position")
338:             position = Position(entry.get('location'), entry.get('sort_index'))
339:             if record_key(position.location) != key:
340:                 raise PropertyError("Position key and location disagree")
341:             result.append(position)
342:         return validated_positions(result)
343: 
344:     def write_positions(self, definition, positions):
345:         self._write_allowed()
346:         positions = validated_positions(positions)
347:         record = self._checked_definition(definition)
348:         _positions_header(record, reading=False)
349:         entries = record.get('positions') if record is not None else None
350:         keys = [record_key(position.location) for position in positions]
351:         fields = [(('positions_version',), POSITIONS_VERSION, None),
352:                   (('positions_order',), json.dumps(keys, separators=(',', ':')), None)]
353:         for key, position in zip(keys, positions):
354:             if entries is not None and key in entries:
355:                 entry = entries[key]
356:                 if not _group(entry) or entry.get('location') != position.location:
357:                     raise PropertyError("Existing position identity is malformed or collides")
358:             fields.extend(((('positions', key, 'location'), position.location, None),
359:                            (('positions', key, 'sort_index'), position.sort_index, None)))
360:         self._publish_fields(definition, fields)
361: 
362:     def reset_positions(self, definition):
363:         """Remove only override headers; preserve dormant location metadata."""
364:         self._write_allowed()
365:         record = self._checked_definition(definition)
366:         if not _positions_header(record, reading=False):
367:             return
368:         self._publish_fields(definition, (), delete_paths=(('positions_version',), ('positions_order',)))
369: 
370:     def write_value(self, definition, value):
371:         self._write_allowed()
372:         self._checked_definition(definition)
373:         if self._native.handles(definition.identifier):
374:             self._native.write_value(definition, value)
375:             return
376:         value = definition.validate(value)
377:         self._publish(definition, 'value', value, value_metadata(definition))
