379:     def write_stack(self, definition, layers):
380:         self._write_allowed()
381:         if definition.identifier in SIZE_ALIASES:
382:             raise PropertyError("Size representations share the common size stack")
383:         native_pressure = self._has_native_pressure(definition)
384:         layers = validated_stack(layers)
385:         if layers and not definition.dynamic:
386:             raise PropertyError("Static definitions cannot carry a device stack")
387:         fields = [(("stack_version",), STACK_VERSION, None),
388:                   (("layer_order",), ','.join(layer.device for layer in layers), None)]
389:         for layer in layers:
390:             # Revalidate descriptors before building the complete transaction.
391:             if type(layer.curve) is NativeCurveReference:
392:                 if not native_pressure or layer.device != 'PRESSURE':
393:                     raise PropertyError("Native pressure curve targets the wrong property/device")
394:                 self._native.curve_mapping(layer.curve)
395:                 if layer.curve.identifier != definition.identifier:
396:                     raise PropertyError("Native mapping belongs to another property")
397:                 curve, preset, parameters = layer.curve, 'CUSTOM', ()
398:             elif type(layer.curve) is CustomCurveReference:
399:                 if native_pressure and layer.device == 'PRESSURE':
400:                     raise PropertyError("Brush pressure uses its authoritative native curve")
401:                 self._curve_bank().mapping(self, definition, layer.curve)
402:                 if layer.curve.device != layer.device:
403:                     raise PropertyError("Custom mapping device differs from its layer")
404:                 curve, preset, parameters = layer.curve, 'CUSTOM', ()
405:             else:
406:                 curve = ResponseCurve(layer.curve.preset, layer.curve.parameters)
407:                 preset, parameters = curve.preset, tuple(float(value) for value in curve.parameters)
408:             layer = DeviceLayer(layer.device, layer.enabled, layer.operation, layer.factor, curve)
409:             values = dict(enabled=layer.enabled, operation=layer.operation, factor=float(layer.factor),
410:                           preset=preset)
