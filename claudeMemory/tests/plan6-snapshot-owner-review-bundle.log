88:     def check(self, *, write=False):
89:         _main_thread()
90:         if not _registered or self._generation != _generation:
91:             raise PropertyError("Brush property owner handle is stale; resolve it again")
92:         import bpy
93:         try:
94:             owner = self.owner
95:             if _restoration_revision(owner) != self._restoration:
96:                 raise PropertyError("Brush property owner was restored; resolve it again")
97:             if int(owner.session_uid) != self._uid or owner.is_evaluated:
98:                 raise PropertyError("Brush property owner is not the original live ID")
99:             owners = bpy.data.brushes if self.kind == 'BRUSH' else bpy.data.scenes
100:             if not any(candidate == owner for candidate in owners):
101:                 raise PropertyError("Brush property owner is not in the current Main")
102:             editable = owner.is_editable and owner.override_library is None
103:             if write and not editable:
104:                 raise PropertyError("Brush property owner is read-only or an unsupported override")
105:             return editable
106:         except (ReferenceError, AttributeError) as error:
107:             raise PropertyError("Brush property owner is no longer available") from error
