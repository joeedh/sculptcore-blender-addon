41: @dataclass(frozen=True)
42: class SampleConfig:
43:     count: int = 256
44:     reverse: bool = False
45:     clamp_output: bool = False
46:     hardness: float = 0.0
47: 
48:     def __post_init__(self):
49:         if (type(self.count) is not int or not 2 <= self.count <= 65536
50:                 or type(self.reverse) is not bool or type(self.clamp_output) is not bool
51:                 or not finite(self.hardness) or not 0 <= self.hardness <= 1):
52:             raise PropertyError("Invalid response sampling configuration")
53: 
54: 
55: @dataclass(frozen=True)
56: class PreparedResponse:
57:     """TABLE samples or an analytic CONSTANT/TWO_STEP; no saved mapping or owner."""
58:     kind: str
59:     samples: tuple = ()
60:     parameters: tuple = ()
61: 
62:     def __post_init__(self):
63:         if type(self.samples) is not tuple or type(self.parameters) is not tuple:
64:             raise PropertyError("Prepared responses must be immutable")
65:         if self.kind == 'TABLE':
66:             if self.parameters or not 2 <= len(self.samples) <= 65536:
67:                 raise PropertyError("Invalid response table")
68:             for value in self.samples:
69:                 if scalar('FLOAT32', value) != value:
70:                     raise PropertyError("Response samples must be float32")
71:         elif self.kind in ('CONSTANT', 'TWO_STEP') and not self.samples:
72:             ResponseCurve(self.kind, self.parameters)
73:         else:
74:             raise PropertyError("Invalid prepared response")
75: 
76:     def evaluate(self, x):
77:         if not finite(x):
78:             raise PropertyError("Expected finite response input")
79:         if self.kind != 'TABLE':
80:             return evaluate(ResponseCurve(self.kind, self.parameters), x)
81:         x = min(1.0, max(0.0, x)) * (len(self.samples) - 1)
82:         index = min(int(x), len(self.samples) - 2)
83:         factor = x - index
84:         return self.samples[index] * (1.0 - factor) + self.samples[index + 1] * factor
85: 
86: 
87: def sample(function, config):
88:     """Bake at synchronization time; preserve legacy falloff hardness ordering."""
89:     if type(config) is not SampleConfig:
90:         raise PropertyError("Expected a sampling configuration")
91:     values = []
92:     for index in range(config.count):
93:         x = index / (config.count - 1)
94:         distance = 1.0 - x
95:         if config.hardness == 1:
96:             value = 1.0 if distance < 1 else 0.0
97:         elif config.hardness > 0 and distance < config.hardness:
98:             value = 1.0
99:         else:
100:             if config.hardness:
101:                 x = 1.0 - (distance - config.hardness) / (1.0 - config.hardness)
102:             value = function(1.0 - x if config.reverse else x)
103:         if not finite(value):
104:             raise PropertyError("Curve produced a nonfinite sample")
105:         if config.clamp_output:
106:             value = min(1.0, max(0.0, value))
107:         values.append(scalar('FLOAT32', value))
108:     return tuple(values)
