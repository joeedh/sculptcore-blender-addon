20: class ResponseCache:
21:     def __init__(self, capacity=256):
22:         if type(capacity) is not int or not 1 <= capacity <= 256:
23:             raise PropertyError("Response cache capacity must be 1..256")
24:         self.capacity = capacity
25:         self.sources = OrderedDict()
26:         self.contents = OrderedDict()
27:         self.identities = {}
28:         self._next = itertools.count(1)
29:         self.bakes = 0
30:         self.hits = 0
31: 
32:     def clear(self):
33:         self.sources.clear()
34:         self.contents.clear()
35:         self.identities.clear()
36: 
37:     def get(self, source):
38:         identity = self.sources.get(source)
39:         key = self.identities.get(identity)
40:         if key is None:
41:             self.sources.pop(source, None)
42:             return None
43:         self.sources.move_to_end(source)
44:         self.contents.move_to_end(key)
45:         self.hits += 1
46:         return self.contents[key][1]
47: 
48:     def put(self, source, response, config):
49:         # Full equality authorizes interning; Python's hash only accelerates lookup.
50:         key = (config, response)
51:         present = self.contents.get(key)
52:         if present is None:
53:             identity = next(self._next)
54:             self.contents[key] = identity, response
55:             self.identities[identity] = key
56:         else:
57:             identity, response = present
58:             self.contents.move_to_end(key)
59:         self.sources[source] = identity
60:         self.sources.move_to_end(source)
61:         while len(self.sources) > self.capacity:
62:             self.sources.popitem(last=False)
63:         while len(self.contents) > self.capacity:
64:             _, (old, _) = self.contents.popitem(last=False)
65:             del self.identities[old]
66:         return response
67: 
68:     def generated(self, curve, config=SampleConfig()):
69:         if type(curve) is not ResponseCurve or type(config) is not SampleConfig:
70:             raise PropertyError("Expected a generated response")
71:         curve = ResponseCurve(curve.preset, curve.parameters)
72:         source = ('GENERATED', curve, config)
73:         cached = self.get(source)
74:         if cached is not None:
75:             return cached
76:         if curve.preset in ('CONSTANT', 'TWO_STEP'):
77:             if config.reverse or config.clamp_output or config.hardness:
78:                 raise PropertyError("Analytic device responses require the canonical input domain")
79:             result = PreparedResponse(curve.preset, parameters=curve.parameters)
80:         else:
81:             result = PreparedResponse('TABLE', sample(lambda x: evaluate(curve, x), config))
82:             self.bakes += 1
83:         return self.put(source, result, config)
84: 
85:     def mapping(self, source, mapping, config=SampleConfig(), *, native_key=None):
86:         """Caller must validate the current owner/revision before every invocation."""
87:         if type(config) is not SampleConfig:
88:             raise PropertyError("Expected a sampling configuration")
89:         key = ('MAPPING', source, config)
90:         cached = self.get(key)
91:         if cached is not None:
92:             return cached
93:         # Native keys include hidden evaluation flags (e.g. wrapping); owned v1
94:         # forbids those flags and exposes all editable evaluation fields below.
95:         canonical = (('NATIVE_DEFINITION', native_key, config) if native_key is not None
96:                      else ('OWNED_DEFINITION', canonical_mapping(mapping), config))
97:         cached = self.get(canonical)
98:         if cached is not None:
99:             return self.put(key, cached, config)
100:         mapping.update()
101:         channel = mapping.curves[0]
102:         values = sample(lambda x: mapping.evaluate(channel, x), config)
103:         self.bakes += 1
104:         response = self.put(canonical, PreparedResponse('TABLE', values), config)
105:         return self.put(key, response, config)
