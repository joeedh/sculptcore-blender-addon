166: def resolve_commands(commands, brush):
167:     """Flatten a DAG in execution order; missing parent IDs use target defaults.
168: 
169:     Every eligible property carries an explicit stack, including empty. No RNA,
170:     owner stores, inheritance flags, or mutable containers survive in the result.
171:     """
172:     commands, brush = tuple(commands), tuple(brush)
173:     if any(type(command) is not Command for command in commands):
174:         raise PropertyError("Expected immutable commands")
175:     if any(type(item) is not ExecutionValue for item in brush):
176:         raise PropertyError("Expected an owner-free brush snapshot")
177:     by_name = {command.name: command for command in commands}
178:     brush_values = {item.definition.identifier: item for item in brush}
179:     if len(by_name) != len(commands) or len(brush_values) != len(brush):
180:         raise PropertyError("Duplicate command or brush property")
181:     resolved = {}
182:     visiting = set()
183: 
184:     def visit(command):
185:         if command.name in resolved:
186:             return resolved[command.name]
187:         if command.name in visiting:
188:             raise PropertyError("Command inheritance cycle: " + command.name)
189:         visiting.add(command.name)
190:         if command.parent.kind == 'COMMAND':
191:             if command.parent.name not in by_name:
192:                 raise PropertyError("Missing parent command: " + command.parent.name)
193:             parent = {item.definition.identifier: item for item in visit(by_name[command.parent.name]).properties}
194:         else:
195:             parent = brush_values if command.parent.kind == 'BRUSH' else {}
196:         values, stacks = dict(command.values), dict(command.stacks)
197:         properties = []
198:         for definition in command.definitions:
199:             identifier = definition.identifier
200:             inherited = parent.get(identifier)
201:             if inherited is not None and inherited.definition != definition:
202:                 raise PropertyError("Incompatible execution definition: " + identifier)
203:             value = values.get(identifier, inherited.value if inherited is not None else definition.default)
204:             stack = stacks.get(identifier, inherited.stack if inherited is not None else ())
205:             properties.append(ExecutionValue(definition, value, stack))
206:         result = ResolvedCommand(command.name, command.kernel, tuple(properties))
207:         visiting.remove(command.name)
208:         resolved[command.name] = result
209:         return result
210: 
211:     # Iterative ancestry walk avoids Python recursion limits for valid long chains.
212:     for command in commands:
213:         chain, seen, current = [], set(), command
214:         while current.name not in resolved:
215:             if current.name in seen:
216:                 raise PropertyError("Command inheritance cycle: " + current.name)
217:             seen.add(current.name)
218:             chain.append(current)
219:             if current.parent.kind != 'COMMAND':
220:                 break
221:             if current.parent.name not in by_name:
222:                 raise PropertyError("Missing parent command: " + current.parent.name)
223:             current = by_name[current.parent.name]
224:         for entry in reversed(chain):
225:             visit(entry)
226:     return tuple(resolved[command.name] for command in commands)
227: 
