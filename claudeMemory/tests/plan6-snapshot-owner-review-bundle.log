3: """Canonical generated responses and immutable engine-ready response descriptions."""
4: from dataclasses import dataclass
5: import math
6: 
7: from .registry import PropertyError, ResponseCurve, finite, scalar
8: 
9: 
10: def evaluate(curve, x):
11:     """Evaluate the frozen response formulas on normalized device input."""
12:     if type(curve) is not ResponseCurve or not finite(x):
13:         raise PropertyError("Expected a generated response and finite input")
14:     curve = ResponseCurve(curve.preset, curve.parameters)
15:     x = min(1.0, max(0.0, x))
16:     name, parameters = curve.preset, curve.parameters
17:     if name == 'CONSTANT':
18:         return parameters[0]
19:     if name == 'TWO_STEP':
20:         threshold, low, high = parameters
21:         return low if x < threshold else high
22:     if name == 'LINEAR':
23:         return x
24:     if name == 'ROOT':
25:         return math.sqrt(x)
26:     if name == 'SQUARE':
27:         return x * x
28:     if name == 'SMOOTHSTEP':
29:         return x * x * (3.0 - 2.0 * x)
30:     if name == 'SMOOTHERSTEP':
31:         return x * x * x * (x * (x * 6.0 - 15.0) + 10.0)
32:     if name == 'SPHERE':
33:         return math.sqrt(max(0.0, 2.0 * x - x * x))
34:     if name == 'POW4':
35:         return x * x * x * x
36:     if name == 'INVSQUARE':
37:         return x * (2.0 - x)
38:     raise PropertyError("Unknown response preset")
