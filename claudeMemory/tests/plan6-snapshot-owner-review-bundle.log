79: def value_metadata(definition):
80:     """Return fresh per-definition metadata without touching an owner."""
81:     subtypes = {'NONE': 'NONE', 'ROTATION': 'ANGLE', 'LENGTH': 'DISTANCE'}
82:     try:
83:         subtype = subtypes[definition.unit]
84:     except KeyError:
85:         raise PropertyError("Unsupported property unit: " + definition.unit) from None
86:     result = dict(default=definition.default, description=definition.description, subtype=subtype)
87:     if definition.scalar_type == 'BOOL':
88:         if definition.unit != 'NONE':
89:             raise PropertyError("Boolean properties cannot have a physical unit")
90:         return result
91:     minimum, maximum = definition.minimum, definition.maximum
92:     soft_min, soft_max = definition.soft_minimum, definition.soft_maximum
93:     if definition.scalar_type == 'INT32':
94:         minimum, maximum = math.ceil(minimum), math.floor(maximum)
95:         soft_min = min(maximum, max(minimum, math.ceil(soft_min)))
96:         soft_max = max(soft_min, min(maximum, max(minimum, math.floor(soft_max))))
97:     result.update(min=minimum, max=maximum, soft_min=soft_min, soft_max=soft_max)
98:     return result
