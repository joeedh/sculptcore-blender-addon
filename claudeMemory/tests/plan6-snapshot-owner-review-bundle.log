101: class PersistentOwnerStore:
102:     """Reacquire raw groups per operation; never expose retained storage wrappers."""
103: 
104:     def __init__(self, owner, registry, *, epoch=0, curve_bank=None, execution_diagnostic=None):
105:         self._guard = OwnerGuard(owner, epoch=epoch)
106:         self.owner = owner
107:         self.kind = self._guard.kind
108:         self.registry = registry
109:         self.curve_bank = curve_bank
110:         self._execution_diagnostic = execution_diagnostic
111:         self._native = NativeOwner(owner, epoch=epoch)
112: 
113:     @property
114:     def identity(self):
115:         return self._guard.identity
116: 
117:     @property
118:     def editable(self):
119:         return self._guard.check() and hasattr(self.owner, 'id_properties_update_atomic')
120: 
121:     def _definition(self, identifier):
122:         self._guard.check()
123:         definition = self.registry.get(identifier)
124:         frozen = legacy.BY_ID.get(identifier)
125:         if frozen is not None and frozen != definition:
126:             raise PropertyError("Definition conflicts with the frozen legacy contract")
127:         if self.kind not in definition.owners:
128:             raise PropertyError("Definition does not support this owner")
129:         if identifier in BY_ID and definition != BY_ID[identifier]:
130:             raise PropertyError("Definition conflicts with the reserved native contract")
131:         return definition
132: 
133:     def _record(self, identifier):
134:         definition = self._definition(identifier)
135:         root = _root(self.owner)
136:         if root is None:
137:             return None
138:         records = root.get('records')
139:         if records is None:
140:             return None
141:         key = record_key(identifier)
142:         record = records.get(key)
143:         if record is None and key not in records:
144:             return None
145:         if (not _group(record) or record.get('identifier') != identifier
146:                 or record.get('scalar_type') != definition.scalar_type):
147:             raise PropertyError("Mismatched generic property record identity or type")
148:         modes = (*MODES, 'NATIVE_CAVITY') if identifier.startswith(CAVITY + '.') else MODES
149:         if record.get('value_mode', 'UNIFIED') not in modes:
150:             raise PropertyError("Malformed value inheritance mode")
151:         for name in ('inherit_stack', 'unified'):
152:             if type(record.get(name, False)) is not bool:
153:                 raise PropertyError("Malformed generic property flag: " + name)
154:         return record
155: 
156:     def _checked_definition(self, definition):
157:         if self._definition(definition.identifier) != definition:
158:             raise PropertyError("Store definition differs from the registered definition")
159:         return self._record(definition.identifier)
160: 
161:     def _write_allowed(self):
162:         self._guard.check(write=True)
163:         if not hasattr(self.owner, 'id_properties_update_atomic'):
164:             raise PropertyError("Atomic property storage is unavailable in this Blender build")
165: 
166:     def capability(self, definition):
167:         self._checked_definition(definition)
168:         if self._native.handles(definition.identifier):
169:             return self._native.capability(definition)
170:         reason = (self._execution_diagnostic(definition.identifier) if self._execution_diagnostic
171:                   else 'generic_execution_adapter_pending')
172:         return Capability(True, True, False, reason)
173: 
174:     def diagnostics(self, definition):
175:         self._checked_definition(definition)
176:         if self.kind == 'BRUSH' and definition.identifier == STRENGTH and self.owner.sculpt_brush_type == 'PINCH':
177:             return ('legacy:pinch_extra_uses_local_strength',)
178:         return ()
179: 
180:     def read_value(self, definition):
181:         record = self._checked_definition(definition)
182:         if self._native.handles(definition.identifier):
183:             return self._native.read_value(definition)
184:         if record is None or 'value' not in record:
185:             return legacy.read_value(self, definition)
186:         value = record['value']
187:         expected = {'FLOAT32': float, 'INT32': int, 'BOOL': bool}[definition.scalar_type]
188:         if type(value) is not expected:
189:             raise PropertyError("Stored scalar has the wrong type")
190:         converted = definition.validate(value)
191:         if converted != value:
192:             raise PropertyError("Stored float is not canonical FLOAT32")
193:         return ValueSource(converted, True)
194: 
195:     def read_stack(self, definition):
196:         if definition.identifier in SIZE_ALIASES:
197:             raise PropertyError("Size representations share the common size stack")
198:         native_pressure = self._has_native_pressure(definition)
199:         result = []
200:         for device, enabled, operation, factor, preset, parameters in self._stack_descriptions(definition):
201:             if preset == 'CUSTOM' and native_pressure and device == 'PRESSURE':
202:                 curve = self._native.curve_reference(definition.identifier)
203:             elif preset == 'CUSTOM':
204:                 curve = self._curve_bank().reference(self, definition, device)
205:             else:
206:                 curve = ResponseCurve(preset, parameters)
207:             result.append(DeviceLayer(device, enabled, operation, factor, curve))
208:         if native_pressure and not any(layer.device == 'PRESSURE' for layer in result):
209:             record = self._checked_definition(definition)
210:             enabled = self._native.pressure_enabled(definition.identifier)
211:             if enabled or not _stack_header(record, reading=True):
212:                 result.insert(0, DeviceLayer('PRESSURE', enabled, curve=self._native.curve_reference(
213:                     definition.identifier)))
214:         return tuple(result)
215: 
216:     def _has_native_pressure(self, definition):
217:         return self.kind == 'BRUSH' and definition.identifier in (STRENGTH, SIZE)
218: 
219:     def validate_value(self, definition, value):
220:         self._checked_definition(definition)
221:         return (self._native.validate_value(definition, value) if self._native.handles(definition.identifier)
222:                 else definition.validate(value))
223: 
224:     def value_domain(self, definition):
225:         self._checked_definition(definition)
226:         return self._native.value_domain(definition) if self._native.handles(definition.identifier) else definition
227: 
228:     def _curve_bank(self):
229:         if self.curve_bank is None:
230:             raise PropertyError("Custom curve authoring requires an explicitly registered bank")
231:         return self.curve_bank
232: 
233:     def _stack_descriptions(self, definition):
234:         """Validate selection metadata without resolving any mapping payload."""
235:         record = self._checked_definition(definition)
236:         if not _stack_header(record, reading=True):
237:             return ()
238:         order = record.get('layer_order')
239:         if type(order) is not str or len(order) > 64:
240:             raise PropertyError("Malformed device order")
241:         devices = order.split(',') if order else []
242:         if (len(devices) > len(DEVICE_TYPES) or len(set(devices)) != len(devices)
243:                 or any(device not in DEVICE_TYPES for device in devices)):
244:             raise PropertyError("Unknown or duplicate device in stack order")
245:         if devices and (not definition.dynamic or 'layers' not in record):
246:             raise PropertyError("Static definition or missing device layer data")
247:         result = []
248:         for device in devices:
249:             data = record['layers'].get(device)
250:             if not _group(data):
251:                 raise PropertyError("Malformed active device layer")
252:             enabled, operation, factor, preset = (data.get(name) for name in
253:                                                   ('enabled', 'operation', 'factor', 'preset'))
254:             if self._has_native_pressure(definition) and device == 'PRESSURE':
255:                 enabled = self._native.pressure_enabled(definition.identifier)
256:             parameters = tuple(data.get('parameter_' + str(index)) for index in range(3))
257:             if (type(enabled) is not bool or type(operation) is not str or type(factor) is not float
258:                     or type(preset) is not str or (preset != 'CUSTOM' and preset not in CURVE_PRESET_ARITY)
259:                     or any(type(value) is not float or not math.isfinite(value) for value in parameters)):
260:                 raise PropertyError("Malformed device layer fields")
261:             count = CURVE_PRESET_ARITY.get(preset, 0)
262:             if any(value != 0.0 for value in parameters[count:]):
263:                 raise PropertyError("Unused curve parameters must be zero")
264:             curve = ResponseCurve() if preset == 'CUSTOM' else ResponseCurve(preset, parameters[:count])
265:             DeviceLayer(device, enabled, operation, factor, curve)
266:             result.append((device, enabled, operation, factor, preset, parameters[:count]))
267:         return tuple(result)
268: 
269:     def value_mode(self, identifier):
270:         identifier = policy_identifier(identifier)
271:         record = self._record(identifier)
272:         default = 'NATIVE_CAVITY' if identifier.startswith(CAVITY + '.') else 'UNIFIED'
273:         return record.get('value_mode', default) if record is not None else default
