68:     def __init__(self, owner, *, epoch):
69:         _main_thread()
70:         if not _registered:
71:             raise PropertyError("Brush property lifecycle is not registered")
72:         if type(epoch) is not int:
73:             raise PropertyError("Caller epoch must be an integer")
74:         self._generation = _generation
75:         self.owner = owner
76:         try:
