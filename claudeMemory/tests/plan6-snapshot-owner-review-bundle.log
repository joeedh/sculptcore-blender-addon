78:             if identifier not in ('Brush', 'Scene'):
79:                 raise PropertyError("Expected a native Brush or Scene")
80:             self.kind = identifier.upper()
81:             self._uid = int(owner.session_uid)
82:             self._restoration = _restoration_revision(owner)
83:         except (ReferenceError, AttributeError) as error:
84:             raise PropertyError("Brush property owner is no longer available") from error
85:         self._identity = (self._generation, epoch, self.kind, self._uid)
86:         self.check()
