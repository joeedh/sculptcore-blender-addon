13:     return (
14:         mapping.use_clip, mapping.clip_min_x, mapping.clip_min_y, mapping.clip_max_x, mapping.clip_max_y,
15:         mapping.extend, mapping.tone, tuple(mapping.black_level), tuple(mapping.white_level),
