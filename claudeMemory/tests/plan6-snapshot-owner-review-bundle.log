283:     def unified(self, identifier):
284:         identifier = policy_identifier(identifier)
285:         record = self._record(identifier)
286:         if identifier in (STRENGTH, SIZE):
287:             return self._native.unified(identifier)
288:         return record.get('unified', False) if self.kind == 'SCENE' and record is not None else False
289: 
290:     def inherits_stack(self, identifier):
291:         if identifier in SIZE_ALIASES:
292:             return False
293:         record = self._record(identifier)
294:         return record.get('inherit_stack', False) if record is not None else False
