229: def build_program(manager, commands, names):
230:     """Create a candidate native program; caller publishes only the returned object.
231: 
232:     names maps (kernel, stable ID) to authoritative manifest spelling. Every
233:     command uploads complete values and explicit eligible stacks, even empties.
234:     Dispose the returned program when replacing it. A failed build disposes only
235:     its candidate and never touches the caller's previous executable program.
236:     """
237:     from sculptcore.brush_properties import DeviceLayer, replace_command_stack, set_command_scalar
238: 
239:     commands = tuple(commands)
240:     scalar_types = {'FLOAT32': 0, 'INT32': 4, 'BOOL': 10}
241:     operations = {'REPLACE': 0, 'MULTIPLY': 1, 'ADD': 2, 'SUBTRACT': 3, 'DIFFERENCE': 4}
242:     devices = {'PRESSURE': 0, 'TILT_X': 1, 'TILT_Y': 2, 'SPEED': 3}
243:     payload = []
244:     for command in commands:
245:         if type(command) is not ResolvedCommand or type(command.properties) is not tuple:
246:             raise PropertyError("Expected a resolved command")
247:         used = set()
248:         properties = []
249:         for item in command.properties:
250:             if type(item) is not ExecutionValue:
251:                 raise PropertyError("Expected a resolved execution value")
252:             try:
253:                 name = _name(names[command.kernel, item.definition.identifier])
254:             except KeyError:
255:                 raise PropertyError("Missing native property translation") from None
256:             if name in used:
257:                 raise PropertyError("Duplicate native command target: " + name)
258:             used.add(name)
259:             layers = tuple(DeviceLayer(devices[layer.device], operations[layer.operation], layer.factor,
260:                                        layer.enabled, layer.response.samples, layer.response.kind,
261:                                        layer.response.parameters) for layer in item.stack)
262:             properties.append((name, scalar_types[item.definition.scalar_type], item.value,
263:                                layers if item.definition.dynamic else None))
264:         payload.append((command.kernel, tuple(properties)))
265:     program = manager.construct('sculptcore::brush::BrushProgram')
266:     try:
267:         for kernel, properties in payload:
268:             index = program.addCommand(kernel)
269:             for name, kind, value, layers in properties:
270:                 set_command_scalar(manager, program, index, name, kind, value)
271:                 if layers is not None:
272:                     replace_command_stack(manager, program, index, name, kind, layers)
273:         return program
274:     except BaseException:
275:         program.dispose()
276:         raise
