21:     association = ASSOCIATIONS.get(definition.identifier)
22:     if association is None or store.kind != 'BRUSH':
23:         return ValueSource()
24:     store._guard.check()
25:     reader = getattr(store.owner, 'system_property_scalar', None)
26:     if not callable(reader):
27:         raise PropertyError("Nonmutating legacy property inspection API is unavailable")
28:     try:
29:         present, kind, value = reader(('sculptcore', association[1]))
30:     except (ValueError, TypeError, ReferenceError, RuntimeError) as error:
31:         raise PropertyError("Legacy scalar cannot be inspected: " + association[1]) from error
