275:     def native_cavity_parent(self, parent):
276:         self._guard.check()
277:         local = self._native.cavity()
278:         if local is not None and (local.use_automasking_cavity or local.use_automasking_cavity_inverted):
279:             return False
280:         shared = parent._native.cavity() if parent is not None else None
281:         return shared is not None and (shared.use_automasking_cavity or shared.use_automasking_cavity_inverted)
