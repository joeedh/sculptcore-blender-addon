25: def _root(owner):
26:     root = owner.get(ROOT)
27:     if root is None and ROOT not in owner:
28:         return None
29:     if not _group(root) or type(root.get('schema_version')) is not int:
30:         raise PropertyError("Malformed generic property schema header")
31:     if root['schema_version'] != SCHEMA_VERSION:
32:         raise PropertyError("Unsupported generic property schema; data preserved")
33:     if 'records' in root and not _group(root['records']):
34:         raise PropertyError("Malformed generic property records group")
35:     return root
36: 
37: 
38: def _positions_header(record, *, reading):
39:     if record is None:
40:         return False
41:     if 'positions' in record and not _group(record['positions']):
42:         raise PropertyError("Malformed positions group")
43:     version_set, order_set = 'positions_version' in record, 'positions_order' in record
44:     if version_set:
45:         version = record['positions_version']
46:         if type(version) is not int or version != POSITIONS_VERSION:
47:             raise PropertyError("Unsupported or malformed positions version; data preserved")
48:     if reading and version_set != order_set:
49:         raise PropertyError("Incomplete positions header")
50:     return version_set or order_set
51: 
52: 
53: def _stack_header(record, *, reading):
54:     """Validate only on stack access; other fields preserve unknown stack schemas."""
55:     if record is None:
56:         return False
57:     present = any(name in record for name in ('stack_version', 'layer_order', 'layers'))
58:     if 'stack_version' in record:
59:         version = record['stack_version']
60:         if type(version) is not int or version != STACK_VERSION:
61:             raise PropertyError("Unsupported or malformed device stack version; data preserved")
62:     elif reading and present:
63:         raise PropertyError("Missing device stack version")
64:     if 'layers' in record and not _group(record['layers']):
65:         raise PropertyError("Malformed device layer group")
66:     return present
