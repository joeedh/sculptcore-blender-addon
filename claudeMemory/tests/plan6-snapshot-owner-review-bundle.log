3: """Resolve and edit effective owners through a non-allocating authoring-store interface."""
4: 
5: from dataclasses import dataclass, replace
6: from typing import Protocol
7: 
8: from .registry import Definition, PropertyError, validated_stack
9: 
10: MODES = ('UNIFIED', 'ALWAYS', 'NEVER')
11: 
12: 
13: @dataclass(frozen=True)
14: class Capability:
15:     value: bool = True
16:     stack: bool = True
17:     execution: bool = True
18:     reason: str = ""
19: 
20:     def __post_init__(self):
21:         if (any(type(value) is not bool for value in (self.value, self.stack, self.execution))
22:                 or type(self.reason) is not str):
23:             raise PropertyError("Malformed owner capability")
24: 
25: 
26: @dataclass(frozen=True)
27: class ValueSource:
28:     value: object = None
29:     present: bool = False
30:     source: str = 'GENERIC'
31: 
32:     def __post_init__(self):
33:         if (type(self.present) is not bool or type(self.source) is not str
34:                 or (not self.present and self.value is not None)):
35:             raise PropertyError("Malformed authored value presence/source")
36: 
37: 
38: class OwnerStore(Protocol):
39:     """Identity includes the caller's lifecycle epoch; stores remain valid only for the current operation."""
40: 
41:     identity: tuple
42:     kind: str
43:     editable: bool
44: 
45:     def capability(self, definition: Definition) -> Capability: ...
46:     def read_value(self, definition: Definition) -> ValueSource: ...
47:     def read_stack(self, definition: Definition) -> tuple: ...
48:     def value_mode(self, identifier: str) -> str: ...
49:     def unified(self, identifier: str) -> bool: ...
50:     def inherits_stack(self, identifier: str) -> bool: ...
51:     def write_value(self, definition: Definition, value): ...
52:     def write_stack(self, definition: Definition, layers: tuple): ...
53:     def write_mode(self, identifier: str, mode: str): ...
54:     def write_unified(self, identifier: str, enabled: bool): ...
55:     def write_stack_inheritance(self, identifier: str, enabled: bool): ...
56: 
57: 
58: @dataclass(frozen=True)
59: class Resolved:
60:     definition: Definition
61:     value: object
62:     value_owner: OwnerStore
63:     stack: tuple | None
64:     stack_owner: OwnerStore
65:     value_source: ValueSource
66:     stack_available: bool
67:     execution_available: bool
68:     diagnostics: tuple
69:     invalidation_key: tuple
70:     value_domain: object = None
71: 
72: 
73: def _resolve(registry, identifier, local, parent, read_stack, read_value=True):
74:     definition = registry.get(identifier)
75:     if local.kind not in definition.owners:
76:         raise PropertyError("Definition does not support this owner")
77:     if local.kind == 'SCENE':
78:         parent = None
79:     elif local.kind != 'BRUSH' or (parent is not None and parent.kind != 'SCENE'):
80:         raise PropertyError("The supported hierarchy is Brush -> Scene")
81:     local_cap = local.capability(definition)
82:     if type(local_cap) is not Capability:
83:         raise PropertyError("Malformed local capability")
84:     if not local_cap.value:
85:         raise PropertyError("Local value capability is unavailable")
86:     parent_cap = (parent.capability(definition) if parent is not None and 'SCENE' in definition.owners
87:                   else Capability(False, False, False, 'parent_unavailable'))
88:     if type(parent_cap) is not Capability:
89:         raise PropertyError("Malformed parent capability")
90:     mode = local.value_mode(identifier) if local.kind == 'BRUSH' else 'NEVER'
91:     inherited_stack = local.inherits_stack(identifier) if local.kind == 'BRUSH' else False
92:     unified = parent.unified(identifier) if parent is not None and parent_cap.value else False
93:     cavity_mode = mode == 'NATIVE_CAVITY' and identifier.startswith('sculptcore.brush.cavity.')
94:     if (mode not in MODES and not cavity_mode) or type(inherited_stack) is not bool or type(unified) is not bool:
95:         raise PropertyError("Malformed inheritance metadata")
96:     want_parent = mode == 'ALWAYS' or (mode == 'UNIFIED' and unified)
97:     if cavity_mode:
98:         if not hasattr(local, 'native_cavity_parent'):
99:             raise PropertyError("Native cavity policy requires a cavity adapter")
100:         want_parent = local.native_cavity_parent(parent)
101:     diagnostics = []
102:     if hasattr(local, 'diagnostics'):
103:         diagnostics.extend(local.diagnostics(definition))
104:     value_owner = parent if want_parent and parent_cap.value else local
105:     if mode != 'NEVER' and not parent_cap.value:
106:         diagnostics.append('value:parent_unavailable')
107:     stack_owner = parent if inherited_stack and parent_cap.stack else local
108:     if inherited_stack and not parent_cap.stack:
109:         diagnostics.append('stack:parent_unavailable')
110:     stack_cap = parent_cap if stack_owner is parent else local_cap
111:     value_cap = parent_cap if value_owner is parent else local_cap
112:     source = value_owner.read_value(definition) if read_value else ValueSource()
113:     if type(source) is not ValueSource:
114:         raise PropertyError("Malformed authored value source")
115:     authored = source.value if source.present else definition.default
116:     value = (value_owner.validate_value(definition, authored) if read_value and hasattr(value_owner, 'validate_value')
117:              else definition.validate(authored))
118:     layers = validated_stack(stack_owner.read_stack(definition)) if stack_cap.stack and read_stack else None
119:     if layers and not definition.dynamic:
120:         raise PropertyError("Static definitions cannot carry a device stack")
121:     if not stack_cap.stack:
122:         diagnostics.append('stack:unavailable')
123:     execution_available = value_cap.execution and stack_cap.execution and stack_cap.stack
124:     if not execution_available:
125:         diagnostics.append('execution:unavailable')
126:         for capability in (value_cap, stack_cap):
127:             if not capability.execution and capability.reason:
128:                 reason = 'execution:' + capability.reason
129:                 if reason not in diagnostics:
130:                     diagnostics.append(reason)
131:     domain = value_owner.value_domain(definition) if hasattr(value_owner, 'value_domain') else definition
132:     key = (registry.revision, definition, domain, local.identity, parent.identity if parent is not None else None,
133:            local_cap, parent_cap, mode, unified, inherited_stack, value_owner.identity, stack_owner.identity,
134:            source, value, layers, tuple(diagnostics))
135:     return Resolved(definition, value, value_owner, layers, stack_owner, source, stack_cap.stack,
136:                     execution_available, tuple(diagnostics), key, domain)
137: 
138: 
139: def resolve(registry, identifier, local, parent=None):
140:     return _resolve(registry, identifier, local, parent, True)
141: 
142: 
143: def _editable(owner):
144:     if not owner.editable:
145:         raise PropertyError("Effective owner is read-only; create an editable copy")
146: 
147: 
148: def set_value(registry, identifier, local, parent, value):
149:     result = _resolve(registry, identifier, local, parent, False, False)
150:     value = (result.value_owner.validate_value(result.definition, value)
151:              if hasattr(result.value_owner, 'validate_value') else result.definition.validate(value))
152:     _editable(result.value_owner)
153:     result.value_owner.write_value(result.definition, value)
154: 
155: 
156: def set_stack(registry, identifier, local, parent, layers):
157:     result = _resolve(registry, identifier, local, parent, False, False)
158:     layers = validated_stack(layers)
159:     if not result.stack_available or (layers and not result.definition.dynamic):
160:         raise PropertyError("Device stack authoring is unavailable")
161:     _editable(result.stack_owner)
162:     result.stack_owner.write_stack(result.definition, layers)
163: 
164: 
165: def update_layer(registry, identifier, local, parent, layer):
166:     layer, = validated_stack((layer,))
167:     result = resolve(registry, identifier, local, parent)
168:     if result.stack is None:
169:         raise PropertyError("Device stack authoring is unavailable")
170:     layers = list(result.stack)
171:     index = next((i for i, old in enumerate(layers) if old.device == layer.device), len(layers))
172:     if index == len(layers):
173:         layers.append(layer)
174:     else:
175:         layers[index] = layer
176:     set_stack(registry, identifier, local, parent, layers)
177: 
178: 
179: def set_layer_enabled(registry, identifier, local, parent, device, enabled):
180:     result = resolve(registry, identifier, local, parent)
181:     layer = next((layer for layer in result.stack or () if layer.device == device), None)
182:     if layer is None:
183:         raise PropertyError("Device entry is absent")
184:     update_layer(registry, identifier, local, parent, replace(layer, enabled=enabled))
185: 
186: 
187: def set_value_mode(registry, identifier, local, mode):
188:     definition = registry.get(identifier)
189:     cavity = mode == 'NATIVE_CAVITY' and identifier.startswith('sculptcore.brush.cavity.')
190:     if local.kind != 'BRUSH' or local.kind not in definition.owners or (mode not in MODES and not cavity):
191:         raise PropertyError("Value inheritance belongs to Brush")
192:     if type(local.capability(definition)) is not Capability or not local.capability(definition).value:
193:         raise PropertyError("Local value capability is unavailable")
194:     _editable(local)
195:     local.write_mode(identifier, mode)
196: 
197: 
198: def set_stack_inheritance(registry, identifier, local, enabled):
199:     definition = registry.get(identifier)
200:     if local.kind != 'BRUSH' or local.kind not in definition.owners or type(enabled) is not bool:
201:         raise PropertyError("Stack inheritance belongs to Brush and requires bool")
202:     if type(local.capability(definition)) is not Capability or not local.capability(definition).value:
203:         raise PropertyError("Local value capability is unavailable")
204:     _editable(local)
205:     local.write_stack_inheritance(identifier, enabled)
206: 
207: 
208: def set_unified(registry, identifier, scene, enabled):
209:     definition = registry.get(identifier)
210:     if scene.kind != 'SCENE' or scene.kind not in definition.owners or type(enabled) is not bool:
211:         raise PropertyError("Unified flags belong to Scene and require bool")
212:     if type(scene.capability(definition)) is not Capability or not scene.capability(definition).value:
213:         raise PropertyError("Scene value capability is unavailable")
214:     _editable(scene)
215:     scene.write_unified(identifier, enabled)
