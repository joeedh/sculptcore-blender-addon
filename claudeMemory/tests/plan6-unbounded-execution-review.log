148: bool GridBrushExecutor::createPreparedCommand(SculptBrushes type, brush_command &command)
149: {
150:   Brush scratch;
151:   brush_command candidate;
152:   if (!createCommandSwitch<AccumLive>(type, &scratch, candidate))
153:     return false;
154:   if (nonAccum && candidate.accumulable && !candidate.relaxesBase) {
155:     brush_command original;
156:     if (!createCommandSwitch<AccumOrig>(type, &scratch, original))
157:       return false;
158:     candidate = std::move(original);
159:   }
160:   command = std::move(candidate);
161:   return true;
162: }
