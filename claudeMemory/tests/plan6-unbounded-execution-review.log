39: public:
40:   std::span<const PreparedBrushScalar> values() const
41:   {
42:     return {values_.size() ? &values_[0] : nullptr, values_.size()};
43:   }
44:   std::span<const props::ScalarDeclaration> declarations() const
45:   {
46:     return {declarations_.size() ? &declarations_[0] : nullptr, declarations_.size()};
