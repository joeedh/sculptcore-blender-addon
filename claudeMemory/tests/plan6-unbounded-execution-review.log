239: props::ScalarRegistrationResult CommandExecutor::applyResolvedProgram(
240:     BrushProgram *program, float3 center, float3 normal, bool validateOnly)
241: {
242:   using props::PropError;
243:   auto fail = [&](PropError error, const char *name) {
244:     lastRegistration = {error, name};
245:     return lastRegistration;
246:   };
247:   if (!preparedStepValid() || !program || !brush || !tree || !tree->m || !tree->getRoot())
248:     return fail(PropError::ERROR_INVALID_OWNER, "program or mesh");
249:   for (int axis = 0; axis < 3; axis++)
250:     if (!std::isfinite(center[axis]) || !std::isfinite(normal[axis]))
251:       return fail(PropError::ERROR_INVALID_VALUE, "dab frame");
252:   if (!program->commands.size()) {
253:     PreparedBrushScalars empty;
254:     lastRegistration = prepareBrushScalars(*brush, {}, brush->deviceInputCtx, empty);
255:     if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
256:       return lastRegistration;
257:     lastRegistration = {};
258:     dabNodes_.clear();
259:     lastDabNodeCount = 0;
260:     clearIsFirstOfStep();
261:     return {};
262:   }
263:   Vector<brush_command> commands;
264:   commands.resize(program->commands.size());
265:   Vector<std::span<const BrushUniformManifestEntry>> manifests;
266:   bool needsLive = keepTopoThawed;
267:   for (size_t i = 0; i < program->commands.size(); i++) {
268:     const auto &entry = program->commands[i];
269:     auto &command = commands[i];
270:     if (!createPreparedCommand(entry.type, command)) {
271:       lastRegistration = programError(i, {PropError::ERROR_NOT_EXISTS, "kernel"});
272:       return lastRegistration;
273:     }
274:     if (entry.attrLayerOverrides.size() ||
275:         !resolvedCapability(*this, command, entry.type))
276:     {
277:       lastRegistration = programError(
278:           i, {PropError::ERROR_INVALID_VALUE, "unsupported resolved capability"});
279:       return lastRegistration;
280:     }
281:     needsLive |= brushNeedsLiveLinks(entry.type);
282:     manifests.append({command.uniforms.data(), command.uniforms.size()});
283:   }
284:   PreparedProgramScalars prepared;
285:   lastRegistration = prepareProgramScalars(*brush,
286:                                            *program,
287:                                            {manifests.data(), manifests.size()},
288:                                            brush->deviceInputCtx,
289:                                            prepared);
290:   if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
291:     return lastRegistration;
292:   dabNodes_.clear();
293:   if (prepared.radius > 0)
294:     tree->filterNodes(center, prepared.radius, dabNodes_);
295:   lastDabNodeCount = int(dabNodes_.size());
296:   if (dabNodes_.size()) {
297:     ScopedBrushWorkingValues working(*brush,
298:                                      {prepared.stages.data(), prepared.stages.size()});
299:     auto *mesh = tree->m;
300:     Vector<BrushHookFn> completed;
301:     BrushHookCtx hc{*this, mesh, &dabNodes_, brush, isFirstOfStep};
302:     for (size_t i = 0; i < program->commands.size(); i++) {
303:       const auto *hooks = brushHooksFor(program->commands[i].type);
304:       if (!prepared.radii[i] || !hooks || !hooks->stepPreFreeze)
305:         continue;
306:       bool seen = false;
307:       for (auto fn : completed)
308:         seen |= fn == hooks->stepPreFreeze;
309:       if (!seen) {
310:         hooks->stepPreFreeze(hc);
311:         completed.append(hooks->stepPreFreeze);
312:       }
313:     }
314:     bool needsCavity = false;
315:     for (size_t i = 0; i < prepared.stages.size(); i++) {
316:       if (prepared.radii[i] > 0)
317:         for (const auto &value : prepared.stages[i].values())
318:           needsCavity |= value.name == string("automask_cavity") && value.value != 0;
319:     }
320:     if (needsCavity) {
321:       if (mesh->topo_frozen && !mesh->topo_cache.valid(*mesh))
322:         mesh->thawTopo();
323:       mesh->topo_cache.ensureRing1(*mesh);
324:     }
325:     if (needsLive) {
326:       if (mesh->topo_frozen)
327:         mesh->thawTopo();
328:     } else if (!mesh->topo_frozen) {
329:       mesh->freezeTopo();
330:     }
331:     ctx.m = mesh;
332:     ctx.surfaceNo = normal;
333:     ctx.surfacePos = center;
334:     ctx.meshLog = meshLog;
335:     ctx.isFirstOfStep = isFirstOfStep;
336:     updateStrokeFrame(center);
337:     brush->pushStrokeSample(center, normal);
338:     ScopedPreparedCavity cavityScope(preparedCavityActive);
339:     for (size_t i = 0; i < commands.size(); i++) {
340:       if (prepared.radii[i] == 0)
341:         continue;
342:       prepared.stages[i].applyWorking(*brush);
343:       curCaptureSlot = int(i);
344:       curCaptureTool = int(program->commands[i].type);
345:       exec(commands[i], {dabNodes_.data(), dabNodes_.size()});
346:     }
347:     curCaptureSlot = -1;
348:     tree->updateQueries();
349:   }
350:   clearIsFirstOfStep();
351:   return {};
352: }
