27: props::ScalarRegistrationResult GridBrushExecutor::resolvedState(float3 origin,
28:                                                                  float3 normal) const
29: {
30:   using props::PropError;
31:   // Check the live owner before dereferencing a possibly freed domain or tree.
32:   if (!attachedMultires_ ||
33:       attachedMultires_->domainGeneration() != attachedGeneration_ || !domain ||
34:       domain != attachedDomain_ || !tree || tree != attachedTree_ || !brush)
35:   {
36:     return {PropError::ERROR_INVALID_OWNER, "grid attachment"};
37:   }
38:   if (!stepOpen_ || log != stepLog_ ||
39:       (log && (log->domain() != domain || !stepLogSerial_ ||
40:                log->openStepSerial() != stepLogSerial_)))
41:   {
42:     return {PropError::ERROR_INVALID_OWNER, "grid step"};
43:   }
44:   for (int axis = 0; axis < 3; axis++) {
45:     if (!std::isfinite(origin[axis]) || !std::isfinite(normal[axis])) {
46:       return {PropError::ERROR_INVALID_VALUE, "dab frame"};
47:     }
48:   }
49:   return {};
50: }
