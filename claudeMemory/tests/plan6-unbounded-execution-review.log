12: bool resolvedCapability(CommandExecutor &executor,
13:                         const CommandExecutor::brush_command &command,
14:                         SculptBrushes type)
15: {
16:   const auto &brush = *executor.brush;
17:   return !(
18:       executor.stepHasDyntopo || (executor.anchoredGrab && command.grabModeCapable) ||
19:       command.unbounded ||
20:       !resolvedAttributesSupported(
21:           {command.attrs.size() ? &command.attrs[0] : nullptr, command.attrs.size()}) ||
22:       (command.attrs.size() && !brushHooksFor(type)) ||
23:       executor.defaultAttrOverrides.size() || command.execHost ||
24:       !command.preparedScalarSafe || !preparedHooksSupported(type, false) ||
25:       executor.previewActive() || !resolvedFalloffSupported(brush));
26: }
