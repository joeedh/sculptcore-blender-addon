69:   prepareBrushScalars(Brush &,
70:                       std::span<const BrushUniformManifestEntry>,
71:                       const props::DeviceInputCtx &,
72:                       PreparedBrushScalars &,
73:                       std::span<const BrushScalarOverride>,
74:                       std::span<const BrushUniformManifestEntry>,
75:                       ScalarSource,
76:                       std::span<const BrushDynamicsOverride>,
77:                       std::span<const float>);
78:   const Brush *brush_ = nullptr;
79:   const props::StructDef *definition_ = nullptr;
80:   util::Vector<PreparedBrushScalar> values_;
81:   util::Vector<props::ScalarDeclaration> declarations_;
82:   std::array<float, 256> cavityCurve_{};
