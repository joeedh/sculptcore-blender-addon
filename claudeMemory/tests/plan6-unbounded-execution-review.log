108: bool CommandExecutor::createPreparedCommand(SculptBrushes type, brush_command &command)
109: {
110:   Brush scratch;
111:   const bool csr = effectiveNeighborMode() == NeighborMode::Csr;
112:   brush_command candidate;
113:   if (!createCommandSwitch<AccumLive>(type, csr, &scratch, candidate))
114:     return false;
115:   if (nonAccum && candidate.accumulable && !candidate.relaxesBase) {
116:     brush_command original;
117:     if (!createCommandSwitch<AccumOrig>(type, csr, &scratch, original))
118:       return false;
119:     candidate = std::move(original);
120:   }
121:   command = std::move(candidate);
122:   return true;
123: }
124: 
125: bool CommandExecutor::supportsResolved(SculptBrushes type)
126: {
127:   if (!brush)
128:     return false;
129:   brush_command command;
130:   return createPreparedCommand(type, command) && resolvedCapability(*this, command, type);
131: }
132: 
133: bool CommandExecutor::supportsResolvedProgram(BrushProgram *program)
134: {
135:   if (!program || !brush)
136:     return false;
137:   for (const auto &entry : program->commands)
138:     if (entry.attrLayerOverrides.size() || !supportsResolved(entry.type))
139:       return false;
140:   return true;
141: }
