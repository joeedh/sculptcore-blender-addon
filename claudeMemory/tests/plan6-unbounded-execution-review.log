29: bool CommandExecutor::preflightRaw(SculptBrushes type)
30: {
31:   Brush scratch;
32:   brush_command command;
33:   if (!brush ||
34:       !createCommandSwitch<AccumLive>(
35:           type, effectiveNeighborMode() == NeighborMode::Csr, &scratch, command))
36:   {
37:     lastRegistration = {props::PropError::ERROR_NOT_EXISTS, "kernel or brush"};
38:   } else {
39:     PreparedBrushScalars prepared;
40:     lastRegistration =
41:         prepareBrushScalars(*brush,
42:                             {command.uniforms.data(), command.uniforms.size()},
43:                             brush->deviceInputCtx,
44:                             prepared,
45:                             {},
46:                             {},
47:                             ScalarSource::RawStandalone);
48:   }
49:   lastValidation = {};
50:   lastValidation.ok = lastRegistration.error == props::PropError::ERROR_NONE;
51:   strokeValidationFailed = !lastValidation.ok;
52:   if (!lastValidation.ok)
53:     fprintf(stderr,
54:             "SculptCore: rejected %s (property status %d)\n",
55:             lastRegistration.name.c_str(),
56:             int(lastRegistration.error));
57:   return lastValidation.ok;
58: }
59: 
60: bool CommandExecutor::preflightRawProgram(BrushProgram *program)
61: {
62:   lastValidation = {};
63:   lastRegistration = {};
64:   auto validate = [&]() -> props::ScalarRegistrationResult {
65:     if (!brush || !program)
66:       return {props::PropError::ERROR_INVALID_OWNER, "program or brush"};
67:     Vector<brush_command> commands;
68:     commands.resize(program->commands.size());
69:     Vector<std::span<const BrushUniformManifestEntry>> manifests;
70:     ScopedPreparedCavity cavityScope(preparedCavityActive);
71:     for (size_t i = 0; i < commands.size(); i++) {
72:       Brush scratch;
73:       const auto &entry = program->commands[i];
74:       if (entry.dynamicsOverrides.size() || entry.scalarOverrides.size() ||
75:           entry.cavityCurveOverride.size())
76:         return programError(i,
77:                             {props::PropError::ERROR_INVALID_VALUE,
78:                              "typed overrides require resolved execution"});
79:       if (!createCommandSwitch<AccumLive>(entry.type,
80:                                           effectiveNeighborMode() == NeighborMode::Csr,
81:                                           &scratch,
82:                                           commands[i]))
83:         return programError(i, {props::PropError::ERROR_NOT_EXISTS, "kernel"});
84:       manifests.append({commands[i].uniforms.data(), commands[i].uniforms.size()});
85:     }
86:     if (!commands.size()) {
87:       PreparedBrushScalars prepared;
88:       return prepareBrushScalars(*brush, {}, brush->deviceInputCtx, prepared);
89:     }
90:     PreparedProgramScalars prepared;
91:     return prepareProgramScalars(*brush,
92:                                  *program,
93:                                  {manifests.data(), manifests.size()},
94:                                  brush->deviceInputCtx,
95:                                  prepared);
96:   };
97:   lastRegistration = validate();
98:   lastValidation.ok = lastRegistration.error == props::PropError::ERROR_NONE;
99:   strokeValidationFailed = !lastValidation.ok;
100:   if (!lastValidation.ok)
101:     fprintf(stderr,
102:             "SculptCore: rejected %s (property status %d)\n",
103:             lastRegistration.name.c_str(),
104:             int(lastRegistration.error));
105:   return lastValidation.ok;
106: }
