45: static PropError commandStackTarget(const BrushProgram &program,
46:                                     int idx,
47:                                     const util::string &name,
48:                                     int scalarType)
49: {
50:   if (idx < 0 || size_t(idx) >= program.commands.size() || !name.size() ||
51:       std::strlen(name.c_str()) != name.size())
52:     return PropError::ERROR_NOT_EXISTS;
53:   if (scalarType != int(Prop::FLOAT32) && scalarType != int(Prop::INT32) &&
54:       scalarType != int(Prop::BOOL))
55:     return PropError::ERROR_INVALID_TYPE;
56:   return PropError::ERROR_NONE;
57: }
