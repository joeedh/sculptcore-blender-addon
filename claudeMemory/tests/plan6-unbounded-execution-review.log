98: bool GridBrushExecutor::preflightRawProgram(BrushProgram *program,
99:                                             float3 origin,
100:                                             float3 normal)
101: {
102:   lastRegistration = resolvedState(origin, normal);
103:   if (lastRegistration.error != props::PropError::ERROR_NONE)
104:     return false;
105:   auto validate = [&]() -> props::ScalarRegistrationResult {
106:     if (!program)
107:       return {props::PropError::ERROR_INVALID_OWNER, "program"};
108:     Vector<brush_command> commands;
109:     commands.resize(program->commands.size());
110:     Vector<std::span<const BrushUniformManifestEntry>> manifests;
111:     ScopedPreparedCavity cavityScope(preparedCavityActive);
112:     for (size_t i = 0; i < commands.size(); i++) {
113:       Brush scratch;
114:       const auto &entry = program->commands[i];
115:       if (entry.dynamicsOverrides.size() || entry.scalarOverrides.size() ||
116:           entry.cavityCurveOverride.size() || entry.attrLayerOverrides.size())
117:         return programError(
118:             i, {props::PropError::ERROR_INVALID_VALUE, "unsupported raw grid override"});
119:       if (!createCommandSwitch<AccumLive>(entry.type, &scratch, commands[i]))
120:         return programError(i, {props::PropError::ERROR_NOT_EXISTS, "kernel"});
121:       if (!maskStorageSupported(*this, commands[i].writesMask))
122:         return programError(i, {props::PropError::ERROR_SCHEMA_CONFLICT, "mask channel"});
123:       if (commands[i].grabModeCapable && anchoredGrab)
124:         return programError(
125:             i, {props::PropError::ERROR_INVALID_VALUE, "anchored grid program"});
126:       manifests.append({commands[i].uniforms.data(), commands[i].uniforms.size()});
127:     }
128:     if (!commands.size()) {
129:       PreparedBrushScalars prepared;
130:       return prepareBrushScalars(*brush, {}, brush->deviceInputCtx, prepared);
131:     }
132:     PreparedProgramScalars prepared;
133:     return prepareProgramScalars(*brush,
134:                                  *program,
135:                                  {manifests.data(), manifests.size()},
136:                                  brush->deviceInputCtx,
137:                                  prepared);
138:   };
139:   lastRegistration = validate();
140:   if (lastRegistration.error != props::PropError::ERROR_NONE)
141:     fprintf(stderr,
142:             "SculptCore: rejected %s (property status %d)\n",
143:             lastRegistration.name.c_str(),
144:             int(lastRegistration.error));
145:   return lastRegistration.error == props::PropError::ERROR_NONE;
146: }
