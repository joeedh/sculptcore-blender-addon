14: bool maskStorageSupported(const GridBrushExecutor &executor, bool writesMask)
15: {
16:   if (!writesMask)
17:     return true;
18:   const auto &store = executor.domain->multires()->store;
19:   const int channel =
20:       store.findChannel(util::string(subdiv::GridLevelDomain::kMaskChannelName));
21:   return channel < 0 || (store.channelElemSize(channel) == 1 &&
22:                          store.channelType(channel) == mesh::AttrType::FLOAT &&
23:                          store.channelDomain(channel) == subdiv::GridElemDomain::Vertex);
