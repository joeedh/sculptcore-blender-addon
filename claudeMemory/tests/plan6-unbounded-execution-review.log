2378:         write("    ctx.node.update(Spatial_UpdateNormals | Spatial_UpdateGPUGeom | "
2379:               "Spatial_RegenBounds);\n");
2380:       } else {
2381:         write("    ctx.node.update(Spatial_UpdateNormals | Spatial_UpdateGPU | "
2382:               "Spatial_RegenBounds);\n");
2383:       }
2384:       write("  }\n");
2385:       write("}\n\n");
2386:     } // end vertex/face primary-kernel branch
2387: 
2388:     // post-stage: empty for Wave 1.
2389:     write("template <CommandTypes TYPES>\n");
2390:     write("static void ");
2391:     write(lowerName);
2392:     write("Post(CommandCtxBase &ctx, std::span<typename TYPES::node_type *> nodes)\n");
2393:     write("{\n");
2394:     write("  (void)ctx; (void)nodes;\n");
2395:     write("}\n\n");
2396: 
2397:     // wire-up function: identical shape to existing createDrawBrush. For
2398:     // for_neighbor brushes it carries the NbrSource policy (default: live disk
2399:     // walk) through to the kernel instantiation assigned to def.exec.
2400:     if (usesNbr) {
2401:       write("template <CommandTypes TYPES, sculptcore::brush::NbrSource NbrSrc = "
2402:             "sculptcore::brush::LiveDiskNbr, "
2403:             "sculptcore::brush::AccumMode AccMode = sculptcore::brush::AccumLive>\n");
2404:     } else {
2405:       write("template <CommandTypes TYPES, "
2406:             "sculptcore::brush::AccumMode AccMode = sculptcore::brush::AccumLive>\n");
2407:     }
2408:     write("static void create");
2409:     write(camelName);
2410:     write("Brush(BrushCommandDef<CommandCtx<TYPES>> &def)\n");
2411:     write("{\n");
2412:     // Host stages, if any, are composed into a single lambda so multiple
2413:     // hosts on one brush still flow through one execHost slot.
2414:     if (hostStages.size() > 0) {
2415:       write("  def.execHost = [](CommandCtxBase &ctx, Brush &brush) {\n");
2416:       for (const auto *st : hostStages) {
2417:         write("    ");
2418:         write(lowerName);
2419:         write(capitalize(st->name));
2420:         write("<TYPES>(ctx, brush);\n");
2421:       }
2422:       write("  };\n");
2423:     }
2424:     write("  def.execPre  = ");
2425:     write(lowerName);
2426:     write("Pre<TYPES>;\n");
2427:     write("  def.exec     = ");
2428:     write(lowerName);
2429:     if (usesNbr)
2430:       write("<TYPES, NbrSrc, AccMode>;\n");
2431:     else
2432:       write("<TYPES, AccMode>;\n");
2433:     write("  def.execPost = ");
2434:     write(lowerName);
2435:     write("Post<TYPES>;\n");
2436:     write("  def.preparedScalarSafe = ");
2437:     write(!preparedStateUnsafe && hostStages.size() == 0 && reduceStages.size() == 0 &&
2438:                   !faceStage
2439:               ? "true;\n"
2440:               : "false;\n");
2441:     // for_neighbor reads ctx.co_prev — tell the executor to snapshot it.
2442:     if (neighborLoopUsed) {
2443:       write("  def.needsCoPrev = true;\n");
2444:     }
2445:     // Non-accumulate eligibility (see plans/nonAccumMode.md): accumulable is the
2446:     // default; the executor runs the AccumOrig instantiation when non-accumulate
2447:     // mode is on for the stroke. @paint writes attributes and @unbounded fields
2448:     // are anchored, so from-base re-derivation is meaningless for both; an
2449:     // @incremental kernel is driven by a per-dab delta, so it has no base; a
2450:     // grad() kernel differentiates over v.co, which the base-read proxy breaks.
2451:     write("  def.accumulable = ");
2452:     write((!brush->isPaint && !brush->isUnbounded && !brush->isIncremental &&
2453:            !brushUsesGrad())
2454:               ? "true"
2455:               : "false");
