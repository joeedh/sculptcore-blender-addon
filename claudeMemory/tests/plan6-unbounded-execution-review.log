143: props::ScalarRegistrationResult CommandExecutor::applyResolvedDab(SculptBrushes brushType,
144:                                                                   float3 center,
145:                                                                   float3 normal,
146:                                                                   bool validateOnly)
147: {
148:   using props::PropError;
149:   auto fail = [&](PropError error, const char *name) {
150:     lastRegistration = {error, name};
151:     return lastRegistration;
152:   };
153:   if (!preparedStepValid() || !brush || !tree || !tree->m || !tree->getRoot()) {
154:     return fail(PropError::ERROR_INVALID_OWNER, "mesh");
155:   }
156:   for (int axis = 0; axis < 3; axis++) {
157:     if (!std::isfinite(center[axis]) || !std::isfinite(normal[axis])) {
158:       return fail(PropError::ERROR_INVALID_VALUE, "dab frame");
159:     }
160:   }
161:   brush_command command;
162:   if (!createPreparedCommand(brushType, command)) {
163:     return fail(PropError::ERROR_NOT_EXISTS, "kernel");
164:   }
165:   // These modes need additional region, host-state or attribute preflight.
166:   // Generated host stages may themselves change radius/center after selection.
167:   if (!resolvedCapability(*this, command, brushType)) {
168:     return fail(PropError::ERROR_INVALID_VALUE, "unsupported resolved capability");
169:   }
170:   PreparedBrushScalars prepared;
171:   lastRegistration =
172:       prepareBrushScalars(*brush,
173:                           {command.uniforms.data(), command.uniforms.size()},
174:                           brush->deviceInputCtx,
175:                           prepared);
176:   if (lastRegistration.error != PropError::ERROR_NONE) {
177:     return lastRegistration;
178:   }
179:   float radius = -1;
180:   for (const auto &value : prepared.values()) {
181:     if (value.name == string("radius")) {
182:       radius = float(value.value);
183:     }
184:   }
185:   if (!std::isfinite(radius) || radius < 0 ||
186:       (radius > 0 && !std::isfinite(1.0f / radius)))
187:   {
188:     return fail(PropError::ERROR_INVALID_VALUE, "radius");
189:   }
190:   // No callbacks or yields between preparation and publication. The exact
191:   // scratch command above executes below; no live factory or legacy loader.
192:   if (validateOnly)
193:     return {};
194:   ScopedBrushWorkingValues executorSettings(*brush, {&prepared, 1}, true);
195:   lastRegistration = prepared.publish(*brush);
196:   if (lastRegistration.error != PropError::ERROR_NONE) {
197:     return lastRegistration;
198:   }
199:   dabNodes_.clear();
200:   if (radius > 0) {
201:     tree->filterNodes(center, radius, dabNodes_);
202:   }
203:   lastDabNodeCount = int(dabNodes_.size());
204:   if (dabNodes_.size()) {
205:     auto *mesh = tree->m;
206:     if (const auto *hooks = brushHooksFor(brushType); hooks && hooks->stepPreFreeze) {
207:       BrushHookCtx hc{*this, mesh, &dabNodes_, brush, isFirstOfStep};
208:       hooks->stepPreFreeze(hc);
209:     }
210:     if (brush->automask_cavity) {
211:       if (mesh->topo_frozen && !mesh->topo_cache.valid(*mesh))
212:         mesh->thawTopo();
213:       mesh->topo_cache.ensureRing1(*mesh);
214:     }
215:     if (brushNeedsLiveLinks(brushType) || keepTopoThawed) {
216:       if (mesh->topo_frozen)
217:         mesh->thawTopo();
218:     } else if (!mesh->topo_frozen) {
219:       mesh->freezeTopo();
220:     }
221:     ctx.m = mesh;
222:     ctx.surfaceNo = normal;
223:     ctx.surfacePos = center;
224:     ctx.meshLog = meshLog;
225:     ctx.isFirstOfStep = isFirstOfStep;
226:     updateStrokeFrame(center);
227:     brush->pushStrokeSample(center, normal);
228:     curCaptureSlot = 0;
229:     curCaptureTool = int(brushType);
230:     ScopedPreparedCavity cavityScope(preparedCavityActive);
231:     exec(command, {dabNodes_.data(), dabNodes_.size()});
232:     curCaptureSlot = -1;
233:     tree->updateQueries();
234:   }
235:   clearIsFirstOfStep();
236:   return {};
237: }
