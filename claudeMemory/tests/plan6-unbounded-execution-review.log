243:   bool preparedAssignmentSafe(const Expr &expression) const
244:   {
245:     const Expr *root = &expression;
246:     while (root->kind == ExprKind::Member || root->kind == ExprKind::Index ||
247:            root->kind == ExprKind::Paren)
248:     {
249:       root = root->lhs.get();
250:     }
251:     if (root->kind != ExprKind::Ident)
252:       return false;
253:     for (const auto &neighbor : nbrBundles)
254:       if (root->name == neighbor)
255:         return false;
256:     // Lexical locals win over fields/parameters, just as identifier emission does.
257:     for (size_t i = locals.size(); i > 0; i--)
258:       if (root->name == locals[i - 1].name)
259:         return scalarOrVectorValue(locals[i - 1].type);
260:     if (currentTexture && currentStage) {
261:       for (const auto &param : currentStage->params)
262:         if (root->name == param.name)
263:           return scalarOrVectorValue(param.type);
264:     }
265:     if (currentStage != vertexStage || root->name != vertexParamName)
266:       return false;
267:     // A vertex bundle exposes executor/context references as well as geometry.
268:     // Only direct geometry members and numeric component/index suffixes qualify.
269:     const Expr *member = &expression;
270:     while (member->kind == ExprKind::Paren || member->kind == ExprKind::Index ||
271:            (member->kind == ExprKind::Member &&
272:             (member->name == string("x") || member->name == string("y") ||
273:              member->name == string("z") || member->name == string("w"))))
274:     {
275:       member = member->lhs.get();
276:     }
277:     if (member->kind != ExprKind::Member ||
278:         (member->name != string("co") && member->name != string("no") &&
279:          member->name != string("mask")))
280:       return false;
281:     const Expr *base = member->lhs.get();
282:     while (base->kind == ExprKind::Paren)
283:       base = base->lhs.get();
284:     return base == root;
285:   }
