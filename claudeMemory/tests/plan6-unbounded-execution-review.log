66: bool GridBrushExecutor::preflightRaw(SculptBrushes type, float3 origin, float3 normal)
67: {
68:   lastRegistration = resolvedState(origin, normal);
69:   if (lastRegistration.error != props::PropError::ERROR_NONE)
70:     return false;
71:   Brush scratch;
72:   brush_command command;
73:   if (!createCommandSwitch<AccumLive>(type, &scratch, command)) {
74:     lastRegistration = {props::PropError::ERROR_NOT_EXISTS, "kernel"};
75:     return false;
76:   }
77:   if (!maskStorageSupported(*this, command.writesMask)) {
78:     lastRegistration = {props::PropError::ERROR_SCHEMA_CONFLICT, "mask channel"};
79:     return false;
80:   }
81:   PreparedBrushScalars prepared;
82:   lastRegistration =
83:       prepareBrushScalars(*brush,
84:                           {command.uniforms.data(), command.uniforms.size()},
85:                           brush->deviceInputCtx,
86:                           prepared,
87:                           {},
88:                           {},
89:                           ScalarSource::RawStandalone);
90:   if (lastRegistration.error != props::PropError::ERROR_NONE)
91:     fprintf(stderr,
92:             "SculptCore: rejected %s (property status %d)\n",
93:             lastRegistration.name.c_str(),
94:             int(lastRegistration.error));
95:   return lastRegistration.error == props::PropError::ERROR_NONE;
96: }
