376:   // runs live-from-live even in a non-accumulate stroke; see def.relaxesBase.
377:   bool isRelaxation = false;
378:   // A kernel marked `@unbounded` has a field with unbounded support that is its
379:   // own falloff, so `strength()` is forbidden in it (sema errors) and
380:   // `unbounded_window()` is required — the window makes the field vanish at the
381:   // host's node-filter radius instead of tearing on a leaf boundary. It is
382:   // non-accumulate-ineligible for now, unlike `@incremental`, whose
383:   // non-accumulability is structural. See the Open list in the wave-5 plan.
384:   bool isUnbounded = false;
385:   // `@incremental`: a stage input is a per-dab *delta* rather than an absolute
386:   // stroke quantity (snakehook's `grabTo` is the step since the last dab), so
387:   // there is no stroke-start base to re-derive the dab from — replaying it from
388:   // base would discard every earlier dab's drag. Codegen emits
389:   // def.accumulable = false, which makes the executor ignore nonAccum.
390:   bool isIncremental = false;
391:   // `@tool NAME[, NAME...]`: the SculptBrushes enum items this kernel implements.
392:   // One kernel can serve several tools (plane.sbrush is CLAY/SCRAPE/FILL — the
393:   // host varies uniforms, not code). Empty means the kernel is compiled but not
394:   // dispatched by any tool, which is what the built-in registry generator uses to
395:   // tell a live kernel from a scratch one.
396:   Vector<string> tools;
397:   // `@fulltopo`: the kernel (or its host pre-pass) walks live topology links every
398:   // dab, so the stroke can neither freeze topology nor read neighbors from a
399:   // stroke-start CSR snapshot.
400:   bool isFullTopo = false;
401:   // `@gpu`: the kernel has a GPU port — the built-in registry publishes its stem
402:   // per tool in kBuiltinBrushGpuKernel, which gpu_marshal dispatches on.
403:   bool isGpu = false;
404: };
