355:   /** C1 cutoff window for an `@unbounded` field: 1 inside 0.8R, smoothstepped
356:    * to exactly 0 at R = radius * unboundedExtent. The host filters spatial
357:    * nodes against the same R, so the field vanishes before the region boundary
358:    * and no seam can form on a leaf edge. Extent <= 0 disables it. */
359:   float unboundedWindow(float3 co)
360:   {
361:     float R = brush.radius * brush.unboundedExtent;
362:     if (!(R > 0.0f)) {
363:       return 1.0f;
364:     }
365:     float d = (co - surfacePos).length();
366:     float t = std::clamp((R - d) / (0.2f * R), 0.0f, 1.0f);
367:     return t * t * (3.0f - 2.0f * t);
368:   }
