62:   friend struct CommandExecutor;
63:   friend struct GridBrushExecutor;
64:   /** Only for synchronous prepare/check/publish in the executor. No raw edits,
65:    * callbacks or yield points may intervene; this is not a reusable token. */
66:   props::ScalarRegistrationResult publish(Brush &brush) const;
67:   void applyWorking(Brush &brush) const;
