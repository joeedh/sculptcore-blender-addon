267:   }
268:   Vector<brush_command> commands;
269:   commands.resize(program->commands.size());
270:   Vector<std::span<const BrushUniformManifestEntry>> manifests;
271:   for (size_t i = 0; i < program->commands.size(); i++) {
272:     const auto &entry = program->commands[i];
