279:       lastRegistration = programError(
280:           i, {PropError::ERROR_INVALID_VALUE, "unsupported resolved capability"});
281:       return lastRegistration;
282:     }
283:     manifests.append({command.uniforms.data(), command.uniforms.size()});
284:   }
285:   PreparedProgramScalars prepared;
286:   lastRegistration = prepareProgramScalars(*brush,
287:                                            *program,
288:                                            {manifests.data(), manifests.size()},
289:                                            brush->deviceInputCtx,
290:                                            prepared);
291:   if (lastRegistration.error != PropError::ERROR_NONE || validateOnly)
292:     return lastRegistration;
293:   stats.dabs++;
294:   dabMoved_.clear();
295:   dabGrids_.clear();
296:   dabLeaves_.clear();
297:   nodePtrs_.clear();
298:   if (prepared.radius > 0 && queryDabLeaves(false, prepared.radius, origin)) {
299:     ScopedBrushWorkingValues working(*brush,
300:                                      {prepared.stages.data(), prepared.stages.size()});
301:     updateStrokeFrame(origin);
302:     brush->pushStrokeSample(origin, normal);
303:     dabSeq_++;
304:     ScopedPreparedCavity cavityScope(preparedCavityActive);
305:     for (size_t i = 0; i < commands.size(); i++) {
306:       if (prepared.radii[i] == 0)
307:         continue;
308:       prepared.stages[i].applyWorking(*brush);
309:       execStage(commands[i], origin, normal);
